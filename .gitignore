# bv (beads viewer) local config and caches
.bv/

# Runtime state and caches (use XDG dirs in production)
state/
cache/
*.log

# User-specific configuration (may contain IPs, hosts, credentials)
config/hosts.yaml
config/config.yaml
config/repos.d/*.yaml
!config/repos.d/_template_*.yaml
!config/repos.d/*.yaml.example
secrets/

# Act (nektos/act) artifacts
.actrc
*.actrc

# Build artifacts
a.out
artifacts/
manifests/
*.minisig

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
._*

# Temporary files
*.tmp
*.bak
.beads/.br_history/

# === multi-repo ephemeral patterns 2026-08-10 ===
# br fsqlite-ns VFS sidecars — per-machine runtime state, like -wal/-shm
.beads/beads.db-fsqlite-ns-*
.beads/.write.lock.stale-*
# Agent runtime scratch
.ee/
.ntm/
.wrangler/
.claude/
.repo_janitor_workspace/
.skill-loop-progress.md
.skill-loop-progress-*.md
