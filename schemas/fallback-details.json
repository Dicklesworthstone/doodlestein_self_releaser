{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dicklesworthstone/doodlestein_self_releaser/schemas/fallback-details.json",
  "title": "DSR Fallback Details",
  "description": "Details payload for 'dsr fallback' command",
  "type": "object",
  "required": ["repo", "steps"],
  "properties": {
    "repo": {
      "type": "string",
      "description": "Repository name"
    },
    "version": {
      "type": "string",
      "description": "Version/tag used for the fallback"
    },
    "expected_sha": {
      "type": "string",
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
      "description": "Explicit workflow source commit required of the checkout, version tag, and build manifest"
    },
    "watch_admission": {
      "$ref": "#/$defs/watch_admission",
      "description": "Original conditional authority for an automatic workflow worker"
    },
    "watch_observation": {
      "type": ["object", "null"],
      "description": "Latest fresh admission result; null before a check or after its refusal",
      "required": ["run_id", "run_attempt", "workflow_id", "reason", "status", "conclusion", "threshold_seconds", "checked_epoch"],
      "properties": {
        "run_id": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
        "run_attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "workflow_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "reason": { "enum": ["throttled", "upstream_failure"] },
        "status": { "enum": ["queued", "in_progress", "completed"] },
        "conclusion": { "enum": [null, "failure", "timed_out", "startup_failure"] },
        "threshold_seconds": { "type": "integer", "minimum": 0, "maximum": 9999999 },
        "checked_epoch": { "type": "integer", "minimum": 0 },
        "queue_reason": { "enum": ["workflow_queue", "job_queue"] },
        "queued_job_ids": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "isolated_source": {
      "type": "boolean",
      "description": "Pinned source is materialized privately without changing the configured checkout"
    },
    "source_materialization": {
      "type": ["object", "null"],
      "description": "Retained private source identity; null before materialization or in a dry-run plan",
      "required": ["source_root", "git_sha", "git_ref", "tag_object", "transport"],
      "properties": {
        "source_root": { "type": "string", "pattern": "^/" },
        "git_sha": { "type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$" },
        "git_ref": { "type": "string" },
        "tag_object": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "transport": { "enum": ["local-objects", "github"] },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["relative_path", "local_path", "git_sha"],
            "properties": {
              "relative_path": { "type": "string" },
              "local_path": { "type": "string", "pattern": "^/" },
              "git_sha": { "type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$" }
            }
          }
        }
      }
    },
    "trigger": {
      "type": "string",
      "description": "Reason the fallback was triggered"
    },
    "publication_recovery": {
      "type": "object",
      "required": ["schema_version", "intent", "build_run_id", "status"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "dsr.strict_fallback_recovery.v1" },
        "intent": { "type": "string", "pattern": "^/" },
        "build_run_id": { "type": "string", "format": "uuid" },
        "status": { "enum": ["prepared", "ready", "blocked", "finalized"] },
        "create_response": { "type": "string", "pattern": "^/" },
        "finalization_tmpdir": { "type": "string", "pattern": "^/" },
        "release_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "finalization_receipt": { "type": "string", "pattern": "^/" }
      }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/fallback_step" },
      "description": "Steps executed during fallback"
    },
    "build_manifest": {
      "type": "string",
      "description": "Path to build manifest JSON"
    },
    "release_url": {
      "type": "string",
      "format": "uri",
      "description": "GitHub release URL"
    }
  },
  "$defs": {
    "watch_admission": {
      "type": "object",
      "required": ["run_id", "run_attempt", "workflow_id", "repo", "version", "git_sha", "reason", "threshold_seconds"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
        "run_attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "workflow_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+([.+-][0-9A-Za-z.+-]*)?$" },
        "git_sha": { "type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$" },
        "reason": { "enum": ["throttled", "upstream_failure"] },
        "threshold_seconds": { "type": "integer", "minimum": 0, "maximum": 9999999 }
      },
      "if": { "properties": { "reason": { "const": "throttled" } } },
      "then": { "properties": { "threshold_seconds": { "minimum": 1 } } },
      "else": { "properties": { "threshold_seconds": { "const": 0 } } }
    },
    "fallback_step": {
      "type": "object",
      "required": ["command", "status", "exit_code"],
      "properties": {
        "command": {
          "type": "string",
          "enum": ["check", "build", "release"],
          "description": "Step name"
        },
        "status": {
          "type": "string",
          "enum": ["success", "partial", "error"],
          "description": "Step status"
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "description": "Step exit code"
        },
        "run_id": {
          "type": "string",
          "format": "uuid",
          "description": "Run identifier for this step"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Duration of step"
        },
        "error": {
          "type": "string",
          "description": "Error message if step failed"
        }
      }
    }
  }
}
