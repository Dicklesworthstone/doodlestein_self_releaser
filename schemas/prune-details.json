{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dicklesworthstone/doodlestein_self_releaser/schemas/prune-details.json",
  "title": "DSR Prune Details",
  "description": "Details payload for 'dsr prune' command",
  "type": "object",
  "required": ["state_dir", "dry_run", "pruned_count", "bytes_freed"],
  "properties": {
    "state_dir": {
      "type": "string",
      "description": "State directory being pruned"
    },
    "dry_run": {
      "type": "boolean",
      "description": "Whether this was a dry run"
    },
    "snapshots_only": {
      "type": "boolean",
      "description": "Whether only owned retired Unix snapshots were considered, preserving ordinary artifacts, logs, caches and checkpoints"
    },
    "include_latest": {
      "type": "boolean",
      "description": "Whether completed latest runs were explicitly included in snapshot retirement; all retention and build-custody checks still apply"
    },
    "cutoff_days": {
      "type": "integer",
      "minimum": 0,
      "description": "Age threshold for pruning"
    },
    "keep_last": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of recent items to keep"
    },
    "keep_releases": {
      "type": "boolean",
      "description": "Whether artifacts of published releases were kept regardless of age"
    },
    "kept_for_releases": {
      "type": "integer",
      "minimum": 0,
      "description": "Old artifact sets kept because dsr published their release"
    },
    "pruned_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of items pruned"
    },
    "bytes_freed": {
      "type": "integer",
      "minimum": 0,
      "description": "Total bytes freed"
    },
    "pruned_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/pruned_item" },
      "description": "List of pruned files"
    },
    "retained_build_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/retained_build_item" },
      "description": "Build checkpoints or version directories excluded by ownership and state checks, in addition to ordinary age, latest and keep-last retention"
    },
    "retained_artifact_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/retained_artifact_item" },
      "description": "Artifact directories or adjacent manifests retained because build custody, publication completion or canonical ownership could not be established"
    },
    "snapshot_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/snapshot_result" },
      "description": "Per-host snapshot inspection or removal outcomes; already-absent roots contribute no bytes or pruned count"
    },
    "retained_snapshot_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/retained_snapshot_item" },
      "description": "Snapshot source roots retained because ownership, host support, transport or cleanup could not be established"
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/prune_error" },
      "description": "Errors encountered during pruning"
    }
  },
  "$defs": {
    "snapshot_result": {
      "type": "object",
      "required": ["host", "source_root", "path", "status", "size_bytes"],
      "properties": {
        "host": { "type": "string" },
        "source_root": { "type": "string" },
        "path": { "type": "string", "description": "Owned snapshot parent, including source and private caches" },
        "status": { "enum": ["eligible", "removed", "already_absent"] },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "if": { "properties": { "status": { "const": "already_absent" } } },
      "then": { "properties": { "size_bytes": { "const": 0 } } }
    },
    "retained_snapshot_item": {
      "type": "object",
      "required": ["path", "host", "run_id", "reason"],
      "properties": {
        "path": { "type": "string", "description": "Retained source root on this host" },
        "host": { "type": "string" },
        "run_id": { "type": "string" },
        "reason": {
          "enum": ["snapshot_ownership", "unsupported_host", "snapshot_transport", "cleanup_failed"]
        }
      },
      "additionalProperties": false
    },
    "retained_artifact_item": {
      "type": "object",
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string" },
        "reason": {
          "type": "string",
          "enum": ["build_custody", "artifact_ownership", "publication_pending"]
        }
      },
      "additionalProperties": false
    },
    "retained_build_item": {
      "type": "object",
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string" },
        "reason": {
          "type": "string",
          "enum": ["build_custody", "source_roots", "invalid_state", "active_run", "publication_pending", "release_retention"]
        }
      },
      "additionalProperties": false
    },
    "pruned_item": {
      "type": "object",
      "required": ["path", "size_bytes"],
      "properties": {
        "path": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "mtime": { "type": "string", "format": "date-time" },
        "host": { "type": "string" },
        "run_id": { "type": "string" },
        "source_root": { "type": "string" },
        "status": { "enum": ["eligible", "removed"] }
      }
    },
    "prune_error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "path": { "type": "string" }
      }
    }
  }
}
