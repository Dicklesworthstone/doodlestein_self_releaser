+# Generate checksums from the final manifest before any GitHub mutation.
+# Retain already-valid checksum bytes exactly: sorting or normalizing a signed
+# SHA256SUMS would invalidate its detached signature. Missing files are staged
+# and published without clobbering; a failed retry never truncates evidence.
+_release_prepare_ordinary_checksums() (
+    local manifest="$1" directory="$2" expected="$3"
+    local rows name sha path suffix stage current
+    local -a names=(SHA256SUMS)
+    local -A retained=()
+    signing_validate_release_inventory "$manifest" "$directory" "$expected" || return $?
+    rows=$(jq -er '.artifacts | sort_by(.name)[] | [.name,.sha256] | @tsv' "$manifest") || return 4
+    # Payloads cannot occupy generated checksum names, even by case folding.
+    jq -e '[.artifacts[].name] as $p |
+        ($p + ($p | map(. + ".sha256")) + ["SHA256SUMS"]) as $all |
+        ($all | map(ascii_downcase) | unique | length) == ($all | length)
+    ' "$manifest" >/dev/null || {
+        log_error "Payload names collide with generated release checksums"
+        return 4
+    }
+    while IFS=$'\t' read -r name sha; do names+=("$name.sha256"); done <<< "$rows"
+    # Check the entire retained set before exposing any new checksum file.
+    for name in "${names[@]}"; do
+        path="$directory/$name"
+        if [[ -e "$path" || -L "$path" ]]; then
+            retained["$name"]=$(_signing_sha256 "$path") || return 4
+        else
+            for suffix in minisig sig asc; do
+                if [[ -e "$path.$suffix" || -L "$path.$suffix" ]]; then
+                    log_error "Refusing to regenerate checksum with orphan signature: $name.$suffix"
+                    return 4
+                fi
+            done
+        fi
+    done
+    # A completed retry does not create staging or rewrite any inode.
+    if [[ ${#retained[@]} -eq ${#names[@]} ]]; then
+        signing_validate_release_inventory "$manifest" "$directory" "$expected" || return $?
+        for name in "${!retained[@]}"; do
+            [[ "$(_signing_sha256 "$directory/$name")" == "${retained[$name]}" ]] || return 4
+        done
+        return 0
+    fi
+    umask 077
+    stage=$(mktemp -d "$directory/.dsr-checksums.XXXXXXXX") || return 4
+    # Retain private staging on errors, just like failed build collection.
+    : > "$stage/SHA256SUMS" || return 4
+    while IFS=$'\t' read -r name sha; do
+        printf '%s  %s\n' "$sha" "$name" >> "$stage/SHA256SUMS" || return 4
+        printf '%s  %s\n' "$sha" "$name" > "$stage/$name.sha256" || return 4
+    done <<< "$rows"
+    signing_validate_release_inventory "$manifest" "$directory" "$expected" || return $?
+    # Keep retained GNU binary-marker/order/newline conventions unchanged.
+    # Exclusive link publication also refuses a competing pathname or symlink.
+    for name in "${names[@]}"; do
+        path="$directory/$name"
+        if [[ -n "${retained[$name]:-}" ]]; then
+            current=$(_signing_sha256 "$path") || return 4
+            [[ "$current" == "${retained[$name]}" ]] || return 4
+        else
+            for suffix in minisig sig asc; do
+                [[ ! -e "$path.$suffix" && ! -L "$path.$suffix" ]] || return 4
+            done
+            if ! ln -- "$stage/$name" "$path"; then
+                log_error "Checksum publication conflict: $name"
+                return 4
+            fi
+            [[ -f "$path" && ! -L "$path" && "$path" -ef "$stage/$name" ]] || return 4
+        fi
+    done
+    signing_validate_release_inventory "$manifest" "$directory" "$expected" || return $?
+    for name in "${!retained[@]}"; do
+        [[ "$(_signing_sha256 "$directory/$name")" == "${retained[$name]}" ]] || return 4
+    done
+)
