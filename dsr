# ============================================================================
# VERIFY SUBCOMMAND - Verification Commands
# ============================================================================

cmd_verify() {
    local subcmd="${1:-}"
    shift 2>/dev/null || true

    case "$subcmd" in
        upgrade)
            _verify_upgrade "$@"
            ;;
        --help|-h|help|"")
            cat << 'EOF'
dsr verify - Verification commands

USAGE:
    dsr verify upgrade <tool> [options]
    dsr verify upgrade --all

SUBCOMMANDS:
    upgrade     Verify tool upgrade commands work correctly after release

OPTIONS:
    --version <ver>        Require the update check to resolve this exact version
    --build-from-source   Build tool from source before testing
    --dry-run             Show what would be tested
    --all                 Verify all tools

DESCRIPTION:
    After releasing binaries, verify that each tool's configured update-check
    command finds the new release assets. The default is `upgrade --check`;
    set `upgrade_check_args` in repos.d/<tool>.yaml for a different CLI.
    Catches asset naming mismatches between code and build configs.

EXAMPLES:
    dsr verify upgrade ntm                    Verify ntm's upgrade command
    dsr verify upgrade --all                  Verify all tools
    dsr verify upgrade ntm --build-from-source  Build and verify

EXIT CODES:
    0  - All verifications passed
    1  - Some verifications failed
    4  - Invalid arguments
EOF
            return 0
            ;;
        *)
            log_error "Unknown verify subcommand: $subcmd"
            log_info "Run 'dsr verify --help' for usage"
            return 4
            ;;
    esac
}

_verify_upgrade() {
    local tool_name=""
    local all_tools=false
    local build_from_source=false
    local dry_run_flag="${DRY_RUN:-false}"
    local version=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)
                all_tools=true
                shift
                ;;
            --build-from-source)
                build_from_source=true
                shift
                ;;
            --version|-V)
                version="$2"
                shift 2
                ;;
            --dry-run)
                dry_run_flag=true
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                return 4
                ;;
            *)
                tool_name="$1"
                shift
                ;;
        esac
    done

    local start_time
    start_time=$(date +%s)

    local -a args=()
    $build_from_source && args+=("--build-from-source")
    $dry_run_flag && args+=("--dry-run")
    [[ -n "$version" ]] && args+=("--version" "$version")

    if $all_tools; then
        log_info "Verifying upgrade command for all tools..."

        if upgrade_verify_all ${args[@]+"${args[@]}"}; then
            local duration=$(($(date +%s) - start_time))
            if $JSON_MODE; then
                json_envelope "verify-upgrade" "success" 0 "{\"mode\": \"all\", \"dry_run\": $dry_run_flag, \"duration_seconds\": $duration}"
            else
                log_ok "All upgrade verifications passed"
            fi
            return 0
        else
            local duration=$(($(date +%s) - start_time))
            if $JSON_MODE; then
                json_envelope "verify-upgrade" "error" 1 "{\"mode\": \"all\", \"dry_run\": $dry_run_flag, \"duration_seconds\": $duration}"
            else
                log_error "Some upgrade verifications failed"
            fi
            return 1
        fi
    fi

    if [[ -z "$tool_name" ]]; then
        log_error "Tool name required (or use --all)"
        return 4
    fi

    # Run the update check exactly once. The structured runner reports the
    # check's output and versions, but it neither builds nor dry-runs, so
    # those cases (and a binary missing from PATH, which the plain runner
    # builds) go through upgrade_verify_tool and report its verdict.
    local verify_status=0 details=""
    local binary_name
    binary_name=$(_upgrade_tool_binary_name "$tool_name")
    if $JSON_MODE && ! $dry_run_flag && ! $build_from_source &&
       { command -v "$binary_name" &>/dev/null || command -v "$tool_name" &>/dev/null; }; then
        details=$(upgrade_verify_json "$tool_name" ${args[@]+"${args[@]}"}) || verify_status=$?
    else
        upgrade_verify_tool "$tool_name" ${args[@]+"${args[@]}"} || verify_status=$?
        local outcome="passed"
        if [[ $verify_status -ne 0 ]]; then
            outcome="failed"
        elif $dry_run_flag; then
            outcome="planned"
        fi
        details=$(jq -nc --arg tool "$tool_name" --arg status "$outcome" \
            --argjson dry_run "$dry_run_flag" --argjson built "$build_from_source" \
            '{tool: $tool, status: $status, dry_run: $dry_run, built_from_source: $built}')
    fi
    local exit_code=0
    if [[ $verify_status -eq 4 ]]; then
        exit_code=4
    elif [[ $verify_status -ne 0 ]]; then
        exit_code=1
    fi

    local duration=$(($(date +%s) - start_time))
    if $JSON_MODE; then
        json_envelope "verify-upgrade" "$([[ $exit_code -eq 0 ]] && echo success || echo error)" "$exit_code" \
            "$(jq -c --argjson duration "$duration" '. + {duration_seconds: $duration}' <<< "$details")"
    elif [[ $exit_code -eq 0 ]]; then
        log_ok "Upgrade verification passed for $tool_name"
    else
        log_error "Upgrade verification failed for $tool_name"
    fi
    return "$exit_code"
}

# ============================================================================
# INSTALLER SUBCOMMAND - Generate curl|bash installers
# ============================================================================

cmd_installer() {
    local subcmd="${1:-}"
    shift 2>/dev/null || true
    local output_dir="${DSR_INSTALLER_DIR:-$SCRIPT_DIR/installers}"
    local all=false dry_run="${DRY_RUN:-false}"
    local -a tools=()

    case "$subcmd" in
        generate|validate) ;;
        --help|-h|help|"")
            cat << 'EOF'
dsr installer - Generate and validate curl|bash installers

USAGE:
    dsr installer generate <tool>... [--output-dir DIR] [--dry-run]
    dsr installer generate --all [--output-dir DIR] [--dry-run]
    dsr installer validate <tool>... [--output-dir DIR]

DESCRIPTION:
    Writes <output-dir>/<tool>/install.sh from repos.d/<tool>.yaml: platform
    and libc detection, checksum verification, minisign verification with
    the configured key (or the `dsr signing init` key), staleness-aware
    source fallback, offline caching and agent-skill installation.
    Installs every configured workspace executable for the selected platform,
    with complete-set validation and rollback if replacement fails.
    The default output directory is the one `dsr canary` tests:
    installers/ beside dsr (override with --output-dir or DSR_INSTALLER_DIR).
    Commit each generated install.sh to its tool's repository so the
    documented `curl ... | bash` URL serves it.

    validate checks syntax, ShellCheck and the required safety elements.

EXIT CODES:
    0  - All installers generated/valid
    1  - Some tools failed
    4  - Invalid arguments or tool configuration
EOF
            return 0
            ;;
        *)
            log_error "Unknown installer subcommand: $subcmd"
            log_info "Run 'dsr installer --help' for usage"
            return 4
            ;;
    esac

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) all=true; shift ;;
            --output-dir|-o)
                [[ $# -ge 2 && -n "$2" ]] || { log_error "$1 requires a directory"; return 4; }
                output_dir="$2"; shift 2 ;;
            --dry-run) dry_run=true; shift ;;
            -*) log_error "Unknown option: $1"; return 4 ;;
            *) tools+=("$1"); shift ;;
        esac
    done

    _dsr_require install_gen
    _IG_OUTPUT_DIR="$output_dir"

    if $all; then
        [[ ${#tools[@]} -eq 0 ]] || { log_error "Give tool names or --all, not both"; return 4; }
        local repos_d="${DSR_CONFIG_DIR:-$HOME/.config/dsr}/repos.d" config_file
        for config_file in "$repos_d"/*.yaml; do
            [[ -f "$config_file" && "${config_file##*/}" != _* ]] || continue
            tools+=("$(basename "$config_file" .yaml)")
        done
    fi
    if [[ ${#tools[@]} -eq 0 ]]; then
        log_error "No tools given (name them, or use --all with tools in repos.d)"
        log_info "Run 'dsr installer --help' for usage"
        return 4
    fi

    local tool path status=0 last_status=0 ok=0
    local -a results=()
    for tool in "${tools[@]}"; do
        status=0 path="$output_dir/$tool/install.sh"
        if [[ ! "$tool" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
            log_error "Invalid tool name: $tool"
            status=4
        elif [[ "$subcmd" == validate ]]; then
            install_gen_validate "$tool" >&2 || status=$?
        elif $dry_run; then
            log_info "[dry-run] Would generate $path"
        else
            path=$(install_gen_create "$tool") || status=$?
        fi
        if [[ $status -eq 0 ]]; then
            ((ok++))
        else
            last_status=$status
            log_error "$subcmd failed for $tool (exit $status)"
        fi
        results+=("$(jq -nc --arg tool "$tool" --arg path "$path" --argjson status "$status" \
            '{tool: $tool, path: $path, ok: ($status == 0), exit_code: $status}')")
    done

    local exit_code=0
    if [[ $ok -lt ${#tools[@]} ]]; then
        exit_code=1
        [[ $ok -eq 0 ]] && exit_code="$last_status"
    fi
    if $JSON_MODE; then
        local status_word=success
        [[ $exit_code -eq 0 ]] || status_word=$([[ $ok -gt 0 ]] && echo partial || echo error)
        json_envelope "installer" "$status_word" "$exit_code" "$(printf '%s\n' "${results[@]}" | jq -sc \
            --arg action "$subcmd" --arg output_dir "$output_dir" --argjson dry_run "$dry_run" \
            '{action: $action, output_dir: $output_dir, dry_run: $dry_run, installers: .}')"
    else
        [[ "$subcmd" == generate ]] && ! $dry_run && [[ $ok -gt 0 ]] &&
            jq -r 'select(.ok) | .path' <<< "$(printf '%s\n' "${results[@]}")"
        log_info "Installer $subcmd: $ok of ${#tools[@]} succeeded"
    fi
    return "$exit_code"
}

# ============================================================================
# CANARY SUBCOMMAND - Installer Testing in Docker
# ============================================================================

cmd_canary() {
    local subcmd="${1:-}"
    shift 2>/dev/null || true

    case "$subcmd" in
        run)
            _canary_run "$@"
            ;;
        matrix)
            _canary_matrix "$@"
            ;;
        schedule)
            _canary_schedule "$@"
            ;;
        results)
            _canary_results "$@"
            ;;
        --help|-h|help|"")
            cat << 'EOF'
dsr canary - Test installers in Docker containers

USAGE:
    dsr canary run <tool> [--os <image>] [--mode <vibe|safe>]
    dsr canary run --all [--os <image>]
    dsr canary matrix [--tools <list>]
    dsr canary schedule [--cron <expr>] [--unschedule] [--show] [--dry-run]
    dsr canary results

SUBCOMMANDS:
    run         Run canary test for one or all tools
    matrix      Run full test matrix (all images/modes)
    schedule    Setup daily canary cron job
    results     Show latest canary results

OPTIONS:
    --os <image>    Docker image to test (default: ubuntu:24.04)
    --mode <mode>   Installation mode: vibe or safe (default: vibe)
    --all           Test all tools with installers
    --tools <list>  Comma-separated list of tools
    --cron <expr>   Cron schedule: five fields or @daily-style (default: "0 6 * * *")
    --unschedule    Remove the canary crontab entry
    --show          Show the canary crontab entry
    --dry-run       Show the crontab change without making it

EXAMPLES:
    dsr canary run ntm                      Test ntm on ubuntu:24.04
    dsr canary run ntm --os debian:12       Test on specific image
    dsr canary run --all                    Test all tools
    dsr canary matrix                       Full test matrix
    dsr canary schedule                     Setup daily cron
    dsr canary results                      Show latest results

EXIT CODES:
    0  - All tests passed
    1  - Some tests failed
    3  - Docker not available
    4  - Invalid arguments
EOF
            return 0
            ;;
        *)
            log_error "Unknown canary subcommand: $subcmd"
            log_info "Run 'dsr canary --help' for usage"
            return 4
            ;;
    esac
}

_canary_run() {
    local tool=""
    local image="ubuntu:24.04"
    local mode="vibe"
    local all_tools=false
    local verbose=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --os|--image)
                image="$2"
                shift 2
                ;;
            --mode)
                mode="$2"
                shift 2
                ;;
            --all)
                all_tools=true
                shift
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                return 4
                ;;
            *)
                tool="$1"
                shift
                ;;
        esac
    done

    # Check Docker
    if ! canary_check_docker; then
        if $JSON_MODE; then
            json_envelope "canary" "error" 3 '{"error": "Docker not available"}'
        fi
        return 3
    fi

    local start_time results
    start_time=$(date +%s)

    if $all_tools; then
        log_info "Running canary tests for all tools on $image ($mode mode)..."
        # stdout is the results object; progress and container output stay
        # on stderr instead of being parsed as part of it.
        local status=0
        results=$(canary_run_image "$image" --mode "$mode") || status=$?
        if ! jq -e 'type == "object" and has("results")' <<< "$results" >/dev/null 2>&1; then
            log_error "Canary run produced no results"
            $JSON_MODE && json_envelope "canary" "error" 1 '{"error": "canary run produced no results"}'
            return 1
        fi

        if $JSON_MODE; then
            local duration=$(($(date +%s) - start_time))
            json_envelope "canary" "$([[ $status -eq 0 ]] && echo "success" || echo "error")" "$status" \
                "$(echo "$results" | jq -c --argjson duration "$duration" '. + {duration_seconds: $duration}')"
        else
            echo "$results" | jq -r '
                "Results for \(.image) (\(.mode) mode):",
                "  Passed: \(.passed)",
                "  Failed: \(.failed)",
                "",
                (.results[] | "  \(.tool): \(.status)")
            ' >&2
        fi

        canary_save_results "$results" || log_warn "Could not save canary results"

        return $status
    fi

    if [[ -z "$tool" ]]; then
        log_error "Tool name required (or use --all)"
        return 4
    fi

    log_info "Running canary test for $tool on $image ($mode mode)..."

    if canary_run_test "$tool" "$image" "$mode" "$verbose"; then
        local duration=$(($(date +%s) - start_time))
        if $JSON_MODE; then
            json_envelope "canary" "success" 0 "$(jq -nc \
                --arg tool "$tool" \
                --arg image "$image" \
                --arg mode "$mode" \
                --argjson duration "$duration" \
                '{tool: $tool, image: $image, mode: $mode, status: "passed", duration_seconds: $duration}')"
        else
            log_ok "Canary test passed for $tool on $image"
        fi
        return 0
    else
        local duration=$(($(date +%s) - start_time))
        if $JSON_MODE; then
            json_envelope "canary" "error" 1 "$(jq -nc \
                --arg tool "$tool" \
                --arg image "$image" \
                --arg mode "$mode" \
                --argjson duration "$duration" \
                '{tool: $tool, image: $image, mode: $mode, status: "failed", duration_seconds: $duration}')"
        else
            log_error "Canary test failed for $tool on $image"
        fi
        return 1
    fi
}

_canary_matrix() {
    local tools_arg=""
    local modes_arg=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tools)
                tools_arg="--tools $2"
                shift 2
                ;;
            --modes)
                modes_arg="--modes $2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    # Check Docker
    if ! canary_check_docker; then
        if $JSON_MODE; then
            json_envelope "canary-matrix" "error" 3 '{"error": "Docker not available"}'
        fi
        return 3
    fi

    log_info "Running full canary matrix..."

    local start_time
    start_time=$(date +%s)

    # shellcheck disable=SC2086  # Intentional word splitting
    if canary_run_matrix $tools_arg $modes_arg; then
        local duration=$(($(date +%s) - start_time))
        if $JSON_MODE; then
            json_envelope "canary-matrix" "ok" 0 "{\"duration_seconds\": $duration}"
        else
            log_ok "Matrix tests completed successfully"
        fi
        return 0
    else
        local duration=$(($(date +%s) - start_time))
        if $JSON_MODE; then
            json_envelope "canary-matrix" "failed" 1 "{\"duration_seconds\": $duration}"
        else
            log_error "Some matrix tests failed"
        fi
        return 1
    fi
}

_canary_schedule() {
    local cron_expr="$CANARY_DEFAULT_SCHEDULE"
    local unschedule=false
    local dry_run="${DRY_RUN:-false}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --cron)
                [[ $# -ge 2 ]] || { log_error "--cron requires a schedule"; return 4; }
                cron_expr="$2"
                shift 2
                ;;
            --remove|--unschedule)
                unschedule=true
                shift
                ;;
            --show)
                canary_show_schedule
                return 0
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            *)
                log_error "Unknown schedule option: $1"
                log_info "Usage: dsr canary schedule [--cron <expr>] [--unschedule] [--show] [--dry-run]"
                return 4
                ;;
        esac
    done

    local action="schedule" entry="" status=0
    $unschedule && action="unschedule"
    if ! $unschedule && ! entry=$(canary_cron_entry "$cron_expr"); then
        log_error "Invalid cron schedule: $cron_expr (five fields or @daily-style keyword)"
        $JSON_MODE && json_envelope "canary" "error" 4 "$(jq -nc --arg cron "$cron_expr" '{action: "schedule", error: "invalid cron schedule", cron: $cron}')"
        return 4
    fi

    if $dry_run; then
        if $unschedule; then
            log_info "[dry-run] Would remove crontab lines containing 'dsr canary'"
        else
            log_info "[dry-run] Would install crontab entry: $entry"
        fi
    elif $unschedule; then
        canary_unschedule || status=$?
    else
        canary_schedule "$cron_expr" || status=$?
    fi

    if $JSON_MODE; then
        json_envelope "canary" "$([[ $status -eq 0 ]] && echo success || echo error)" "$status" \
            "$(jq -nc --arg action "$action" --arg entry "$entry" --argjson dry_run "$dry_run" \
                '{action: $action, entry: (if $entry == "" then null else $entry end), dry_run: $dry_run}')"
    fi
    return "$status"
}

_canary_results() {
    local results
    results=$(canary_get_latest)

    if $JSON_MODE; then
        echo "$results"
    else
        echo "$results" | jq -r '
            if .error then
                "No canary results found"
            else
                "Latest canary results (\(.timestamp // "unknown")):",
                "  Image: \(.image // "unknown")",
                "  Mode: \(.mode // "unknown")",
                "  Passed: \(.passed // 0)",
                "  Failed: \(.failed // 0)",
                "",
                "Results:",
                (.results // [] | .[] | "  \(.tool): \(.status)")
            end
        '
    fi
}

