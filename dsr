#!/usr/bin/env bash
# dsr - Doodlestein Self-Releaser
#
# Fallback release infrastructure for when GitHub Actions is throttled.
#
# Usage:
#   dsr <command> [options]
#
# Commands:
#   check     Detect throttled GitHub Actions runs
#   watch     Continuous monitoring daemon
#   build     Build artifacts locally
#   release   Upload artifacts to GitHub
#   fallback  Full pipeline: check -> build -> release
#   repos     Manage repository registry
#   health    Check health of build hosts
#   prune     Clean up old artifacts and cache
#   config    View/modify configuration
#   doctor    System diagnostics
#   signing   Manage minisign keys and signing
#
# Global Options:
#   --json, -j          Machine-readable JSON output
#   --non-interactive   Disable prompts (CI mode)
#   --dry-run, -n       Show planned actions without executing
#   --verbose, -v       Enable verbose logging
#   --quiet, -q         Suppress non-error output
#   --help, -h          Show help
#   --version           Show version

set -uo pipefail

# Version
DSR_VERSION="0.2.3"

# Script directory (optimized: avoid dirname subshell where possible)
_dsr_source="${BASH_SOURCE[0]}"
# Resolve symlinks (portable: try readlink -f, fall back to manual resolution)
if [[ -L "$_dsr_source" ]]; then
  if _dsr_source="$(readlink -f "$_dsr_source" 2>/dev/null)"; then
    : # readlink -f worked (GNU coreutils)
  else
    # macOS/BSD fallback: manually resolve symlink chain
    while [[ -L "$_dsr_source" ]]; do
      _dsr_dir="${_dsr_source%/*}"
      [[ "$_dsr_dir" == "$_dsr_source" ]] && _dsr_dir="."
      _dsr_source="$(cd "$_dsr_dir" && readlink "$_dsr_source")"
      [[ "$_dsr_source" != /* ]] && _dsr_source="$_dsr_dir/$_dsr_source"
    done
    unset _dsr_dir
  fi
fi
SCRIPT_DIR="${_dsr_source%/*}"
[[ "$SCRIPT_DIR" == "$_dsr_source" ]] && SCRIPT_DIR="."
SCRIPT_DIR="$(cd "$SCRIPT_DIR" && pwd)"
unset _dsr_source

# Source guardrails first for Bash version check
source "$SCRIPT_DIR/src/guardrails.sh"

# Enforce Bash 4.0+ requirement
require_bash_4 || exit $?

# ============================================================================
# LAZY MODULE LOADING
# ============================================================================
# Modules are loaded on-demand to improve startup time for simple commands.
# Core modules (logging, config) are always loaded; others load when needed.

# Track loaded modules to avoid double-sourcing
declare -gA _DSR_LOADED_MODULES=()

# Lazy source helper - only loads if not already loaded
_dsr_require() {
  local module="$1"
  [[ -n "${_DSR_LOADED_MODULES[$module]:-}" ]] && return 0
  # shellcheck source=/dev/null  # Dynamic module loading
  source "$SCRIPT_DIR/src/${module}.sh"
  _DSR_LOADED_MODULES[$module]=1
}

# Environment-backed global flags (docs/CLI_CONTRACT.md) must take effect
# before the core modules below derive their paths, log level and colors.
# Value flags are read only before the subcommand; --no-color anywhere before
# a `--` terminator. main() validates and skips the same flags.
_dsr_prescan_global_flags() {
  local in_prefix=true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --) return 0 ;;
      --no-color) export NO_COLOR=1 ;;
      --state-dir|--cache-dir|--config|-c|--log-level)
        if $in_prefix && [[ $# -ge 2 && -n "$2" ]]; then
          case "$1" in
            --state-dir) export DSR_STATE_DIR="$2" ;;
            --cache-dir) export DSR_CACHE_DIR="$2" ;;
            --config|-c) export DSR_CONFIG_FILE="$2" ;;
            --log-level) export DSR_LOG_LEVEL="$2" ;;
          esac
          shift
        fi
        ;;
      --state-dir=*) $in_prefix && export DSR_STATE_DIR="${1#*=}" ;;
      --cache-dir=*) $in_prefix && export DSR_CACHE_DIR="${1#*=}" ;;
      --config=*) $in_prefix && export DSR_CONFIG_FILE="${1#*=}" ;;
      --log-level=*) $in_prefix && export DSR_LOG_LEVEL="${1#*=}" ;;
      -*) ;;
      *) in_prefix=false ;;
    esac
    shift
  done
}
_dsr_prescan_global_flags "$@"

# Core modules (always needed)
source "$SCRIPT_DIR/src/logging.sh"
_DSR_LOADED_MODULES[logging]=1
source "$SCRIPT_DIR/src/config.sh"
_DSR_LOADED_MODULES[config]=1

# Load all modules for commands that need them
_dsr_load_all_modules() {
  _dsr_require secrets
  _dsr_require notify
  _dsr_require signing
  _dsr_require github
  _dsr_require host_health
  _dsr_require host_selector
  _dsr_require quality_gates
  _dsr_require build_state
  _dsr_require git_ops
  _dsr_require version
  _dsr_require act_runner
  _dsr_require release_formulas
  _dsr_require canary
  _dsr_require upgrade_verify
  _dsr_require sbom
  _dsr_require slsa
  _dsr_require docker
}

# Global flags
JSON_MODE=false
# shellcheck disable=SC2034  # Reserved for future use
DRY_RUN=false
VERBOSE=false
QUIET=false
# shellcheck disable=SC2034  # Reserved for future use
NON_INTERACTIVE=false

# Note: Colors and log functions are now provided by src/logging.sh
