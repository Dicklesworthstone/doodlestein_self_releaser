    while [[ $# -gt 0 ]]; do
        case "$1" in
            --format|-f) format="$2"; shift 2 ;;
            --output|-o) output="$2"; shift 2 ;;
            -*) log_error "Unknown option: $1"; return 4 ;;
            *) target="$1"; shift ;;
        esac
    done

    if [[ -z "$target" ]]; then
        log_error "Target path required"
        return 4
    fi

    local start_time
    start_time=$(date +%s)

    local -a args=()
    [[ -n "$output" ]] && args+=("--output" "$output")

    # The SBOM path is stdout; diagnostics stay on stderr, where a failure's
    # cause (syft missing, unreadable target) is shown instead of discarded.
    if _dsr_capture sbom_generate "$target" --format "$format" ${args[@]+"${args[@]}"}; then
        local duration=$(($(date +%s) - start_time))
        if $JSON_MODE; then
            json_envelope "sbom-generate" "success" 0 "$(jq -nc \
                --arg target "$target" \
                --arg format "$format" \
                --arg output "$_DSR_CAPTURED_OUT" \
                --argjson duration "$duration" \
                '{target: $target, format: $format, output: $output, duration_seconds: $duration}')"
        else
            printf '%s\n' "$_DSR_CAPTURED_OUT"
        fi
        return 0
    else
        local exit_code=$?
        local duration=$(($(date +%s) - start_time))
        if [[ -z "$_DSR_CAPTURED_ERR" ]]; then
            _DSR_CAPTURED_ERR="SBOM generation failed for $target (exit $exit_code)"
            log_error "$_DSR_CAPTURED_ERR"
        fi
        if $JSON_MODE; then
            json_envelope "sbom-generate" "error" "$exit_code" "$(jq -nc \
                --arg error "$_DSR_CAPTURED_ERR" \
                --argjson duration "$duration" \
                '{error: $error, duration_seconds: $duration}')"
        fi
        return $exit_code
    fi
}

_sbom_verify() {
    local sbom_file="${1:-}"

    if [[ -z "$sbom_file" ]]; then
        log_error "SBOM file required"
        return 4
    fi

    if sbom_verify "$sbom_file"; then
        if $JSON_MODE; then
            json_envelope "sbom-verify" "ok" 0 "$(jq -nc --arg file "$sbom_file" '{file: $file, valid: true}')"
        fi
        return 0
    else
        local exit_code=$?
        if $JSON_MODE; then
            json_envelope "sbom-verify" "error" "$exit_code" "$(jq -nc --arg file "$sbom_file" '{file: $file, valid: false}')"
        fi
        return $exit_code
    fi
}

# ============================================================================
# SLSA SUBCOMMAND - Supply Chain Provenance
# ============================================================================

cmd_slsa() {
    local subcmd="${1:-}"
    shift 2>/dev/null || true

    case "$subcmd" in
        generate)
            _slsa_generate "$@"
            ;;
        verify)
            _slsa_verify "$@"
            ;;
        --help|-h|help|"")
            cat << 'EOF'
dsr slsa - SLSA provenance attestation

USAGE:
    dsr slsa generate <artifact> [options]
    dsr slsa verify <artifact> [provenance]

SUBCOMMANDS:
    generate    Generate SLSA v1 provenance for an artifact
    verify      Verify SLSA provenance matches artifact digest

OPTIONS:
    --builder, -b <id>   Builder identity URL
    --output, -o <file>  Output file (default: <artifact>.intoto.jsonl)
    --repo-path <dir>    Source checkout to record (origin URL, commit, ref,
                         dirty flag). Without it no source is recorded.

DESCRIPTION:
    Generates an SLSA v1 provenance statement (in-toto) for an artifact.
    It is a post-build observation, not an authenticated build record.

    The statement includes:
    - Artifact name and SHA256 digest
    - Builder identity
    - Observation time (not an invented build start/finish)
    - Git source info, only from an explicit --repo-path

EXAMPLES:
    dsr slsa generate ./build/ntm-linux-amd64
    dsr slsa generate ./build/ntm-darwin-arm64 --builder "https://github.com/Dicklesworthstone/dsr"
    dsr slsa generate /tmp/out/ntm-linux-amd64 --repo-path /data/projects/ntm
    dsr slsa verify ./build/ntm-linux-amd64

EXIT CODES:
    0  - Success
    1  - Verification failed / digest mismatch
    4  - Invalid arguments
EOF
            return 0
            ;;
        *)
            log_error "Unknown slsa subcommand: $subcmd"
            log_info "Run 'dsr slsa --help' for usage"
            return 4
            ;;
    esac
}

_slsa_generate() {
    local artifact=""
    local builder_id="$SLSA_BUILDER_ID"
    local output=""
    local repo_path=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --builder|-b) builder_id="$2"; shift 2 ;;
            --output|-o) output="$2"; shift 2 ;;
            --repo-path) repo_path="$2"; shift 2 ;;
            -*) log_error "Unknown option: $1"; return 4 ;;
            *) artifact="$1"; shift ;;
        esac
    done

    if [[ -z "$artifact" ]]; then
        log_error "Artifact path required"
        return 4
    fi
    if [[ ! -f "$artifact" ]]; then
        log_error "Artifact not found (or not a regular file): $artifact"
        $JSON_MODE && json_envelope "slsa-generate" "error" 4 "$(jq -nc --arg artifact "$artifact" '{error: "artifact not found", artifact: $artifact}')"
        return 4
    fi

    local start_time
    start_time=$(date +%s)

    local -a args=()
    [[ -n "$output" ]] && args+=("--output" "$output")
    [[ -n "$repo_path" ]] && args+=("--repo-path" "$repo_path")

    if _dsr_capture slsa_generate "$artifact" --builder "$builder_id" ${args[@]+"${args[@]}"}; then
        local duration=$(($(date +%s) - start_time))
        if $JSON_MODE; then
            json_envelope "slsa-generate" "success" 0 "$(jq -nc \
                --arg artifact "$artifact" \
                --arg builder "$builder_id" \
                --arg output "$_DSR_CAPTURED_OUT" \
                --argjson duration "$duration" \
                '{artifact: $artifact, builder: $builder, output: $output, duration_seconds: $duration}')"
        else
            printf '%s\n' "$_DSR_CAPTURED_OUT"
        fi
        return 0
    else
        local exit_code=$?
        local duration=$(($(date +%s) - start_time))
        if [[ -z "$_DSR_CAPTURED_ERR" ]]; then
            _DSR_CAPTURED_ERR="SLSA provenance generation failed for $artifact (exit $exit_code; 4 = invalid arguments, output path or repository)"
            log_error "$_DSR_CAPTURED_ERR"
        fi
        if $JSON_MODE; then
            json_envelope "slsa-generate" "error" "$exit_code" "$(jq -nc \
                --arg error "$_DSR_CAPTURED_ERR" \
                --argjson duration "$duration" \
                '{error: $error, duration_seconds: $duration}')"
        fi
        return $exit_code
    fi
}

_slsa_verify() {
    local artifact="${1:-}"
    local provenance="${2:-}"

    if [[ -z "$artifact" ]]; then
        log_error "Artifact path required"
        return 4
    fi

    local start_time
    start_time=$(date +%s)

    if slsa_verify "$artifact" "$provenance"; then
        local duration=$(($(date +%s) - start_time))
        if $JSON_MODE; then
            json_envelope "slsa-verify" "ok" 0 "$(jq -nc \
                --arg artifact "$artifact" \
                --argjson duration "$duration" \
                '{artifact: $artifact, valid: true, duration_seconds: $duration}')"
        fi
        return 0
    else
        local exit_code=$?
        local duration=$(($(date +%s) - start_time))
        if $JSON_MODE; then
            json_envelope "slsa-verify" "error" "$exit_code" "$(jq -nc \
                --arg artifact "$artifact" \
                --argjson duration "$duration" \
                '{artifact: $artifact, valid: false, duration_seconds: $duration}')"
        fi
        return $exit_code
    fi
}

# ============================================================================
# DOCKER SUBCOMMAND
# ============================================================================

cmd_docker() {
    local subcmd="${1:-}"
    shift 2>/dev/null || true

    case "$subcmd" in
        build)
            _docker_build "$@"
            ;;
        release)
            _docker_release "$@"
            ;;
        sign)
            _docker_sign "$@"
            ;;
        setup)
            _docker_setup "$@"
            ;;
        --help|-h|help|"")
            cat << 'EOF'
dsr docker - Multi-arch Docker image building

USAGE:
    dsr docker build <tool> <version> [options]
    dsr docker release <tool> <version> --certificate-identity <id>
                       --certificate-oidc-issuer <https-url> [options]
    dsr docker sign <registry/repository@sha256:<digest>>
    dsr docker setup

SUBCOMMANDS:
    build     Build multi-arch Docker image
    release   Build, push, sign, and attest image
    sign      Sign a digest-pinned image with cosign (keyless)
    setup     Setup buildx builder

OPTIONS:
    --push              Push to GHCR after build (build only)
    --local             Build for local platform only (build only)
    -p, --platform      Platforms (build only; default: linux/amd64,linux/arm64)
    --skip-sign         Skip cosign signing (release only)
    --certificate-identity, --certificate-oidc-issuer
                        Keyless identity the release verifies its signature
                        and SBOM attestation against (release only; or set
                        DOCKER_CERTIFICATE_IDENTITY / _OIDC_ISSUER)
    -n, --dry-run       Show what would be done

DESCRIPTION:
    Builds and publishes multi-architecture Docker images for tools
    that support containerization. Uses docker buildx for cross-platform
    builds and cosign for keyless signing.

    Containerized tools: ubs, mcp_agent_mail, process_triage

EXAMPLES:
    dsr docker build ubs v1.2.3              # Build multi-arch
    dsr docker build ubs v1.2.3 --push       # Build and push
    dsr docker release ubs v1.2.3 \
        --certificate-identity https://github.com/OWNER/REPO/.github/workflows/release.yml@refs/tags/v1.2.3 \
        --certificate-oidc-issuer https://token.actions.githubusercontent.com
    dsr docker sign ghcr.io/dicklesworthstone/ubs@sha256:<64-hex digest>
                                             # Tags are refused: sign the digest

EXIT CODES:
    0  - Success
    1  - Build/operation failed
    3  - Dependency error (docker/buildx/cosign)
    4  - Invalid arguments
    7  - No Dockerfile found
EOF
            return 0
            ;;
        *)
            log_error "Unknown docker subcommand: $subcmd"
            log_info "Run 'dsr docker --help' for usage"
            return 4
            ;;
    esac
}

_docker_build() {
    local tool=""
    local version=""
    local push=false
    local local_only=false
    local platforms=""
    local dry_run=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --push) push=true; shift ;;
            --local) local_only=true; shift ;;
            --platform|-p) platforms="$2"; shift 2 ;;
            --dry-run|-n) dry_run=true; shift ;;
            --help|-h) docker_build --help; return 0 ;;
            -*) log_error "Unknown option: $1"; return 4 ;;
            *)
                if [[ -z "$tool" ]]; then
                    tool="$1"
                elif [[ -z "$version" ]]; then
                    version="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$tool" || -z "$version" ]]; then
        log_error "Tool and version required"
        log_info "Usage: dsr docker build <tool> <version>"
        return 4
    fi

    local start_time
    start_time=$(date +%s)

    local args=(--tool "$tool" --version "$version")
    $push && args+=(--push)
    $local_only && args+=(--local)
    [[ -n "$platforms" ]] && args+=(--platform "$platforms")
    $dry_run && args+=(--dry-run)

    # As in _docker_release: the module's stdout JSON belongs in the envelope.
    local build_output="" exit_code=0
    if $JSON_MODE; then
        build_output=$(docker_build "${args[@]}") || exit_code=$?
    else
        docker_build "${args[@]}" || exit_code=$?
    fi
    local duration=$(($(date +%s) - start_time))
    if [[ $exit_code -eq 0 ]]; then
        if $JSON_MODE; then
            local image="$DOCKER_REGISTRY/$tool:v${version#v}"
            json_envelope "docker-build" "ok" 0 "$(jq -nc \
                --arg tool "$tool" \
                --arg version "$version" \
                --arg image "$image" \
                --argjson pushed "$push" \
                --arg result "$build_output" \
                --argjson duration "$duration" \
                '{tool: $tool, version: $version, image: $image, pushed: $pushed, duration_seconds: $duration,
                  result: (if $result == "" then null else ($result | try fromjson catch $result) end)}')"
        fi
        return 0
    fi
    if $JSON_MODE; then
        json_envelope "docker-build" "error" "$exit_code" "$(jq -nc \
            --arg tool "$tool" \
            --arg version "$version" \
            --arg result "$build_output" \
            --argjson duration "$duration" \
            '{tool: $tool, version: $version, duration_seconds: $duration,
              result: (if $result == "" then null else ($result | try fromjson catch $result) end)}')"
    fi
    return $exit_code
}

_docker_release() {
    local tool=""
    local version=""
    local skip_sign=false
    local dry_run=false
    local -a policy_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --skip-sign) skip_sign=true; shift ;;
            --dry-run|-n) dry_run=true; shift ;;
            # The module verifies signatures and SBOM attestations against this
            # keyless policy (also DOCKER_CERTIFICATE_IDENTITY/_OIDC_ISSUER).
            --certificate-identity|--certificate-oidc-issuer)
                if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
                    log_error "$1 requires a value"
                    return 4
                fi
                policy_args+=("$1" "$2")
                shift 2
                ;;
            --help|-h) docker_release --help; return 0 ;;
            -*) log_error "Unknown option: $1"; return 4 ;;
            *)
                if [[ -z "$tool" ]]; then
                    tool="$1"
                elif [[ -z "$version" ]]; then
                    version="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$tool" || -z "$version" ]]; then
        log_error "Tool and version required"
        log_info "Usage: dsr docker release <tool> <version> [--certificate-identity ID --certificate-oidc-issuer URL] [--skip-sign] [--dry-run]"
        return 4
    fi

    local start_time
    start_time=$(date +%s)

    local args=(--tool "$tool" --version "$version")
    $skip_sign && args+=(--skip-sign)
    $dry_run && args+=(--dry-run)
    [[ ${#policy_args[@]} -eq 0 ]] || args+=("${policy_args[@]}")

    # The module prints its plan/result JSON on stdout. In --json mode that
    # document goes inside the envelope, so stdout stays a single document.
    local release_output="" exit_code=0
    if $JSON_MODE; then
        release_output=$(docker_release "${args[@]}") || exit_code=$?
    else
        docker_release "${args[@]}" || exit_code=$?
    fi
    local duration=$(($(date +%s) - start_time))
    if [[ $exit_code -eq 0 ]]; then
        if $JSON_MODE; then
            local image="$DOCKER_REGISTRY/$tool:v${version#v}"
            json_envelope "docker-release" "ok" 0 "$(jq -nc \
                --arg tool "$tool" \
                --arg version "$version" \
                --arg image "$image" \
                --arg result "$release_output" \
                --argjson duration "$duration" \
                '{tool: $tool, version: $version, image: $image, duration_seconds: $duration,
                  result: (if $result == "" then null else ($result | try fromjson catch $result) end)}')"
        fi
        return 0
    fi
    if $JSON_MODE; then
        json_envelope "docker-release" "error" "$exit_code" "$(jq -nc \
            --arg tool "$tool" \
            --arg version "$version" \
            --arg result "$release_output" \
            --argjson duration "$duration" \
            '{tool: $tool, version: $version, duration_seconds: $duration,
              result: (if $result == "" then null else ($result | try fromjson catch $result) end)}')"
    fi
    return $exit_code
}

_docker_sign() {
    local image=""
    local dry_run=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run|-n) dry_run=true; shift ;;
            --help|-h) docker_sign --help; return 0 ;;
            -*)
                log_error "Unknown option: $1"
                return 4
                ;;
            *)
                [[ -z "$image" ]] && image="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$image" ]]; then
        log_error "Image reference required"
        log_info "Usage: dsr docker sign <image>"
        return 4
    fi

    local args=("$image")
    $dry_run && args+=(--dry-run)

    if docker_sign "${args[@]}"; then
        if $JSON_MODE; then
            json_envelope "docker-sign" "ok" 0 "$(jq -nc --arg image "$image" '{image: $image, signed: true}')"
        fi
        return 0
    else
        local exit_code=$?
        if $JSON_MODE; then
            json_envelope "docker-sign" "error" "$exit_code" "$(jq -nc --arg image "$image" '{image: $image, signed: false}')"
        fi
        return $exit_code
    fi
}

_docker_setup() {
    if docker_setup_buildx; then
        if $JSON_MODE; then
            json_envelope "docker-setup" "ok" 0 "$(jq -nc --arg builder "$DOCKER_BUILDER_NAME" '{builder: $builder, ready: true}')"
        fi
        return 0
    else
        local exit_code=$?
        if $JSON_MODE; then
            json_envelope "docker-setup" "error" "$exit_code" '{"ready": false}'
        fi
        return $exit_code
    fi
}

# ============================================================================
# MAIN
# ============================================================================

main() {
    # shellcheck disable=SC2034  # DRY_RUN/NON_INTERACTIVE reserved for future use
    # Parse global options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json|-j)
                JSON_MODE=true
                shift
                ;;
            --dry-run|-n)
                DRY_RUN=true
                shift
                ;;
            --verbose|-v)
                VERBOSE=true
                shift
                ;;
            --quiet|-q)
                QUIET=true
                shift
                ;;
            --non-interactive|-y)
                NON_INTERACTIVE=true
                shift
                ;;
            --no-color)
                # Applied by _dsr_prescan_global_flags before logging loaded.
                shift
                ;;
            --state-dir|--cache-dir|--config|-c|--log-level)
                # Applied by _dsr_prescan_global_flags; require the value here.
                if [[ $# -lt 2 || -z "$2" ]]; then
                    log_error "Global option $1 requires a value"
                    exit 4
                fi
                shift 2
                ;;
            --state-dir=*|--cache-dir=*|--config=*|--log-level=*)
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            --version)
                show_version
                exit 0
                ;;
            -*)
                # Unknown option - might be command-specific
                break
                ;;
            *)
                # Not an option - must be command
                break
                ;;
        esac
    done
    case "${DSR_LOG_LEVEL:-info}" in
        debug|info|warn|error) ;;
        *)
            log_error "Invalid log level: ${DSR_LOG_LEVEL} (expected debug, info, warn or error)"
            exit 4
            ;;
    esac

    # Get command
    local command="${1:-}"
    shift 2>/dev/null || true

    # Global flags apply to every subcommand (docs/CLI_CONTRACT.md), so the
    # unambiguous boolean ones are also accepted after it: `dsr status --json`
    # is `dsr --json status`. Arguments after a `--` terminator are untouched.
    local -a command_args=()
    local lift_globals=true global_arg
    for global_arg in "$@"; do
        if $lift_globals; then
            case "$global_arg" in
                --) lift_globals=false ;;
                --json|-j) JSON_MODE=true; continue ;;
                --verbose) VERBOSE=true; continue ;;
                --quiet) QUIET=true; continue ;;
                --non-interactive) NON_INTERACTIVE=true; continue ;;
                --no-color) continue ;;
                # release plans through the global DRY_RUN and parses no
                # --dry-run of its own; commands that do parse one keep it,
                # and those that ignore DRY_RUN must keep rejecting it.
                --dry-run)
                    if [[ "$command" == release ]]; then
                        DRY_RUN=true
                        continue
                    fi
                    ;;
            esac
        fi
        command_args+=("$global_arg")
    done
    set -- ${command_args[@]+"${command_args[@]}"}

    # Resolve the command before initializing file logging. A dry-run must not
    # create, rotate, compress, or delete log files merely to print a plan.
    log_set_level_from_flags "$VERBOSE" "$QUIET"

    if [[ -z "$command" ]]; then
        show_help
        exit 0
    fi

    # Set command context for logging
    log_set_command "$command"

    local dry_run_requested="$DRY_RUN"
    local command_arg
    for command_arg in "$@"; do
        case "$command_arg" in
            --dry-run|-n)
                dry_run_requested=true
                break
                ;;
        esac
    done
    if ! $dry_run_requested; then
        log_init
    fi

    # Load modules needed for command execution
    # Simple commands (config, doctor, help) need fewer modules
    case "$command" in
        config)
            # config only needs core modules (already loaded)
            ;;
        doctor|help)
            # doctor/help only need core modules (logging, config) - already loaded
            ;;
        *)
            # All other commands need full module set
            _dsr_load_all_modules
            ;;
    esac

    # Dispatch to command handler
    case "$command" in
        config)
            cmd_config "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        check)
            cmd_check "$@"
            ;;
        watch)
            cmd_watch "$@"
            ;;
        build)
            cmd_build "$@"
            ;;
        release)
            # Check for subcommand
            case "${1:-}" in
                finalize)
                    shift
                    cmd_release_finalize "$@"
                    ;;
                source-only)
                    shift
                    cmd_release_source_only "$@"
                    ;;
                verify)
                    shift
                    cmd_release_verify "$@"
                    ;;
                formulas)
                    shift
                    cmd_release_formulas "$@"
                    ;;
                *)
                    cmd_release "$@"
                    ;;
            esac
            ;;
        fallback)
            cmd_fallback "$@"
            ;;
        quality)
            cmd_quality "$@"
            ;;
        repos)
            cmd_repos "$@"
            ;;
        health)
            cmd_health "$@"
            ;;
        prune)
            cmd_prune "$@"
            ;;
        signing)
            cmd_signing "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        report)
            cmd_report "$@"
            ;;
        version)
            cmd_version "$@"
            ;;
        canary)
            cmd_canary "$@"
            ;;
        installer)
            cmd_installer "$@"
            ;;
        sbom)
            cmd_sbom "$@"
            ;;
        slsa)
            cmd_slsa "$@"
            ;;
        docker)
            cmd_docker "$@"
            ;;
        verify)
            cmd_verify "$@"
            ;;
        help)
            show_help
            exit 0
            ;;
        *)
            log_error "Unknown command: $command"
            log_info "Run 'dsr --help' for usage"
            exit 4
            ;;
    esac
    local command_status=$?
    log_session_finished "$command_status"
    return "$command_status"
}

# Parse dispatch and exit together: a long-running command may outlive an
# in-place tool update. Never resume reading changed source after it returns.
{
    main "$@"
    exit $?
}
