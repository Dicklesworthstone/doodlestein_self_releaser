# Configured tools as "tool<TAB>owner/repo<TAB>workflow" lines: repos.d files
# first (flat keys, or the older github.repo/github.workflow layout), then
# registry-only tools. One line per repository.
_check_configured_repos() {
    command -v yq &>/dev/null || return 0
    local config_dir="${DSR_CONFIG_DIR:-$HOME/.config/dsr}"
    local registry="${DSR_REPOS_FILE:-$config_dir/repos.yaml}"
    local file line repo
    local -A seen=()
    while IFS= read -r line; do
        IFS=$'\t' read -r _ repo _ <<< "$line"
        [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || continue
        [[ -z "${seen[${repo,,}]:-}" ]] || continue
        seen["${repo,,}"]=1
        printf '%s\n' "$line"
    done < <(
        for file in "$config_dir"/repos.d/*.yaml; do
            [[ -f "$file" && "${file##*/}" != _* ]] || continue
            yq -r '[(.tool_name // .name // ""), (.repo // .github.repo // ""),
                    (.workflow // .github.workflow // "")] | @tsv' "$file" 2>/dev/null
        done
        if [[ -f "$registry" ]]; then
            yq -r '.tools // {} | to_entries[] |
                [.key, (.value.repo // ""), (.value.workflow // "")] | @tsv' "$registry" 2>/dev/null
        fi
    )
}

# Save the outcome of one check as state/check/last.json (atomic replace).
_check_save_snapshot() {
    local threshold="$1"
    shift
    local dir="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}/check" tmp
    mkdir -p "$dir" 2>/dev/null || return 0
    tmp=$(mktemp "$dir/.last.XXXXXXXX" 2>/dev/null) || return 0
    if printf '%s\n' "$@" | jq -sc --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --argjson threshold "$threshold" '
            {checked_at: $at, threshold_seconds: $threshold, repos_checked: [.[].repo],
             throttled: [.[] | select(.status == "throttled") | .repo],
             skipped: [.[] | select(.status == "error") | .repo]}' > "$tmp" 2>/dev/null &&
       mv -f -- "$tmp" "$dir/last.json"; then
        return 0
    fi
    rm -f -- "$tmp"
}

cmd_check() {
    local repos=()
    local threshold=""
    local all_workflows=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repos|-r)
                [[ $# -ge 2 && -n "$2" ]] || { log_error "$1 requires a value"; return 4; }
                IFS=',' read -ra repos <<< "$2"
                shift 2
                ;;
            --threshold|-t)
                [[ $# -ge 2 ]] || { log_error "$1 requires a value"; return 4; }
                threshold="$2"
                shift 2
                ;;
            --all|-a)
                all_workflows=true
                shift
                ;;
            --help|-h)
                cat << 'EOF'
dsr check - Detect throttled GitHub Actions runs

USAGE:
    dsr check [<repo>...] [--repos repo1,repo2] [--threshold <sec>] [--all]

OPTIONS:
    -r, --repos <list>      Comma-separated repos or tool names (default: all configured)
    -t, --threshold <sec>   Queue time threshold in seconds
                            (default: threshold_seconds from config, else 600)
    -a, --all               Check every workflow, not only each tool's release workflow
    --json                  JSON output (global flag)

A configured tool's `workflow` names its release workflow; only that
workflow's runs are checked unless --all is given.

EXAMPLES:
    dsr check                              All configured repos
    dsr check ntm Dicklesworthstone/bv
    dsr check --repos ntm,bv --threshold 300
    dsr check --all --json

EXIT CODES:
    0  - No throttling detected
    1  - Throttling detected
    3  - Dependency error (gh not authenticated)
    4  - Invalid arguments
    8  - Network/API error (no throttling seen in the repos that answered)
EOF
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                log_info "Run 'dsr check --help' for usage"
                return 4
                ;;
            *)
                # Positional argument - repo
                repos+=("$1")
                shift
                ;;
        esac
    done

    # The configured threshold (threshold_seconds, or DSR_THRESHOLD through
    # config_load) applies unless --threshold overrides it.
    if [[ -z "$threshold" ]]; then
        config_load 2>/dev/null || true
        threshold=$(config_get threshold_seconds 600 2>/dev/null) || threshold=600
        [[ -n "$threshold" ]] || threshold=600
    fi
    if [[ ! "$threshold" =~ ^[1-9][0-9]{0,6}$ ]]; then
        log_error "Invalid threshold: $threshold (positive number of seconds)"
        $JSON_MODE && json_envelope "check" "error" 4 \
            "$(jq -nc --arg t "$threshold" '{error: "invalid threshold", threshold: $t}')"
        return 4
    fi

    # Resolve each requested repo (or every configured one) to owner/repo,
    # its dsr tool and its release workflow file.
    local -a configured_repos=() targets=()
    local line tool repo workflow arg found
    while IFS= read -r line; do
        [[ -n "$line" ]] && configured_repos+=("$line")
    done < <(_check_configured_repos)
    if [[ ${#repos[@]} -eq 0 ]]; then
        targets=(${configured_repos[@]+"${configured_repos[@]}"})
    else
        for arg in "${repos[@]}"; do
            [[ -n "$arg" ]] || continue
            found=""
            for line in ${configured_repos[@]+"${configured_repos[@]}"}; do
                IFS=$'\t' read -r tool repo workflow <<< "$line"
                if [[ "$arg" == "$tool" || "${arg,,}" == "${repo,,}" ]]; then
                    found="$line"
                    break
                fi
            done
            if [[ -z "$found" ]]; then
                # Unconfigured short names keep the historical default owner.
                repo="$arg"
                [[ "$repo" == */* ]] || repo="Dicklesworthstone/$repo"
                found=$'\t'"$repo"$'\t'
            fi
            targets+=("$found")
        done
    fi

    if [[ ${#targets[@]} -eq 0 ]]; then
        log_error "No repos to check: pass <repo> or --repos, or configure tools (dsr repos add)"
        $JSON_MODE && json_envelope "check" "error" 4 '{"error": "no repositories configured or given"}'
        return 4
    fi

    # Check dependencies
    if ! gh_check 2>/dev/null; then
        if ! gh_check_token 2>/dev/null; then
            if $JSON_MODE; then
                json_envelope "check" "error" 3 '{"error": "GitHub authentication required"}'
            fi
            return 3
        fi
    fi

    # Process each repo
    local any_throttled=false any_error=false
    local results=()
    local now
    now=$(date +%s)

    for line in "${targets[@]}"; do
        IFS=$'\t' read -r tool repo workflow <<< "$line"
        $all_workflows && workflow=""
        local result
        result=$(_check_repo "$repo" "$threshold" "$now" "${workflow##*/}")
        local status=$?

        if [[ $status -eq 1 ]]; then
            any_throttled=true
        elif [[ $status -ne 0 ]]; then
            any_error=true
        fi
        result=$(jq -c --arg tool "$tool" '. + {tool: (if $tool == "" then null else $tool end)}' \
            <<< "$result" 2>/dev/null) || result=$(jq -nc --arg repo "$repo" \
            '{repo: $repo, status: "error", error: "unreadable check result"}')

        results+=("$result")

        if ! $JSON_MODE; then
            _check_print_result "$result"
        fi
    done

    # The last result, for `dsr report` and `dsr status` (not under dry-run).
    ${DRY_RUN:-false} || _check_save_snapshot "$threshold" "${results[@]}"

    # Throttling is actionable even when another repo could not be read; an
    # unreadable repo is never reported as healthy.
    # Envelope status per docs/CLI_CONTRACT.md: success|partial|error.
    local summary_status="success" summary_exit=0
    if $any_throttled; then
        summary_status="partial" summary_exit=1
    elif $any_error; then
        summary_status="error" summary_exit=8
    fi

    # JSON output (schemas/check-details.json)
    if $JSON_MODE; then
        local results_json
        results_json=$(printf '%s\n' "${results[@]}" | jq -sc '.')
        json_envelope "check" "$summary_status" "$summary_exit" \
            "$(jq -nc --argjson repos "$results_json" --argjson threshold "$threshold" '
                {threshold_seconds: $threshold,
                 repos_checked: [$repos[].repo],
                 throttled: [$repos[] | select(.status == "throttled") | . as $r |
                     ((.queued_runs // []) + (.stuck_runs // []))[] |
                     ((.path // "") | split("/") | last) as $file |
                     {repo: $r.repo, tool: $r.tool,
                      workflow: (if $file != "" then $file else (.workflow_name // "unknown") end),
                      run_id: .id, status: .status, queue_time_seconds: .age_seconds,
                      threshold_seconds: $threshold, created_at: .created_at,
                      started_at: .run_started_at, head_branch: .head_branch, html_url: .html_url} |
                     with_entries(select(.value != null))],
                 healthy: [$repos[] | select(.status == "ok") | .repo],
                 skipped: [$repos[] | select(.status == "error") |
                     {repo: .repo, reason: (.error // "check failed")}],
                 repos: $repos}')"
    fi

    return "$summary_exit"
}

# Check a single repo for throttling
# Returns JSON result, exit code 1 if throttled
_check_repo() {
    local repo="$1"
    local threshold="$2"
    local now="$3"
    local workflow="${4:-}"

    # Resolve short repo name to owner/repo
    if [[ ! "$repo" =~ / ]]; then
        # Assume Dicklesworthstone if no owner specified
        repo="Dicklesworthstone/$repo"
    fi

    # Fetch workflow runs: the release workflow's own runs when one is
    # configured, so busy CI elsewhere neither hides nor fakes a throttle.
    local runs_json
    local -a run_args=("$repo" --limit 20)
    [[ -n "$workflow" ]] && run_args+=(--workflow "$workflow")
    runs_json=$(gh_workflow_runs "${run_args[@]}" 2>/dev/null)
    local fetch_status=$?

    if [[ $fetch_status -ne 0 ]] || [[ -z "$runs_json" ]] ||
       ! jq -e 'type == "object"' <<< "$runs_json" >/dev/null 2>&1; then
        jq -nc --arg repo "$repo" --arg workflow "$workflow" \
            '{repo: $repo, status: "error", error: "failed to fetch runs",
              workflow: (if $workflow == "" then null else $workflow end)}'
        return 8
    fi

    # Extract and analyze runs
    local queued_runs stuck_runs
    queued_runs=$(echo "$runs_json" | jq -c --argjson now "$now" --argjson threshold "$threshold" '
        .workflow_runs // [] |
        map(select(.status == "queued")) |
        map(. as $run |
            ($now - ($run.created_at | fromdateiso8601 // $now)) as $age |
            select($age > $threshold) |
            {
                id: .id,
                status: .status,
                created_at: .created_at,
                workflow_id: .workflow_id,
                workflow_name: .name,
                path: .path,
                head_branch: .head_branch,
                event: .event,
                html_url: .html_url,
                age_seconds: $age
            }
        )' 2>/dev/null || echo '[]')

    stuck_runs=$(echo "$runs_json" | jq -c --argjson now "$now" --argjson threshold "$threshold" '
        .workflow_runs // [] |
        map(select(.status == "in_progress")) |
        map(. as $run |
            ($run.run_started_at // $run.created_at) as $start_time |
            ($now - ($start_time | fromdateiso8601 // $now)) as $age |
            select($age > $threshold) |
            {
                id: .id,
                status: .status,
                created_at: .created_at,
                run_started_at: .run_started_at,
                workflow_id: .workflow_id,
                workflow_name: .name,
                path: .path,
                head_branch: .head_branch,
                event: .event,
                html_url: .html_url,
                age_seconds: $age
            }
        )' 2>/dev/null || echo '[]')

    # Count issues
    local queued_count stuck_count
    queued_count=$(echo "$queued_runs" | jq 'length')
    stuck_count=$(echo "$stuck_runs" | jq 'length')

    # Determine oldest queued time
    local oldest_queued_sec=0
    if [[ "$queued_count" -gt 0 ]]; then
        oldest_queued_sec=$(echo "$queued_runs" | jq '[.[].age_seconds] | max // 0')
    fi

    # Build result
    local status="ok"
    if [[ "$queued_count" -gt 0 ]] || [[ "$stuck_count" -gt 0 ]]; then
        status="throttled"
    fi

    jq -nc \
        --arg repo "$repo" \
        --arg workflow "$workflow" \
        --arg status "$status" \
        --argjson threshold "$threshold" \
        --argjson queued_count "$queued_count" \
        --argjson stuck_count "$stuck_count" \
        --argjson oldest_queued_sec "$oldest_queued_sec" \
        --argjson queued_runs "$queued_runs" \
        --argjson stuck_runs "$stuck_runs" \
        '{
            repo: $repo,
            workflow: (if $workflow == "" then null else $workflow end),
            status: $status,
            threshold_seconds: $threshold,
            queued_count: $queued_count,
            stuck_in_progress_count: $stuck_count,
            oldest_queued_seconds: $oldest_queued_sec,
            oldest_queued_minutes: (($oldest_queued_sec / 60) | floor),
            queued_runs: $queued_runs,
            stuck_runs: $stuck_runs
        }'

    [[ "$status" == "throttled" ]] && return 1 || return 0
}

# Print human-readable check result
_check_print_result() {
    local result="$1"

    local repo status queued stuck oldest_min
    repo=$(echo "$result" | jq -r '.repo + (if .workflow then " (\(.workflow))" else "" end)')
    status=$(echo "$result" | jq -r '.status')
    queued=$(echo "$result" | jq -r '.queued_count')
    stuck=$(echo "$result" | jq -r '.stuck_in_progress_count')
    oldest_min=$(echo "$result" | jq -r '.oldest_queued_minutes')

    if [[ "$status" == "error" ]]; then
        log_error "$repo: $(echo "$result" | jq -r '.error // "unknown error"')"
    elif [[ "$status" == "throttled" ]]; then
        log_warn "$repo: THROTTLED"
        [[ "$queued" -gt 0 ]] && log_warn "  - $queued runs queued (oldest: ${oldest_min}m)"
        [[ "$stuck" -gt 0 ]] && log_warn "  - $stuck runs stuck in_progress"

        # Show URLs for queued runs
        echo "$result" | jq -r '.queued_runs[:3][] | "    → \(.html_url)"' 2>/dev/null | while read -r url; do
            log_info "$url"
        done
    else
        log_ok "$repo: OK (no throttling detected)"
    fi
}

# ============================================================================
# WATCH SUBCOMMAND - Continuous Monitoring Daemon
# ============================================================================

# State file paths
_WATCH_STATE_DIR="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}"
_WATCH_TRIGGERED_FILE="$_WATCH_STATE_DIR/triggered.json"
_WATCH_LOCK_FILE="$_WATCH_STATE_DIR/watch.lock"

# Default settings
_WATCH_DEFAULT_INTERVAL=60   # 1 minute (docs/CLI_CONTRACT.md)
_WATCH_JITTER_PERCENT=20     # ±20% jitter
_WATCH_DEBOUNCE_WINDOW=180   # 3 minutes
_WATCH_BACKOFF_INITIAL=60    # 1 minute initial backoff
_WATCH_BACKOFF_MAX=3600      # 1 hour max backoff

# Internal state
_WATCH_RUNNING=false
_WATCH_CURRENT_BACKOFF=0

# Watch signal handlers
_watch_cleanup() {
    log_info "Shutting down watcher..."
    _watch_release_lock
    _WATCH_RUNNING=false
}

# Acquire lock to prevent multiple watcher instances
# Uses atomic mv -n to prevent race conditions (TOCTOU)
_watch_acquire_lock() {
    if ! mkdir -p "$_WATCH_STATE_DIR"; then
        log_error "Failed to create watch state directory: $_WATCH_STATE_DIR"
        return 1
    fi

    local temp_lock="${_WATCH_LOCK_FILE}.$$"
    local max_attempts=3
    local attempt=0

    while [[ $attempt -lt $max_attempts ]]; do
        ((attempt++))

        # Check for existing lock
        if [[ -f "$_WATCH_LOCK_FILE" ]]; then
            local lock_pid
            # Read PID (format: "PID:TIMESTAMP" - timestamp for future stale detection)
            IFS=':' read -r lock_pid _ < "$_WATCH_LOCK_FILE" 2>/dev/null || true

            # Validate PID is numeric
            if [[ ! "$lock_pid" =~ ^[0-9]+$ ]]; then
                log_warn "Corrupted lock file, removing"
                rm -f "$_WATCH_LOCK_FILE"
            elif kill -0 "$lock_pid" 2>/dev/null; then
                log_error "Another watcher is running (PID $lock_pid)"
                return 2
            else
                # Stale lock - remove it
                log_warn "Removing stale lock file (PID $lock_pid no longer running)"
                rm -f "$_WATCH_LOCK_FILE"
            fi
        fi

        # Create temp lock with PID:TIMESTAMP
        echo "$$:$(date +%s)" > "$temp_lock" || {
            log_error "Failed to create temp lock file"
            return 1
        }

        # Atomic rename - mv -n fails if target exists (race-safe)
        # Note: mv -n is POSIX and atomic on same filesystem
        if mv -n "$temp_lock" "$_WATCH_LOCK_FILE" 2>/dev/null; then
            # Verify we own the lock (another process might have won)
            local final_pid
            IFS=':' read -r final_pid _ < "$_WATCH_LOCK_FILE" 2>/dev/null || true
            if [[ "$final_pid" == "$$" ]]; then
                return 0
            fi
            # Lost race, loop and retry
            log_debug "Lost lock race, retrying..."
        fi

        # Clean up temp file if mv failed
        rm -f "$temp_lock" 2>/dev/null
        sleep 0.1
    done

    log_error "Failed to acquire lock after $max_attempts attempts"
    return 2
}

_watch_release_lock() {
    rm -f "$_WATCH_LOCK_FILE" 2>/dev/null
}

# Load triggered runs state
_watch_load_triggered() {
    if [[ -f "$_WATCH_TRIGGERED_FILE" ]]; then
        cat "$_WATCH_TRIGGERED_FILE"
    else
        echo '{"runs": {}, "last_check": null}'
    fi
}

# Save triggered runs state
_watch_save_triggered() {
    local state="$1"
    echo "$state" > "$_WATCH_TRIGGERED_FILE"
}

# Check if a run was already triggered
_watch_is_triggered() {
    local run_id="$1"
    local state
    state=$(_watch_load_triggered)

    echo "$state" | jq -e --arg id "$run_id" '.runs[$id] != null' &>/dev/null
}

# Mark a run as triggered
_watch_mark_triggered() {
    local run_id="$1"
    local state now
    state=$(_watch_load_triggered)
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    state=$(echo "$state" | jq --arg id "$run_id" --arg ts "$now" \
        '.runs[$id] = $ts | .last_check = $ts')

    _watch_save_triggered "$state"
}

# Clean old triggered entries (older than 24 hours)
_watch_cleanup_triggered() {
    local state cutoff
    state=$(_watch_load_triggered)
    cutoff=$(date -u -d "-24 hours" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || \
             date -u -v-24H +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")

    if [[ -n "$cutoff" ]]; then
        state=$(echo "$state" | jq --arg cutoff "$cutoff" \
            '.runs |= with_entries(select(.value >= $cutoff))')
        _watch_save_triggered "$state"
    fi
}

# Calculate jittered sleep interval
_watch_jittered_sleep() {
    local base_interval="$1"
    local jitter_range=$((base_interval * _WATCH_JITTER_PERCENT / 100))
    local jitter=$((RANDOM % (jitter_range * 2 + 1) - jitter_range))
    local sleep_time=$((base_interval + jitter))

    [[ $sleep_time -lt 10 ]] && sleep_time=10
    echo "$sleep_time"
}

# Throttled runs this watcher has already reported (without --auto-fallback),
# so each is announced once per watcher rather than on every poll.
declare -A _WATCH_REPORTED=()

# Main watch loop iteration
# Args: dry_run auto_fallback
_watch_iteration() {
    local dry_run="$1"
    local auto_fallback="${2:-false}"
    local triggered_count=0

    log_info "Running throttle check..."

    # Run dsr check over every configured repo's release workflow.
    local check_output check_exit
    if check_output=$("$0" --json check 2>/dev/null); then
        check_exit=0
        _WATCH_CURRENT_BACKOFF=0  # Reset backoff on success
    else
        check_exit=$?

        # Network error - apply backoff
        if [[ $check_exit -eq 8 ]]; then
            if [[ $_WATCH_CURRENT_BACKOFF -eq 0 ]]; then
                _WATCH_CURRENT_BACKOFF=$_WATCH_BACKOFF_INITIAL
            else
                _WATCH_CURRENT_BACKOFF=$((_WATCH_CURRENT_BACKOFF * 2))
                [[ $_WATCH_CURRENT_BACKOFF -gt $_WATCH_BACKOFF_MAX ]] && \
                    _WATCH_CURRENT_BACKOFF=$_WATCH_BACKOFF_MAX
            fi
            log_warn "API error, backing off for ${_WATCH_CURRENT_BACKOFF}s"
            return 1
        fi
        if [[ $check_exit -ne 1 ]]; then
            log_error "Throttle check failed (exit $check_exit); run 'dsr check' for details"
            return 1
        fi
        _WATCH_CURRENT_BACKOFF=0
    fi

    # Throttled runs: .details.throttled[] (schemas/check-details.json)
    local throttled_runs
    throttled_runs=$(jq -r '.details.throttled[]? |
        [(.run_id | tostring), .repo, (.tool // ""), (.head_branch // "")] | @tsv' \
        <<< "$check_output" 2>/dev/null)

    if [[ -z "$throttled_runs" ]]; then
        log_ok "No throttled runs detected"
        return 0
    fi

    # Process each throttled run
    local run_id repo tool_name ref
    while IFS=$'\t' read -r run_id repo tool_name ref; do
        [[ -z "$run_id" ]] && continue

        # Check if already triggered
        if _watch_is_triggered "$run_id"; then
            log_debug "Run $run_id already triggered, skipping"
            continue
        fi
        if ! $auto_fallback && [[ -n "${_WATCH_REPORTED[$run_id]:-}" ]]; then
            continue
        fi

        log_warn "Throttled run detected: $run_id ($repo)"
        if [[ "${DSR_NOTIFY_ENABLED:-false}" == "true" ]]; then
            notify_event "watch.throttled" "warn" \
                "Throttle detected" \
                "Repo $repo run $run_id exceeded threshold" \
                "$run_id" || true
        fi

        # The dsr tool configured for this repository, and the release
        # version when the run was started by a version tag.
        local -a fallback_args=()
        if [[ "$ref" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([.+-][0-9A-Za-z.+-]*)?$ ]]; then
            fallback_args=(--version "$ref")
        fi

        if ! $auto_fallback; then
            _WATCH_REPORTED["$run_id"]=1
            if [[ -n "$tool_name" ]]; then
                log_info "Run 'dsr fallback $tool_name${fallback_args[*]:+ ${fallback_args[*]}}' or watch with --auto-fallback"
            else
                log_info "No dsr tool is configured for $repo; add it with 'dsr repos add' to enable fallback"
            fi
        elif [[ -z "$tool_name" ]]; then
            _WATCH_REPORTED["$run_id"]=1
            log_warn "No dsr tool is configured for $repo; not triggering a fallback"
        elif $dry_run; then
            log_info "[DRY RUN] Would trigger fallback for $tool_name${fallback_args[*]:+ ${fallback_args[*]}} (run $run_id)"
            ((triggered_count++))
        else
            log_info "Triggering fallback for $tool_name..."

            # Mark as triggered before attempting (to prevent repeated attempts on failure)
            _watch_mark_triggered "$run_id"

            # Trigger fallback as a background subprocess
            # Note: --non-interactive is a global flag and must come before the subcommand
            local fallback_log="$_WATCH_STATE_DIR/fallback-${run_id}.log"
            log_info "Starting fallback for $tool_name (run $run_id)..."
            "$0" --non-interactive fallback "$tool_name" ${fallback_args[@]+"${fallback_args[@]}"} \
                >> "$fallback_log" 2>&1 &
            local fallback_pid=$!
            log_info "Fallback started (PID: $fallback_pid, log: $fallback_log)"
            if [[ "${DSR_NOTIFY_ENABLED:-false}" == "true" ]]; then
                notify_event "watch.fallback_started" "info" \
                    "Fallback started" \
                    "Repo $repo run $run_id fallback started (PID: $fallback_pid)" \
                    "$run_id" || true
            fi
            ((triggered_count++))
        fi
    done <<< "$throttled_runs"

    if [[ $triggered_count -gt 0 ]]; then
        if $dry_run; then
            log_info "Would trigger $triggered_count fallback(s)"
        else
            log_info "Triggered $triggered_count fallback(s)"
        fi
    fi

    return 0
}

cmd_watch() {
    local interval=$_WATCH_DEFAULT_INTERVAL
    local daemon_mode=false
    # The global --dry-run (dsr -n watch) never starts a fallback either.
    local dry_run="${DRY_RUN:-false}"
    local auto_fallback=false
    local once_mode=false
    local notify_methods="none"

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --interval|-i)
                [[ $# -ge 2 ]] || { log_error "$1 requires a value"; return 4; }
                interval="$2"
                shift 2
                ;;
            --auto-fallback)
                auto_fallback=true
                shift
                ;;
            --notify)
                [[ $# -ge 2 && "$2" != -* ]] || { log_error "--notify requires a method list"; return 4; }
                notify_methods="$2"
                shift 2
                ;;
            --notify=*)
                notify_methods="${1#*=}"
                shift
                ;;
            --daemon|-d)
                daemon_mode=true
                shift
                ;;
            --dry-run|-n)
                dry_run=true
                shift
                ;;
            --once|-1)
                once_mode=true
                shift
                ;;
            --help|-h)
                cat << 'EOF'
dsr watch - Continuous monitoring daemon

USAGE:
    dsr watch [options]

OPTIONS:
    --interval, -i <sec>   Poll interval in seconds (default: 60)
    --auto-fallback        Start `dsr fallback` for each throttled release run
    --daemon, -d           Run in background (daemon mode)
    --dry-run, -n          Check but don't trigger fallbacks (also the global -n)
    --once, -1             Single check and exit
    --notify <method>      Notification: slack|discord|desktop|terminal|none
    --json                 JSON output (global flag)

BEHAVIOR:
    - Polls every configured repo's release workflow for throttled runs
      (dsr check), at the configured threshold_seconds
    - Reports each throttled run once; with --auto-fallback, starts one
      fallback per run for the repo's dsr tool, at the run's version tag
    - Deduplicates by run ID (won't re-trigger same run)
    - Uses jittered intervals to avoid thundering herd
    - Exponential backoff on API errors (up to 1 hour)
    - Stores state in ~/.local/state/dsr/triggered.json

STATE FILES:
    ~/.local/state/dsr/triggered.json  - Triggered run history
    ~/.local/state/dsr/watch.lock      - Lock file (single instance)

EXAMPLES:
    dsr watch                         Report throttled runs (foreground)
    dsr watch --auto-fallback         Also build and release on throttle
    dsr watch --once                  Single check and exit
    dsr watch --dry-run --auto-fallback   Show which fallbacks would start
    dsr watch --interval 300          Poll every five minutes
    dsr watch --daemon &              Run in background

EXIT CODES:
    0  - Success (or clean shutdown)
    2  - Another watcher is already running
    3  - Dependency error (run dsr doctor)
    5  - Interrupted (SIGTERM/SIGINT)
EOF
                return 0
                ;;
            *)
                log_error "Unknown option: $1"
                log_info "Run 'dsr watch --help' for usage"
                return 4
                ;;
        esac
    done

    # Validate interval
    if ! [[ "$interval" =~ ^[0-9]+$ ]] || [[ "$interval" -lt 10 ]]; then
        log_error "Invalid interval: $interval (must be >= 10 seconds)"
        return 4
    fi

    local bad_method
    if ! bad_method=$(notify_validate_methods "$notify_methods"); then
        log_error "Unknown --notify method: $bad_method (terminal, slack, discord, desktop, agent_mail, all, none)"
        return 4
    fi

    # Configure notifications for the watch loop. Exported: the fallbacks it
    # starts are child processes and report their build and release outcome
    # through the same channels.
    if [[ "$notify_methods" != "none" ]]; then
        export DSR_NOTIFY_METHODS="$notify_methods"
        export DSR_NOTIFY_ENABLED=true
        notify_init >/dev/null 2>&1 || true
        log_info "Notifications enabled: $notify_methods"
    else
        export DSR_NOTIFY_METHODS=none
        export DSR_NOTIFY_ENABLED=false
    fi

    # Run preflight check
    log_info "Running preflight check..."
    if ! "$0" doctor --quick &>/dev/null; then
        log_error "Preflight check failed. Run 'dsr doctor' for details."
        return 3
    fi
    log_ok "Preflight check passed"

    # Single check mode
    if $once_mode; then
        log_info "Running single check..."
        _watch_iteration "$dry_run" "$auto_fallback"
        local result=$?

        if $JSON_MODE; then
            local state
            state=$(_watch_load_triggered)
            json_envelope "watch" "$([[ $result -eq 0 ]] && echo success || echo error)" "$result" "$(jq -nc \
                --arg mode "once" \
                --argjson state "$state" \
                --argjson auto_fallback "$auto_fallback" \
                --argjson dry_run "$dry_run" \
                '{mode: $mode, auto_fallback: $auto_fallback, dry_run: $dry_run, triggered_state: $state}')"
        fi

        return $result
    fi

    # Acquire lock for continuous mode
    if ! _watch_acquire_lock; then
        return 2
    fi

    # Set up signal handlers
    trap _watch_cleanup SIGTERM SIGINT

    # Daemon mode
    if $daemon_mode; then
        log_info "Starting daemon mode (interval: ${interval}s)..."
        # For true daemon mode, the process should be backgrounded by the caller
        # We just continue running in foreground but signal that we're ready
    else
        log_info "Starting watch mode (interval: ${interval}s, Ctrl+C to stop)..."
    fi

    if $dry_run; then
        log_info "(dry-run mode - no fallbacks will be triggered)"
    elif ! $auto_fallback; then
        log_info "(report-only mode - pass --auto-fallback to start fallbacks)"
    fi

    # Clean old triggered entries on startup
    _watch_cleanup_triggered

    _WATCH_RUNNING=true
    local iteration=0

    while $_WATCH_RUNNING; do
        ((iteration++))
        log_info "--- Iteration $iteration ---"

        # Run check
        if ! _watch_iteration "$dry_run" "$auto_fallback"; then
            # Backoff on error
            if [[ $_WATCH_CURRENT_BACKOFF -gt 0 ]]; then
                log_info "Sleeping ${_WATCH_CURRENT_BACKOFF}s (backoff)..."
                sleep "$_WATCH_CURRENT_BACKOFF" || break
                continue
            fi
        fi

        # Calculate jittered sleep
        local sleep_time
        sleep_time=$(_watch_jittered_sleep "$interval")
        log_info "Next check in ${sleep_time}s..."

        # Sleep (interruptible)
        sleep "$sleep_time" || break
    done

    # Cleanup
    _watch_release_lock
    log_info "Watcher stopped"

    if $JSON_MODE; then
        local state
        state=$(_watch_load_triggered)
        json_envelope "watch" "success" 0 "$(jq -nc \
            --argjson iterations "$iteration" \
            --argjson state "$state" \
            '{mode: "continuous", iterations: $iterations, triggered_state: $state}')"
    fi

    return 0
}

cmd_build() {
    local tool_name=""
    local targets=()
    local version=""
    local output_dir=""
    local output_dir_explicit=false
    local dry_run="$DRY_RUN"
    local parallel_jobs=1
    local resume=false resume_selector="latest"
    local resume_target_host=""
    local resume_target_host_approval=""
    local allow_dirty=false
    local no_sync=false
    local sync_only=false
    local only_act=false
    local only_native=false
    local build_purpose="release"
    local -a purpose_args=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tool|-t|--repo)
                tool_name="$2"
                shift 2
                ;;
            --target)
                targets+=("$2")
                shift 2
                ;;
            --targets)
                # Allow comma-separated list
                IFS=',' read -ra targets <<< "$2"
                shift 2
                ;;
            --version|-V)
                version="$2"
                shift 2
                ;;
            --output-dir|-o)
                output_dir="$2"
                output_dir_explicit=true
                shift 2
                ;;
            --parallel|-p)
                parallel_jobs="${DSR_BUILD_PARALLELISM:-2}"
                shift
                ;;
            --parallel=*)
                parallel_jobs="${1#*=}"
                shift
                ;;
            --jobs)
                [[ $# -ge 2 ]] || { log_error "--jobs requires a value"; return 4; }
                parallel_jobs="$2"
                shift 2
                ;;
            --resume|-r)
                resume=true
                shift
                ;;
            --resume=*)
                resume=true
                resume_selector="${1#*=}"
                shift
                ;;
            --resume-target-host)
                [[ $# -ge 2 && -z "$resume_target_host" ]] || return 4
                resume_target_host="$2"
                shift 2
                ;;
            --resume-target-host-approval)
                [[ $# -ge 2 && -z "$resume_target_host_approval" ]] || return 4
                resume_target_host_approval="$2"
                shift 2
                ;;
            --allow-dirty)
                allow_dirty=true
                shift
                ;;
            --no-sync)
                no_sync=true
                shift
                ;;
            --sync-only)
                sync_only=true
                shift
                ;;
            --only-act)
                only_act=true
                shift
                ;;
            --only-native)
                only_native=true
                shift
                ;;
            --diagnostic-native)
                build_purpose="diagnostic-native"
                purpose_args=(--diagnostic-native)
                shift
                ;;
            --dry-run|-n)
                dry_run=true
                shift
                ;;
            --help|-h)
                cat << 'EOF'
dsr build - Build artifacts locally

USAGE:
    dsr build <tool> [options]
    dsr build --tool <name> [options]

OPTIONS:
    -t, --tool <name>      Tool to build (required, or as first positional arg)
        --repo <name>      Alias for --tool
    --target <target>      Specific target (e.g., linux/amd64); can repeat
    --targets <list>       Comma-separated target list
    -V, --version <ver>    Version to build (default: detect from version files)
    -o, --output-dir <dir> Output directory for artifacts
    -p, --parallel[=N]     Build targets concurrently (default bound: 2)
        --jobs <N>         Explicit target concurrency bound (1-32)
    -r, --resume[=RUN_ID]  Resume latest or selected interrupted build
    --resume-target-host TARGET=HOST
                          Relocate one failed strict native target; retain prior attempts
    --resume-target-host-approval FILE
                          Required operator-approved prior/current configuration hashes
    --allow-dirty          Allow building with uncommitted changes
    --no-sync              Skip source sync to remote hosts
    --sync-only            Sync source to remote hosts without building
    --only-act             Only build targets that use act (Linux, no SSH)
    --only-native          Only build targets that require native SSH builds
    --diagnostic-native    Strict tagged native subset for local measurements;
                           isolated outputs can never be published as a release
    -n, --dry-run          Show the validated build plan without executing it

DESCRIPTION:
    Builds a tool for all configured targets using act (Linux) and
    SSH to remote hosts (macOS/Windows).

    Before building on remote hosts (macOS/Windows), source code is
    automatically synced via rsync. Use --no-sync to skip this step
    if you manage sync separately, or --sync-only to sync without building.
    A failed sync blocks that host's unfinished native targets; other
    synced hosts can build. Resume resyncs and retains verified completed
    artifacts. --sync-only returns nonzero if any host fails to sync.

TARGETS:
    Configured per tool in ~/.config/dsr/repos.d/<tool>.yaml
    Common targets: linux/amd64, linux/arm64, darwin/arm64, windows/amd64

EXAMPLES:
    dsr build ntm                           Build ntm for all targets
    dsr build ntm --target linux/amd64      Build only for Linux x64
    dsr build ntm --version 1.2.3           Build specific version
    dsr build ntm --parallel                Build up to 2 targets concurrently
    dsr build ntm --parallel=4              Build up to 4 targets concurrently
    dsr build --tool bv --resume            Resume interrupted bv build
    dsr build ntm --sync-only               Sync source without building
    dsr build ntm --no-sync                 Build without syncing source
    dsr build ntm --only-act                Build only act targets (Linux)
    dsr build ntm --only-native             Build only native targets (macOS/Win)
    dsr build frankenterm --version 0.15.6-rc.13 --diagnostic-native --target darwin/arm64

EXIT CODES:
    0  - All builds succeeded
    1  - Some builds failed
    2  - Build already in progress (lock held)
    4  - Invalid arguments or missing config
    6  - Build failed
EOF
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                log_info "Run 'dsr build --help' for usage"
                return 4
                ;;
            *)
                # First positional arg is tool name
                if [[ -z "$tool_name" ]]; then
                    tool_name="$1"
                else
                    # Additional positional args might be targets
                    targets+=("$1")
                fi
                shift
                ;;
        esac
    done

    # Validate tool name
    if [[ -z "$tool_name" ]]; then
        log_error "Tool name required"
        log_info "Run 'dsr build --help' for usage"
        return 4
    fi

    if [[ ! "$parallel_jobs" =~ ^[1-9][0-9]*$ ]] || [[ "$parallel_jobs" -gt 32 ]]; then
        log_error "Parallel job count must be an integer from 1 through 32"
        return 4
    fi
    if $resume && [[ "$resume_selector" != "latest" ]] && ! _act_is_uuid "$resume_selector"; then
        log_error "--resume run ID must be a schema-valid UUID"
        return 4
    fi

    # Validate matrix filter flags are mutually exclusive
    if $only_act && $only_native; then
        log_error "Cannot specify both --only-act and --only-native"
        return 4
    fi

    if $no_sync && $sync_only; then
        log_error "--no-sync and --sync-only are mutually exclusive"
        return 4
    fi
    if $resume && $sync_only; then
        log_error "--resume and --sync-only are mutually exclusive"
        return 4
    fi
    if [[ "$build_purpose" == "diagnostic-native" ]] && \
       { [[ ${#targets[@]} -eq 0 ]] || $output_dir_explicit || $only_act || $sync_only; }; then
        log_error "--diagnostic-native requires explicit native targets and its private default output directory; --only-act/--sync-only are unsupported"
        return 4
    fi

    # Load tool config
    if ! act_load_repo_config "$tool_name"; then
        log_error "Tool '$tool_name' not found in repos.d"
        log_info "Available tools: $(act_list_tools 2>/dev/null | tr '\n' ' ')"
        return 4
    fi

    # Get local path
    local local_path
    local_path=$(act_get_local_path "$tool_name")
    if [[ -z "$local_path" || ! -d "$local_path" ]]; then
        log_error "Local path not found for $tool_name: $local_path"
        return 4
    fi

    # Check for dirty working tree
    if ! $allow_dirty; then
        if git_ops_is_dirty "$local_path"; then
            log_error "Working tree has uncommitted changes in $local_path"
            log_info "Commit changes or use --allow-dirty to override"
            return 1
        fi
    fi

    # Detect version if not specified
    if [[ -z "$version" ]]; then
        log_info "Detecting version from version files..."
        local configured_language="" configured_main_package=""
        configured_language=$(config_get_tool_field "$tool_name" "language" "" 2>/dev/null || true)
        configured_main_package=$(config_get_tool_field "$tool_name" "main_package" "" 2>/dev/null || true)
        if version=$(version_detect \
            "$local_path" "$configured_language" "$configured_main_package" 2>/dev/null); then
            log_info "Detected version: $version"
        else
            log_error "Cannot detect version. Specify with --version"
            return 4
        fi
    fi

    # Normalize version (ensure it has 'v' prefix for tag)
    local tag
    tag=$(git_ops_version_to_tag "$version")

    local build_release_contract_json="null"
    local build_release_contract_enabled=false
    local build_source_sha=""
    local build_source_ref=""
    local build_run_id=""
    local build_source_roots_json="{}"
    local build_target_hosts_json="{}"
    local -a build_source_args=()
    local -a build_sync_args=()
    if declare -F config_get_release_contract_json &>/dev/null; then
        if ! config_validate_release_contract "$tool_name"; then
            log_error "Release contract validation failed for $tool_name"
            return 4
        fi
        build_release_contract_json=$(config_get_release_contract_json "$tool_name") || return $?
        [[ "$build_release_contract_json" != "null" ]] && build_release_contract_enabled=true
    fi
    if [[ "$build_purpose" == "diagnostic-native" ]] && ! $build_release_contract_enabled; then
        log_error "--diagnostic-native requires an enabled strict release contract"
        return 4
    fi
    if [[ -n "$resume_target_host" || -n "$resume_target_host_approval" ]]; then
        if ! $resume || ! $build_release_contract_enabled ||
           [[ "$build_purpose" != "release" || -z "$resume_target_host" || -z "$resume_target_host_approval" ]]; then
            log_error "Target relocation requires a strict release resume and its approval file"
            return 4
        fi
    fi

    # A local refs/replace namespace must never reinterpret the commit named by
    # a strict release contract. Keep the override function-scoped so ordinary
    # development builds retain the caller's Git semantics.
    if $build_release_contract_enabled; then
        local GIT_NO_REPLACE_OBJECTS=1
        export GIT_NO_REPLACE_OBJECTS
    fi

    if $build_release_contract_enabled && $no_sync; then
        log_error "Strict release contract requires source synchronization; --no-sync is forbidden"
        return 4
    fi

    # Contract builds are release-identity builds: the requested tag must exist
    # and peel to the exact commit currently checked out.
    if $build_release_contract_enabled; then
        if ! git_ops_tag_exists "$local_path" "$tag"; then
            log_error "Strict release contract requires local tag $tag"
            return 4
        fi
        local strict_source_status
        strict_source_status=$(git -C "$local_path" status --porcelain --untracked-files=all 2>/dev/null) || {
            log_error "Could not inspect strict release source tree"
            return 4
        }
        if [[ -n "$strict_source_status" ]]; then
            log_error "Strict release contract requires a clean source tree (tracked and untracked files)"
            return 4
        fi
        build_source_sha=$(git -C "$local_path" rev-parse --verify HEAD 2>/dev/null) || return 4
        local build_tag_sha
        build_tag_sha=$(git_ops_tag_sha "$local_path" "$tag" 2>/dev/null) || return 4
        if [[ ! "$build_source_sha" =~ ^[0-9a-f]{40}$ || "$build_source_sha" != "$build_tag_sha" ]]; then
            log_error "Strict release contract requires HEAD to equal the peeled local tag $tag"
            return 4
        fi
        build_source_ref="$tag"
        build_source_args=(--git-sha "$build_source_sha" --git-ref "$build_source_ref")
    elif ! git_ops_tag_exists "$local_path" "$tag"; then
        log_warn "Tag $tag does not exist in $local_path"
        log_info "Creating tag with: dsr version tag $tool_name"
        # For now, proceed anyway - the version might be in version files but not tagged
    elif [[ "$build_purpose" == release ]]; then
        # An existing tag names the source of this version. Building another
        # commit under it would publish binaries that are not the tagged code
        # (dsr release refuses that manifest; fail here, before building).
        local ordinary_head_sha ordinary_tag_sha
        ordinary_head_sha=$(git -C "$local_path" rev-parse --verify HEAD 2>/dev/null) || ordinary_head_sha=""
        ordinary_tag_sha=$(git_ops_tag_sha "$local_path" "$tag" 2>/dev/null) || ordinary_tag_sha=""
        if [[ -n "$ordinary_tag_sha" && "$ordinary_head_sha" != "$ordinary_tag_sha" ]]; then
            log_error "$tag is $ordinary_tag_sha, but $local_path is at ${ordinary_head_sha:-an unknown commit}"
            log_info "Check out $tag (git -C '$local_path' checkout $tag) and build again"
            if $JSON_MODE; then
                json_envelope "build" "error" 4 "$(jq -nc --arg tool "$tool_name" --arg version "$tag" \
                    --arg head "$ordinary_head_sha" --arg tag_sha "$ordinary_tag_sha" \
                    '{tool: $tool, version: $version, error: "checkout is not at the release tag",
                      head_sha: $head, tag_sha: $tag_sha}')"
            fi
            return 4
        fi
    fi

    # Set output directory default (tool-version)
    local state_dir="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}"
    [[ -z "$output_dir" ]] && output_dir="$state_dir/artifacts/${tool_name}-${tag}"
    if [[ "$build_purpose" == "diagnostic-native" ]]; then
        build_run_id=$(_act_generate_uuid) || return 4
        _act_is_uuid "$build_run_id" || return 4
        output_dir="$state_dir/diagnostics/${tool_name}-${tag}/$build_run_id"
    fi
    [[ "$output_dir" != "/" ]] && output_dir="${output_dir%/}"

    # Get targets from args or config
    local target_list
    if [[ ${#targets[@]} -gt 0 ]]; then
        target_list="${targets[*]}"
    else
        target_list=$(act_get_targets "$tool_name")
    fi

    if [[ -z "$target_list" ]]; then
        log_error "No targets configured for $tool_name"
        return 4
    fi

    local configured_target_list target
    configured_target_list=$(act_get_targets "$tool_name")
    for target in $target_list; do
        case " $configured_target_list " in
            *" $target "*) ;;
            *)
                log_error "Target '$target' is not configured for $tool_name"
                return 4
                ;;
        esac
    done

    # Apply matrix filtering (--only-act / --only-native)
    if $only_act || $only_native; then
        local filtered_targets=()
        for target in $target_list; do
            if $only_act && act_platform_uses_act "$tool_name" "$target"; then
                filtered_targets+=("$target")
            elif $only_native && ! act_platform_uses_act "$tool_name" "$target"; then
                filtered_targets+=("$target")
            fi
        done

        if [[ ${#filtered_targets[@]} -eq 0 ]]; then
            if $only_act; then
                log_error "No act-compatible targets found (try without --only-act)"
            else
                log_error "No native build targets found (try without --only-native)"
            fi
            return 4
        fi

        target_list="${filtered_targets[*]}"
        if $only_act; then
            log_info "Filtered to act targets: $target_list"
        else
            log_info "Filtered to native targets: $target_list"
        fi
    fi

    if $build_release_contract_enabled; then
        local requested_targets_json
        # shellcheck disable=SC2086  # target_list is intentionally word-split into one target per line.
        requested_targets_json=$(printf '%s\n' $target_list | jq -Rsc 'split("\n") | map(select(length > 0)) | sort')
        if ! _act_contract_for_build_purpose "$tool_name" "$build_release_contract_json" \
            "$requested_targets_json" "$build_purpose" >/dev/null; then
            return 4
        fi
        if [[ "$build_purpose" == "diagnostic-native" ]]; then
            for target in $target_list; do
                if act_platform_uses_act "$tool_name" "$target"; then
                    log_error "Diagnostic target $target must use the strict native runner"
                    return 4
                fi
            done
        fi
    fi

    local resume_run_id="" resume_state=""
    if $resume; then
        if ! build_state_init; then
            log_error "Build state initialization failed"
            return 4
        fi
        if ! resume_state=$(build_state_get "$tool_name" "$version" "$resume_selector" 2>/dev/null); then
            log_error "No resumable build state found for $tool_name $version ($resume_selector)"
            return 4
        fi
        resume_run_id=$(jq -r '.run_id // empty' <<< "$resume_state")
        if ! _act_build_purpose_matches "$(jq -c '.context // {}' <<< "$resume_state")" \
            "$build_purpose" "$build_release_contract_enabled"; then
            log_error "Resume purpose is missing or differs from the requested build"
            return 4
        fi
        if ! _act_is_uuid "$resume_run_id" || \
           [[ "$(jq -r '.status // empty' <<< "$resume_state")" == "completed" ]] || \
           [[ "$(jq -r '.status // empty' <<< "$resume_state")" == "cancelled" ]]; then
            log_error "Selected build state is not resumable"
            return 4
        fi

        local resume_targets_json requested_resume_targets_json
        resume_targets_json=$(jq -c '.targets // []' <<< "$resume_state")
        # shellcheck disable=SC2086  # one configured target per word
        requested_resume_targets_json=$(printf '%s\n' $target_list | \
            jq -Rsc 'split("\n") | map(select(length > 0))')
        if [[ "$resume_targets_json" != "$requested_resume_targets_json" ]]; then
            log_error "Resume target set differs from the interrupted run"
            return 4
        fi

        local resume_sha resume_ref resume_output current_sha
        resume_sha=$(jq -r '.git_sha // empty' <<< "$resume_state")
        resume_ref=$(jq -r '.git_ref // empty' <<< "$resume_state")
        resume_output=$(jq -r '.context.output_dir // empty' <<< "$resume_state")
        current_sha=$(git -C "$local_path" rev-parse --verify HEAD 2>/dev/null || true)
        if ! $output_dir_explicit && [[ -n "$resume_output" ]]; then
            output_dir="$resume_output"
        fi
        if [[ "$build_purpose" == "diagnostic-native" && \
              "$output_dir" != "$state_dir/diagnostics/${tool_name}-${tag}/$resume_run_id" ]]; then
            log_error "Diagnostic resume output is outside its bound private namespace"
            return 4
        fi
        if [[ ! "$resume_sha" =~ ^[0-9a-f]{40}$ || "$current_sha" != "$resume_sha" || \
              -z "$resume_output" || "$resume_output" != "$output_dir" ]]; then
            log_error "Resume state source commit or output directory does not match this build"
            return 4
        fi
        build_source_sha="$resume_sha"
        build_source_ref="$resume_ref"
        build_source_roots_json=$(jq -cS '.context.source_roots // {}' <<< "$resume_state")
        build_target_hosts_json=$(jq -cS '.context.target_hosts // {}' <<< "$resume_state")
        if $build_release_contract_enabled && \
           ! jq -e 'type == "object" and length > 0 and all(.[]; type == "string" and length > 0)' \
                <<< "$build_source_roots_json" &>/dev/null; then
            log_error "Strict resume state has no valid source-root snapshot"
            return 4
        fi
        if $build_release_contract_enabled && \
           ! jq -e --argjson targets "$requested_targets_json" '
                type == "object" and (keys | sort) == $targets and
                all(.[]; type == "string" and test("^[A-Za-z0-9_-]+$"))
            ' <<< "$build_target_hosts_json" &>/dev/null; then
            log_error "Strict resume state has no valid target-host snapshot; start a fresh build"
            return 4
        fi
        log_info "Resuming build run $resume_run_id"
    fi

    if $dry_run; then
        local planned_targets='[]'
        local planned_host planned_method
        for target in $target_list; do
            if act_platform_uses_act "$tool_name" "$target"; then
                planned_host="local"
                planned_method="act"
            else
                planned_host=$(act_get_native_host "$target" "$tool_name" 2>/dev/null || true)
                if [[ -z "$planned_host" ]]; then
                    log_error "No native build host is configured for target '$target'"
                    return 4
                fi
                planned_method="native"
            fi
            planned_targets=$(jq -nc \
                --argjson targets "$planned_targets" \
                --arg platform "$target" \
                --arg host "$planned_host" \
                --arg method "$planned_method" \
                '$targets + [{platform: $platform, host: $host, method: $method, status: "skipped"}]')
        done

        log_info "[dry-run] Would execute build:"
        log_info "  Tool:       $tool_name"
        log_info "  Version:    $tag"
        log_info "  Targets:    $target_list"
        log_info "  Output:     $output_dir"
        log_info "  Concurrency: $parallel_jobs"
        log_info "  Purpose:    $build_purpose"
        $resume && log_info "  Resume run: $resume_run_id"
        if $sync_only; then
            log_info "  Source sync: planned (sync only; no build)"
        elif $no_sync; then
            log_info "  Source sync: skipped"
        else
            log_info "  Source sync: planned"
        fi

        if $JSON_MODE; then
            json_envelope "build" "success" 0 "$(jq -nc \
                --arg repo "$ACT_REPO_GITHUB" \
                --arg tool "$tool_name" \
                --arg version "$tag" \
                --argjson targets "$planned_targets" \
                --arg output_dir "$output_dir" \
                --argjson parallel_jobs "$parallel_jobs" \
                --arg resume_run_id "$resume_run_id" \
                --argjson no_sync "$no_sync" \
                --argjson sync_only "$sync_only" \
                --arg purpose "$build_purpose" \
                '{repo: $repo, tool: $tool, version: $version, targets: $targets,
                  build_purpose: $purpose, publishable: ($purpose == "release"),
                  output_dir: $output_dir, parallel_jobs: $parallel_jobs,
                  resume_run_id: $resume_run_id, no_sync: $no_sync,
                  sync_only: $sync_only, mode: "dry_run"}')"
        fi
        return 0
    fi

    if $build_release_contract_enabled; then
        local output_parent
        output_dir="${output_dir%/}"
        output_parent=$(dirname "$output_dir")
        if $resume; then
            if [[ -z "$output_dir" || ! -d "$output_dir" || -L "$output_dir" ]]; then
                log_error "Strict resume requires its existing private output directory: $output_dir"
                return 4
            fi
        else
            if [[ -z "$output_dir" || -e "$output_dir" || -L "$output_dir" ]]; then
                log_error "Strict release build requires a fresh output directory: $output_dir"
                return 4
            fi
            if ! mkdir -p "$output_parent" || [[ ! -d "$output_parent" || -L "$output_parent" ]] || \
               ! (umask 077; mkdir "$output_dir") || [[ ! -d "$output_dir" || -L "$output_dir" ]]; then
                log_error "Failed to create private strict output directory: $output_dir"
                return 4
            fi
        fi
    else
        # Never inherit artifacts from a previous build (issue #11): a stale
        # binary with the right name, right architecture, and a valid checksum
        # survives every cheap verification and ships the previous version's
        # code. Quarantine any existing output to a sibling directory and
        # start empty. Resumed runs keep their partial output (its bytes are
        # verified against frozen receipts), and the strict path above already
        # requires a fresh directory. --sync-only builds nothing, so it must
        # leave the existing outputs where a following release expects them.
        if ! $resume && ! $sync_only && [[ -d "$output_dir" && ! -L "$output_dir" ]] && \
           [[ -n "$(find "$output_dir" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
            if [[ "$(basename "$output_dir")" == "${tool_name}-${tag}" ]]; then
                local stale_output_dir
                stale_output_dir="${output_dir}.stale-$(date -u +%Y%m%dT%H%M%SZ)-$$"
                if [[ -e "$stale_output_dir" ]] || ! mv "$output_dir" "$stale_output_dir"; then
                    log_error "Output directory $output_dir holds artifacts from a previous build and could not be quarantined"
                    return 1
                fi
                log_warn "Quarantined stale artifacts from a previous $tool_name $tag build to $stale_output_dir"
                log_info "Previous outputs are never reused; delete the quarantine directory once the new build is verified"
            else
                log_error "Output directory is not empty: $output_dir"
                log_error "Refusing to build into it — leftover artifacts from an earlier build can be republished as if freshly built (issue #11). Use a fresh --output-dir."
                return 1
            fi
        fi
        if ! mkdir -p "$output_dir"; then
            log_error "Failed to create output directory: $output_dir"
            return 1
        fi
    fi

    if [[ "$build_purpose" == "diagnostic-native" ]]; then
        local purpose_marker="$output_dir/.dsr-build-purpose.json"
        if $resume; then
            if [[ ! -f "$purpose_marker" || -L "$purpose_marker" ]] || \
               ! jq -es --arg run "$resume_run_id" --arg sha "$build_source_sha" '
                    length == 1 and (.[0] | type == "object" and
                    .build_purpose == "diagnostic-native" and .publishable == false and
                    .run_id == $run and .git_sha == $sha)
                ' "$purpose_marker" >/dev/null; then
                log_error "Diagnostic output purpose receipt is missing or inconsistent"
                return 4
            fi
        elif ! (umask 077; set -o noclobber;
            jq -nc --arg run "$build_run_id" --arg sha "$build_source_sha" \
                '{build_purpose: "diagnostic-native", publishable: false,
                  run_id: $run, git_sha: $sha}' > "$purpose_marker"); then
            log_error "Could not persist diagnostic output purpose"
            return 4
        fi
    fi

    # The orchestrator is captured through command substitution below, so any
    # shell-local initialization it performs cannot propagate back into this
    # coordinator. Initialize the parent before source sync or build work so
    # the final targets-complete -> completed transition addresses the same
    # state root and fails before remote side effects if persistence is
    # unavailable.
    if ! command -v build_state_init &>/dev/null || ! build_state_init; then
        log_error "Build state initialization failed"
        return 4
    fi

    log_info "Building $tool_name $version"
    log_set_tool "$tool_name"
    log_info "Targets: $target_list"

    # Check if act is required for selected targets
    local need_act=false
    for target in $target_list; do
        if act_platform_uses_act "$tool_name" "$target"; then
            need_act=true
            break
        fi
    done

    if $need_act; then
        local workflow_path="$local_path/$ACT_REPO_WORKFLOW"
        if _act_workflow_needs_writable_parent "$workflow_path"; then
            if ! act_check_prereqs; then
                log_error "act not available - cannot build act targets"
                return 3
            fi
            log_info "Selected act workflow uses isolated act config; deferring bind/user validation to workflow runner"
        elif ! act_check; then
            log_error "act not available - cannot build act targets"
            return 3
        fi
    else
        log_info "No act targets selected; skipping act dependency check"
    fi

    # Strict resume reuses the immutable, SHA-verified source roots recorded by
    # the interrupted run. Creating a second strict snapshot would change the
    # run identity and defeat resume. Ordinary builds may safely resync HEAD.
    if $resume && $build_release_contract_enabled; then
        build_run_id="$resume_run_id"
        build_source_args=(
            --git-sha "$build_source_sha"
            --git-ref "$build_source_ref"
            --source-roots-json "$build_source_roots_json"
            --target-hosts-json "$build_target_hosts_json"
        )
        log_info "Reusing strict source snapshot for resumed run $resume_run_id"
    # Sync source to remote hosts (unless --no-sync)
    elif ! $no_sync; then
        if $build_release_contract_enabled; then
            if [[ -z "$build_run_id" ]]; then
                build_run_id=$(_act_generate_uuid) || return 4
            fi
            if ! _act_is_uuid "$build_run_id"; then
                log_error "Could not generate a strict release build run ID"
                return 4
            fi
            build_sync_args=(
                --strict-release
                --run-id "$build_run_id"
                --git-sha "$build_source_sha"
                --
            )
        fi

        log_info "Syncing source to remote build hosts..."
        local sync_output sync_json sync_status sync_detail sync_exit=0
        # shellcheck disable=SC2086
        sync_output=$(act_sync_sources "$tool_name" "${build_sync_args[@]}" $target_list 2>&1) || sync_exit=$?
        sync_json=$(printf '%s\n' "$sync_output" | grep '^{' | tail -1)
        # Everything that is not the structured summary is the sync transcript
        # (module logs plus the underlying rsync/ssh/tar diagnostics). It must
        # be shown on failure or the real error is silently discarded.
        sync_detail=$(printf '%s\n' "$sync_output" | grep -v '^{' | grep -v '^[[:space:]]*$' || true)
        if ! sync_status=$(jq -er '.status | strings' <<< "$sync_json" 2>/dev/null); then
            sync_status="unknown"
        fi

        # Both the command result and the host receipt must agree. A success
        # string alone cannot authorize builds after a failed transfer.
        local sync_receipt_valid=true
        case "$sync_status:$sync_exit" in
            success:0|skipped:0|partial:1|failed:1) ;;
            *) sync_receipt_valid=false ;;
        esac
        if ! $build_release_contract_enabled && $sync_receipt_valid; then
            local sync_tasks_json='[]' sync_method
            for target in $target_list; do
                sync_method=native
                if act_platform_uses_act "$tool_name" "$target"; then sync_method=act; fi
                sync_tasks_json=$(jq -c --arg platform "$target" --arg method "$sync_method" \
                    '. + [{platform: $platform, method: $method}]' <<< "$sync_tasks_json") || return 4
            done
            if ! sync_json=$(_act_validate_source_sync_receipt "$sync_json" "$sync_tasks_json"); then
                sync_receipt_valid=false
            fi
        fi
        if ! $sync_receipt_valid; then
            [[ -n "$sync_detail" ]] && printf '%s\n' "$sync_detail" >&2
            log_error "Source sync failed or returned incomplete host evidence"
            if $JSON_MODE; then
                local sync_error_json
                if ! sync_error_json=$(jq -nc \
                    --arg error "Source sync failed or returned incomplete host evidence" \
                    --argjson sync "${sync_json:-null}" \
                    --argjson exit_code "$sync_exit" \
                    '{error: $error, sync: $sync, sync_exit_code: $exit_code}' 2>/dev/null); then
                    sync_error_json='{"error":"Source sync failed or returned incomplete host evidence"}'
                fi
                json_envelope "build" "error" 1 "$sync_error_json"
            fi
            return 1
        fi

        if [[ "$sync_status" == "success" || "$sync_status" == "skipped" ]]; then
            local synced
            synced=$(jq -r '.synced // 0' <<< "$sync_json" 2>/dev/null || echo 0)
            if [[ "$synced" -gt 0 ]]; then
                log_ok "Source synced to $synced host(s)"
            fi
        else
            [[ -n "$sync_detail" ]] && printf '%s\n' "$sync_detail" >&2
            if $build_release_contract_enabled; then
                log_error "Strict source sync was incomplete"
                if $JSON_MODE; then
                    json_envelope "build" "error" 1 "$sync_json"
                fi
                return 1
            fi
            log_warn "Source sync failed on some hosts; their unfinished native targets will be blocked"
        fi

        if ! $build_release_contract_enabled; then
            # Retain failure evidence as well as successful host/path bindings.
            # The coordinator persists blocked targets before any compilation.
            build_source_args+=(--source-sync-json "$sync_json")
        fi
        if $build_release_contract_enabled; then
            build_target_hosts_json=$(jq -ce '.target_hosts | objects' <<< "$sync_json") || return 4
            if ! build_source_roots_json=$(jq -ce '
                .source_roots |
                if type == "object" and all(.[]; type == "string" and length > 0)
                then .
                else error("invalid strict source roots")
                end
            ' <<< "$sync_json" 2>/dev/null); then
                log_error "Strict source sync did not return valid source roots"
                return 1
            fi
            build_source_args=(
                --git-sha "$build_source_sha"
                --git-ref "$build_source_ref"
                --run-id "$build_run_id"
                --source-roots-json "$build_source_roots_json"
                --target-hosts-json "$build_target_hosts_json"
            )
        fi

        # If --sync-only, we're done
        if $sync_only; then
            if [[ "$sync_status" == "partial" || "$sync_status" == "failed" ]]; then
                log_error "Source sync was incomplete (--sync-only mode)"
                if $JSON_MODE; then
                    local sync_envelope_status=error
                    [[ "$sync_status" == "partial" ]] && sync_envelope_status=partial
                    json_envelope "build" "$sync_envelope_status" 1 "$sync_json"
                fi
                return 1
            fi
            log_ok "Sync completed (--sync-only mode)"
            if $JSON_MODE; then
                json_envelope "build" "success" 0 "$sync_json"
            fi
            return 0
        fi
    fi

    if $no_sync; then
        build_source_args+=(--no-source-sync-gate)
    fi
    if $resume && ! $build_release_contract_enabled; then
        build_source_args+=(--git-sha "$build_source_sha" --git-ref "$build_source_ref")
    fi

    # Record start time
    local start_time
    start_time=$(date +%s)

    # Run orchestrated build. Options precede an explicit delimiter so target
    # names can never be reinterpreted as scheduler flags.
    local full_output orchestrator_exit=0
    local -a orchestration_resume_args=()
    $resume && orchestration_resume_args=(--resume-run-id "$resume_run_id")
    if [[ -n "$resume_target_host" ]]; then
        $resume && $build_release_contract_enabled && [[ -n "$resume_target_host_approval" ]] || return 4
        orchestration_resume_args+=(--resume-target-host "$resume_target_host" \
            --resume-target-host-approval "$resume_target_host_approval")
    elif [[ -n "$resume_target_host_approval" ]]; then
        return 4
    fi
    # shellcheck disable=SC2086
    full_output=$(act_orchestrate_build "$tool_name" "$version" \
        "${build_source_args[@]}" "${orchestration_resume_args[@]}" "${purpose_args[@]}" \
        --parallel-jobs "$parallel_jobs" --output-dir "$output_dir" -- \
        $target_list 2>&1) || orchestrator_exit=$?

    # Debug: show orchestrator exit and last few lines of output
    log_debug "Orchestrator exit=$orchestrator_exit, output lines=$(echo "$full_output" | wc -l)"
    if [[ $orchestrator_exit -ne 0 ]] || [[ "$(echo "$full_output" | wc -l)" -lt 3 ]]; then
        echo "$full_output" | tail -10 >&2
    fi

    # Extract JSON from mixed output (orchestrator logs + JSON at end)
    # The orchestrator outputs JSON containing a summary object
    # We look for lines containing "summary" that are valid JSON
    local result=""

    # Try multiple patterns to find the JSON output
    # First: lines starting with { (standard jq output)
    result=$(echo "$full_output" | grep '^{' | tail -1)

    # Validate it's actually JSON with expected structure
    if ! echo "$result" | jq -e '.summary' &>/dev/null 2>&1; then
        # Second: try finding any JSON object with summary field
        result=$(echo "$full_output" | grep -o '{[^}]*"summary"[^}]*}' | tail -1)

        if ! echo "$result" | jq -e '.summary' &>/dev/null 2>&1; then
            # Third: look for multiline JSON (lines between { and })
            result=$(echo "$full_output" | awk '/^{$/,/^}$/' | tr -d '\n')

            if ! echo "$result" | jq -e '.summary' &>/dev/null 2>&1; then
                log_warn "Could not parse orchestrator JSON output"
                if [[ $orchestrator_exit -ne 0 ]]; then
                    log_error "Orchestrator exited with code $orchestrator_exit"
                    # Show last few lines of output for diagnosis
                    echo "$full_output" | tail -20 >&2
                fi
                # In verbose mode, show what we got
                if $VERBOSE; then
                    log_debug "Full output was:"
                    echo "$full_output" | head -50 >&2
                fi
                result='{}'
            fi
        fi
    fi

    # Parse result
    local end_time duration
    end_time=$(date +%s)
    duration=$((end_time - start_time))

    # Extract summary from JSON result
    local total success failed result_run_id
    total=$(echo "$result" | jq -r '.summary.total // 0' 2>/dev/null || echo 0)
    success=$(echo "$result" | jq -r '.summary.success // 0' 2>/dev/null || echo 0)
    failed=$(echo "$result" | jq -r '.summary.failed // 0' 2>/dev/null || echo 0)
    result_run_id=$(echo "$result" | jq -r '.run_id // empty' 2>/dev/null || true)

    # Default values if parsing failed
    [[ -z "$total" || "$total" == "null" ]] && total=0
    [[ -z "$success" || "$success" == "null" ]] && success=0
    [[ -z "$failed" || "$failed" == "null" ]] && failed=0

    # Log parsing results in verbose mode
    if $VERBOSE; then
        log_debug "Parsed counts: total=$total success=$success failed=$failed"
    fi

    # Collect artifacts into output directory for release/upload
    local collect_failed=false
    local collected_count=0
    local collision_count=0
    local -A collected_names=()
    local -a artifact_rename_pairs=()

    _build_target_suffix_name() {
        local name="$1"
        local target="$2"
        local os arch base ext

        [[ -z "$name" || -z "$target" ]] && printf '%s\n' "$name" && return 0

        os="${target%/*}"
        arch="${target#*/}"
        if [[ -z "$os" || -z "$arch" || "$os" == "$target" ]]; then
            printf '%s\n' "$name"
            return 0
        fi

        # Split off compound extensions FIRST so e.g. `binary.tar.gz`
        # becomes (base="binary", ext=".tar.gz") and the os/arch suffix
        # is inserted before the full extension instead of between
        # `.tar` and `.gz` (which silently broke `.tar.gz` recognition
        # in downstream tar/checksum logic).
        case "$name" in
            *.tar.gz)  ext=".tar.gz";  base="${name%.tar.gz}"  ;;
            *.tar.xz)  ext=".tar.xz";  base="${name%.tar.xz}"  ;;
            *.tar.bz2) ext=".tar.bz2"; base="${name%.tar.bz2}" ;;
            *.tar.zst) ext=".tar.zst"; base="${name%.tar.zst}" ;;
            *.*)       ext=".${name##*.}"; base="${name%.*}"   ;;
            *)         ext=""; base="$name"                    ;;
        esac

        if [[ "$base" == *"_${os}_${arch}" ]]; then
            printf '%s\n' "$name"
            return 0
        fi

        printf '%s_%s_%s%s\n' "$base" "$os" "$arch" "$ext"
    }

    _build_collect_artifact_file() {
        local src="$1"
        local target="${2:-}"
        local target_triple="${3:-}" native_result="${4:-false}"
        local name dest
        local orig_name=""

        [[ -z "$src" || ! -f "$src" ]] && return 0

        name=$(basename "$src")
        if [[ "$native_result" == true ]]; then
            if ! name=$(_act_native_variant_artifact_name "$tool_name" "$target" "$target_triple" "$name"); then
                log_error "Native artifact disagrees with its build variant: $src"
                collect_failed=true
                return 1
            fi
        fi
        orig_name="$name"
        dest="$output_dir/$name"

        if [[ -n "${collected_names[$name]:-}" ]]; then
            local prior="${collected_names[$name]}"
            if cmp -s "$prior" "$src" 2>/dev/null; then
                log_info "Duplicate artifact (same content): $name"
                return 0
            fi
            if [[ -n "$target" ]]; then
                local renamed
                renamed=$(_build_target_suffix_name "$name" "$target")
                if [[ -z "$renamed" || "$renamed" == "$name" ]]; then
                    log_error "Artifact name collision: $name"
                    log_error "  $prior"
                    log_error "  $src"
                    collision_count=$((collision_count + 1))
                    collect_failed=true
                    return 1
                fi
                log_warn "Artifact name collision: $name (target=$target); saving as $renamed"
                name="$renamed"
                dest="$output_dir/$name"
                artifact_rename_pairs+=("${target}||${target_triple}||${orig_name}"$'\t'"${name}")

                if $build_release_contract_enabled && [[ -e "$dest" || -L "$dest" ]]; then
                    log_error "Strict release artifact destination already exists: $name"
                    collect_failed=true
                    return 1
                elif [[ -f "$dest" ]]; then
                    if cmp -s "$dest" "$src" 2>/dev/null; then
                        log_info "Artifact already present: $name"
                        collected_names["$name"]="$src"
                        return 0
                    fi
                    log_error "Artifact name collision after suffix: $name"
                    log_error "  $dest"
                    log_error "  $src"
                    collision_count=$((collision_count + 1))
                    collect_failed=true
                    return 1
                fi
            else
                log_error "Artifact name collision: $name"
                log_error "  $prior"
                log_error "  $src"
                collision_count=$((collision_count + 1))
                collect_failed=true
                return 1
            fi
        fi

        if $build_release_contract_enabled; then
            if [[ -e "$dest" || -L "$dest" ]]; then
                if $resume && [[ -f "$dest" && ! -L "$dest" ]] && cmp -s "$src" "$dest"; then
                    log_info "Resume verified existing strict artifact: $name"
                    collected_names["$name"]="$src"
                    return 0
                fi
                log_error "Strict release artifact destination already exists with unverified content: $name"
                collect_failed=true
                return 1
            fi
            if cp -n "$src" "$dest" && [[ -f "$dest" && ! -L "$dest" ]] && \
               cmp -s "$src" "$dest"; then
                collected_names["$name"]="$src"
                collected_count=$((collected_count + 1))
                return 0
            fi
            log_error "Failed to create strict release artifact without clobbering: $name"
            collect_failed=true
            return 1
        fi

        if [[ -f "$dest" ]]; then
            if cmp -s "$dest" "$src" 2>/dev/null; then
                log_info "Artifact already present: $name"
                collected_names["$name"]="$src"
                return 0
            fi
            log_warn "Overwriting existing artifact: $name"
        fi

        if cp "$src" "$dest"; then
            collected_names["$name"]="$src"
            collected_count=$((collected_count + 1))
            return 0
        fi

        log_error "Failed to copy artifact: $src"
        collect_failed=true
        return 1
    }

    _build_collect_artifact_zip() {
        local zip_path="$1"
        local tag_filter="$2"
        local version_stripped="${tag_filter#v}"

        if ! command -v unzip &>/dev/null; then
            log_error "unzip required to extract act artifacts: $zip_path"
            collect_failed=true
            return 1
        fi

        local entries
        entries=$(unzip -Z1 "$zip_path" 2>/dev/null)
        if [[ -z "$entries" ]]; then
            log_error "Failed to read zip entries: $zip_path"
            collect_failed=true
            return 1
        fi

        local -a matched_entries=()
        while IFS= read -r entry; do
            [[ -z "$entry" ]] && continue
            [[ "$entry" == */ ]] && continue
            if [[ "$entry" == *"$tag_filter"* || "$entry" == *"$version_stripped"* ]]; then
                matched_entries+=("$entry")
            fi
        done <<< "$entries"

        local -a use_entries=()
        if [[ ${#matched_entries[@]} -gt 0 ]]; then
            use_entries=("${matched_entries[@]}")
        else
            while IFS= read -r entry; do
                [[ -z "$entry" ]] && continue
                [[ "$entry" == */ ]] && continue
                use_entries+=("$entry")
            done <<< "$entries"
        fi

        local entry
        for entry in "${use_entries[@]}"; do
            local dest_name dest_path
            dest_name=$(basename "$entry")
            dest_path="$output_dir/$dest_name"

            if [[ -n "${collected_names[$dest_name]:-}" ]]; then
                log_error "Artifact name collision: $dest_name (from $zip_path)"
                collision_count=$((collision_count + 1))
                collect_failed=true
                continue
            fi

            if [[ -f "$dest_path" ]]; then
                log_warn "Overwriting existing artifact: $dest_name"
            fi

            if unzip -p "$zip_path" "$entry" > "$dest_path" 2>/dev/null; then
                collected_names["$dest_name"]="$zip_path::$entry"
                collected_count=$((collected_count + 1))
            else
                log_error "Failed to extract $entry from $zip_path"
                collect_failed=true
            fi
        done
    }

    local -a extra_manifest_entries=()
    local -A existing_archive_formats=()

    _build_sha256() {
        local file="$1"

        if command -v sha256sum &>/dev/null; then
            sha256sum "$file" 2>/dev/null | awk '{print $1}'
            return $?
        fi

        if command -v shasum &>/dev/null; then
            shasum -a 256 "$file" 2>/dev/null | awk '{print $1}'
            return $?
        fi

        return 3
    }

    _build_file_size() {
        local file="$1"
        stat -c %s "$file" 2>/dev/null || stat -f %z "$file" 2>/dev/null || echo 0
    }

    _build_manifest_add_entry() {
        local file="$1"
        local target="$2"
        local format="$3"
        local target_triple="${4:-}"

        [[ -z "$file" || ! -f "$file" ]] && return 0
        [[ -z "$target" ]] && return 0

        local name sha size
        name=$(basename "$file")
        sha=$(_build_sha256 "$file" 2>/dev/null || echo "")
        size=$(_build_file_size "$file")

        if [[ -z "$sha" ]]; then
            log_warn "Unable to compute SHA256 for packaged artifact: $file"
            return 0
        fi
        if [[ -z "$size" || "$size" -le 0 ]]; then
            log_warn "Unable to determine size for packaged artifact: $file"
            return 0
        fi

        local artifact_json
        artifact_json=$(jq -nc \
            --arg name "$name" \
            --arg target "$target" \
            --arg sha "$sha" \
            --argjson size "$size" \
            --arg format "$format" \
            --arg target_triple "$target_triple" \
            '{
                name: $name,
                target: $target,
                sha256: $sha,
                size_bytes: $size,
                archive_format: $format,
                signed: false,
                signature_file: ""
            } + (if $target_triple == "" then {} else {target_triple: $target_triple} end)')

        extra_manifest_entries+=("$artifact_json")
    }

    _build_emit_compat_alias() {
        local src_path="$1"
        local compat_name="$2"
        local output_dir="$3"
        local target="$4"
        local format="$5"
        local target_triple="${6:-}"

        [[ -z "$compat_name" || -z "$src_path" || ! -f "$src_path" ]] && return 0

        local src_name
        src_name=$(basename "$src_path")
        if [[ "$compat_name" == "$src_name" ]]; then
            return 0
        fi

        local compat_path="$output_dir/$compat_name"
        if [[ -f "$compat_path" ]]; then
            if cmp -s "$compat_path" "$src_path" 2>/dev/null; then
                log_info "Compat alias already present: $compat_name"
                return 0
            fi
            log_warn "Compat alias exists with different content: $compat_name"
            return 1
        fi

        if cp "$src_path" "$compat_path"; then
            log_info "Created compat alias: $compat_name"
            _build_manifest_add_entry "$compat_path" "$target" "$format" "$target_triple"
            return 0
        fi

        log_warn "Failed to create compat alias: $compat_name"
        return 1
    }

    _build_is_archive_ext() {
        local name="$1"
        case "$name" in
            *.tar.gz|*.tgz|*.tar.xz|*.zip) return 0 ;;
            *) return 1 ;;
        esac
    }

    _build_emit_binary_alias() {
        local src_path="$1"
        local compat_name="$2"
        local output_dir="$3"
        local target="$4"
        local target_triple="${5:-}"

        [[ -z "$src_path" || -z "$compat_name" ]] && return 0

        local compat_path="$output_dir/$compat_name"
        if [[ -f "$compat_path" ]]; then
            if cmp -s "$compat_path" "$src_path" 2>/dev/null; then
                log_info "Binary alias already present: $compat_name"
                return 0
            fi
            log_warn "Binary alias exists with different content: $compat_name"
            return 1
        fi

        if cp "$src_path" "$compat_path"; then
            log_info "Created binary alias: $compat_name"
            _build_manifest_add_entry "$compat_path" "$target" "binary" "$target_triple"
            return 0
        fi

        log_warn "Failed to create binary alias: $compat_name"
        return 1
    }

    _build_find_manifest_artifact() {
        local manifest_file="$1"
        local output_dir="$2"
        local target="$3"
        local format="$4"
        local target_triple="${5:-}"

        if [[ -f "$manifest_file" ]]; then
            local name
            name=$(jq -r --arg t "$target" --arg f "$format" --arg triple "$target_triple" '
                .artifacts[]? | select(.target == $t) |
                select($triple == "" or .target_triple == $triple) |
                select(.archive_format == $f) | .name
            ' "$manifest_file" 2>/dev/null | head -1)
            if [[ -n "$name" && -f "$output_dir/$name" ]]; then
                echo "$output_dir/$name"
                return 0
            fi

            name=$(jq -r --arg t "$target" --arg triple "$target_triple" '
                .artifacts[]? | select(.target == $t) |
                select($triple == "" or .target_triple == $triple) | .name
            ' "$manifest_file" 2>/dev/null | head -1)
            if [[ -n "$name" && -f "$output_dir/$name" ]]; then
                echo "$output_dir/$name"
                return 0
            fi
        fi
        return 1
    }

    _build_get_archive_format() {
        local tool="$1"
        local os="$2"
        local format=""
        local config_dir="${DSR_CONFIG_DIR:-$HOME/.config/dsr}"
        local tool_config="$config_dir/repos.d/${tool}.yaml"

        # NOTE: $tool and $os are interpolated via env vars + strenv()
        # rather than spliced directly into the yq path expression.
        # Same defense-in-depth class as the round-4 config.sh fix:
        # if either ever contains a yq metachar (`.`, `[`, `(`, …)
        # the directly-spliced form silently returns the wrong value
        # or evaluates an unintended expression.
        if command -v yq &>/dev/null; then
            if [[ -f "$tool_config" ]]; then
                format=$(DSR_OS="$os" yq -r '.archive_format[strenv(DSR_OS)] // ""' "$tool_config" 2>/dev/null)
                [[ "$format" == "null" ]] && format=""
                if [[ -n "$format" ]]; then
                    echo "$format"
                    return 0
                fi
                format=$(yq -r '.archive_format // ""' "$tool_config" 2>/dev/null)
                if [[ "$format" != "null" && "$format" != "" && "$format" != "{"* ]]; then
                    echo "$format"
                    return 0
                fi
            fi

            if [[ -f "$DSR_REPOS_FILE" ]]; then
                format=$(DSR_TOOL="$tool" DSR_OS="$os" yq -r '.tools[strenv(DSR_TOOL)].archive_format[strenv(DSR_OS)] // ""' "$DSR_REPOS_FILE" 2>/dev/null)
                [[ "$format" == "null" ]] && format=""
                if [[ -n "$format" ]]; then
                    echo "$format"
                    return 0
                fi
                format=$(DSR_TOOL="$tool" yq -r '.tools[strenv(DSR_TOOL)].archive_format // ""' "$DSR_REPOS_FILE" 2>/dev/null)
                if [[ "$format" != "null" && "$format" != "" && "$format" != "{"* ]]; then
                    echo "$format"
                    return 0
                fi
            fi
        fi

        case "$os" in
            windows) echo "zip" ;;
            *) echo "tar.gz" ;;
        esac
    }

    _build_get_include_files() {
        local tool="$1"
        local config_dir="${DSR_CONFIG_DIR:-$HOME/.config/dsr}"
        local tool_config="$config_dir/repos.d/${tool}.yaml"

        if command -v yq &>/dev/null; then
            if [[ -f "$tool_config" ]]; then
                # Per-repo flat-archive contract: consumers whose installers
                # enforce an exact payload member set opt out of in-archive
                # extras with `include_extra_files: false` / `flat_archive:
                # true` (see packaging_include_files_in_archives).
                if declare -F packaging_include_files_in_archives &>/dev/null && \
                   [[ "$(packaging_include_files_in_archives "$tool_config")" == "false" ]]; then
                    return 0
                fi
                yq -r '.include_files[]?' "$tool_config" 2>/dev/null
                return 0
            fi
            if [[ -f "$DSR_REPOS_FILE" ]]; then
                # See _build_get_archive_format above — same strenv()
                # rationale: $tool came from a CLI flag and may be
                # unsanitised at the boundary.
                local reg_extra reg_flat
                # `// ""` would swallow a boolean false; read raw values.
                reg_extra=$(DSR_TOOL="$tool" yq -r '.tools[strenv(DSR_TOOL)].include_extra_files' "$DSR_REPOS_FILE" 2>/dev/null)
                reg_flat=$(DSR_TOOL="$tool" yq -r '.tools[strenv(DSR_TOOL)].flat_archive' "$DSR_REPOS_FILE" 2>/dev/null)
                if [[ "$reg_extra" == "false" || "$reg_flat" == "true" ]]; then
                    return 0
                fi
                DSR_TOOL="$tool" yq -r '.tools[strenv(DSR_TOOL)].include_files[]?' "$DSR_REPOS_FILE" 2>/dev/null
                return 0
            fi
        fi
    }

    _build_detect_compat_ext() {
        local tool="$1"
        local repo_path="$2"
        local compat_pattern
        compat_pattern=$(artifact_naming_get_compat_pattern "$tool" "$repo_path" 2>/dev/null || echo "")

        case "$compat_pattern" in
            *".tar.gz") echo "tar.gz" ;;
            *".tgz") echo "tgz" ;;
            *".tar.xz") echo "tar.xz" ;;
            *".zip") echo "zip" ;;
            *".exe") echo "exe" ;;
            *) echo "" ;;
        esac
    }

    _build_detect_install_ext() {
        local tool="$1"
        local repo_path="$2"
        local install_path
        install_path=$(config_get_install_script_path "$tool" 2>/dev/null || echo "")
        if [[ -z "$install_path" || -z "$repo_path" ]]; then
            return 0
        fi

        local full_path="$repo_path/$install_path"
        if [[ ! -f "$full_path" ]]; then
            return 0
        fi

        local pattern=""
        pattern=$(sed -n 's/.*TAR="\([^"]*\)".*/\1/p' "$full_path" | head -1 || true)
        if [[ -z "$pattern" ]]; then
            pattern=$(sed -n 's/.*[Aa][Ss][Ss][Ee][Tt]_[Nn][Aa][Mm][Ee]="\([^"]*\)".*/\1/p' "$full_path" | head -1 || true)
        fi

        case "$pattern" in
            *".tar.gz") echo "tar.gz" ;;
            *".tgz") echo "tgz" ;;
            *".tar.xz") echo "tar.xz" ;;
            *".zip") echo "zip" ;;
            *".exe") echo "exe" ;;
            *) return 0 ;;
        esac
    }

    _build_find_binary() {
        local output_dir="$1"
        local binary_name="$2"
        local os="$3"
        local candidate=""

        if [[ "$os" == "windows" ]]; then
            if [[ -f "$output_dir/${binary_name}.exe" ]]; then
                candidate="$output_dir/${binary_name}.exe"
            elif [[ -f "$output_dir/$binary_name" ]]; then
                candidate="$output_dir/$binary_name"
            fi
        else
            if [[ -f "$output_dir/$binary_name" ]]; then
                candidate="$output_dir/$binary_name"
            elif [[ -f "$output_dir/${binary_name}.exe" ]]; then
                candidate="$output_dir/${binary_name}.exe"
            fi
        fi

        [[ -n "$candidate" ]] && printf '%s\n' "$candidate"
    }

    # Complete a build lane's same-format archive that already occupies the
    # release name but lacks configured include_files (GH#29). It is rebuilt
    # atomically from its own payload plus the missing includes; the manifest
    # row and a byte-identical compat alias follow the new bytes. Lane
    # checksums or signatures attest the thin bytes and cannot be regenerated
    # here, so they fail the build visibly instead of shipping either a thin
    # archive or a broken attestation.
    _build_complete_lane_archive() {
        local tool="$1" target="$2" format="$3" archive_path="$4"
        local archive_format="$5" compat_name="$6" output_dir="$7" repo_path="$8"
        local target_triple="$9"
        shift 9
        local -a missing=("$@")

        local name compat_path=""
        name=$(basename "$archive_path")
        if [[ -n "$compat_name" && "$compat_name" != "$name" && \
              -f "$output_dir/$compat_name" && ! -L "$output_dir/$compat_name" ]] && \
           cmp -s "$output_dir/$compat_name" "$archive_path"; then
            compat_path="$output_dir/$compat_name"
        fi

        local attested_name attestation aggregate
        for attested_name in "$name" ${compat_path:+"$compat_name"}; do
            for attestation in "$output_dir/$attested_name".sha256 "$output_dir/$attested_name".sha512 \
                "$output_dir/$attested_name".minisig "$output_dir/$attested_name".sig \
                "$output_dir/$attested_name".asc; do
                if [[ -e "$attestation" || -L "$attestation" ]]; then
                    log_error "Archive $attested_name for $tool $target lacks configured include_files (${missing[*]}), but $(basename "$attestation") attests its current bytes; refusing to rebuild it"
                    collect_failed=true
                    return 1
                fi
            done
            for aggregate in "$output_dir"/SHA256SUMS* "$output_dir"/*checksums*.txt; do
                [[ -f "$aggregate" ]] || continue
                if awk -v n="$attested_name" '{f=$2; sub(/^\*/, "", f); if (f == n) found=1} END {exit !found}' "$aggregate"; then
                    log_error "Archive $attested_name for $tool $target lacks configured include_files (${missing[*]}), but $(basename "$aggregate") lists its current bytes; refusing to rebuild it"
                    collect_failed=true
                    return 1
                fi
            done
        done

        local workdir thin completed=true
        if ! workdir=$(mktemp -d "$output_dir/.dsr-complete.XXXXXXXX"); then
            log_error "Could not stage completion of $name for $tool $target"
            collect_failed=true
            return 1
        fi
        thin="$workdir/$name"
        if ! cp -p -- "$archive_path" "$thin" || \
           ! packaging_repack_archive "$thin" "$archive_format" "$archive_path" "$archive_format" \
               "$repo_path" "${missing[@]}"; then
            log_error "Could not add configured include_files (${missing[*]}) to $name for $tool $target"
            completed=false
        else
            log_info "Added configured include_files to $name: ${missing[*]}"
            _build_manifest_add_entry "$archive_path" "$target" "$format" "$target_triple"
            if [[ -n "$compat_path" ]]; then
                if cp -- "$archive_path" "$workdir/compat" && \
                   mv -f -- "$workdir/compat" "$compat_path"; then
                    log_info "Refreshed compat alias $compat_name with the completed archive"
                    _build_manifest_add_entry "$compat_path" "$target" "$format" "$target_triple"
                else
                    log_error "Could not refresh compat alias $compat_name for $tool $target"
                    completed=false
                fi
            fi
        fi
        rm -f -- "$thin" "$workdir/compat"
        rmdir -- "$workdir" 2>/dev/null || true
        if ! $completed; then
            collect_failed=true
            return 1
        fi
        return 0
    }

    # Configured include_files an archive lacks, one per line (GH#16, GH#29).
    _build_archive_missing_includes() {
        local tool="$1" archive="$2" archive_format="$3" repo_path="$4"
        local include members
        [[ -n "$repo_path" ]] || return 0
        members=$(packaging_payload_members "$archive" "$archive_format" 2>/dev/null || echo "")
        while IFS= read -r include; do
            [[ -n "$include" ]] || continue
            if [[ ! -f "$repo_path/$include" ]]; then
                log_warn "Include file not found for $tool: $include"
            elif ! grep -qxF -- "$include" <<< "$members"; then
                printf '%s\n' "$include"
            fi
        done < <(_build_get_include_files "$tool" 2>/dev/null)
    }

    # Platforms with several target-triple variants (bd-cdcz), e.g. gnu and
    # musl builds of linux/amd64. The build lane produces each variant's
    # archive; give every non-primary variant it produced its own
    # installer-compatible alias, and name the variants it did not produce.
    _build_emit_variant_aliases() {
        local tool="$1" version="$2" target="$3" format="$4" naming_ext="$5"
        local output_dir="$6" repo_path="$7" primary_versioned="$8"
        local native_results="${9:-null}" primary_compat="${10:-}"
        local listed triple names_json versioned compat variant_path
        local -a triples=()
        listed=$(config_get_target_triples "$tool" "$target" 2>/dev/null) || return 0
        while IFS= read -r triple; do
            [[ -n "$triple" ]] && triples+=("$triple")
        done <<< "$listed"
        [[ ${#triples[@]} -gt 1 ]] || return 0
        log_debug "Target triples for $tool $target: ${triples[*]} (primary ${triples[0]})"

        for triple in "${triples[@]:1}"; do
            names_json=$(artifact_naming_generate_dual_for_variant "$tool" "$version" \
                "${target%/*}" "${target#*/}" "$naming_ext" "$repo_path" "$triple" 2>/dev/null) || names_json=""
            versioned=$(jq -r '.versioned // empty' <<< "$names_json" 2>/dev/null) || versioned=""
            compat=$(jq -r '.compat // empty' <<< "$names_json" 2>/dev/null) || compat=""
            local native_variant=false naming_override=""
            if jq -e --arg platform "$target" --arg triple "$triple" '
                any(.targets[]?; .platform == $platform and .method == "native" and
                    .target_triple == $triple and
                    (.status == "success" or .status == "ok" or .status == "passed"))
            ' <<< "$native_results" >/dev/null 2>&1; then
                native_variant=true
            fi
            if [[ -z "$versioned" ]]; then
                log_warn "Unable to name variant $triple of $tool $target"
                continue
            fi
            if [[ "$versioned" == "$primary_versioned" ]]; then
                if $native_variant; then
                    # Native compilation has produced distinct payloads even
                    # when an older naming pattern only names the platform.
                    # Retain its primary name and package every other variant
                    # under the same qualification used by native collection.
                    versioned=$(_act_native_variant_artifact_name \
                        "$tool" "$target" "$triple" "$versioned") || {
                        collect_failed=true
                        return 1
                    }
                    log_info "Native variant $triple uses its qualified archive name: $versioned"
                else
                    log_warn "artifact_naming for $tool does not distinguish the variants of $target (add \${target_triple}); only ${triples[0]} gets installer names"
                    return 0
                fi
            fi
            if $native_variant; then
                # A shared public name belongs to the primary. Emitting the
                # secondary alias first would either steal that name or make
                # later primary packaging fail with a byte collision.
                if [[ "$compat" == "$primary_compat" || "$compat" == "$primary_versioned" ]]; then
                    compat=""
                fi
                naming_override=$(jq -nc --arg versioned "$versioned" --arg compat "$compat" \
                    '{versioned:$versioned, compat:$compat}') || return 1
            fi
            variant_path=$(_build_find_manifest_artifact "$manifest_file" "$output_dir" "$target" "$format" "$triple" 2>/dev/null || true)
            if [[ -z "$variant_path" || -L "$variant_path" ]]; then
                log_warn "Variant $triple of $tool $target was not produced by this build ($versioned); installers selecting it will find no asset"
                continue
            fi
            log_info "Variant $triple of $tool $target: $versioned"
            local variant_format include
            local -a missing=()
            variant_format=$(packaging_format_for_name "${variant_path##*/}")
            local requested_format="$format"
            [[ "$requested_format" == tgz ]] && requested_format=tar.gz
            if [[ "$requested_format" == binary && "$variant_format" != none ]]; then
                log_error "Variant $triple is an archive; refusing to publish archive bytes as a raw executable"
                collect_failed=true
                return 1
            fi
            if [[ "$requested_format" != binary && "$variant_format" != "$requested_format" ]]; then
                # A platform job can emit a different container for each
                # libc variant. Convert the actual payload before assigning
                # a new extension; copying xz bytes to a .tar.gz alias makes
                # the release impossible to install.
                _build_package_archive_for_target "$tool" "$version" "$target" \
                    "$output_dir" "$repo_path" "$binary_name" "$variant_path" "$triple" "$naming_override" || return 1
                if [[ ! -f "$output_dir/$versioned" ]]; then
                    log_error "Could not package $triple as $requested_format: $versioned"
                    collect_failed=true
                    return 1
                fi
                continue
            fi
            if [[ "$format" != "binary" && "$variant_format" != none && -n "$repo_path" ]]; then
                while IFS= read -r include; do
                    [[ -n "$include" ]] && missing+=("$include")
                done < <(_build_archive_missing_includes "$tool" "$variant_path" \
                    "$variant_format" "$repo_path")
                if [[ ${#missing[@]} -gt 0 ]] && ! _build_complete_lane_archive "$tool" "$target" \
                        "$format" "$variant_path" "$variant_format" "$compat" \
                        "$output_dir" "$repo_path" "$triple" "${missing[@]}"; then
                    continue
                fi
            fi
            [[ -n "$compat" && "$compat" != "$versioned" ]] || continue
            if [[ "$format" == "binary" ]]; then
                _build_emit_binary_alias "$variant_path" "$compat" "$output_dir" "$target" "$triple" || collect_failed=true
            elif _build_is_archive_ext "$compat"; then
                _build_emit_compat_alias "$variant_path" "$compat" "$output_dir" "$target" "$format" "$triple" || collect_failed=true
            else
                log_warn "Variant $triple of $tool $target: installer name $compat is not an archive; no alias emitted"
            fi
        done
    }

    # Collection qualifies native raw payloads by triple. Their public
    # archives must still contain the configured executable name, with the
    # same bytes and mode, rather than that transport filename.
    _build_package_named_binary() (
        local format="$1" archive="$2" source="$3" member="$4" include_root="$5"
        shift 5
        local workdir include
        local -a members=("$member")
        _act_is_safe_basename "$member" || return 4
        [[ -f "$source" && ! -L "$source" ]] || return 4
        workdir=$(mktemp -d "${archive%/*}/.dsr-payload.XXXXXXXX") || return 4
        trap 'rm -rf -- "$workdir"' EXIT
        trap 'exit 5' HUP INT TERM
        cp -p -- "$source" "$workdir/$member" || return 4
        for include in "$@"; do
            packaging_member_is_safe "$include" || return 4
            [[ -n "$include_root" && -f "$include_root/$include" ]] && \
                _pkg_path_has_no_links "$include_root" "$include" || return 4
            if [[ -e "$workdir/$include" ]]; then
                cmp -s "$include_root/$include" "$workdir/$include" || return 4
                continue
            fi
            mkdir -p -- "$workdir/$(dirname "$include")" || return 4
            cp -p -- "$include_root/$include" "$workdir/$include" || return 4
            members+=("$include")
        done
        packaging_build_archive "$format" "$archive" "$workdir" "${members[@]}"
    )

    _build_package_archive_for_target() {
        local tool="$1"
        local version="$2"
        local target="$3"
        local output_dir="$4"
        local repo_path="$5"
        local binary_name="$6"
        local binary_override="${7:-}"
        local target_triple="${8:-}"
        local naming_override="${9:-}"

        local os arch
        os="${target%/*}"
        arch="${target#*/}"

        local format
        format=$(_build_get_archive_format "$tool" "$os")

        local compat_ext
        compat_ext=$(_build_detect_compat_ext "$tool" "$repo_path")
        if [[ -z "$compat_ext" ]]; then
            compat_ext=$(_build_detect_install_ext "$tool" "$repo_path")
        fi
        if [[ -n "$compat_ext" && "$format" != "binary" ]]; then
            if [[ "$compat_ext" == "exe" ]]; then
                format="none"
            elif [[ "$format" != "$compat_ext" ]]; then
                log_warn "Archive format for $tool $target ($format) differs from installer ($compat_ext); using $compat_ext"
                format="$compat_ext"
            fi
        fi

        if [[ -z "$format" || "$format" == "none" ]]; then
            return 0
        fi

        local -a include_files=()
        local include
        while IFS= read -r include; do
            [[ -z "$include" ]] && continue
            include_files+=("$include")
        done < <(_build_get_include_files "$tool" 2>/dev/null)
        if [[ ${#include_files[@]} -gt 0 && -z "$repo_path" && "$format" != "binary" ]]; then
            # A configured include list with nowhere to read it from must
            # never degrade into a quietly thinner archive (GH#16).
            log_warn "include_files configured for $tool (${include_files[*]}) but local_path is unresolved; $target archive will omit them"
        fi

        local existing_format="${existing_archive_formats[$target]:-}"
        if [[ -n "$target_triple" && -n "$binary_override" && -f "$binary_override" ]]; then
            existing_format=$(packaging_format_for_name "${binary_override##*/}")
            [[ "$existing_format" != none ]] || existing_format=""
        fi
        if [[ -n "$existing_format" && "$existing_format" == "$format" ]]; then
            if [[ ${#include_files[@]} -gt 0 && -n "$repo_path" && "$format" != "binary" ]]; then
                # Fall through: the lane's archive may lack the configured
                # include_files, which is verified against its member list
                # below (GH#16) rather than assumed.
                :
            else
                log_info "Archive already produced for $tool $target ($format); skipping packaging"
                return 0
            fi
        fi

        local naming_ext="$format"
        if [[ "$format" == "binary" ]]; then
            naming_ext=""
            [[ "$os" == "windows" ]] && naming_ext="exe"
        fi

        local names_json versioned_name
        if [[ -n "$naming_override" ]]; then
            names_json="$naming_override"
        elif ! names_json=$(artifact_naming_generate_dual_for_tool "$tool" "$version" "$os" "$arch" \
                "$naming_ext" "$repo_path" release "$target_triple"); then
            log_error "Unable to resolve archive names for $tool $target ${target_triple:-}"
            collect_failed=true
            return 1
        fi
        versioned_name=$(echo "$names_json" | jq -r '.versioned // empty' 2>/dev/null)
        local compat_name
        compat_name=$(echo "$names_json" | jq -r '.compat // empty' 2>/dev/null)
        if [[ -z "$versioned_name" ]]; then
            log_error "Unable to resolve archive name for $tool $target ($format)"
            collect_failed=true
            return 1
        fi

        local archive_path="$output_dir/$versioned_name"

        local binary_path=""
        if [[ -n "$binary_override" && -f "$binary_override" ]]; then
            binary_path="$binary_override"
        elif [[ -z "$target_triple" ]]; then
            binary_path=$(_build_find_binary "$output_dir" "$binary_name" "$os" 2>/dev/null || echo "")
        fi
        if [[ -z "$binary_path" || ! -f "$binary_path" ]]; then
            log_error "Binary not found for $tool $target ${target_triple:-}; cannot package the requested variant"
            collect_failed=true
            return 1
        fi

        # If the build already produced an ARCHIVE for this target (the
        # native workspace collector always emits tar.gz/zip), never treat
        # it as a raw binary member: wrapping an archive inside another
        # archive shipped corrupted assets (mcp_agent_mail_rust v0.3.30 /
        # v0.3.31 tar.xz-wrapping-tar.gz). Rebuild the requested format
        # independently from the extracted payload instead, preserving the
        # exact member set.
        local input_format
        input_format=$(packaging_format_for_name "$(basename "$binary_path")")
        if [[ "$input_format" != "none" ]]; then
            if [[ "$format" == "binary" ]]; then
                log_error "Build artifact for $tool $target is an archive; refusing to publish archive bytes as a raw executable"
                collect_failed=true
                return 1
            fi
            local normalized_format="$format"
            [[ "$format" == "tgz" ]] && normalized_format="tar.gz"

            # The build lane may have wrapped a lone binary (or a workspace
            # payload) without the configured include_files. Determine which
            # includes the produced archive still lacks so the repack adds
            # them instead of silently preserving a thinner member set (GH#16:
            # rano v0.2.1 lost its LICENSE this way, with no diagnostic).
            local -a missing_includes=()
            if [[ -n "$repo_path" && ${#include_files[@]} -gt 0 ]]; then
                local existing_members
                existing_members=$(packaging_payload_members "$binary_path" "$input_format" 2>/dev/null || echo "")
                for include in "${include_files[@]}"; do
                    if [[ ! -f "$repo_path/$include" ]]; then
                        log_warn "Include file not found for $tool: $include"
                    elif ! grep -qxF -- "$include" <<< "$existing_members"; then
                        missing_includes+=("$include")
                    fi
                done
            fi

            if [[ "$input_format" == "$normalized_format" ]]; then
                if [[ ${#missing_includes[@]} -eq 0 ]]; then
                    log_info "Archive already produced for $tool $target ($format); skipping packaging"
                    return 0
                fi
                if [[ "$binary_path" -ef "$archive_path" ]]; then
                    # The lane's archive already occupies the release name
                    # but lacks configured include_files (GH#29). Complete
                    # it in place, or fail the build visibly when lane
                    # checksums or signatures attest the thin bytes.
                    _build_complete_lane_archive "$tool" "$target" "$format" \
                        "$archive_path" "$normalized_format" "$compat_name" \
                        "$output_dir" "$repo_path" "$target_triple" "${missing_includes[@]}"
                    return $?
                fi
            fi
            if [[ -f "$archive_path" ]]; then
                log_warn "Overwriting existing archive: $archive_path"
            fi
            local -a repack_includes=()
            if [[ ${#missing_includes[@]} -gt 0 ]]; then
                repack_includes=("$repo_path" "${missing_includes[@]}")
                log_info "Adding configured include_files to $versioned_name: ${missing_includes[*]}"
            fi
            if packaging_repack_archive "$binary_path" "$input_format" "$archive_path" "$normalized_format" "${repack_includes[@]}"; then
                log_info "Rebuilt $format archive independently from $(basename "$binary_path") payload: $versioned_name"
                _build_manifest_add_entry "$archive_path" "$target" "$format" "$target_triple"
                if [[ -n "$compat_name" && "$compat_name" != "$versioned_name" ]] && \
                   _build_is_archive_ext "$compat_name"; then
                    _build_emit_compat_alias "$archive_path" "$compat_name" "$output_dir" "$target" "$format" "$target_triple" || collect_failed=true
                fi
            else
                log_error "Failed to rebuild $format archive from $(basename "$binary_path"): $archive_path"
                collect_failed=true
                return 1
            fi
            return 0
        fi

        if [[ "$format" == "binary" ]]; then
            if [[ -f "$archive_path" ]]; then
                log_warn "Overwriting existing binary asset: $archive_path"
            fi
            if [[ "$binary_path" -ef "$archive_path" ]] || cp "$binary_path" "$archive_path"; then
                chmod +x "$archive_path" 2>/dev/null || true
                _build_manifest_add_entry "$archive_path" "$target" "binary" "$target_triple"
                if [[ -n "$compat_name" && "$compat_name" != "$versioned_name" ]]; then
                    _build_emit_binary_alias "$binary_path" "$compat_name" "$output_dir" "$target" "$target_triple" || collect_failed=true
                fi
            else
                log_error "Failed to create binary asset: $archive_path"
                collect_failed=true
                return 1
            fi
            return 0
        fi

        local raw_member="$binary_name"
        [[ "$os" != windows || "$raw_member" == *.exe ]] || raw_member+=.exe
        if [[ -n "$target_triple" && "${binary_path##*/}" != "$raw_member" ]]; then
            if ! _build_package_named_binary "$format" "$archive_path" "$binary_path" \
                "$raw_member" "$repo_path" "${include_files[@]}"; then
                log_error "Failed to package the named executable for $tool $target $target_triple"
                collect_failed=true
                return 1
            fi
            _build_manifest_add_entry "$archive_path" "$target" "$format" "$target_triple"
            if [[ -n "$compat_name" && "$compat_name" != "$versioned_name" ]]; then
                if _build_is_archive_ext "$compat_name"; then
                    _build_emit_compat_alias "$archive_path" "$compat_name" "$output_dir" "$target" "$format" "$target_triple" || collect_failed=true
                else
                    _build_emit_binary_alias "$binary_path" "$compat_name" "$output_dir" "$target" "$target_triple" || collect_failed=true
                fi
            fi
            return 0
        fi

        if [[ "$format" == "tar.gz" || "$format" == "tgz" ]]; then
            if [[ -f "$archive_path" ]]; then
                log_warn "Overwriting existing archive: $archive_path"
            fi
            local -a tar_args=()
            local binary_dir
            binary_dir=$(dirname "$binary_path")
            tar_args=(--no-xattrs -czf "$archive_path" -C "$binary_dir" "$(basename "$binary_path")")
            if [[ -n "$repo_path" ]]; then
                for include in "${include_files[@]}"; do
                    if [[ -f "$repo_path/$include" ]]; then
                        tar_args+=(-C "$repo_path" "$include")
                    else
                        log_warn "Include file not found for $tool: $include"
                    fi
                done
            fi
            # COPYFILE_DISABLE suppresses macOS copyfile metadata while
            # --no-xattrs prevents bsdtar from encoding source-file xattrs as
            # AppleDouble ._* members that GNU tar exposes on Linux. Both are
            # required for cross-platform strict installer member allowlists.
            if COPYFILE_DISABLE=1 tar "${tar_args[@]}"; then
                _build_manifest_add_entry "$archive_path" "$target" "$format" "$target_triple"
                if [[ -n "$compat_name" ]]; then
                    if _build_is_archive_ext "$compat_name"; then
                        _build_emit_compat_alias "$archive_path" "$compat_name" "$output_dir" "$target" "$format" "$target_triple" || collect_failed=true
                    else
                        _build_emit_binary_alias "$binary_path" "$compat_name" "$output_dir" "$target" "$target_triple" || collect_failed=true
                    fi
                fi
            else
                log_error "Failed to create archive: $archive_path"
                collect_failed=true
                return 1
            fi
            return 0
        fi

        if [[ "$format" == "tar.xz" ]]; then
            if [[ -f "$archive_path" ]]; then
                log_warn "Overwriting existing archive: $archive_path"
            fi
            local -a tar_args=()
            local binary_dir
            binary_dir=$(dirname "$binary_path")
            tar_args=(--no-xattrs -cJf "$archive_path" -C "$binary_dir" "$(basename "$binary_path")")
            # COPYFILE_DISABLE: see tar.gz branch above (AppleDouble sidecars).
            if [[ -n "$repo_path" ]]; then
                for include in "${include_files[@]}"; do
                    if [[ -f "$repo_path/$include" ]]; then
                        tar_args+=(-C "$repo_path" "$include")
                    else
                        log_warn "Include file not found for $tool: $include"
                    fi
                done
            fi
            if COPYFILE_DISABLE=1 tar "${tar_args[@]}"; then
                _build_manifest_add_entry "$archive_path" "$target" "$format" "$target_triple"
                if [[ -n "$compat_name" ]]; then
                    if _build_is_archive_ext "$compat_name"; then
                        _build_emit_compat_alias "$archive_path" "$compat_name" "$output_dir" "$target" "$format" "$target_triple" || collect_failed=true
                    else
                        _build_emit_binary_alias "$binary_path" "$compat_name" "$output_dir" "$target" "$target_triple" || collect_failed=true
                    fi
                fi
            else
                log_error "Failed to create archive: $archive_path"
                collect_failed=true
                return 1
            fi
            return 0
        fi

        if [[ "$format" == "zip" ]]; then
            if ! command -v zip &>/dev/null; then
                log_warn "zip not available; skipping archive packaging for $tool $target"
                return 0
            fi
            if [[ -f "$archive_path" ]]; then
                log_warn "Overwriting existing archive: $archive_path"
            fi
            local -a zip_inputs=("$binary_path")
            if [[ -n "$repo_path" ]]; then
                for include in "${include_files[@]}"; do
                    if [[ -f "$repo_path/$include" ]]; then
                        zip_inputs+=("$repo_path/$include")
                    else
                        log_warn "Include file not found for $tool: $include"
                    fi
                done
            fi
            if zip -j -q -FS "$archive_path" "${zip_inputs[@]}"; then
                _build_manifest_add_entry "$archive_path" "$target" "$format" "$target_triple"
                if [[ -n "$compat_name" ]]; then
                    if _build_is_archive_ext "$compat_name"; then
                        _build_emit_compat_alias "$archive_path" "$compat_name" "$output_dir" "$target" "$format" "$target_triple" || collect_failed=true
                    else
                        _build_emit_binary_alias "$binary_path" "$compat_name" "$output_dir" "$target" "$target_triple" || collect_failed=true
                    fi
                fi
            else
                log_error "Failed to create archive: $archive_path"
                collect_failed=true
                return 1
            fi
        fi
    }

    _build_package_archives() {
        local tool="$1"
        local version="$2"
        local output_dir="$3"
        local result_json="$4"
        local target_list="$5"
        local manifest_file="$6"

        _dsr_require artifact_naming
        _dsr_require packaging

        local repo_path binary_name
        repo_path=$(config_get_tool_field "$tool" "local_path" "" 2>/dev/null || echo "")
        binary_name=$(config_get_tool_field "$tool" "binary_name" "" 2>/dev/null || echo "")
        [[ -z "$binary_name" ]] && binary_name="$tool"

        local -a targets=()
        while IFS= read -r target; do
            [[ -n "$target" ]] && targets+=("$target")
        done < <(echo "$result_json" | jq -r '[.targets[]? | select(.status == "success" or .status == "ok" or .status == "passed") | .platform // empty] | unique[]' 2>/dev/null)

        if [[ ${#targets[@]} -eq 0 ]]; then
            while IFS= read -r target; do
                [[ -n "$target" ]] && targets+=("$target")
            done < <(echo "$result_json" | jq -r '[.targets[]? | .platform // empty] | unique[]' 2>/dev/null)
        fi

        if [[ ${#targets[@]} -eq 0 ]]; then
            if [[ -n "$target_list" ]]; then
                local target
                for target in $target_list; do
                    [[ -n "$target" ]] && targets+=("$target")
                done
            fi
        fi

        if [[ ${#targets[@]} -eq 0 ]]; then
            return 0
        fi

        if [[ -n "$manifest_file" && -f "$manifest_file" ]]; then
            local target format
            while IFS=$'\t' read -r target format; do
                [[ -z "$target" || -z "$format" || "$format" == "none" ]] && continue
                existing_archive_formats["$target"]="$format"
            done < <(jq -r '.artifacts[]? | [.target // "", .archive_format // ""] | @tsv' "$manifest_file" 2>/dev/null)
        else
            local target artifact_path
            while IFS=$'\t' read -r target artifact_path; do
                [[ -z "$target" || -z "$artifact_path" ]] && continue
                case "$artifact_path" in
                    *.tar.gz|*.tgz) existing_archive_formats["$target"]="tar.gz" ;;
                    *.tar.xz) existing_archive_formats["$target"]="tar.xz" ;;
                    *.zip) existing_archive_formats["$target"]="zip" ;;
                esac
            done < <(echo "$result_json" | jq -r '.targets[]? | [.platform, (.artifact_path // .artifact // "")] | @tsv' 2>/dev/null)
        fi

        for target in "${targets[@]}"; do
            log_info "Packaging installer archive for $tool $target"
            local os arch format names_json versioned_name compat_name primary_triple
            os="${target%/*}"
            arch="${target#*/}"
            primary_triple=$(config_get_target_triple "$tool" "$target") || {
                collect_failed=true
                return 1
            }
            if [[ -z "$primary_triple" && -f "$manifest_file" ]]; then
                primary_triple=$(jq -r --arg target "$target" '
                    [.artifacts[]? | select(.target == $target) | .target_triple // empty] |
                    (map(select(endswith("-gnu"))) + .) | .[0] // ""
                ' "$manifest_file") || return 1
            fi
            format=$(_build_get_archive_format "$tool" "$os")

            local compat_ext
            compat_ext=$(_build_detect_compat_ext "$tool" "$repo_path")
            if [[ -z "$compat_ext" ]]; then
                compat_ext=$(_build_detect_install_ext "$tool" "$repo_path")
            fi
            if [[ -n "$compat_ext" && "$format" != "binary" ]]; then
                if [[ "$compat_ext" == "exe" ]]; then
                    format="none"
                elif [[ "$format" != "$compat_ext" ]]; then
                    format="$compat_ext"
                fi
            fi

            local naming_ext="$format"
            if [[ "$format" == "binary" ]]; then
                naming_ext=""
                [[ "$os" == "windows" ]] && naming_ext="exe"
            fi

            names_json=$(artifact_naming_generate_dual_for_tool "$tool" "$version" "$os" "$arch" \
                "$naming_ext" "$repo_path" release "$primary_triple") || {
                collect_failed=true
                return 1
            }
            versioned_name=$(echo "$names_json" | jq -r '.versioned // empty' 2>/dev/null)
            compat_name=$(echo "$names_json" | jq -r '.compat // empty' 2>/dev/null)

            if [[ "$format" != "none" ]]; then
                _build_emit_variant_aliases "$tool" "$version" "$target" "$format" "$naming_ext" \
                    "$output_dir" "$repo_path" "$versioned_name" "$result_json" "$compat_name"
            fi

            # The primary's actual container determines whether it needs
            # repacking. A later musl row for this platform cannot make a
            # GNU xz archive look like an already-built gzip archive.
            local existing_path="" existing_format=""
            existing_path=$(_build_find_manifest_artifact "$manifest_file" "$output_dir" "$target" "$format" "$primary_triple" 2>/dev/null || true)
            if [[ -z "$existing_path" && ! -f "$manifest_file" && -n "$versioned_name" && -f "$output_dir/$versioned_name" ]]; then
                existing_path="$output_dir/$versioned_name"
            fi
            if [[ -n "$existing_path" ]]; then
                existing_format=$(packaging_format_for_name "${existing_path##*/}")
            fi
            if [[ -n "$existing_format" && "$existing_format" == "$format" ]]; then

                if [[ -n "$existing_path" && "$format" != "binary" && -n "$repo_path" && \
                      -n "$(_build_get_include_files "$tool" 2>/dev/null)" ]]; then
                    # A matching format says nothing about the members: the
                    # lane may have archived the executable alone (GH#29).
                    # Verify configured include_files before skipping.
                    _build_package_archive_for_target "$tool" "$version" "$target" \
                        "$output_dir" "$repo_path" "$binary_name" "$existing_path" "$primary_triple" || return 1
                    if [[ -n "$versioned_name" && -f "$output_dir/$versioned_name" ]]; then
                        existing_path="$output_dir/$versioned_name"
                    fi
                fi

                if [[ -n "$existing_path" ]]; then
                    if [[ "$format" == "binary" ]]; then
                        _build_emit_binary_alias "$existing_path" "$compat_name" "$output_dir" "$target" "$primary_triple" || collect_failed=true
                    elif [[ -n "$compat_name" ]]; then
                        if _build_is_archive_ext "$compat_name"; then
                            _build_emit_compat_alias "$existing_path" "$compat_name" "$output_dir" "$target" "$format" "$primary_triple" || collect_failed=true
                        else
                            local binary_path
                            binary_path=$(_build_find_binary "$output_dir" "$binary_name" "$os" 2>/dev/null || echo "")
                            if [[ -n "$binary_path" ]]; then
                                _build_emit_binary_alias "$binary_path" "$compat_name" "$output_dir" "$target" "$primary_triple" || collect_failed=true
                            else
                                log_warn "Binary not found for $tool $target to create compat alias"
                            fi
                        fi
                    fi
                else
                    log_warn "No existing artifact found for $tool $target to create compat alias"
                fi

                log_info "Archive already produced for $tool $target ($format); skipping packaging"
                continue
            fi

            local binary_override=""
            if [[ -n "$existing_path" ]]; then
                binary_override="$existing_path"
            elif [[ -n "$primary_triple" ]]; then
                binary_override=$(_build_find_manifest_artifact "$manifest_file" "$output_dir" "$target" "$format" "$primary_triple" 2>/dev/null || true)
            else
                binary_override=$(echo "$result_json" | jq -r --arg t "$target" '.targets[]? | select(.platform == $t) | .artifact_path // empty' 2>/dev/null | head -1)
            fi
            if [[ -n "$binary_override" && "$binary_override" == *","* ]]; then
                binary_override="${binary_override%%,*}"
            fi
            if [[ -z "$binary_override" || ! -f "$binary_override" ]]; then
                binary_override=""
            fi
            _build_package_archive_for_target "$tool" "$version" "$target" "$output_dir" "$repo_path" "$binary_name" "$binary_override" "$primary_triple" || return 1
        done
    }

    if [[ $success -gt 0 ]]; then
        log_info "Collecting build artifacts into $output_dir..."
        local target_result target_triple native_result array_count
        while IFS= read -r target_result; do
            local target method dir file
            target=$(jq -r '.platform // empty' <<< "$target_result")
            method=$(jq -r '.method // empty' <<< "$target_result")
            dir=$(jq -r '.artifact_dir // empty' <<< "$target_result")
            target_triple=""; native_result=false
            if [[ "$method" == native ]]; then
                native_result=true
                if ! target_triple=$(_act_native_result_target_triple "$tool_name" "$target_result"); then
                    collect_failed=true
                    continue
                fi
            fi
            if ! array_count=$(jq -er '(.artifact_paths // []) |
                if type == "array" and all(.[]; type == "string" and length > 0)
                then length else error("invalid artifact_paths") end' <<< "$target_result"); then
                collect_failed=true
                continue
            fi
            # Arrays preserve exact paths, including commas. Only legacy
            # scalar receipts are split; additional payloads remain explicit.
            while IFS= read -r -d '' file; do
                [[ -n "$file" ]] || continue
                _build_collect_artifact_file "$file" "$target" "$target_triple" "$native_result"
            done < <(jq -j --argjson count "$array_count" '
                ((if $count > 0 then .artifact_paths[] else
                    (.artifact_path // "" | split(",")[]) end),
                 ((.additional_artifacts // [])[]? | .path // "")) | ., "\u0000"
            ' <<< "$target_result")

            [[ -z "$dir" || ! -d "$dir" ]] && continue
            while IFS= read -r -d '' file; do
                if act_artifact_zip_is_wrapper "$method" "$file"; then
                    _build_collect_artifact_zip "$file" "$tag"
                else
                    _build_collect_artifact_file "$file" "$target" "$target_triple" "$native_result"
                fi
            done < <(find "$dir" -type f -print0 2>/dev/null)
        done < <(jq -c '.targets[]?' <<< "$result")

        if $collect_failed; then
            log_error "Artifact collection encountered errors"
            if $build_release_contract_enabled; then
                return 6
            fi
        else
            log_info "Collected $collected_count artifact(s) into $output_dir"
        fi
    fi

    # Generate manifest
    local manifest_file="$output_dir/${tool_name}-${tag}-manifest.json"
    local manifest_failed=false orchestration_status
    local all_targets_succeeded=false
    orchestration_status=$(jq -r '.status // "unknown"' <<< "$result" 2>/dev/null || true)
    if [[ $orchestrator_exit -eq 0 && "$orchestration_status" == "success" &&
          $total -gt 0 && $failed -eq 0 && $success -eq $total ]]; then
        all_targets_succeeded=true
    fi
    if $all_targets_succeeded; then
        # Generate manifest from orchestration result JSON
        if $build_release_contract_enabled; then
            local post_build_source_status
            post_build_source_status=$(git -C "$local_path" status --porcelain --untracked-files=all 2>/dev/null) || {
                log_error "Could not re-inspect strict release source tree after build"
                return 6
            }
            if [[ -n "$post_build_source_status" ]]; then
                log_error "Strict release build changed tracked or untracked source; refusing tag-bound manifest"
                return 6
            fi
            if ! act_generate_manifest "$result" "$manifest_file"; then
                log_error "Strict release manifest generation failed"
                return 6
            fi
            while IFS=$'\t' read -r manifest_name manifest_sha manifest_size; do
                local collected_path="$output_dir/$manifest_name"
                local collected_sha collected_size
                if [[ ! -f "$collected_path" || -L "$collected_path" ]]; then
                    log_error "Strict manifest primary was not collected: $manifest_name"
                    return 6
                fi
                collected_sha=$(_build_sha256 "$collected_path" 2>/dev/null || true)
                collected_size=$(_build_file_size "$collected_path")
                if [[ "$collected_sha" != "$manifest_sha" || "$collected_size" != "$manifest_size" ]]; then
                    log_error "Collected primary does not match strict manifest: $manifest_name"
                    return 6
                fi
            done < <(jq -r '.artifacts[] | [.name, .sha256, (.size_bytes | tostring)] | @tsv' "$manifest_file")
        else
            if ! act_generate_manifest "$result" "$manifest_file"; then
                log_error "Build manifest generation failed"
                manifest_failed=true
            fi
        fi
    fi

    if $all_targets_succeeded && ! $build_release_contract_enabled && \
       [[ -f "$manifest_file" && ${#artifact_rename_pairs[@]} -gt 0 ]]; then
        local renames_json updated_manifest
        renames_json=$(printf '%s\n' "${artifact_rename_pairs[@]}" | jq -Rn '
            reduce inputs as $line ({}; 
                if ($line | length) == 0 then . else
                    ($line | split("\t") | { (.[0]): .[1] }) as $pair
                    | . + $pair
                end
            )
        ')
        updated_manifest=$(jq --argjson renames "$renames_json" '
            .artifacts = (.artifacts // []) |
            .artifacts |= map(
                . as $a |
                ($renames[($a.target // "") + "||" + ($a.target_triple // "") + "||" + ($a.name // "")] //
                 $renames[($a.target // "") + "||||" + ($a.name // "")] // "") as $new |
                if $new != "" then .name = $new else . end
            )
        ' "$manifest_file" 2>/dev/null)
        if [[ -n "$updated_manifest" ]]; then
            printf '%s\n' "$updated_manifest" > "$manifest_file"
            log_info "Updated manifest for ${#artifact_rename_pairs[@]} renamed artifact(s)"
        else
            log_warn "Failed to update manifest for renamed artifacts"
        fi
    fi

    if $all_targets_succeeded && ! $build_release_contract_enabled; then
        _build_package_archives "$tool_name" "$version" "$output_dir" "$result" "$target_list" "$manifest_file"
    fi

    if $all_targets_succeeded && ! $build_release_contract_enabled && \
       [[ -f "$manifest_file" && ${#extra_manifest_entries[@]} -gt 0 ]]; then
        # Packaging can rebuild a collected archive in place (GH#29), so the
        # last packaged row for a name describes its final bytes: refresh the
        # digest and size of a row already in the manifest, append the rest.
        local extra_json merge_result merged
        extra_json=$(printf '%s\n' "${extra_manifest_entries[@]}" | jq -s '.')
        if merge_result=$(jq -c --argjson extra "$extra_json" '
            (reduce $extra[] as $e ({}; .[$e.name] = $e)) as $latest |
            (reduce $extra[] as $e ([]; if any(.[]; . == $e.name) then . else . + [$e.name] end)) as $order |
            ((.artifacts // []) | map(.name)) as $present |
            ((.artifacts // []) | map(select($latest[.name] != null and
                ($latest[.name].sha256 != .sha256 or $latest[.name].size_bytes != .size_bytes))) | length) as $refreshed |
            ($order | map(select(. as $n | $present | any(.[]; . == $n) | not))) as $added |
            {refreshed: $refreshed, added: ($added | length), manifest: (
                .artifacts = (((.artifacts // []) | map(
                    if $latest[.name] != null
                    then . + {sha256: $latest[.name].sha256, size_bytes: $latest[.name].size_bytes}
                    else . end)) + ($added | map($latest[.])))
            )}' "$manifest_file") && \
           merged=$(jq '.manifest' <<< "$merge_result"); then
            printf '%s\n' "$merged" > "$manifest_file"
            local refreshed_count added_count
            refreshed_count=$(jq -r '.refreshed' <<< "$merge_result")
            added_count=$(jq -r '.added' <<< "$merge_result")
            [[ "$added_count" -gt 0 ]] && log_info "Added $added_count packaged artifact(s) to manifest"
            [[ "$refreshed_count" -gt 0 ]] && log_info "Refreshed $refreshed_count manifest digest(s) for archives rebuilt by packaging"
        else
            log_error "Failed to merge packaged artifacts into the build manifest"
            manifest_failed=true
        fi
    fi

    # Resolve the final command status before emitting either JSON or human
    # output. In particular, a failed completion-state write must never be
    # followed by a success envelope, and signal cancellation must retain 130.
    local final_exit=6 final_status="error"
    if [[ $orchestrator_exit -eq 130 ]]; then
        final_exit=130
    elif [[ $orchestrator_exit -ne 0 && $orchestrator_exit -ne 1 ]]; then
        final_exit="$orchestrator_exit"
    elif [[ $failed -eq 0 && $success -gt 0 && $collect_failed == false &&
            $manifest_failed == false && -f "$manifest_file" ]]; then
        if ! _act_is_uuid "$result_run_id" ||
           ! command -v build_state_update_status &>/dev/null ||
           ! build_state_update_status "$tool_name" "$version" "completed" "$result_run_id"; then
            log_error "Could not persist completed build state"
            final_exit=4
        else
            final_exit=0
            final_status="success"
        fi
    elif [[ $success -gt 0 ]]; then
        final_exit=1
        final_status="partial"
    elif [[ $orchestrator_exit =~ ^[1-9][0-9]*$ ]]; then
        final_exit="$orchestrator_exit"
    fi

    # Output
    if $JSON_MODE; then
        local build_details authoritative_manifest=""
        $all_targets_succeeded && [[ $manifest_failed == false && -f "$manifest_file" ]] && \
            authoritative_manifest="$manifest_file"
        # Per-target results (schemas/build-details.json): which target
        # failed, where and how it built. A requested target without a
        # result was not attempted.
        local target_results_json build_repo
        build_repo=$(act_get_repo "$tool_name" 2>/dev/null || true)
        [[ -z "$build_repo" || "$build_repo" == */* ]] || build_repo="Dicklesworthstone/$build_repo"
        target_results_json=$(jq -c '[.targets[]? | select(type == "object" and (.platform | type == "string")) |
            {platform, host: (.host // ""), method: (.method // "native"),
             status: (if (.status // "") | IN("success", "ok", "passed") then "success"
                      elif .status == "timeout" then "timeout" else "failed" end)}
            + (if (.artifact_path | type) == "string" then {artifact_path} else {} end)
            + (if (.artifact_paths | type) == "array" then {artifact_paths} else {} end)
            + (if (.target_triple | type) == "string" then {target_triple} else {} end)
            + (if (.task_key | type) == "string" then {task_key} else {} end)
            + (if (.stage | type) == "string" then {stage} else {} end)
            + (if (.source_sync | type) == "object" then {source_sync} else {} end)
            + (if (.log_path | type) == "string" then {log_path} else {} end)
            + (if (.error | type) == "string" then {error} else {} end)
            + (if (.duration_ms | type) == "number" then {duration_ms: (.duration_ms | floor)} else {} end)]' \
            <<< "$result" 2>/dev/null) || target_results_json='[]'
        build_details=$(jq -n \
            --arg tool "$tool_name" --arg version "$version" --arg repo "$build_repo" \
            --arg build_purpose "$build_purpose" --arg targets "$target_list" \
            --argjson results "$target_results_json" --arg run_id "$result_run_id" \
            --argjson source_sync "$(jq -c '.source_sync // null' <<< "$result")" \
            --argjson total "$total" --argjson success "$success" --argjson failed "$failed" \
            --argjson duration "$duration" --arg output_dir "$output_dir" \
            --arg manifest "$authoritative_manifest" '
            {tool: $tool, repo: $repo, version: $version, build_purpose: $build_purpose,
             publishable: ($build_purpose == "release"), run_id: $run_id,
             source_sync: $source_sync,
             targets: [($targets | split(" ") | map(select(length > 0)))[] as $platform |
                 ($results | map(select(.platform == $platform))) as $matches |
                 if ($matches | length) > 0 then $matches[]
                 else {platform: $platform, host: "", method: "native", status: "skipped"} end],
             total: $total, success: $success, failed: $failed,
             duration_seconds: $duration, total_build_time_ms: ($duration * 1000),
             output_dir: $output_dir, manifest_path: $manifest}') || return 4
        json_envelope "build" "$final_status" "$final_exit" "$build_details"
    else
        echo ""
        log_info "=== Build Summary ==="
        log_info "Purpose:  $build_purpose"
        [[ "$build_purpose" == "diagnostic-native" ]] && log_warn "Diagnostic artifacts cannot be published or reused by a release build"
        log_info "Tool:     $tool_name"
        log_info "Version:  $version"
        log_info "Duration: ${duration}s"
        echo ""
        log_info "Results:"
        log_info "  Total:    $total"
        if [[ $success -gt 0 ]]; then
            log_ok "  Success:  $success"
        else
            log_info "  Success:  $success"
        fi
        if [[ $failed -gt 0 ]]; then
            log_error "  Failed:   $failed"
        else
            log_info "  Failed:   $failed"
        fi
        echo ""
        if $all_targets_succeeded && [[ $manifest_failed == false && -f "$manifest_file" ]]; then
            log_ok "Manifest: $manifest_file"
        elif [[ $success -gt 0 ]]; then
            log_warn "Manifest withheld until every requested target succeeds"
        fi
        log_info "Artifacts: $output_dir"
    fi

    return "$final_exit"
}

# Quality gates command - run pre-release checks
cmd_quality() {
    local tool_name=""
    # Honor both supported spellings:
    #   dsr --dry-run quality ...
    #   dsr quality ... --dry-run
    # The global parser consumes the former before dispatch, so resetting this
    # to false here would execute checks that the operator only asked to plan.
    local dry_run="$DRY_RUN"
    local skip_checks=false
    local work_dir=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tool|-t|--repo)
                tool_name="$2"
                shift 2
                ;;
            --dry-run|-n)
                dry_run=true
                shift
                ;;
            --skip-checks)
                skip_checks=true
                shift
                ;;
            --work-dir|-w)
                work_dir="$2"
                shift 2
                ;;
            --help|-h)
                cat << 'EOF'
dsr quality - Run pre-release quality checks

USAGE:
    dsr quality --tool <name> [options]

OPTIONS:
    -t, --tool <name>    Tool to check (required)
    -n, --dry-run        Show checks without running them
    --skip-checks        Skip ordinary checks; required checks still run
    -w, --work-dir       Directory to run checks in

DESCRIPTION:
    Runs quality gate checks configured in repos.yaml for the specified tool.
    Checks are commands like 'cargo test', 'go vet', etc.

CONFIGURATION:
    Configure checks in ~/.config/dsr/repos.yaml:

    tools:
      ntm:
        checks:
          - "cargo clippy --all-targets -- -D warnings"
          - "cargo test"
          - "cargo fmt --check"

EXAMPLES:
    dsr quality --tool ntm             Run checks for ntm
    dsr quality --tool ntm --dry-run   Show what would run
    dsr quality --tool bv -w /path/to/bv

EXIT CODES:
    0  - All checks passed
    1  - One or more checks failed
    2  - Dry run: checks planned, none executed (never a pass)
    4  - Invalid arguments, or no checks configured
EOF
                return 0
                ;;
            *)
                if [[ -z "$tool_name" ]]; then
                    tool_name="$1"
                else
                    log_error "Unknown argument: $1"
                    return 4
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$tool_name" ]]; then
        log_error "Tool name required. Use --tool <name> or provide as first argument."
        log_info "Run 'dsr quality --help' for usage"
        return 4
    fi

    # Build qg_run_checks arguments
    local qg_args=("$tool_name")
    $dry_run && qg_args+=("--dry-run")
    $skip_checks && qg_args+=("--skip-checks")
    [[ -n "$work_dir" ]] && qg_args+=("--work-dir" "$work_dir")

    # Run quality checks
    local result exit_code=0
    result=$(qg_run_checks "${qg_args[@]}") || exit_code=$?

    # Output — the rc contract distinguishes planned and config-error
    # states from real failures (bead oxmp): a dry run is never a pass
    # AND never a spurious failure; a missing/zero-check config is a
    # configuration failure, fail-closed.
    if $JSON_MODE; then
        local status
        case "$exit_code" in
            0) status="success" ;;
            2) status="planned" ;;
            4) status="config-error" ;;
            *) status="failure" ;;
        esac
        json_envelope "quality" "$status" "$exit_code" "$result"
    fi

    return $exit_code
}

# ============================================================================
# RELEASE SUBCOMMAND
# ============================================================================

_dispatch_is_true() {
    case "${1:-}" in
        true|TRUE|1|yes|YES|y|Y) return 0 ;;
        *) return 1 ;;
    esac
}

_dispatch_join_lines() {
    # Join newline-separated values into comma-separated string
    local input="$1"
    echo "$input" | tr '\n' ',' | sed 's/,$//'
}

_dispatch_load_config() {
    local tool_name="$1"

    local enabled=""
    local event_type=""
    local repos_csv=""

    # Env overrides (highest precedence)
    [[ -n "${DSR_DISPATCH_ENABLED:-}" ]] && enabled="$DSR_DISPATCH_ENABLED"
    [[ -n "${DSR_DISPATCH_EVENT:-}" ]] && event_type="$DSR_DISPATCH_EVENT"
    [[ -n "${DSR_DISPATCH_REPOS:-}" ]] && repos_csv="$DSR_DISPATCH_REPOS"

    # Config file overrides (requires yq)
    if command -v yq &>/dev/null; then
        local config_dir="${DSR_CONFIG_DIR:-$HOME/.config/dsr}"
        local tool_config="$config_dir/repos.d/${tool_name}.yaml"
        local cfg_enabled cfg_event cfg_repos

        if [[ -f "$tool_config" ]]; then
            cfg_enabled=$(yq -r '.dispatch.enabled // ""' "$tool_config" 2>/dev/null || echo "")
            cfg_event=$(yq -r '.dispatch.event_type // ""' "$tool_config" 2>/dev/null || echo "")
            cfg_repos=$(_dispatch_join_lines "$(yq -r '.dispatch.repos[]?' "$tool_config" 2>/dev/null || true)")

            [[ -z "$enabled" && -n "$cfg_enabled" ]] && enabled="$cfg_enabled"
            [[ -z "$event_type" && -n "$cfg_event" ]] && event_type="$cfg_event"
            [[ -z "$repos_csv" && -n "$cfg_repos" ]] && repos_csv="$cfg_repos"
        fi

        if [[ -f "${DSR_CONFIG_FILE:-$config_dir/config.yaml}" ]]; then
            cfg_enabled=$(yq -r '.dispatch.enabled // ""' "${DSR_CONFIG_FILE:-$config_dir/config.yaml}" 2>/dev/null || echo "")
            cfg_event=$(yq -r '.dispatch.event_type // ""' "${DSR_CONFIG_FILE:-$config_dir/config.yaml}" 2>/dev/null || echo "")
            cfg_repos=$(_dispatch_join_lines "$(yq -r '.dispatch.repos[]?' "${DSR_CONFIG_FILE:-$config_dir/config.yaml}" 2>/dev/null || true)")

            [[ -z "$enabled" && -n "$cfg_enabled" ]] && enabled="$cfg_enabled"
            [[ -z "$event_type" && -n "$cfg_event" ]] && event_type="$cfg_event"
            [[ -z "$repos_csv" && -n "$cfg_repos" ]] && repos_csv="$cfg_repos"
        fi
    fi

    # Defaults
    [[ -z "$event_type" ]] && event_type="dsr_release"
    if [[ -z "$enabled" && -n "$repos_csv" ]]; then
        enabled="true"
    fi

    echo "$enabled|$event_type|$repos_csv"
}

_dispatch_send_all() {
    local tool_name="$1"
    local version="$2"
    local tag="$3"
    local source_repo="$4"
    local git_sha="$5"
    local release_url="$6"
    local event_type="$7"
    local repos_csv="$8"
    local run_id="$9"

    if [[ -z "$repos_csv" ]]; then
        echo "[]"
        return 2
    fi

    if ! command -v jq &>/dev/null; then
        log_warn "jq not available; skipping repository dispatch"
        echo "[]"
        return 2
    fi

    local payload
    payload=$(jq -nc \
        --arg tool "$tool_name" \
        --arg version "$version" \
        --arg tag "$tag" \
        --arg repo "$source_repo" \
        --arg sha "$git_sha" \
        --arg run_id "$run_id" \
        --arg release_url "$release_url" \
        '{tool: $tool, version: $version, tag: $tag, repo: $repo, sha: $sha, run_id: $run_id, release_url: $release_url}')

    local results=()
    local any_failed=0
    local total=0
    local target
    IFS=',' read -ra targets <<< "$repos_csv"
    for target in "${targets[@]}"; do
        target="$(echo "$target" | xargs)"
        [[ -z "$target" ]] && continue

        if [[ "$target" != */* ]]; then
            target="Dicklesworthstone/$target"
        fi

        log_info "Dispatching $event_type to $target" "\"tool\":\"$tool_name\",\"version\":\"$version\",\"run_id\":\"$run_id\""

        local dispatch_status="success"
        local dispatch_error=""

        if command -v build_retry_with_backoff &>/dev/null; then
            if ! build_retry_with_backoff "${DSR_DISPATCH_RETRIES:-3}" gh_repository_dispatch "$target" "$event_type" "$payload"; then
                dispatch_status="failed"
                dispatch_error="dispatch failed"
            fi
        else
            if ! gh_repository_dispatch "$target" "$event_type" "$payload"; then
                dispatch_status="failed"
                dispatch_error="dispatch failed"
            fi
        fi

        if [[ "$dispatch_status" == "success" ]]; then
            log_ok "Dispatch sent to $target"
        else
            log_warn "Dispatch failed for $target"
        fi

        [[ "$dispatch_status" == "failed" ]] && any_failed=1
        total=$((total + 1))

        results+=("$(jq -nc \
            --arg repo "$target" \
            --arg status "$dispatch_status" \
            --arg error "$dispatch_error" \
            '{repo: $repo, status: $status, error: (if $error == "" then null else $error end)}')")
    done

    if [[ ${#results[@]} -gt 0 ]]; then
        printf '%s\n' "${results[@]}" | jq -s '.'
    else
        echo "[]"
    fi

    if [[ $total -eq 0 ]]; then
        return 2
    fi
    if [[ $any_failed -eq 1 ]]; then
        return 1
    fi
    return 0
}

_release_file_size() {
    local file="$1"
    local size=""

    size=$(stat -c %s "$file" 2>/dev/null || stat -f %z "$file" 2>/dev/null) || return 1
    [[ "$size" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$size"
}

_release_sha256() {
    local file="$1"
    local sha=""

    if command -v sha256sum &>/dev/null; then
        sha=$(sha256sum "$file" 2>/dev/null | awk '{print $1}') || return 1
    elif command -v shasum &>/dev/null; then
        sha=$(shasum -a 256 "$file" 2>/dev/null | awk '{print $1}') || return 1
    else
        log_error "No SHA256 implementation available (need sha256sum or shasum)"
        return 3
    fi

    [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$sha"
}

_release_sha256_line() {
    local line="$1"
    local sha=""

    if command -v sha256sum &>/dev/null; then
        sha=$(printf '%s\n' "$line" | sha256sum 2>/dev/null | awk '{print $1}') || return 1
    elif command -v shasum &>/dev/null; then
        sha=$(printf '%s\n' "$line" | shasum -a 256 2>/dev/null | awk '{print $1}') || return 1
    else
        log_error "No SHA256 implementation available (need sha256sum or shasum)"
        return 3
    fi

    [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$sha"
}

# Revalidate a frozen strict-release asset immediately before mutation. The
# preflight proves the same facts earlier, but upload repair must not trust a
# path whose type or bytes may have changed since that snapshot.
_release_contract_verify_local_asset() {
    local file_path="$1"
    local expected_name="$2"
    local expected_size="$3"
    local expected_sha="$4"
    local actual_size actual_sha

    if [[ -z "$file_path" || ! -f "$file_path" || -L "$file_path" ]]; then
        log_error "Strict repair asset must be a regular non-symlink file: $file_path"
        return 1
    fi
    if [[ "$(basename "$file_path")" != "$expected_name" ]]; then
        log_error "Strict repair asset path no longer matches its contracted name: $expected_name"
        return 1
    fi

    actual_size=$(_release_file_size "$file_path") || {
        log_error "Could not determine strict repair asset size: $file_path"
        return 1
    }
    if [[ "$actual_size" != "$expected_size" ]]; then
        log_error "Strict repair asset size changed after preflight: $expected_name"
        return 1
    fi

    actual_sha=$(_release_sha256 "$file_path") || {
        log_error "Could not hash strict repair asset: $file_path"
        return 1
    }
    if [[ "$actual_sha" != "$expected_sha" ]]; then
        log_error "Strict repair asset digest changed after preflight: $expected_name"
        return 1
    fi
    return 0
}

# This guard also applies when a tool's strict contract has since been removed.
# A missing diagnostic manifest must never fall through to upload-all behavior.
_release_require_publishable_artifacts() {
    local artifacts_dir="$1" manifest_file="$2" strict="${3:-false}"
    local state_dir="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}"
    local physical_dir diagnostic_root
    physical_dir=$(cd "$artifacts_dir" 2>/dev/null && pwd -P) || return 4
    diagnostic_root=$(cd "$state_dir/diagnostics" 2>/dev/null && pwd -P) || diagnostic_root=""
    if [[ -n "$diagnostic_root" && ( "$physical_dir" == "$diagnostic_root" ||
          "$physical_dir" == "$diagnostic_root/"* ) ]]; then
        log_error "Native diagnostic outputs are not publishable release artifacts"
        return 4
    fi
    local marker="$artifacts_dir/.dsr-build-purpose.json"
    if [[ -e "$marker" || -L "$marker" ]]; then
        if [[ ! -f "$marker" || -L "$marker" ]] || \
           ! jq -es 'length == 1 and (.[0] | type == "object" and
                .build_purpose == "release" and .publishable == true)' "$marker" >/dev/null; then
            log_error "Artifact directory carries non-publishable or invalid build purpose"
            return 4
        fi
    fi
    if [[ -e "$manifest_file" || -L "$manifest_file" ]]; then
        if [[ ! -f "$manifest_file" || -L "$manifest_file" ]] || \
           ! jq -es --argjson strict "$strict" '
                def release_purpose:
                    if has("build_purpose") or has("publishable") or $strict
                    then .build_purpose == "release" and .publishable == true
                    else true end;
                length == 1 and (.[0] | type == "object" and
                    release_purpose and all(.artifacts[]?; release_purpose))
            ' "$manifest_file" >/dev/null; then
            log_error "Manifest purpose is missing, mixed, or not publishable as a release"
            return 4
        fi
    elif [[ "$strict" == "true" ]]; then
        log_error "Strict release requires an explicitly release-purpose manifest"
        return 4
    fi
}

# Validate an opt-in release contract and return the closed upload plan as JSON.
# No GitHub mutation is allowed before this succeeds. sidecar_mode is create,
# verify, or plan. Creation uses noclobber; an existing sidecar is always
# validated and never overwritten.
_release_contract_preflight() {
    local tool_name="$1"
    local tag="$2"
    local repo="$3"
    local local_path="$4"
    local artifacts_dir="$5"
    local manifest_file="$6"
    local contract_json="$7"
    local sidecar_mode="${8:-verify}"
    local GIT_NO_REPLACE_OBJECTS=1
    export GIT_NO_REPLACE_OBJECTS

    _release_require_publishable_artifacts "$artifacts_dir" "$manifest_file" true || return 4

    case "$sidecar_mode" in
        create|verify|plan) ;;
        *)
            log_error "Invalid strict checksum sidecar mode: $sidecar_mode"
            return 4
            ;;
    esac

    if ! jq -e '
        def safe_name:
            type == "string" and
            length > 0 and
            test("^[A-Za-z0-9][A-Za-z0-9._+-]*$") and
            (contains("/") | not) and
            (contains("..") | not);
        def safe_path_component:
            type == "string" and
            length > 0 and
            test("^[A-Za-z0-9][A-Za-z0-9._+-]*$") and
            . != "." and
            . != "..";
        def safe_project_path:
            type == "string" and
            length > 0 and
            (startswith("/") | not) and
            (contains("\\") | not) and
            (split("/") | all(.[]; safe_path_component));
        (.exact_primary_assets | [.[]]) as $primaries |
        (if has("exact_additional_assets")
         then .exact_additional_assets
         else []
         end) as $additional |
        (if has("minisign_public_key_file")
         then ($primaries | map(. + ".minisig"))
         else []
         end) as $signatures |
        (.build_manifest_assets // []) as $manifest_names |
        has("build_manifest_assets") as $has_manifest_names |
        ($primaries + ($primaries | map(. + ".sha256")) + $signatures + $additional +
            (if ($manifest_names | type) == "array" then $manifest_names else [] end)) as $all_assets |
        type == "object" and
        has("checksum_sidecar") and
        has("exact_primary_assets") and
        (((keys) - [
            "build_manifest_assets",
            "checksum_sidecar",
            "exact_additional_assets",
            "exact_primary_assets",
            "github_tag_ruleset",
            "minisign_public_key_file"
        ]) | length == 0) and
        .checksum_sidecar == "sha256" and
        (.exact_primary_assets | type == "object") and
        (.exact_primary_assets | length > 0) and
        ($additional | type == "array") and
        ([$additional[] | safe_name] | all) and
        ($manifest_names | type == "array" and length <= 2 and
            (($has_manifest_names | not) or length >= 1)) and
        ([$manifest_names[] | safe_name and
            (ascii_downcase | endswith(".json")) and
            (ascii_downcase | test("\\.(sha256|minisig)$") | not) and
            (. as $name | ["SHA256SUMS", "SHA256SUMS.txt", "checksums.txt"] |
                index($name) | not)] | all) and
        ((has("minisign_public_key_file") | not) or
         (.minisign_public_key_file | safe_project_path)) and
        ((has("github_tag_ruleset") | not) or
         ((.github_tag_ruleset | type) == "object" and
          (.github_tag_ruleset | keys) == ["repository_id", "ruleset_id"] and
          (.github_tag_ruleset.repository_id | type) == "number" and
          (.github_tag_ruleset.repository_id | floor) ==
            .github_tag_ruleset.repository_id and
          .github_tag_ruleset.repository_id > 0 and
          (.github_tag_ruleset.ruleset_id | type) == "number" and
          (.github_tag_ruleset.ruleset_id | floor) ==
            .github_tag_ruleset.ruleset_id and
          .github_tag_ruleset.ruleset_id > 0)) and
        (($all_assets | map(ascii_downcase) | unique | length) == ($all_assets | length))
    ' <<< "$contract_json" >/dev/null 2>&1; then
        log_error "Invalid release contract for $tool_name"
        return 4
    fi

    if [[ -z "$local_path" || ! -d "$local_path" ]] || ! git -C "$local_path" rev-parse --git-dir >/dev/null 2>&1; then
        log_error "Strict release contract requires a local git repository for $tool_name"
        return 4
    fi
    if [[ ! -f "$manifest_file" || -L "$manifest_file" ]]; then
        log_error "Strict release contract requires a regular non-symlink manifest: $manifest_file"
        return 4
    fi
    if ! jq -e . "$manifest_file" >/dev/null 2>&1; then
        log_error "Build manifest is not valid JSON: $manifest_file"
        return 4
    fi
    local manifest_sha_before manifest_sha_after
    manifest_sha_before=$(_release_sha256 "$manifest_file") || {
        log_error "Could not hash strict build manifest: $manifest_file"
        return 4
    }

    local expected_count base_additional_json base_additional_count expected_manifest_count
    expected_count=$(jq -r '.exact_primary_assets | length' <<< "$contract_json")
    base_additional_json=$(jq -c '
        [(.exact_additional_assets // [])[] |
         select((endswith(".sha256") or endswith(".minisig") or
                 . == "SHA256SUMS" or . == "SHA256SUMS.txt" or . == "checksums.txt") | not)] | sort
    ' <<< "$contract_json") || return 4
    base_additional_count=$(jq -r 'length' <<< "$base_additional_json") || return 4
    expected_manifest_count=$((expected_count + base_additional_count))
    local expected_dependencies_json='[]'
    if ! declare -F config_get_release_source_dependencies_json &>/dev/null; then
        log_error "Strict release dependency-pin helper is unavailable"
        return 4
    fi
    expected_dependencies_json=$(config_get_release_source_dependencies_json "$tool_name") || {
        log_error "Could not resolve strict release source dependency pins"
        return 4
    }
    if ! jq -e \
        --arg tool "$tool_name" \
        --arg tag "$tag" \
        --argjson expected_count "$expected_count" \
        --argjson expected_manifest_count "$expected_manifest_count" \
        --argjson base_additional "$base_additional_json" \
        --argjson expected_dependencies "$expected_dependencies_json" \
        --argjson contract "$contract_json" '
        .tool == $tool and
        .version == $tag and
        (.source | type == "object") and
        .source.git_ref == $tag and
        (.source.git_sha | type == "string" and test("^[0-9a-f]{40}$")) and
        .source.dependencies == $expected_dependencies and
        .status == "success" and
        (.summary | type == "object") and
        .summary.total == $expected_count and
        .summary.success == $expected_count and
        .summary.failed == 0 and
        (.artifacts | type == "array") and
        (.artifacts | length == $expected_manifest_count) and
        ([.artifacts[].name] | unique | length) == $expected_manifest_count and
        ([.artifacts[] | select(.target != "additional") |
          {key: .target, value: .name}] | from_entries) ==
            $contract.exact_primary_assets and
        ([.artifacts[] | select(.target == "additional") | .name] | sort) ==
            $base_additional and
        all(.artifacts[];
            (.target | type == "string") and
            (.name | type == "string") and
            (.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
            (.size_bytes | type == "number" and floor == . and . > 0)
        )
    ' "$manifest_file" >/dev/null 2>&1; then
        log_error "Build manifest does not satisfy the exact release contract"
        return 4
    fi

    local -a primary_targets=()
    local -a primary_names=()
    local -a primary_paths=()
    local -a primary_shas=()
    local -a primary_sizes=()
    local target name manifest_sha manifest_size file_path actual_sha actual_size

    while IFS=$'\t' read -r target name; do
        [[ -n "$target" && -n "$name" ]] || {
            log_error "Release contract contains an empty target or primary asset"
            return 4
        }

        file_path="$artifacts_dir/$name"
        if [[ ! -f "$file_path" || -L "$file_path" ]]; then
            log_error "Primary release asset must be a regular non-symlink file: $file_path"
            return 4
        fi

        manifest_sha=$(jq -r --arg target "$target" --arg name "$name" \
            '.artifacts[] | select(.target == $target and .name == $name) | .sha256' "$manifest_file")
        manifest_size=$(jq -r --arg target "$target" --arg name "$name" \
            '.artifacts[] | select(.target == $target and .name == $name) | .size_bytes' "$manifest_file")
        actual_sha=$(_release_sha256 "$file_path") || {
            log_error "Could not compute SHA256 for primary asset: $file_path"
            return 4
        }
        actual_size=$(_release_file_size "$file_path") || {
            log_error "Could not determine size for primary asset: $file_path"
            return 4
        }

        if [[ "$actual_sha" != "$manifest_sha" || "$actual_size" != "$manifest_size" ]]; then
            log_error "Primary asset does not match manifest hash/size: $name"
            return 4
        fi

        primary_targets+=("$target")
        primary_names+=("$name")
        primary_paths+=("$file_path")
        primary_shas+=("$actual_sha")
        primary_sizes+=("$actual_size")
    done < <(jq -r '.exact_primary_assets | to_entries | sort_by(.key)[] | [.key, .value] | @tsv' <<< "$contract_json")

    if [[ ${#primary_names[@]} -ne $expected_count ]]; then
        log_error "Release contract target count changed during preflight"
        return 4
    fi

    if ! git_ops_tag_exists "$local_path" "$tag"; then
        log_error "Tag $tag does not exist in $local_path"
        return 4
    fi

    local head_sha local_tag_sha remote_tag_sha manifest_git_sha
    head_sha=$(git -C "$local_path" rev-parse --verify HEAD 2>/dev/null) || {
        log_error "Could not resolve HEAD in $local_path"
        return 4
    }
    local_tag_sha=$(git_ops_tag_sha "$local_path" "$tag" 2>/dev/null) || {
        log_error "Could not dereference local tag $tag"
        return 4
    }
    remote_tag_sha=$(gh_resolve_tag_sha "$repo" "$tag" 2>/dev/null) || {
        log_error "Could not dereference GitHub tag $tag in $repo"
        return 4
    }
    manifest_git_sha=$(jq -r '.source.git_sha' "$manifest_file")

    if [[ ! "$head_sha" =~ ^[0-9a-f]{40}$ || ! "$local_tag_sha" =~ ^[0-9a-f]{40}$ || ! "$remote_tag_sha" =~ ^[0-9a-f]{40}$ ]]; then
        log_error "Release tag identity must resolve to 40-hex commit SHAs"
        return 4
    fi
    if [[ "$head_sha" != "$local_tag_sha" ]] || [[ "$head_sha" != "$remote_tag_sha" ]] || \
        [[ "$head_sha" != "$manifest_git_sha" ]]; then
        log_error "Release identity mismatch: HEAD, local tag, GitHub tag, and manifest git_sha must match"
        return 4
    fi

    local tag_ruleset_receipt_json="null"
    if jq -e 'has("github_tag_ruleset")' <<< "$contract_json" >/dev/null 2>&1; then
        local tag_ruleset_repository_id tag_ruleset_id
        local tag_ruleset_policy_json tag_ruleset_policy_sha256
        tag_ruleset_repository_id=$(jq -r \
            '.github_tag_ruleset.repository_id' <<< "$contract_json") || return 4
        tag_ruleset_id=$(jq -r \
            '.github_tag_ruleset.ruleset_id' <<< "$contract_json") || return 4
        tag_ruleset_policy_json=$(gh_get_immutable_tag_ruleset_receipt \
            "$repo" "$tag_ruleset_repository_id" "$tag_ruleset_id" "$tag") || {
            log_error "Live GitHub tag-ruleset verification failed for $repo"
            return 4
        }
        tag_ruleset_policy_sha256=$(_release_sha256_line \
            "$tag_ruleset_policy_json") || return 4
        tag_ruleset_receipt_json=$(jq -cS \
            --arg git_sha "$head_sha" \
            --arg policy_sha256 "$tag_ruleset_policy_sha256" '
            . + {
                git_sha: $git_sha,
                policy_sha256: $policy_sha256
            }
        ' <<< "$tag_ruleset_policy_json") || return 4
    fi

    local minisign_public_key_relative=""
    local minisign_public_key_file=""
    local minisign_public_key_sha256=""
    local minisign_public_key_worktree_sha256=""
    local minisign_public_key_token=""
    local minisign_public_key_json="null"
    if jq -e 'has("minisign_public_key_file")' \
        <<< "$contract_json" >/dev/null 2>&1; then
        minisign_public_key_relative=$(jq -r '.minisign_public_key_file' \
            <<< "$contract_json") || return 4
        minisign_public_key_file="$local_path/$minisign_public_key_relative"

        local key_tree_entry="" key_mode="" key_type="" key_oid="" key_path=""
        key_tree_entry=$(git -C "$local_path" ls-tree "$head_sha" -- \
            "$minisign_public_key_relative" 2>/dev/null) || {
            log_error "Could not inspect the pinned minisign public key at release HEAD"
            return 4
        }
        read -r key_mode key_type key_oid key_path <<< "$key_tree_entry"
        if [[ "$key_mode" != "100644" || "$key_type" != "blob" || \
              ! "$key_oid" =~ ^[0-9a-f]{40,64}$ || \
              "$key_path" != "$minisign_public_key_relative" ]]; then
            log_error "Pinned minisign public key must be one regular tracked file at release HEAD"
            return 4
        fi
        if [[ ! -f "$minisign_public_key_file" || -L "$minisign_public_key_file" ]]; then
            log_error "Pinned minisign public key must be a regular non-symlink worktree file"
            return 4
        fi
        local key_component="" key_component_path="$local_path"
        local -a key_components=()
        IFS='/' read -r -a key_components <<< "$minisign_public_key_relative"
        for key_component in "${key_components[@]}"; do
            key_component_path="$key_component_path/$key_component"
            if [[ -L "$key_component_path" ]]; then
                log_error "Pinned minisign public key path traverses a symlink"
                return 4
            fi
        done
        if ! git -C "$local_path" cat-file blob "$key_oid" 2>/dev/null | \
            cmp -s - "$minisign_public_key_file"; then
            log_error "Pinned minisign public key bytes differ from release HEAD"
            return 4
        fi
        if ! command -v minisign >/dev/null 2>&1; then
            log_error "minisign is required by the strict release contract"
            return 3
        fi
        if command -v sha256sum &>/dev/null; then
            minisign_public_key_sha256=$(git -C "$local_path" cat-file blob \
                "$key_oid" 2>/dev/null | sha256sum | awk '{print $1}') || return 4
        elif command -v shasum &>/dev/null; then
            minisign_public_key_sha256=$(git -C "$local_path" cat-file blob \
                "$key_oid" 2>/dev/null | shasum -a 256 | awk '{print $1}') || return 4
        else
            log_error "No SHA256 implementation available for the pinned public key"
            return 3
        fi
        if [[ ! "$minisign_public_key_sha256" =~ ^[0-9a-f]{64}$ ]]; then
            log_error "Could not hash the tag-pinned Minisign public key blob"
            return 4
        fi
        minisign_public_key_token=$(git -C "$local_path" cat-file blob \
            "$key_oid" 2>/dev/null | sed -n '2{s/\r$//;p;}') || return 4
        if [[ ! "$minisign_public_key_token" =~ ^[A-Za-z0-9+/]{40,}={0,2}$ ]]; then
            log_error "Tag-pinned file does not contain a valid Minisign public key token"
            return 4
        fi
        minisign_public_key_worktree_sha256=$(_release_sha256 \
            "$minisign_public_key_file") || return 4
        if [[ "$minisign_public_key_worktree_sha256" != \
              "$minisign_public_key_sha256" ]]; then
            log_error "Pinned Minisign public key changed during strict preflight"
            return 4
        fi
        minisign_public_key_json=$(jq -nc \
            --arg path "$minisign_public_key_relative" \
            --arg sha256 "$minisign_public_key_sha256" \
            --arg token "$minisign_public_key_token" \
            '{path: $path, sha256: $sha256, token: $token}') || return 4
    fi

    local idx sidecar sidecar_line sidecar_sha sidecar_size
    local expected_sidecar_sha expected_sidecar_size actual_sidecar_sha actual_sidecar_size
    local signature signature_sha signature_size signing_private_key
    local current_primary_sha current_primary_size
    local -a planned_assets=()
    for ((idx = 0; idx < ${#primary_names[@]}; idx++)); do
        name="${primary_names[$idx]}"
        target="${primary_targets[$idx]}"
        file_path="${primary_paths[$idx]}"
        actual_sha="${primary_shas[$idx]}"
        actual_size="${primary_sizes[$idx]}"
        sidecar="${file_path}.sha256"
        sidecar_line="$actual_sha  $name"
        expected_sidecar_size=$(printf '%s\n' "$sidecar_line" | wc -c | tr -d '[:space:]')
        expected_sidecar_sha=$(_release_sha256_line "$sidecar_line") || return 4

        if [[ "$sidecar_mode" == "create" && ! -e "$sidecar" && ! -L "$sidecar" ]]; then
            if ! (set -o noclobber; printf '%s\n' "$sidecar_line" > "$sidecar"); then
                log_error "Could not create checksum sidecar without clobbering: $sidecar"
                return 4
            fi
        fi

        if [[ "$sidecar_mode" != "plan" || -e "$sidecar" || -L "$sidecar" ]]; then
            if [[ ! -f "$sidecar" || -L "$sidecar" ]]; then
                log_error "Checksum sidecar must be a regular non-symlink file: $sidecar"
                return 4
            fi
            actual_sidecar_size=$(_release_file_size "$sidecar") || return 4
            actual_sidecar_sha=$(_release_sha256 "$sidecar") || return 4
            if [[ "$actual_sidecar_size" != "$expected_sidecar_size" || \
                  "$actual_sidecar_sha" != "$expected_sidecar_sha" ]]; then
                log_error "Checksum sidecar verification failed: $sidecar"
                return 4
            fi
        fi
        sidecar_size="$expected_sidecar_size"
        sidecar_sha="$expected_sidecar_sha"

        planned_assets+=("$(jq -nc \
            --arg target "$target" \
            --arg name "$name" \
            --arg path "$file_path" \
            --arg sha256 "$actual_sha" \
            --argjson size_bytes "$actual_size" \
            '{target: $target, name: $name, path: $path, sha256: $sha256, size_bytes: $size_bytes, kind: "primary"}')")
        planned_assets+=("$(jq -nc \
            --arg target "$target" \
            --arg name "${name}.sha256" \
            --arg path "$sidecar" \
            --arg sha256 "$sidecar_sha" \
            --arg source_sha256 "$actual_sha" \
            --argjson size_bytes "$sidecar_size" \
            '{target: $target, name: $name, path: $path, sha256: $sha256, source_sha256: $source_sha256, size_bytes: $size_bytes, kind: "checksum"}')")

        if [[ -n "$minisign_public_key_file" ]]; then
            signature="${file_path}.minisig"
            if [[ "$sidecar_mode" == "create" && ! -e "$signature" && ! -L "$signature" ]]; then
                signing_private_key="${SIGNING_PRIVATE_KEY:-${DSR_CONFIG_DIR:-$HOME/.config/dsr}/secrets/minisign.key}"
                if ! signing_sign_exact "$file_path" "$signature" \
                    "$signing_private_key" "$minisign_public_key_token" \
                    "dsr strict release $tool_name $tag $target $actual_sha" \
                    "$actual_sha"; then
                    log_error "Could not create required Minisign signature: $signature"
                    return 4
                fi
            fi

            if [[ ! -f "$signature" || -L "$signature" ]]; then
                log_error "Minisign sidecar must be a regular non-symlink file: $signature"
                return 4
            fi
            if ! signing_verify_exact "$file_path" "$signature" \
                "$minisign_public_key_token"; then
                log_error "Minisign verification failed for strict primary asset: $name"
                return 4
            fi
            current_primary_sha=$(_release_sha256 "$file_path") || return 4
            current_primary_size=$(_release_file_size "$file_path") || return 4
            if [[ "$current_primary_sha" != "$actual_sha" || \
                  "$current_primary_size" != "$actual_size" ]]; then
                log_error "Primary asset changed while its signature was prepared: $name"
                return 4
            fi
            signature_sha=$(_release_sha256 "$signature") || return 4
            signature_size=$(_release_file_size "$signature") || return 4
            planned_assets+=("$(jq -nc \
                --arg target "$target" \
                --arg name "${name}.minisig" \
                --arg path "$signature" \
                --arg sha256 "$signature_sha" \
                --arg source_sha256 "$actual_sha" \
                --arg public_key_sha256 "$minisign_public_key_sha256" \
                --arg public_key_token "$minisign_public_key_token" \
                --argjson size_bytes "$signature_size" \
                '{target: $target, name: $name, path: $path, sha256: $sha256, source_sha256: $source_sha256, public_key_sha256: $public_key_sha256, public_key_token: $public_key_token, size_bytes: $size_bytes, kind: "minisign"}')")
        fi
    done

    local additional_name additional_path additional_sha additional_size
    local additional_manifest_sha additional_manifest_size
    while IFS= read -r additional_name; do
        [[ -n "$additional_name" ]] || {
            log_error "Release contract contains an empty additional asset name"
            return 4
        }
        additional_path="$artifacts_dir/$additional_name"
        if [[ ! -f "$additional_path" || -L "$additional_path" || \
              "$(basename "$additional_path")" != "$additional_name" ]]; then
            log_error "Additional release asset must be a regular non-symlink file: $additional_path"
            return 4
        fi
        additional_sha=$(_release_sha256 "$additional_path") || {
            log_error "Could not compute SHA256 for additional asset: $additional_path"
            return 4
        }
        additional_size=$(_release_file_size "$additional_path") || {
            log_error "Could not determine size for additional asset: $additional_path"
            return 4
        }
        additional_manifest_sha=$(jq -r --arg name "$additional_name" '
            .artifacts[] | select(.target == "additional" and .name == $name) |
            .sha256
        ' "$manifest_file")
        additional_manifest_size=$(jq -r --arg name "$additional_name" '
            .artifacts[] | select(.target == "additional" and .name == $name) |
            .size_bytes
        ' "$manifest_file")
        if [[ "$additional_sha" != "$additional_manifest_sha" || \
              "$additional_size" != "$additional_manifest_size" ]]; then
            log_error "Additional asset does not match its build-manifest receipt: $additional_name"
            return 4
        fi
        planned_assets+=("$(jq -nc \
            --arg name "$additional_name" \
            --arg path "$additional_path" \
            --arg sha256 "$additional_sha" \
            --argjson size_bytes "$additional_size" \
            '{target: "additional", name: $name, path: $path, sha256: $sha256, size_bytes: $size_bytes, kind: "additional"}')")

        sidecar="${additional_path}.sha256"
        if jq -e --arg name "${additional_name}.sha256" '
            (.exact_additional_assets // []) | index($name) != null
        ' <<< "$contract_json" >/dev/null 2>&1; then
            sidecar_line="$additional_sha  $additional_name"
            expected_sidecar_size=$(printf '%s\n' "$sidecar_line" | wc -c | tr -d '[:space:]')
            expected_sidecar_sha=$(_release_sha256_line "$sidecar_line") || return 4
            if [[ "$sidecar_mode" == "create" && ! -e "$sidecar" && ! -L "$sidecar" ]]; then
                (set -o noclobber; printf '%s\n' "$sidecar_line" > "$sidecar") || return 4
            fi
            if [[ "$sidecar_mode" != "plan" || -e "$sidecar" || -L "$sidecar" ]]; then
                [[ -f "$sidecar" && ! -L "$sidecar" ]] || return 4
                actual_sidecar_size=$(_release_file_size "$sidecar") || return 4
                actual_sidecar_sha=$(_release_sha256 "$sidecar") || return 4
                [[ "$actual_sidecar_size" == "$expected_sidecar_size" &&
                   "$actual_sidecar_sha" == "$expected_sidecar_sha" ]] || return 4
            fi
            planned_assets+=("$(jq -nc \
                --arg name "${additional_name}.sha256" --arg path "$sidecar" \
                --arg sha256 "$expected_sidecar_sha" \
                --arg source_sha256 "$additional_sha" \
                --argjson size_bytes "$expected_sidecar_size" '
                {target: "additional", name: $name, path: $path,
                 sha256: $sha256, source_sha256: $source_sha256,
                 size_bytes: $size_bytes, kind: "checksum"}')")
        fi

        signature="${additional_path}.minisig"
        if jq -e --arg name "${additional_name}.minisig" '
            (.exact_additional_assets // []) | index($name) != null
        ' <<< "$contract_json" >/dev/null 2>&1; then
            [[ -n "$minisign_public_key_file" ]] || return 4
            if [[ "$sidecar_mode" == "create" && ! -e "$signature" && ! -L "$signature" ]]; then
                signing_private_key="${SIGNING_PRIVATE_KEY:-${DSR_CONFIG_DIR:-$HOME/.config/dsr}/secrets/minisign.key}"
                signing_sign_exact "$additional_path" "$signature" \
                    "$signing_private_key" "$minisign_public_key_token" \
                    "dsr strict release $tool_name $tag additional $additional_sha" \
                    "$additional_sha" || return 4
            fi
            [[ -f "$signature" && ! -L "$signature" ]] || return 4
            signing_verify_exact "$additional_path" "$signature" \
                "$minisign_public_key_token" || return 4
            [[ "$(_release_sha256 "$additional_path")" == "$additional_sha" &&
               "$(_release_file_size "$additional_path")" == "$additional_size" ]] || return 4
            signature_sha=$(_release_sha256 "$signature") || return 4
            signature_size=$(_release_file_size "$signature") || return 4
            planned_assets+=("$(jq -nc \
                --arg name "${additional_name}.minisig" --arg path "$signature" \
                --arg sha256 "$signature_sha" --arg source_sha256 "$additional_sha" \
                --arg public_key_sha256 "$minisign_public_key_sha256" \
                --arg public_key_token "$minisign_public_key_token" \
                --argjson size_bytes "$signature_size" '
                {target: "additional", name: $name, path: $path,
                 sha256: $sha256, source_sha256: $source_sha256,
                 public_key_sha256: $public_key_sha256,
                 public_key_token: $public_key_token,
                 size_bytes: $size_bytes, kind: "minisign"}')")
        fi
    done < <(jq -r '.[]' <<< "$base_additional_json")

    # A contracted aggregate checksum is derived from every manifest-bound
    # primary and base additional artifact.  It is never accepted as an
    # unrelated pre-existing file.
    # Only these exact conventional basenames are derived aggregates. Legacy
    # checksums.txt is an alias of the same sorted payload inventory (GH #28).
    local aggregate_name
    while IFS= read -r aggregate_name; do
        local aggregate_path="$artifacts_dir/$aggregate_name"
        local aggregate_lines aggregate_sha aggregate_size
        aggregate_lines=$(
            for ((idx = 0; idx < ${#primary_names[@]}; idx++)); do
                printf '%s  %s\n' "${primary_shas[$idx]}" "${primary_names[$idx]}"
            done
            while IFS= read -r additional_name; do
                [[ -n "$additional_name" ]] || continue
                additional_path="$artifacts_dir/$additional_name"
                printf '%s  %s\n' "$(_release_sha256 "$additional_path")" "$additional_name"
            done < <(jq -r '.[]' <<< "$base_additional_json")
        )
        aggregate_lines=$(printf '%s\n' "$aggregate_lines" | LC_ALL=C sort)
        aggregate_sha=$(_release_sha256_line "$aggregate_lines") || return 4
        aggregate_size=$(printf '%s\n' "$aggregate_lines" | wc -c | tr -d '[:space:]')
        if [[ "$sidecar_mode" == "create" && ! -e "$aggregate_path" && ! -L "$aggregate_path" ]]; then
            (set -o noclobber; printf '%s\n' "$aggregate_lines" > "$aggregate_path") || return 4
        fi
        if [[ "$sidecar_mode" != "plan" || -e "$aggregate_path" || -L "$aggregate_path" ]]; then
            [[ -f "$aggregate_path" && ! -L "$aggregate_path" ]] || return 4
            [[ "$(_release_sha256 "$aggregate_path")" == "$aggregate_sha" &&
               "$(_release_file_size "$aggregate_path")" == "$aggregate_size" ]] || return 4
        fi
        planned_assets+=("$(jq -nc \
            --arg name "$aggregate_name" --arg path "$aggregate_path" \
            --arg sha256 "$aggregate_sha" \
            --argjson size_bytes "$aggregate_size" '
            {target: "additional", name: $name, path: $path,
             sha256: $sha256, size_bytes: $size_bytes,
             kind: "aggregate-checksum"}')")

        if jq -e --arg name "${aggregate_name}.minisig" '
            (.exact_additional_assets // []) | index($name) != null' \
            <<< "$contract_json" >/dev/null 2>&1; then
            signature="${aggregate_path}.minisig"
            [[ -n "$minisign_public_key_file" ]] || return 4
            if [[ "$sidecar_mode" == "create" && ! -e "$signature" && ! -L "$signature" ]]; then
                signing_private_key="${SIGNING_PRIVATE_KEY:-${DSR_CONFIG_DIR:-$HOME/.config/dsr}/secrets/minisign.key}"
                signing_sign_exact "$aggregate_path" "$signature" \
                    "$signing_private_key" "$minisign_public_key_token" \
                    "dsr strict release $tool_name $tag aggregate $aggregate_sha" \
                    "$aggregate_sha" || return 4
            fi
            [[ -f "$signature" && ! -L "$signature" ]] || return 4
            signing_verify_exact "$aggregate_path" "$signature" \
                "$minisign_public_key_token" || return 4
            signature_sha=$(_release_sha256 "$signature") || return 4
            signature_size=$(_release_file_size "$signature") || return 4
            planned_assets+=("$(jq -nc \
                --arg name "${aggregate_name}.minisig" --arg path "$signature" \
                --arg sha256 "$signature_sha" \
                --arg source_sha256 "$aggregate_sha" \
                --arg public_key_sha256 "$minisign_public_key_sha256" \
                --arg public_key_token "$minisign_public_key_token" \
                --argjson size_bytes "$signature_size" '
                {target: "additional", name: $name, path: $path,
                 sha256: $sha256, source_sha256: $source_sha256,
                 public_key_sha256: $public_key_sha256,
                 public_key_token: $public_key_token,
                 size_bytes: $size_bytes, kind: "minisign"}')")
        fi
    done < <(jq -r '(.exact_additional_assets // []) |
        map(select(. == "SHA256SUMS" or . == "SHA256SUMS.txt" or
                   . == "checksums.txt")) | sort[]' \
        <<< "$contract_json")

    # Public names for the frozen build manifest (GH #18). Its bytes are the
    # strict manifest validated above, bound by the plan's manifest_sha256
    # rather than by a self-referential manifest row. A copy is created only
    # in create mode and without clobbering; an existing copy must already be
    # an identical regular file. A name equal to the generated manifest's own
    # basename publishes that file directly.
    local manifest_asset_name manifest_asset_path manifest_size_before
    manifest_size_before=$(_release_file_size "$manifest_file") || return 4
    while IFS= read -r manifest_asset_name; do
        [[ -n "$manifest_asset_name" ]] || continue
        manifest_asset_path="$artifacts_dir/$manifest_asset_name"
        if [[ "$manifest_asset_path" != "$manifest_file" ]]; then
            if [[ "$sidecar_mode" == "create" && ! -e "$manifest_asset_path" && \
                  ! -L "$manifest_asset_path" ]]; then
                if ! (set -o noclobber; cat -- "$manifest_file" > "$manifest_asset_path"); then
                    log_error "Could not create public build manifest without clobbering: $manifest_asset_path"
                    return 4
                fi
            fi
            if [[ "$sidecar_mode" != "plan" || -e "$manifest_asset_path" || -L "$manifest_asset_path" ]]; then
                if [[ ! -f "$manifest_asset_path" || -L "$manifest_asset_path" ]] || \
                   [[ "$(_release_sha256 "$manifest_asset_path")" != "$manifest_sha_before" ]] || \
                   [[ "$(_release_file_size "$manifest_asset_path")" != "$manifest_size_before" ]]; then
                    log_error "Public build manifest must be a regular file identical to the build manifest: $manifest_asset_name"
                    return 4
                fi
            fi
        fi
        planned_assets+=("$(jq -nc \
            --arg name "$manifest_asset_name" --arg path "$manifest_asset_path" \
            --arg sha256 "$manifest_sha_before" \
            --argjson size_bytes "$manifest_size_before" '
            {target: "metadata", name: $name, path: $path,
             sha256: $sha256, size_bytes: $size_bytes,
             kind: "build-manifest"}')")
    done < <(jq -r '(.build_manifest_assets // [])[]' <<< "$contract_json")

    local planned_additional_names contracted_additional_names
    planned_additional_names=$(printf '%s\n' "${planned_assets[@]}" | jq -sr \
        '[.[] | select(.target == "additional") | .name] | sort | join("\n")') || return 4
    contracted_additional_names=$(jq -r \
        '(.exact_additional_assets // []) | sort | join("\n")' \
        <<< "$contract_json") || return 4
    if [[ "$planned_additional_names" != "$contracted_additional_names" ]]; then
        log_error "Strict additional release plan does not match exact_additional_assets"
        return 4
    fi

    manifest_sha_after=$(_release_sha256 "$manifest_file") || return 4
    if [[ "$manifest_sha_before" != "$manifest_sha_after" ]]; then
        log_error "Strict build manifest changed during preflight"
        return 4
    fi

    local assets_json
    assets_json=$(printf '%s\n' "${planned_assets[@]}" | jq -sc '.') || return 4
    jq -nc \
        --arg tool "$tool_name" \
        --arg tag "$tag" \
        --arg repo "$repo" \
        --arg manifest_file "$manifest_file" \
        --arg manifest_sha256 "$manifest_sha_after" \
        --arg git_sha "$head_sha" \
        --argjson dependencies "$expected_dependencies_json" \
        --argjson contract "$contract_json" \
        --argjson minisign_public_key "$minisign_public_key_json" \
        --argjson tag_ruleset_receipt "$tag_ruleset_receipt_json" \
        --argjson assets "$assets_json" \
        '{
            tool: $tool,
            tag: $tag,
            repo: $repo,
            manifest_file: $manifest_file,
            manifest_sha256: $manifest_sha256,
            git_sha: $git_sha,
            dependencies: $dependencies,
            contract: $contract,
            minisign_public_key: $minisign_public_key,
            tag_ruleset_receipt: $tag_ruleset_receipt,
            assets: $assets
        }'
}

# Re-fetch the repository-owned immutable-tag policy and require byte-for-byte
# equality with the normalized receipt frozen by strict preflight. The current
# history version is part of that receipt, so an edit-and-revert cannot silently
# reuse stale evidence even when the visible rules return to their earlier values.
_release_contract_verify_tag_ruleset_receipt() {
    local frozen_receipt="${1:-null}"
    local repo repository_id ruleset_id tag git_sha
    local policy_json policy_sha256 current_receipt

    [[ "$frozen_receipt" == "null" ]] && return 0
    if ! jq -e '
        .schema == "dsr.github_tag_ruleset_receipt.v1" and
        (.repository.full_name | type == "string" and length > 0) and
        (.repository.id | type == "number" and floor == . and . > 0) and
        (.ruleset.policy.id | type == "number" and floor == . and . > 0) and
        (.ruleset.history.version_id | type == "number" and floor == . and . > 0) and
        (.tag | type == "string" and test("^v[A-Za-z0-9._+-]+$")) and
        (.git_sha | type == "string" and test("^[0-9a-f]{40}$")) and
        (.policy_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
    ' <<< "$frozen_receipt" >/dev/null 2>&1; then
        log_error "Strict release plan contains an invalid tag-ruleset receipt"
        return 1
    fi

    repo=$(jq -r '.repository.full_name' <<< "$frozen_receipt") || return 1
    repository_id=$(jq -r '.repository.id' <<< "$frozen_receipt") || return 1
    ruleset_id=$(jq -r '.ruleset.policy.id' <<< "$frozen_receipt") || return 1
    tag=$(jq -r '.tag' <<< "$frozen_receipt") || return 1
    git_sha=$(jq -r '.git_sha' <<< "$frozen_receipt") || return 1
    policy_json=$(gh_get_immutable_tag_ruleset_receipt \
        "$repo" "$repository_id" "$ruleset_id" "$tag") || {
        log_error "Could not refresh the frozen immutable-tag ruleset receipt"
        return 1
    }
    policy_sha256=$(_release_sha256_line "$policy_json") || return 1
    current_receipt=$(jq -cS \
        --arg git_sha "$git_sha" \
        --arg policy_sha256 "$policy_sha256" '
        . + {
            git_sha: $git_sha,
            policy_sha256: $policy_sha256
        }
    ' <<< "$policy_json") || return 1

    if ! jq -en \
        --argjson frozen "$frozen_receipt" \
        --argjson current "$current_receipt" \
        '$frozen == $current' >/dev/null 2>&1; then
        log_error "GitHub immutable-tag ruleset changed after its strict receipt was frozen"
        return 1
    fi
    return 0
}

# Resolve the remote tag without cache and require it to retain the frozen
# release-plan commit identity.
_release_contract_verify_remote_tag_identity() {
    local repo="$1"
    local tag="$2"
    local expected_git_sha="$3"
    local remote_git_sha=""

    if [[ ! "$expected_git_sha" =~ ^[0-9a-f]{40}$ ]]; then
        log_error "Strict release plan contains an invalid git SHA"
        return 1
    fi
    remote_git_sha=$(gh_resolve_tag_sha "$repo" "$tag" 2>/dev/null) || {
        log_error "Could not resolve remote release tag immediately before publication"
        return 1
    }
    if [[ "$remote_git_sha" != "$expected_git_sha" ]]; then
        log_error "Remote release tag moved after strict preflight"
        return 1
    fi
}

# Fetch a release and require its remote asset names and byte sizes to match the
# preflight plan exactly. expected_draft is true, false, or any.
_release_contract_verify_remote_assets() {
    local repo="$1"
    local release_id="$2"
    local expected_assets_json="$3"
    local expected_draft="${4:-any}"
    local expected_tag="${5:-}"
    local expected_metadata_json="${6:-null}"
    local release_json=""

    if [[ ! "$release_id" =~ ^[1-9][0-9]*$ ]]; then
        log_error "GitHub release ID is invalid: $release_id"
        return 1
    fi
    if [[ -z "$expected_tag" ]]; then
        log_error "Expected release tag is required for strict remote verification"
        return 1
    fi
    release_json=$(gh_api "repos/$repo/releases/$release_id" --no-cache 2>/dev/null) || {
        log_error "Could not fetch draft release for remote verification"
        return 1
    }
    if ! jq -e \
        --argjson release_id "$release_id" \
        --arg expected_tag "$expected_tag" '
            .id == $release_id and
            .tag_name == $expected_tag and
            (.assets | type == "array")
        ' \
        <<< "$release_json" >/dev/null 2>&1; then
        log_error "GitHub returned an invalid or wrong-tag release during remote verification"
        return 1
    fi

    case "$expected_draft" in
        true|false)
            if ! jq -e --argjson expected "$expected_draft" '.draft == $expected' \
                <<< "$release_json" >/dev/null 2>&1; then
                log_error "GitHub release draft state changed before verification"
                return 1
            fi
            ;;
        any) ;;
        *)
            log_error "Invalid expected draft state: $expected_draft"
            return 1
            ;;
    esac

    if [[ "$expected_metadata_json" != "null" ]] && ! jq -e \
        --argjson expected "$expected_metadata_json" '
            .name == $expected.name and
            .body == $expected.body and
            .prerelease == $expected.prerelease
        ' <<< "$release_json" >/dev/null 2>&1; then
        log_error "GitHub release metadata changed during strict verification"
        return 1
    fi

    if ! jq -e '
        all(.assets[];
            (.id | type == "number" and floor == . and . > 0) and
            (.state == "uploaded") and
            (.name | type == "string" and length > 0) and
            (.size | type == "number" and floor == . and . >= 0) and
            (.digest | type == "string" and test("^sha256:[0-9a-f]{64}$"))
        ) and
        (([.assets[].id] | unique | length) == (.assets | length)) and
        (([.assets[].name] | unique | length) == (.assets | length))
    ' <<< "$release_json" >/dev/null 2>&1; then
        log_error "GitHub release contains incomplete or duplicate asset records"
        return 1
    fi

    if ! jq -en \
        --argjson expected "$expected_assets_json" \
        --argjson actual "$(jq -c '.assets' <<< "$release_json")" '
        def normalized_expected:
            map({name: .name, size_bytes: .size_bytes, digest: ("sha256:" + .sha256)}) |
            sort_by(.name, .size_bytes, .digest);
        def normalized_actual:
            map({name: .name, size_bytes: .size, digest: .digest}) |
            sort_by(.name, .size_bytes, .digest);
        ($expected | normalized_expected) == ($actual | normalized_actual)
    ' >/dev/null 2>&1; then
        local comparison
        comparison=$(jq -nc \
            --argjson expected "$expected_assets_json" \
            --argjson actual "$(jq -c '.assets' <<< "$release_json")" '
            {
                expected: ($expected | map({name, size_bytes}) | sort_by(.name)),
                actual: ($actual | map({name, size_bytes: .size}) | sort_by(.name))
            }')
        log_error "Remote release assets do not match the exact contract: $comparison"
        return 1
    fi

    if jq -e 'any(.[]; .kind == "minisign")' \
        <<< "$expected_assets_json" >/dev/null 2>&1; then
        if ! _release_contract_verify_remote_signed_bytes \
            "$repo" "$release_json" "$expected_assets_json"; then
            return 1
        fi

        local release_json_after=""
        release_json_after=$(gh_api "repos/$repo/releases/$release_id" \
            --no-cache 2>/dev/null) || {
            log_error "Could not re-fetch release after remote signature verification"
            return 1
        }
        if ! jq -en \
            --argjson before "$release_json" \
            --argjson after "$release_json_after" '
            def identity:
                {
                    id,
                    tag_name,
                    draft,
                    name,
                    body,
                    prerelease,
                    assets: ([.assets[] | {id, name, size, state, digest}] | sort_by(.id))
                };
            ($before | identity) == ($after | identity)
        ' >/dev/null 2>&1; then
            log_error "GitHub release changed during remote signature verification"
            return 1
        fi
        release_json="$release_json_after"
    fi

    printf '%s\n' "$release_json"
}

# For signed strict contracts, metadata is insufficient proof: download every
# payload/signature pair by immutable asset ID, bind the bytes to the frozen
# plan, and verify each detached signature with the tag-pinned inline key.
_release_contract_verify_remote_signed_bytes() {
    local repo="$1"
    local release_json="$2"
    local expected_assets_json="$3"
    local public_key_token=""
    local download_dir=""
    local status=0
    local pair_index=0

    if ! jq -e '
        ([.[] | select(.kind == "primary")]) as $primaries |
        ([.[] | select(.kind == "primary" or .kind == "additional" or
                        .kind == "aggregate-checksum")]) as $payloads |
        ([.[] | select(.kind == "minisign")]) as $signatures |
        ($primaries | length) > 0 and
        ([.[].name] | unique | length) == length and
        all($primaries[];
            . as $primary |
            ([$signatures[] |
                select(.target == $primary.target and
                       .source_sha256 == $primary.sha256 and
                       .name == ($primary.name + ".minisig"))] | length) == 1
        ) and
        all($signatures[];
            . as $signature |
            ([$payloads[] |
                select(.target == $signature.target and
                       .sha256 == $signature.source_sha256 and
                       ($signature.name == (.name + ".minisig")))] | length) == 1
        ) and
        ([ $signatures[].public_key_token ] | unique | length) == 1 and
        all($signatures[];
            (.public_key_token | type == "string" and
             test("^[A-Za-z0-9+/]{40,}={0,2}$"))
        )
    ' <<< "$expected_assets_json" >/dev/null 2>&1; then
        log_error "Signed strict release plan does not contain exact payload/signature pairs"
        return 1
    fi
    public_key_token=$(jq -er \
        '[.[] | select(.kind == "minisign") | .public_key_token] | unique | .[0]' \
        <<< "$expected_assets_json") || return 1

    download_dir=$(mktemp -d "${TMPDIR:-/tmp}/dsr-release-bytes.XXXXXX") || {
        log_error "Could not create a private remote-verification directory"
        return 1
    }
    chmod 700 "$download_dir" || status=1

    local primary_name primary_sha primary_size signature_name signature_sha signature_size
    local primary_id signature_id primary_download signature_download actual_sha actual_size
    while IFS=$'\t' read -r primary_name primary_sha primary_size \
        signature_name signature_sha signature_size; do
        [[ $status -eq 0 ]] || break
        pair_index=$((pair_index + 1))
        primary_id=$(jq -er --arg name "$primary_name" '
            [.assets[] | select(.name == $name)] |
            if length == 1 then .[0].id else error("missing primary asset ID") end
        ' <<< "$release_json") || { status=1; break; }
        signature_id=$(jq -er --arg name "$signature_name" '
            [.assets[] | select(.name == $name)] |
            if length == 1 then .[0].id else error("missing signature asset ID") end
        ' <<< "$release_json") || { status=1; break; }
        primary_download="$download_dir/$pair_index.primary"
        signature_download="$download_dir/$pair_index.minisig"

        if ! gh_download_release_asset "$repo" "$primary_id" "$primary_download" || \
           ! gh_download_release_asset "$repo" "$signature_id" "$signature_download"; then
            log_error "Could not download signed release pair: $primary_name"
            status=1
            break
        fi

        actual_size=$(_release_file_size "$primary_download") || { status=1; break; }
        actual_sha=$(_release_sha256 "$primary_download") || { status=1; break; }
        if [[ "$actual_size" != "$primary_size" || "$actual_sha" != "$primary_sha" ]]; then
            log_error "Downloaded primary bytes differ from the frozen plan: $primary_name"
            status=1
            break
        fi
        actual_size=$(_release_file_size "$signature_download") || { status=1; break; }
        actual_sha=$(_release_sha256 "$signature_download") || { status=1; break; }
        if [[ "$actual_size" != "$signature_size" || "$actual_sha" != "$signature_sha" ]]; then
            log_error "Downloaded signature bytes differ from the frozen plan: $signature_name"
            status=1
            break
        fi
        if ! signing_verify_exact "$primary_download" "$signature_download" \
            "$public_key_token"; then
            log_error "Downloaded Minisign pair failed cryptographic verification: $primary_name"
            status=1
            break
        fi
    done < <(jq -r '
        [.[] | select(.kind == "primary" or .kind == "additional" or
                      .kind == "aggregate-checksum")] as $payloads |
        [.[] | select(.kind == "minisign")] | sort_by(.target, .name)[] as $signature |
        ($payloads[] |
            select(.target == $signature.target and
                   .sha256 == $signature.source_sha256 and
                   $signature.name == (.name + ".minisig"))) as $primary |
        [
            $primary.name,
            $primary.sha256,
            ($primary.size_bytes | tostring),
            $signature.name,
            $signature.sha256,
            ($signature.size_bytes | tostring)
        ] | @tsv
    ' <<< "$expected_assets_json")

    rm -f -- "$download_dir"/* 2>/dev/null || true
    rmdir -- "$download_dir" 2>/dev/null || true
    if [[ $status -ne 0 ]]; then
        log_error "Remote signed release byte verification failed"
        return 1
    fi
    return 0
}

_release_contract_observe_draft_state() {
    local repo="$1"
    local release_id="$2"
    local release_json=""

    release_json=$(gh_api "repos/$repo/releases/$release_id" --no-cache 2>/dev/null) || return 1
    jq -er \
        --argjson release_id "$release_id" '
            if .id == $release_id and (.draft | type == "boolean")
            then .draft
            else error("invalid release state")
            end
        ' <<< "$release_json" 2>/dev/null
}

_release_contract_restore_draft() {
    local repo="$1"
    local release_id="$2"
    local expected_tag="$3"
    local attempt observed_state=""
    local max_attempts=3
    local retry_delay="${DSR_RELEASE_STATE_RETRY_DELAY_SECONDS:-1}"

    [[ "$retry_delay" =~ ^[0-9]+$ ]] || retry_delay=1
    for ((attempt = 1; attempt <= max_attempts; attempt++)); do
        # A transport error is ambiguous: the PATCH may have committed. Always
        # observe the release state before deciding whether another attempt is needed.
        gh_api "repos/$repo/releases/$release_id" \
            --method PATCH --data '{"draft":true}' --no-cache >/dev/null 2>&1 || true
        observed_state=$(_release_contract_observe_draft_state \
            "$repo" "$release_id" 2>/dev/null || true)
        if [[ "$observed_state" == "true" ]]; then
            log_warn "Restored strict release $expected_tag to draft after failed publication verification"
            return 0
        fi
        if ((attempt < max_attempts && retry_delay > 0)); then
            sleep "$retry_delay"
        fi
    done

    log_error "Strict release could not be confirmed as draft after $max_attempts rollback attempts"
    return 1
}

_release_contract_confirm_or_restore_draft() {
    local repo="$1"
    local release_id="$2"
    local expected_tag="$3"
    local observed_state=""

    observed_state=$(_release_contract_observe_draft_state \
        "$repo" "$release_id" 2>/dev/null || true)
    if [[ "$observed_state" == "true" ]]; then
        return 0
    fi
    _release_contract_restore_draft "$repo" "$release_id" "$expected_tag"
}

# Authenticated release lists include drafts, unlike the tag-specific release
# endpoint. Scan every page without cache and return a closed zero-or-one match
# result; duplicate exact tags or malformed pagination fail closed.
_release_contract_scan_release_by_tag() {
    local repo="$1"
    local expected_tag="$2"
    local page=1 page_json="" page_count=0
    local max_pages=1000
    local matches='[]'

    while ((page <= max_pages)); do
        page_json=$(gh_api "repos/$repo/releases?per_page=100&page=$page" \
            --no-cache 2>/dev/null) || {
            log_error "Could not scan GitHub releases for strict tag $expected_tag"
            return 1
        }
        if ! jq -e 'type == "array" and length <= 100' \
            <<< "$page_json" >/dev/null 2>&1; then
            log_error "GitHub returned an invalid strict release-list page"
            return 1
        fi
        if ! matches=$(
            printf '%s\n%s\n' "$matches" "$page_json" |
                jq -c -s -e \
                    --arg expected_tag "$expected_tag" '
                    if length == 2 and
                       (.[0] | type == "array") and
                       (.[1] | type == "array" and length <= 100)
                    then
                        .[0] + [.[1][] | select(.tag_name == $expected_tag)]
                    else
                        error("invalid strict release scan input")
                    end
                '
        ); then
            log_error "GitHub returned an invalid strict release-list page"
            return 1
        fi
        if [[ $(jq 'length' <<< "$matches") -gt 1 ]]; then
            log_error "Multiple GitHub releases use strict tag $expected_tag"
            return 1
        fi
        page_count=$(jq 'length' <<< "$page_json")
        ((page_count < 100)) && break
        page=$((page + 1))
    done

    if ((page > max_pages)); then
        log_error "Strict release-list scan exceeded $max_pages pages"
        return 1
    fi
    jq -c -e \
        'if type == "array" and length <= 1
         then {count: length, release: (.[0] // null)}
         else error("invalid strict release scan result")
         end' <<< "$matches"
}

_release_contract_observe_bound_draft() {
    local repo="$1"
    local release_id="$2"
    local expected_tag="$3"
    local release_json=""

    [[ "$release_id" =~ ^[1-9][0-9]*$ ]] || return 1
    release_json=$(gh_api "repos/$repo/releases/$release_id" --no-cache 2>/dev/null) || return 1
    if ! jq -e \
        --argjson release_id "$release_id" \
        --arg expected_tag "$expected_tag" '
        .id == $release_id and
        .tag_name == $expected_tag and
        .draft == true and
        (.upload_url | type == "string" and length > 0) and
        (.assets | type == "array")
    ' <<< "$release_json" >/dev/null 2>&1; then
        return 1
    fi
    printf '%s\n' "$release_json"
}

_release_contract_confirm_or_restore_bound_draft() {
    local repo="$1"
    local release_id="$2"
    local expected_tag="$3"
    local release_json="" attempt
    local max_attempts=3
    local retry_delay="${DSR_RELEASE_STATE_RETRY_DELAY_SECONDS:-1}"

    [[ "$retry_delay" =~ ^[0-9]+$ ]] || retry_delay=1
    [[ "$release_id" =~ ^[1-9][0-9]*$ ]] || return 1
    release_json=$(gh_api "repos/$repo/releases/$release_id" --no-cache 2>/dev/null) || return 1
    if ! jq -e \
        --argjson release_id "$release_id" \
        --arg expected_tag "$expected_tag" '
        .id == $release_id and
        .tag_name == $expected_tag and
        (.draft | type == "boolean")
    ' <<< "$release_json" >/dev/null 2>&1; then
        log_error "Strict draft reconciliation refused a wrong-ID or wrong-tag release"
        return 1
    fi
    if jq -e '.draft == true' <<< "$release_json" >/dev/null 2>&1; then
        return 0
    fi

    for ((attempt = 1; attempt <= max_attempts; attempt++)); do
        gh_api "repos/$repo/releases/$release_id" \
            --method PATCH --data '{"draft":true}' --no-cache >/dev/null 2>&1 || true
        if _release_contract_observe_bound_draft \
            "$repo" "$release_id" "$expected_tag" >/dev/null 2>&1; then
            log_warn "Restored strict release $expected_tag to its ID-bound draft"
            return 0
        fi
        if ((attempt < max_attempts && retry_delay > 0)); then
            sleep "$retry_delay"
        fi
    done

    log_error "Strict release could not be restored to an ID/tag-bound draft"
    return 1
}

_release_contract_create_nonce() {
    local nonce=""

    nonce=$(od -An -N32 -tx1 /dev/urandom 2>/dev/null | tr -d '[:space:]') || return 1
    [[ "$nonce" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$nonce"
}

# Source-only releases deliberately have no build manifest or uploaded assets.
# Their explicit configuration and CLI keep them separate from binary admission.
_source_release_identity() {
    local repo="$1" path="$2" tag="$3" expected_sha="$4" origin="" status=""
    [[ -d "$path" && "$expected_sha" =~ ^[0-9a-f]{40}$ ]] || return 4
    [[ "$(cd "$path" && pwd -P)" == "$(_act_strict_git -C "$path" rev-parse --show-toplevel)" ]] || {
        log_error "Source-only local_path must be the actual Git checkout root"
        return 4
    }
    origin=$(_act_strict_git -C "$path" config --get remote.origin.url) || return 4
    case "$origin" in
        "https://github.com/$repo"|"https://github.com/$repo.git"|"git@github.com:$repo"|"git@github.com:$repo.git") ;;
        *) log_error "Source-only checkout origin does not match its configured repository"; return 4 ;;
    esac
    status=$(_act_strict_git -C "$path" status --porcelain=v1 --untracked-files=all) || return 4
    [[ -z "$status" && "$(_act_strict_git -C "$path" rev-parse --verify HEAD)" == "$expected_sha" &&
       "$(_act_strict_git -C "$path" rev-parse --verify "refs/tags/$tag^{commit}")" == "$expected_sha" ]] || {
        log_error "Source-only publication requires a clean checkout at the exact peeled tag"
        return 4
    }
    _release_contract_verify_remote_tag_identity "$repo" "$tag" "$expected_sha" || return 4
}

_source_release_metadata_matches() {
    local observed="$1" expected="$2" release_id="$3" draft="$4"
    jq -es --argjson expected "$expected" --argjson id "$release_id" --arg draft "$draft" '
        length == 1 and (.[0] | type == "object" and .id == $id and
        .tag_name == $expected.tag_name and .name == $expected.name and
        .body == $expected.body and .prerelease == $expected.prerelease and
        .target_commitish == $expected.target_commitish and
        (.draft | type == "boolean") and
        ($draft == "any" or (.draft | tostring) == $draft))
    ' <<< "$observed" >/dev/null 2>&1
}

_source_release_observe() {
    local repo="$1" release_id="$2" expected="$3" draft="$4" observed="" assets=""
    observed=$(gh_api "repos/$repo/releases/$release_id" --no-cache) || return 1
    _source_release_metadata_matches "$observed" "$expected" "$release_id" "$draft" || return 1
    jq -es 'length == 1 and .[0].assets == []' <<< "$observed" >/dev/null || return 1
    # Embedded release.assets is not an authoritative complete inventory.
    assets=$(gh_api "repos/$repo/releases/$release_id/assets?per_page=100&page=1" --no-cache) || return 1
    jq -es 'length == 1 and .[0] == []' <<< "$assets" >/dev/null || return 1
    printf '%s\n' "$observed"
}

_source_release_restore_draft() {
    local repo="$1" release_id="$2" expected="$3" tag=""
    # Callers reach rollback only after full nonce-bound creation custody is
    # proven. Later body drift must still return that owned ID/tag to draft.
    tag=$(jq -r '.tag_name' <<< "$expected") || return 1
    _release_contract_confirm_or_restore_bound_draft "$repo" "$release_id" "$tag"
}

_source_release_inputs_match() {
    local config="$1" config_sha="$2" notes="$3" notes_sha="$4" registry="$5" registry_sha="$6"
    [[ -f "$config" && ! -L "$config" && -f "$notes" && ! -L "$notes" &&
       "$(_gh_asset_sha256 "$config")" == "$config_sha" &&
       "$(_gh_asset_sha256 "$notes")" == "$notes_sha" ]] || return 1
    if [[ "$registry_sha" == absent ]]; then
        [[ ! -e "$registry" && ! -L "$registry" ]]
    else
        [[ -f "$registry" && ! -L "$registry" &&
           "$(_gh_asset_sha256 "$registry")" == "$registry_sha" ]]
    fi
}

_source_release_read_private_receipt() {
    local file="$1" receipt_dir="$2" tool="$3" tag="$4"
    local prefix="${5:-$tool-$tag.json.}"
    [[ -f "$file" && ! -L "$file" && -d "$receipt_dir" && ! -L "$receipt_dir" &&
       "${file##*/}" == "$prefix"* &&
       "$(cd "${file%/*}" && pwd -P)" == "$(cd "$receipt_dir" && pwd -P)" ]] || return 4
    python3 -I - "$file" "$receipt_dir" <<'PY'
import hashlib
import json
import os
import stat
import sys

if not __debug__:
    raise SystemExit("Source-only receipt validation requires enabled predicates")

def identity(value):
    return [value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns,
            value.st_ctime_ns, value.st_mode, value.st_uid, value.st_nlink]

def unique_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError("duplicate receipt field")
        value[key] = item
    return value

directory_fd = receipt_fd = None
try:
    path, directory = map(os.path.abspath, sys.argv[1:])
    assert os.path.dirname(path) == directory
    assert os.path.realpath(directory) == directory
    assert getattr(os, "O_NOFOLLOW", 0) and getattr(os, "O_DIRECTORY", 0)
    directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    parent = os.fstat(directory_fd)
    assert stat.S_ISDIR(parent.st_mode) and parent.st_uid == os.geteuid()
    assert not parent.st_mode & 0o022
    directory_identity = [parent.st_dev, parent.st_ino, parent.st_mode, parent.st_uid]
    name = os.path.basename(path)
    receipt_fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory_fd)
    before = os.fstat(receipt_fd)
    assert stat.S_ISREG(before.st_mode) and before.st_uid == os.geteuid()
    assert stat.S_IMODE(before.st_mode) == 0o600 and before.st_nlink == 1
    assert 0 < before.st_size <= 1048576
    assert identity(os.stat(name, dir_fd=directory_fd, follow_symlinks=False)) == identity(before)
    chunks = []
    remaining = 1048577
    while remaining:
        chunk = os.read(receipt_fd, min(65536, remaining))
        if not chunk:
            break
        chunks.append(chunk)
        remaining -= len(chunk)
    raw = b"".join(chunks)
    assert len(raw) == before.st_size and len(raw) <= 1048576
    record = json.loads(raw, object_pairs_hook=unique_object)
    assert isinstance(record, dict)
    assert identity(os.fstat(receipt_fd)) == identity(before)
    assert identity(os.stat(name, dir_fd=directory_fd, follow_symlinks=False)) == identity(before)
    named_parent = os.lstat(directory)
    assert [named_parent.st_dev, named_parent.st_ino, named_parent.st_mode,
            named_parent.st_uid] == directory_identity
    print(json.dumps({"record": record, "identity": identity(before),
                      "directory_identity": directory_identity,
                      "sha256": hashlib.sha256(raw).hexdigest()}))
except (OSError, ValueError, AssertionError):
    raise SystemExit("Source-only receipt failed private descriptor validation")
finally:
    if receipt_fd is not None:
        os.close(receipt_fd)
    if directory_fd is not None:
        os.close(directory_fd)
PY
}

_release_finalize_observe() {
    local repo="$1" id="$2" plan="$3" draft="$4" tag="$5" metadata="$6"
    local observed inventory
    observed=$(_release_contract_verify_remote_assets "$repo" "$id" "$plan" "$draft" "$tag" "$metadata") || return 7
    _source_release_metadata_matches "$observed" "$metadata" "$id" "$draft" || return 7
    inventory=$(gh_api "repos/$repo/releases/$id/assets?per_page=100&page=1" --no-cache) || return 7
    # This bounded recovery route admits fewer than 100 exact assets. A full
    # page is ambiguous and must use a separately qualified paginated route.
    jq -es --argjson observed "$observed" '
        def records: map({id,name,state,size,digest}) | sort_by(.id);
        length == 1 and (.[0] | type == "array" and length < 100 and
        (records == ($observed.assets | records)))
    ' <<< "$inventory" >/dev/null || return 7
    printf '%s\n' "$observed"
}

cmd_release_finalize() {
    local tool="" version="" response="" no_dispatch=false
    local usage="Usage: dsr release finalize <tool> <version> --create-response /abs/path/dsr-api-response.XXXXXXXX --no-dispatch"
    while (($#)); do
        case "$1" in
            --create-response)
                [[ $# -ge 2 ]] || { log_error "--create-response requires a path"; return 4; }
                response="$2"; shift 2 ;;
            --no-dispatch) no_dispatch=true; shift ;;
            --help|-h)
                cat << 'EOF'
dsr release finalize - Publish a verified strict draft from its creation response

USAGE:
    dsr release finalize <tool> <version> --create-response <path> --no-dispatch

OPTIONS:
    --create-response <path>  Absolute path of the preserved private
                              dsr-api-response.XXXXXXXX POST response that
                              created the draft (creation custody)
    --no-dispatch             Required: finalization does not dispatch

Finalization re-verifies every signed asset, the source tag and the release
contract, then publishes the draft. See README "strict releases".
EOF
                return 0 ;;
            -*) log_error "Unsupported strict finalization option: $1"; log_info "$usage"; return 4 ;;
            *)
                if [[ -z "$tool" ]]; then tool="$1"
                elif [[ -z "$version" ]]; then version="$1"
                else log_error "Unexpected argument: $1"; log_info "$usage"; return 4; fi
                shift ;;
        esac
    done
    if [[ ! "$tool" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ||
          ! "$version" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([.+-][A-Za-z0-9.-]+)?$ ]]; then
        log_error "A tool name and a semantic version are required"
        log_info "$usage"
        return 4
    fi
    if [[ "$response" != /* || ! "${response##*/}" =~ ^dsr-api-response\.[A-Za-z0-9]{8}$ ]]; then
        log_error "--create-response must be the absolute path of a preserved dsr-api-response.XXXXXXXX file"
        return 4
    fi
    if [[ "$no_dispatch" != true ]]; then
        log_error "release finalize requires --no-dispatch (finalization never dispatches)"
        return 4
    fi
    gh_check || gh_check_token || return 3
    local repo path tag contract config config_sha config_json registry registry_sha registry_json
    config="$ACT_REPOS_DIR/$tool.yaml"
    if [[ ! -f "$config" || -L "$config" ||
          "$(cd "${config%/*}" && pwd -P)" != "$(cd "${DSR_CONFIG_DIR:-$HOME/.config/dsr}/repos.d" && pwd -P)" ]]; then
        log_error "Strict finalization needs repos.d/$tool.yaml as a regular file in ${DSR_CONFIG_DIR:-$HOME/.config/dsr}/repos.d"
        return 4
    fi
    config_sha=$(_gh_asset_sha256 "$config") || return 4
    config_json=$(_config_read_single_mapping_json "$config") || return 4
    [[ "$(_gh_asset_sha256 "$config")" == "$config_sha" ]] || return 4
    jq -e --arg tool "$tool" '
        (.tool_name == null or .tool_name == $tool) and .publication_mode == null and
        (has("extends") | not) and (.repo | type == "string") and
        (.local_path | type == "string" and startswith("/")) and
        (.release_contract | type == "object")
    ' <<< "$config_json" >/dev/null || return 4
    registry="${DSR_REPOS_FILE:-${DSR_CONFIG_DIR:-$HOME/.config/dsr}/repos.yaml}"
    registry_sha=absent
    if [[ -e "$registry" || -L "$registry" ]]; then
        [[ -f "$registry" && ! -L "$registry" ]] || return 4
        registry_sha=$(_gh_asset_sha256 "$registry") || return 4
        registry_json=$(_config_read_single_mapping_json "$registry") || return 4
        [[ "$(_gh_asset_sha256 "$registry")" == "$registry_sha" ]] || return 4
        jq -e --arg tool "$tool" '(.tools | type == "object") and ((.tools | has($tool)) | not)' <<< "$registry_json" >/dev/null || return 4
    fi
    act_load_repo_config "$tool" || return 4
    config_validate_release_contract "$tool" || return 4
    repo=$(jq -r '.repo' <<< "$config_json") || return 4
    path=$(jq -r '.local_path' <<< "$config_json") || return 4
    [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 4
    tag=$(git_ops_version_to_tag "$version") || return 4
    contract=$(jq -c '.release_contract' <<< "$config_json") || return 4
    [[ "$contract" != null ]] || { log_error "Finalization requires a strict binary release contract"; return 4; }
    local state_dir artifacts manifest
    state_dir="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}"
    artifacts="$state_dir/artifacts/$tool-$tag"
    manifest="$artifacts/$tool-$tag-manifest.json"
    local frozen plan saved metadata release_id receipt_sha receipt_dir scan observed
    # Recovery authority is the original private POST response retained by the
    # GitHub adapter, not a tag lookup, upload journal, or caller-supplied ID.
    receipt_dir="${TMPDIR:-/tmp}"
    frozen=$(_source_release_read_private_receipt "$response" "$receipt_dir" "" "" "dsr-api-response.") || return 4
    saved=$(jq -c '.record' <<< "$frozen") || return 4
    receipt_sha=$(jq -r '.sha256' <<< "$frozen") || return 4
    plan=$(_release_contract_preflight "$tool" "$tag" "$repo" "$path" "$artifacts" "$manifest" "$contract" verify) || return 4
    _source_release_identity "$repo" "$path" "$tag" "$(jq -r '.git_sha' <<< "$plan")" || return 4
    _source_release_inputs_match "$config" "$config_sha" "$response" "$receipt_sha" "$registry" "$registry_sha" || return 4
    if ! jq -e --arg repo "$repo" --arg tag "$tag" --arg sha "$(jq -r '.git_sha' <<< "$plan")" '
        (.id | type == "number" and floor == . and . > 0 and . <= 9007199254740991) and
        .tag_name == $tag and .name == $tag and .target_commitish == $sha and
        .draft == true and (.prerelease | type == "boolean") and .assets == [] and
        (.body | type == "string" and test("<!-- dsr-create-nonce:[0-9a-f]{64} -->$")) and
        .upload_url == ("https://uploads.github.com/repos/" + $repo + "/releases/" + (.id | tostring) + "/assets{?name,label}") and
        (.html_url | type == "string" and startswith("https://github.com/" + $repo + "/releases/"))
    ' <<< "$saved" >/dev/null; then
        log_error "Create response does not prove this exact new empty strict draft"
        return 4
    fi
    release_id=$(jq -r '.id' <<< "$saved") || return 4
    metadata=$(jq -c '{tag_name,name,body,prerelease,target_commitish}' <<< "$saved") || return 4
    scan=$(_release_contract_scan_release_by_tag "$repo" "$tag") || return 7
    jq -e --argjson id "$release_id" '.count == 1 and .release.id == $id' <<< "$scan" >/dev/null || return 7
    observed=$(_release_finalize_observe "$repo" "$release_id" "$(jq -c '.assets' <<< "$plan")" any "$tag" "$metadata") || return 7
    local current_fingerprint current_plan
    current_fingerprint=$(_source_release_read_private_receipt "$response" "$receipt_dir" "" "" "dsr-api-response.") || return 4
    [[ "$current_fingerprint" == "$frozen" && -f "$config" && ! -L "$config" &&
       "$(_gh_asset_sha256 "$config")" == "$config_sha" ]] || return 4
    _source_release_inputs_match "$config" "$config_sha" "$response" "$receipt_sha" "$registry" "$registry_sha" || return 4
    current_plan=$(_release_contract_preflight "$tool" "$tag" "$repo" "$path" "$artifacts" "$manifest" "$contract" verify) || return 4
    jq -en --argjson a "$plan" --argjson b "$current_plan" '$a == $b' >/dev/null || return 4
    _release_contract_verify_remote_tag_identity "$repo" "$tag" "$(jq -r '.git_sha' <<< "$plan")" || return 7
    _release_contract_verify_tag_ruleset_receipt "$(jq -c '.tag_ruleset_receipt' <<< "$plan")" || return 7
    if $DRY_RUN; then
        log_info "Verified strict finalization plan for owned release ID $release_id"
        $JSON_MODE && json_envelope "release-finalize" "dry_run" 0 "$(jq -nc --argjson id "$release_id" '{release_id:$id}')"
        return 0
    fi
    local output final_output
    mkdir -p "$state_dir/releases" || return 7
    [[ -d "$state_dir/releases" && ! -L "$state_dir/releases" ]] || return 7
    output=$(umask 077; mktemp "$state_dir/releases/$tool-$tag-finalization-pending.XXXXXXXX") || return 7
    jq -n --arg repo "$repo" --arg tag "$tag" --argjson id "$release_id" \
        --arg response "$response" --arg sha "$receipt_sha" --argjson plan "$plan" \
        --arg config_sha "$config_sha" --arg registry_sha "$registry_sha" --argjson metadata "$metadata" \
        '{schema:"dsr.strict_finalization_receipt.v1",status:"pending",repo:$repo,tag:$tag,release_id:$id,create_response:$response,create_response_sha256:$sha,config_sha256:$config_sha,registry_sha256:$registry_sha,plan:$plan,metadata:$metadata}' > "$output" || return 7
    jq -e '.status == "pending"' "$output" >/dev/null || return 7
    # Re-observe all remote bytes and the complete original nonce-bound
    # metadata immediately before changing only this proven draft's state.
    observed=$(_release_finalize_observe "$repo" "$release_id" "$(jq -c '.assets' <<< "$plan")" any "$tag" "$metadata") || return 7
    current_fingerprint=$(_source_release_read_private_receipt "$response" "$receipt_dir" "" "" "dsr-api-response.") || return 4
    [[ "$current_fingerprint" == "$frozen" && -f "$config" && ! -L "$config" &&
       "$(_gh_asset_sha256 "$config")" == "$config_sha" ]] || return 4
    _source_release_inputs_match "$config" "$config_sha" "$response" "$receipt_sha" "$registry" "$registry_sha" || return 4
    current_plan=$(_release_contract_preflight "$tool" "$tag" "$repo" "$path" "$artifacts" "$manifest" "$contract" verify) || return 4
    jq -en --argjson a "$plan" --argjson b "$current_plan" '$a == $b' >/dev/null || return 4
    _release_contract_verify_remote_tag_identity "$repo" "$tag" "$(jq -r '.git_sha' <<< "$plan")" || return 7
    _release_contract_verify_tag_ruleset_receipt "$(jq -c '.tag_ruleset_receipt' <<< "$plan")" || return 7
    _source_release_identity "$repo" "$path" "$tag" "$(jq -r '.git_sha' <<< "$plan")" || return 4
    if jq -e '.draft == true' <<< "$observed" >/dev/null; then
        gh_api "repos/$repo/releases/$release_id" --method PATCH --data '{"draft":false}' --no-cache >/dev/null || true
    fi
    local valid=true
    observed=$(_release_finalize_observe "$repo" "$release_id" "$(jq -c '.assets' <<< "$plan")" false "$tag" "$metadata") || valid=false
    current_fingerprint=$(_source_release_read_private_receipt "$response" "$receipt_dir" "" "" "dsr-api-response.") || valid=false
    [[ "$current_fingerprint" == "$frozen" && -f "$config" && ! -L "$config" &&
       "$(_gh_asset_sha256 "$config")" == "$config_sha" ]] || valid=false
    _source_release_inputs_match "$config" "$config_sha" "$response" "$receipt_sha" "$registry" "$registry_sha" || valid=false
    current_plan=$(_release_contract_preflight "$tool" "$tag" "$repo" "$path" "$artifacts" "$manifest" "$contract" verify) || valid=false
    jq -en --argjson a "$plan" --argjson b "${current_plan:-null}" '$a == $b' >/dev/null || valid=false
    _release_contract_verify_remote_tag_identity "$repo" "$tag" "$(jq -r '.git_sha' <<< "$plan")" || valid=false
    _release_contract_verify_tag_ruleset_receipt "$(jq -c '.tag_ruleset_receipt' <<< "$plan")" || valid=false
    _source_release_identity "$repo" "$path" "$tag" "$(jq -r '.git_sha' <<< "$plan")" || valid=false
    if ! $valid; then
        _source_release_restore_draft "$repo" "$release_id" "$metadata" || true
        log_error "Strict finalization failed post-publication revalidation"
        return 7
    fi
    final_output=$(umask 077; mktemp "$state_dir/releases/$tool-$tag-finalized.XXXXXXXX") || {
        _source_release_restore_draft "$repo" "$release_id" "$metadata" || true
        return 7
    }
    if ! jq -n --arg repo "$repo" --arg tag "$tag" --argjson id "$release_id" \
        --arg response "$response" --arg sha "$receipt_sha" --argjson plan "$plan" \
        --arg pending "$output" --argjson release "$observed" '{schema:"dsr.strict_finalization_receipt.v1",status:"success",repo:$repo,tag:$tag,release_id:$id,create_response:$response,create_response_sha256:$sha,pending_receipt:$pending,plan:$plan,release:$release}' > "$final_output"; then
        _source_release_restore_draft "$repo" "$release_id" "$metadata" || true
        return 7
    fi
    log_ok "Strict release finalized and verified: $(jq -r '.html_url' <<< "$observed")"
    $JSON_MODE && json_envelope "release-finalize" "success" 0 "$(jq -nc --arg receipt "$final_output" --argjson id "$release_id" '{receipt:$receipt,release_id:$id}')"
    return 0
}

_source_release_resume_receipt_matches() {
    local file="$1" dir="$2" tool="$3" tag="$4" fingerprint="$5" observed=""
    [[ -z "$file" ]] && return 0
    observed=$(_source_release_read_private_receipt "$file" "$dir" "$tool" "$tag") || return 4
    jq -e --argjson expected "$fingerprint" '
        {identity,directory_identity,sha256} == $expected
    ' <<< "$observed" >/dev/null
}

_source_release_scan_created() {
    local repo="$1" tag="$2" attempt=0 scan="" count=""
    while ((attempt < 3)); do
        scan=$(_release_contract_scan_release_by_tag "$repo" "$tag") || return 7
        count=$(jq -r '.count' <<< "$scan") || return 7
        if [[ "$count" == 1 ]]; then printf '%s\n' "$scan"; return 0; fi
        [[ "$count" == 0 ]] || return 7
        attempt=$((attempt + 1))
        ((attempt < 3)) && sleep 1
    done
    log_error "New source-only draft is not yet visible; retain and resume its private pending receipt"
    return 7
}

cmd_release_source_only() {
    local tool="" version="" exact_tag="" notes="" no_dispatch=false draft=false prerelease=false
    local resume_receipt="" saved_receipt="" saved_sha="" saved_fingerprint="" resume_release_id=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tag)
                [[ $# -ge 2 && -n "$2" && "$2" != -* && -z "$exact_tag" ]] || return 4
                exact_tag="$2"; shift 2 ;;
            --notes-file)
                [[ $# -ge 2 && "$2" != -* ]] || return 4
                notes="$2"; shift 2 ;;
            --resume-receipt)
                [[ $# -ge 2 && "$2" == /* ]] || return 4
                resume_receipt="$2"; shift 2 ;;
            --no-dispatch) no_dispatch=true; shift ;;
            --draft) draft=true; shift ;;
            --prerelease) prerelease=true; shift ;;
            --help|-h)
                cat <<'EOF'
dsr release source-only <tool> <version> --notes-file <file> --no-dispatch
dsr release source-only <tool> --tag <exact-tag> --notes-file <file> --no-dispatch

Publishes an installer/source-only GitHub Release with exactly zero assets.
Requires publication_mode: source-only in repos.d, a clean exact tagged checkout,
the same peeled tag on GitHub, and explicit reviewed notes. Always verifies an
owned draft before publication. --draft, --prerelease, and global --dry-run work.
Use --resume-receipt /absolute/path to recover your private pending draft record.
Use --tag instead of a version for a single-component crate or workspace tag.
Binary artifact, resume, upgrade-verification, and dispatch options are refused.
EOF
                return 0 ;;
            -*) log_error "Unsupported source-only option: $1"; return 4 ;;
            *)
                if [[ -z "$tool" ]]; then tool="$1"
                elif [[ -z "$version" ]]; then version="$1"
                else return 4
                fi
                shift ;;
        esac
    done
    [[ "$tool" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ &&
       -s "$notes" && ! -L "$notes" && "$no_dispatch" == true ]] || {
        log_error "Source-only publication requires a tool, regular reviewed notes and --no-dispatch"
        return 4
    }
    [[ ( -n "$version" && -z "$exact_tag" ) ||
       ( -z "$version" && -n "$exact_tag" ) ]] || {
        log_error "Source-only publication requires exactly one version or --tag"
        return 4
    }
    _dsr_require github
    _dsr_require git_ops
    _dsr_require act_runner
    if ! gh_check 2>/dev/null && ! gh_check_token 2>/dev/null; then return 3; fi
    local config_file="$ACT_REPOS_DIR/$tool.yaml" config="" config_sha=""
    [[ -f "$config_file" && ! -L "$config_file" ]] || return 4
    config_sha=$(_gh_asset_sha256 "$config_file") || return 4
    config=$(_config_read_single_mapping_json "$config_file") || return 4
    [[ "$(_gh_asset_sha256 "$config_file")" == "$config_sha" ]] || return 4
    if ! jq -e --arg tool "$tool" 'type == "object" and
        (((keys) - ["tool_name","repo","local_path","publication_mode"]) | length == 0) and
        (.tool_name == null or .tool_name == $tool) and
        (.repo | type == "string" and length > 0) and
        (.local_path | type == "string" and startswith("/")) and
        .publication_mode == "source-only"' <<< "$config" >/dev/null; then
        log_error "Source-only mode requires explicit configuration without binary release/build fields"
        return 4
    fi
    # repos.yaml is a real legacy inheritance path. Do not allow an explicit
    # source-only file to shadow a binary contract/build entry there.
    local registry="${DSR_REPOS_FILE:-${DSR_CONFIG_DIR:-$HOME/.config/dsr}/repos.yaml}"
    local registry_sha=absent registry_json=""
    if [[ -e "$registry" || -L "$registry" ]]; then
        [[ -f "$registry" && ! -L "$registry" ]] || return 4
        registry_sha=$(_gh_asset_sha256 "$registry") || return 4
        registry_json=$(_config_read_single_mapping_json "$registry") || return 4
        [[ "$(_gh_asset_sha256 "$registry")" == "$registry_sha" ]] || return 4
        if ! jq -e --arg tool "$tool" '
            (.tools | type == "object") and ((.tools | has($tool)) | not)
        ' <<< "$registry_json" >/dev/null; then
            log_error "Source-only publication refuses conflicting legacy registry configuration"
            return 4
        fi
    fi
    local repo="" path="" tag="" sha="" notes_sha="" notes_size="" notes_json=""
    repo=$(jq -r '.repo' <<< "$config") || return 4
    path=$(jq -r '.local_path' <<< "$config") || return 4
    [[ "$repo" == */* ]] || repo="Dicklesworthstone/$repo"
    [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 4
    if [[ -n "$exact_tag" ]]; then
        tag="$exact_tag"
        [[ "$tag" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || return 4
    else
        tag=$(git_ops_version_to_tag "$version") || return 4
        [[ "$tag" =~ ^v[0-9][A-Za-z0-9._+-]*$ ]] || return 4
    fi
    _act_strict_git check-ref-format "refs/tags/$tag" >/dev/null || return 4
    sha=$(_act_strict_git -C "$path" rev-parse --verify "refs/tags/$tag^{commit}") || return 4
    _source_release_identity "$repo" "$path" "$tag" "$sha" || return 4
    notes_size=$(_release_file_size "$notes") || return 4
    [[ "$notes_size" =~ ^[0-9]+$ ]] && ((notes_size > 0 && notes_size <= 1048576)) || return 4
    notes_sha=$(_gh_asset_sha256 "$notes") || return 4
    # jq's rawfile preserves every trailing newline before the ownership nonce.
    notes_json=$(jq -n --rawfile body "$notes" '{body:$body}') || return 4
    [[ "$(_gh_asset_sha256 "$notes")" == "$notes_sha" ]] || return 4
    local receipt_dir="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}/source-only"
    local scan="" nonce="" expected="" title="" body="" release="" release_id=""
    scan=$(_release_contract_scan_release_by_tag "$repo" "$tag") || return 7
    if [[ -n "$resume_receipt" ]]; then
        saved_receipt=$(_source_release_read_private_receipt "$resume_receipt" "$receipt_dir" "$tool" "$tag") || return 4
        saved_sha=$(jq -r '.sha256' <<< "$saved_receipt") || return 4
        saved_fingerprint=$(jq -c '{identity,directory_identity,sha256}' <<< "$saved_receipt") || return 4
        saved_receipt=$(jq -c '.record' <<< "$saved_receipt") || return 4
        _source_release_resume_receipt_matches "$resume_receipt" "$receipt_dir" "$tool" "$tag" "$saved_fingerprint" || return 4
        jq -e --arg repo "$repo" --arg notes "$notes_sha" --arg config "$config_sha" \
            --arg registry "$registry_sha" --argjson draft "$draft" '
            .publication_mode == "source-only" and .status == "pending" and
            .repo == $repo and .notes_sha256 == $notes and .config_sha256 == $config and
            ((.registry_sha256 == $registry) or (.registry_sha256 == null and $registry == "absent")) and
            (.requested_draft == null or .requested_draft == $draft)
        ' <<< "$saved_receipt" >/dev/null || return 4
        nonce=$(jq -er '.metadata.body | capture("\\n\\n<!-- dsr-source-only-create:(?<nonce>[0-9a-f]{64}) -->$").nonce' \
            <<< "$saved_receipt") || return 4
        [[ "$(jq -r '.count' <<< "$scan")" == 1 ]] || return 7
    else
        [[ "$(jq -r '.count' <<< "$scan")" == 0 ]] || {
            log_error "Source-only release already exists; refusing to replace or adopt it"
            return 4
        }
        nonce=$(_release_contract_create_nonce) || return 4
    fi
    title="$tag (source only)"
    expected=$(jq -n --arg tag "$tag" --arg title "$title" --arg sha "$sha" \
        --arg nonce "$nonce" --argjson notes "$notes_json" --argjson prerelease "$prerelease" '
        {tag_name:$tag,name:$title,target_commitish:$sha,prerelease:$prerelease,
         body:($notes.body + "\n\n<!-- dsr-source-only-create:" + $nonce + " -->")}
    ') || return 4
    if [[ -n "$resume_receipt" ]]; then
        jq -e --argjson expected "$expected" '.metadata == $expected' <<< "$saved_receipt" >/dev/null || return 4
        release=$(jq -c '.release' <<< "$scan") || return 7
        release_id=$(jq -r '.id // empty' <<< "$release") || return 7
        [[ "$release_id" =~ ^[1-9][0-9]*$ ]] || return 7
        _source_release_metadata_matches "$release" "$expected" "$release_id" true || return 7
        _source_release_observe "$repo" "$release_id" "$expected" true >/dev/null || return 7
        resume_release_id="$release_id"
    fi
    body=$(jq -r '.body' <<< "$expected") || return 4
    if $DRY_RUN; then
        log_info "Would publish exact source $sha as $repo $tag with zero assets"
        $JSON_MODE && json_envelope "release source-only" "success" 0 "$expected"
        return 0
    fi
    mkdir -p "$receipt_dir" || return 7
    local receipt=""
    receipt=$(mktemp "$receipt_dir/$tool-$tag.json.XXXXXXXX") || return 7
    jq -n --argjson expected "$expected" --arg repo "$repo" --arg notes_sha "$notes_sha" \
        --arg config_sha "$config_sha" --arg registry_sha "$registry_sha" --argjson draft "$draft" \
        --arg resumed_from "$resume_receipt" --arg resumed_sha "$saved_sha" '
        {publication_mode:"source-only",repo:$repo,metadata:$expected,notes_sha256:$notes_sha,
         config_sha256:$config_sha,registry_sha256:$registry_sha,requested_draft:$draft,
         resumed_from:$resumed_from,resumed_receipt_sha256:$resumed_sha,status:"pending"}' \
        > "$receipt" || return 7
    _source_release_identity "$repo" "$path" "$tag" "$sha" || return 4
    _source_release_inputs_match "$config_file" "$config_sha" "$notes" "$notes_sha" \
        "$registry" "$registry_sha" || return 4
    # Create only as draft. A transport failure is reconciled by the unique
    # nonce-bound metadata, never by accepting someone else's same-tag draft.
    if [[ -n "$resume_receipt" ]]; then
        _source_release_resume_receipt_matches "$resume_receipt" "$receipt_dir" "$tool" "$tag" "$saved_fingerprint" || return 4
    else
        local -a create_args=("$repo" "$tag" --name "$title" --body "$body" --draft --target-commitish "$sha")
        $prerelease && create_args+=(--prerelease)
        GH_MAX_RETRIES=1 gh_create_release "${create_args[@]}" >/dev/null || true
    fi
    scan=$(_source_release_scan_created "$repo" "$tag") || return 7
    release=$(jq -c '.release' <<< "$scan") || return 7
    release_id=$(jq -r '.id // empty' <<< "$release") || return 7
    [[ "$release_id" =~ ^[1-9][0-9]*$ ]] || return 7
    [[ -z "$resume_release_id" || "$release_id" == "$resume_release_id" ]] || return 7
    _source_release_metadata_matches "$release" "$expected" "$release_id" true || return 7
    if ! _source_release_observe "$repo" "$release_id" "$expected" true >/dev/null ||
       ! _source_release_resume_receipt_matches "$resume_receipt" "$receipt_dir" "$tool" "$tag" "$saved_fingerprint" ||
       ! _source_release_identity "$repo" "$path" "$tag" "$sha" ||
       ! _source_release_inputs_match "$config_file" "$config_sha" "$notes" "$notes_sha" \
            "$registry" "$registry_sha"; then
        _source_release_restore_draft "$repo" "$release_id" "$expected" || true
        return 7
    fi
    if ! $draft; then
        gh_api "repos/$repo/releases/$release_id" --method PATCH --data '{"draft":false}' \
            --no-cache >/dev/null 2>&1 || true
    fi
    if ! release=$(_source_release_observe "$repo" "$release_id" "$expected" "$draft") ||
       ! _source_release_resume_receipt_matches "$resume_receipt" "$receipt_dir" "$tool" "$tag" "$saved_fingerprint" ||
       ! _source_release_identity "$repo" "$path" "$tag" "$sha" ||
       ! _source_release_inputs_match "$config_file" "$config_sha" "$notes" "$notes_sha" \
            "$registry" "$registry_sha"; then
        _source_release_restore_draft "$repo" "$release_id" "$expected" || true
        return 7
    fi
    jq -n --arg repo "$repo" --arg tag "$tag" --arg sha "$sha" \
        --arg notes_sha "$notes_sha" --arg config_sha "$config_sha" --arg registry_sha "$registry_sha" \
        --arg resumed_from "$resume_receipt" --arg resumed_sha "$saved_sha" \
        --argjson expected "$expected" --argjson release "$release" '
        {publication_mode:"source-only",repo:$repo,tag:$tag,git_sha:$sha,
         notes_sha256:$notes_sha,config_sha256:$config_sha,registry_sha256:$registry_sha,
         metadata:$expected,asset_count:0,release_id:$release.id,
         resumed_from:$resumed_from,resumed_receipt_sha256:$resumed_sha,
         draft:$release.draft,url:$release.html_url,status:"success"}
    ' > "$receipt" || {
        _source_release_restore_draft "$repo" "$release_id" "$expected" || true
        return 7
    }
    log_info "Verified source-only release $repo $tag; receipt: $receipt"
    $JSON_MODE && json_envelope "release source-only" "success" 0 "$(cat "$receipt")"
    return 0
}

cmd_release() {
    local tool_name=""
    local version=""
    local artifacts_dir=""
    local draft=false
    local requested_draft=false
    local prerelease=false
    local generate_notes=false
    local verify_tag=false
    local resume=false
    local verify_upgrade=false
    local dispatch_override=""
    local dispatch_event_override=""
    local dispatch_repos_override=""
    local allow_no_manifest=false
    local release_tag_sha=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tool|-t|--repo)
                tool_name="$2"
                shift 2
                ;;
            --version|-V)
                version="$2"
                shift 2
                ;;
            --artifacts|--artifacts-dir|-a)
                artifacts_dir="$2"
                shift 2
                ;;
            --draft)
                draft=true
                shift
                ;;
            --prerelease)
                prerelease=true
                shift
                ;;
            --generate-notes)
                generate_notes=true
                shift
                ;;
            --verify-tag)
                verify_tag=true
                shift
                ;;
            --no-manifest)
                allow_no_manifest=true
                shift
                ;;
            --resume|-r)
                resume=true
                shift
                ;;
            --verify-upgrade)
                verify_upgrade=true
                shift
                ;;
            --dispatch)
                dispatch_override="true"
                shift
                ;;
            --no-dispatch)
                dispatch_override="false"
                shift
                ;;
            --dispatch-event)
                dispatch_event_override="$2"
                shift 2
                ;;
            --dispatch-repos)
                dispatch_repos_override="$2"
                shift 2
                ;;
            --help|-h)
                cat << 'EOF'
dsr release - Upload artifacts to GitHub

USAGE:
    dsr release <tool> <version>
    dsr release <tool> <version> --artifacts <dir>
    dsr release <tool> <version> --draft
    dsr release verify <tool> <version>   (verify existing release)

SUBCOMMANDS:
    verify    Verify release assets against build manifest

OPTIONS:
    -t, --tool <name>        Tool to release (or first positional arg)
        --repo <name>        Alias for --tool
    -V, --version <ver>      Version to release (or second positional arg)
    -a, --artifacts <dir>    Directory containing build artifacts
    --draft                  Create as draft release
    --prerelease             Mark as prerelease
    --generate-notes         Auto-generate release notes
    --verify-tag             Verify tag exists before release
    --no-manifest            Upload the artifacts directory as-is when it has no
                             build manifest (dsr build writes one only after
                             every target succeeded; without it the directory
                             may hold a partial build, and no checksums are made)
    --verify-upgrade         Run upgrade verification after successful release
    --dispatch               Trigger repository dispatch after release
    --no-dispatch            Disable repository dispatch for this run
    --dispatch-event <name>  Override dispatch event type
    --dispatch-repos <list>  Comma-separated override of dispatch targets
    -r, --resume             Resume interrupted upload

DESCRIPTION:
    Creates a GitHub Release and uploads all build artifacts including
    binaries, checksums, and signatures. Uses manifest from build phase
    to verify completeness.

REQUIRED INPUTS:
    - Build manifest (source of truth from dsr build)
    - Checksums + signatures (from signing module)
    - Existing git tag for the version

EXAMPLES:
    dsr release ntm 1.2.3                   Create release v1.2.3
    dsr release ntm 1.2.3 --draft           Create as draft
    dsr release ntm 1.2.3 --verify-upgrade  Release + verify upgrade works
    dsr release ntm 1.2.3 --dispatch        Release + dispatch downstream workflows
    dsr release ntm 1.2.3 --resume          Resume interrupted upload
    dsr release verify ntm 1.2.3            Verify release assets
    dsr release --tool bv --version 2.0.0   Full flag syntax

EXIT CODES:
    0  - Release created successfully
    1  - Some assets failed to upload
    3  - Authentication error
    4  - Invalid arguments
    7  - Release creation failed
EOF
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                log_info "Run 'dsr release --help' for usage"
                return 4
                ;;
            *)
                # Positional arguments: tool, version
                if [[ -z "$tool_name" ]]; then
                    tool_name="$1"
                elif [[ -z "$version" ]]; then
                    version="$1"
                fi
                shift
                ;;
        esac
    done
    requested_draft=$draft

    # Validate required arguments
    if [[ -z "$tool_name" ]]; then
        log_error "Tool name required"
        log_info "Run 'dsr release --help' for usage"
        return 4
    fi

    if [[ -z "$version" ]]; then
        log_error "Version required"
        log_info "Run 'dsr release --help' for usage"
        return 4
    fi

    # Check GitHub authentication
    if ! gh_check 2>/dev/null; then
        if ! gh_check_token 2>/dev/null; then
            log_error "GitHub authentication required"
            log_info "Run: gh auth login"
            if $JSON_MODE; then
                json_envelope "release" "error" 3 '{"error": "GitHub authentication required"}'
            fi
            return 3
        fi
    fi

    # Load tool configuration
    if ! act_load_repo_config "$tool_name" 2>/dev/null; then
        log_error "Tool '$tool_name' not found in repos.d"
        log_info "Available tools: $(act_list_tools 2>/dev/null | tr '\n' ' ')"
        return 4
    fi

    if [[ "${ACT_REPO_PUBLICATION_MODE:-}" == source-only ]]; then
        log_error "Source-only configuration requires 'dsr release source-only'"
        return 4
    fi

    _dsr_require artifact_naming

    # Get repository info
    local repo local_path
    repo=$(act_get_repo "$tool_name")
    local_path=$(act_get_local_path "$tool_name")

    if [[ -z "$repo" ]]; then
        log_error "No GitHub repo configured for $tool_name"
        return 4
    fi

    # Resolve owner/repo if short name
    if [[ ! "$repo" =~ / ]]; then
        repo="Dicklesworthstone/$repo"
    fi

    # Normalize version tag
    local tag
    tag=$(git_ops_version_to_tag "$version")

    local release_contract_json="null"
    local release_contract_enabled=false
    if declare -F config_get_release_contract_json &>/dev/null; then
        if ! config_validate_release_contract "$tool_name"; then
            log_error "Release contract validation failed for $tool_name"
            return 4
        fi
        release_contract_json=$(config_get_release_contract_json "$tool_name") || return $?
        if [[ "$release_contract_json" != "null" ]]; then
            release_contract_enabled=true
        fi
    fi

    log_info "Releasing $tool_name $version to $repo"
    log_set_tool "$tool_name"

    # Verify tag exists (if requested or local_path available)
    if $verify_tag || [[ -n "$local_path" && -d "$local_path" ]]; then
        if [[ -n "$local_path" && -d "$local_path" ]]; then
            if ! git_ops_tag_exists "$local_path" "$tag"; then
                log_error "Tag $tag does not exist in $local_path"
                log_info "Create with: dsr version tag $tool_name"
                return 4
            fi
            release_tag_sha=$(git_ops_tag_sha "$local_path" "$tag" 2>/dev/null) || release_tag_sha=""
            log_info "Tag $tag verified locally${release_tag_sha:+ ($release_tag_sha)}"
            # GitHub creates a missing tag at target_commitish, else at the
            # default branch head. Origin already holding a different commit
            # under this tag would publish other source than was tagged here.
            local origin_tags origin_tag_sha=""
            if [[ -n "$release_tag_sha" ]] && ! $release_contract_enabled &&
               origin_tags=$(git -C "$local_path" ls-remote --tags origin \
                    "refs/tags/$tag" "refs/tags/$tag^{}" 2>/dev/null); then
                origin_tag_sha=$(awk -v peeled="refs/tags/$tag^{}" -v ref="refs/tags/$tag" '
                    $2 == peeled { p = $1 } $2 == ref { d = $1 } END { print (p != "" ? p : d) }' <<< "$origin_tags")
                if [[ -n "$origin_tag_sha" && "$origin_tag_sha" != "$release_tag_sha" ]]; then
                    log_error "origin's $tag is $origin_tag_sha but the local $tag is $release_tag_sha"
                    return 4
                fi
            fi
        elif $verify_tag; then
            # User explicitly requested verification but no local path available
            log_warn "Cannot verify tag: local_path not configured for $tool_name"
            log_info "Tag verification skipped (GitHub will validate on release)"
        fi
    fi

    # Determine artifacts directory
    local state_dir="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}"
    if [[ -z "$artifacts_dir" ]]; then
        artifacts_dir="$state_dir/artifacts/${tool_name}-${tag}"
    fi

    if [[ ! -d "$artifacts_dir" ]]; then
        log_error "Artifacts directory not found: $artifacts_dir"
        log_info "Run 'dsr build $tool_name --version $version' first"
        return 4
    fi

    _release_require_publishable_artifacts "$artifacts_dir" \
        "$artifacts_dir/${tool_name}-${tag}-manifest.json" false || return 4

    # Find manifest
    local manifest_file="$artifacts_dir/${tool_name}-${tag}-manifest.json"
    if [[ ! -f "$manifest_file" ]]; then
        # Try alternate location
        manifest_file="$state_dir/artifacts/${tool_name}-${tag}-manifest.json"
    fi

    local manifest_exists=false
    if [[ -f "$manifest_file" ]]; then
        manifest_exists=true
        log_info "Using manifest: $manifest_file"
    elif $release_contract_enabled; then
        log_error "Strict release contract requires manifest: $manifest_file"
        return 4
    elif ! $allow_no_manifest; then
        # dsr build withholds the manifest until every target succeeded, so a
        # directory without one may hold a partial build.
        log_error "No build manifest for $tool_name $tag in $artifacts_dir"
        log_info "dsr build writes it only when every target succeeds; re-run 'dsr build $tool_name --version $version'"
        log_info "To upload this directory as-is (no completeness check, no checksums), pass --no-manifest"
        return 4
    else
        log_warn "No manifest (--no-manifest): uploading every file in $artifacts_dir"
    fi
    _release_require_publishable_artifacts "$artifacts_dir" "$manifest_file" \
        "$release_contract_enabled" || return 4

    # Saved upload names are not evidence that GitHub still serves these bytes.
    # Freeze the ordinary manifest and verify every required local artifact
    # before creating a release or replacing any generated checksum sidecars.
    local ordinary_manifest='null'
    local -A ordinary_expected_sha=()
    local -a ordinary_files=()
    if ! $release_contract_enabled && $manifest_exists; then
        if [[ -L "$manifest_file" ]] || ! ordinary_manifest=$(jq -ces '
            if length == 1 and (.[0] | type == "object") and
               (.[0].artifacts | type == "array" and length > 0) and
               all(.[0].artifacts[];
                   type == "object" and
                   ((.name // .filename) | type == "string" and
                       test("^[A-Za-z0-9][A-Za-z0-9._+-]*$")) and
                   (.target_triple == null or
                       (.target_triple | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._+-]*$"))) and
                   (.sha256 | type == "string" and test("^[0-9a-f]{64}$")))
            then .[0] else error("invalid release manifest") end
        ' "$manifest_file" 2>/dev/null); then
            log_error "Release requires one valid, nonempty artifact manifest"
            return 4
        fi
        if ! jq -e --arg tool "$tool_name" --arg tag "$tag" '
            (.tool == null or .tool == $tool) and
            (.version == null or (.version | ltrimstr("v")) == ($tag | ltrimstr("v"))) and
            (.status == null or .status == "success") and
            (.summary.failed == null or .summary.failed == 0)
        ' <<< "$ordinary_manifest" >/dev/null; then
            log_error "Manifest does not describe a successful build of $tool_name $tag"
            return 4
        fi
        _act_validate_native_manifest_inventory "$tool_name" "$ordinary_manifest" || return 4
        # The binaries must come from the commit the tag names, not whatever
        # the checkout held when they were built.
        local manifest_git_sha
        manifest_git_sha=$(jq -r '.source.git_sha // empty' <<< "$ordinary_manifest")
        if [[ -n "$release_tag_sha" && -n "$manifest_git_sha" && "$manifest_git_sha" != "$release_tag_sha" ]]; then
            log_error "Artifacts were built from $manifest_git_sha, but $tag is $release_tag_sha"
            log_info "Check out $tag and rebuild: dsr build $tool_name --version $version"
            return 4
        fi
        local required_name required_sha actual_sha
        while IFS=$'\t' read -r required_name required_sha; do
            if [[ ! -s "$artifacts_dir/$required_name" || -L "$artifacts_dir/$required_name" ]] ||
               ! actual_sha=$(_gh_asset_sha256 "$artifacts_dir/$required_name") ||
               [[ "$actual_sha" != "$required_sha" ]]; then
                log_error "Required artifact is missing or differs from the manifest: $required_name"
                return 4
            fi
            ordinary_expected_sha["$required_name"]="$required_sha"
        done < <(jq -r '.artifacts[] | [(.name // .filename), .sha256] | @tsv' <<< "$ordinary_manifest")
        ordinary_expected_sha["${manifest_file##*/}"]=$(_gh_asset_sha256 "$manifest_file") || return 4
    elif ! $release_contract_enabled; then
        local ordinary_file ordinary_name
        while IFS= read -r -d '' ordinary_file; do
            ordinary_name="${ordinary_file##*/}"
            if [[ ! "$ordinary_name" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ||
                  ! -s "$ordinary_file" || -L "$ordinary_file" ]]; then
                log_error "Invalid or empty release artifact: $ordinary_name"
                return 4
            fi
            ordinary_expected_sha["$ordinary_name"]=$(_gh_asset_sha256 "$ordinary_file") || return 4
            ordinary_files+=("$ordinary_file")
        done < <(find "$artifacts_dir" -maxdepth 1 -type f -print0)
        if [[ ${#ordinary_files[@]} -eq 0 ]]; then
            log_error "No release artifacts were selected"
            return 4
        fi
    fi

    # Freeze user-visible release metadata before the strict upload plan is
    # computed. The same object is required at creation and every remote check.
    local release_body="Release $version"
    if $generate_notes && [[ -n "$local_path" && -d "$local_path" ]]; then
        local prev_tag
        prev_tag=$(git -C "$local_path" describe --tags --abbrev=0 "$tag^" 2>/dev/null || echo "")
        if [[ -n "$prev_tag" ]]; then
            local commit_log
            commit_log=$(git -C "$local_path" log --oneline "$prev_tag..$tag" 2>/dev/null | head -20)
            if [[ -n "$commit_log" ]]; then
                release_body="## Changes since $prev_tag"$'\n\n'"$commit_log"
            fi
        fi
    fi

    if $release_contract_enabled; then
        local release_create_nonce=""
        release_create_nonce=$(_release_contract_create_nonce) || {
            log_error "Could not generate a cryptographic strict-release create nonce"
            return 4
        }
        release_body+=$'\n\n'"<!-- dsr-create-nonce:$release_create_nonce -->"
    fi

    local release_contract_plan='{}'
    local release_contract_metadata_json='null'
    local release_contract_git_sha=""
    local release_contract_tag_ruleset_receipt='null'
    if $release_contract_enabled; then
        local contract_sidecar_mode="create"
        $DRY_RUN && contract_sidecar_mode="plan"
        if ! release_contract_plan=$(_release_contract_preflight \
            "$tool_name" "$tag" "$repo" "$local_path" "$artifacts_dir" \
            "$manifest_file" "$release_contract_json" "$contract_sidecar_mode"); then
            return 4
        fi
        release_contract_git_sha=$(jq -r '.git_sha' <<< "$release_contract_plan")
        release_contract_tag_ruleset_receipt=$(jq -c \
            '.tag_ruleset_receipt' <<< "$release_contract_plan") || return 4
        release_contract_metadata_json=$(jq -nc \
            --arg tag_name "$tag" \
            --arg name "$tag" \
            --arg body "$release_body" \
            --arg target_commitish "$release_contract_git_sha" \
            --argjson prerelease "$prerelease" \
            --argjson requested_draft "$requested_draft" '
            {
                tag_name: $tag_name,
                name: $name,
                body: $body,
                target_commitish: $target_commitish,
                prerelease: $prerelease,
                requested_draft: $requested_draft
            }') || return 4
        release_contract_plan=$(jq -c \
            --argjson release "$release_contract_metadata_json" \
            '. + {release: $release}' <<< "$release_contract_plan") || return 4
        log_ok "Strict release contract preflight passed"
    fi

    # Every name one manifest artifact could be published under: the manifest
    # name, then its versioned and installer-compatible names and the
    # x86_64/aarch64 spelling of the compat name, all rendered for the variant
    # (target triple) the artifact belongs to (bd-cdcz), so a musl build of
    # linux/amd64 never takes the gnu build's names.
    _release_artifact_candidate_names() {
        local filename="$1" target="$2" format="$3" triple="${4:-}"
        local -a names=("$filename")
        local os arch ext names_json versioned compat alias candidate existing duplicate
        if [[ "$target" == */* ]]; then
            os="${target%/*}"
            arch="${target#*/}"
            if [[ -z "$triple" ]]; then
                triple=$(artifact_naming_artifact_variant "$tool_name" "$os" "$arch" "$filename") || return 4
                triple="${triple%%$'\t'*}"
            fi
            ext="$format"
            case "$ext" in
                none) ext="" ;;
                # Only Windows raw binary names carry an extension.
                binary) ext=""; [[ "$os" == windows ]] && ext="exe" ;;
            esac
            if [[ -z "$ext" && "$format" != binary ]]; then
                case "$filename" in
                    *.tar.gz) ext="tar.gz" ;;
                    *.tgz) ext="tgz" ;;
                    *.tar.xz) ext="tar.xz" ;;
                    *.zip) ext="zip" ;;
                    *.exe) ext="exe" ;;
                esac
            fi
            names_json=""
            if [[ ( -n "$ext" || "$format" == binary ) && -n "$triple" ]]; then
                names_json=$(artifact_naming_generate_dual_for_variant \
                    "$tool_name" "$version" "$os" "$arch" "$ext" "$local_path" "$triple") || return 4
            elif [[ -n "$ext" || "$format" == binary ]]; then
                names_json=$(artifact_naming_generate_dual_for_tool \
                    "$tool_name" "$version" "$os" "$arch" "$ext" "$local_path") || return 4
            fi
            if [[ -n "$names_json" ]]; then
                versioned=$(jq -r '.versioned // empty' <<< "$names_json" 2>/dev/null) || versioned=""
                compat=$(jq -r '.compat // empty' <<< "$names_json" 2>/dev/null) || compat=""
                alias=""
                case "$arch" in
                    amd64) alias="${compat//-amd64/-x86_64}"; alias="${alias//_amd64/_x86_64}" ;;
                    arm64) alias="${compat//-arm64/-aarch64}"; alias="${alias//_arm64/_aarch64}" ;;
                esac
                for candidate in "$versioned" "$compat" "$alias"; do
                    [[ -n "$candidate" ]] || continue
                    duplicate=false
                    for existing in "${names[@]}"; do
                        if [[ "$existing" == "$candidate" ]]; then
                            duplicate=true
                            break
                        fi
                    done
                    $duplicate || names+=("$candidate")
                done
            fi
        fi
        printf '%s\n' "${names[@]}"
    }

    # Resolve the upload names of every manifest artifact together. Variants
    # whose naming pattern cannot tell them apart (no ${target_triple}) still
    # derive the same compat name; a name claimed by artifacts with different
    # bytes goes to the artifact it already names, else to the platform's
    # primary variant, else to none, instead of failing the release on a
    # same-name collision or letting manifest order pick the bytes.
    local -A release_upload_plan=() release_artifact_triples=()
    _release_plan_upload_names() {
        local -A claimants=() rank=() sha_of=() artifact_candidates=()
        local -a order=()
        local a_name a_sha a_target a_format a_triple variant triple how primary candidate configured
        while IFS=$'\t' read -r a_name a_sha a_target a_format a_triple; do
            [[ "$a_target" == "-" ]] && a_target=""
            [[ "$a_format" == "-" ]] && a_format=""
            [[ "$a_triple" == "-" ]] && a_triple=""
            [[ -n "$a_name" ]] || continue
            if [[ -n "${sha_of[$a_name]+set}" ]]; then
                log_error "Duplicate artifact name in release manifest: $a_name"
                return 4
            fi
            order+=("$a_name")
            sha_of["$a_name"]="$a_sha"
            triple="" how="" rank["$a_name"]=2
            configured='[]'
            if [[ "$a_target" == */* ]] && declare -F config_get_target_triples_json &>/dev/null; then
                configured=$(config_get_target_triples_json "$tool_name" "$a_target") || return 4
                if [[ $(jq 'length' <<< "$configured") -gt 1 && -z "$a_triple" ]]; then
                    log_error "Multi-variant artifact $a_name must retain its target_triple in the build manifest"
                    return 4
                fi
                if [[ -n "$a_triple" && $(jq 'length' <<< "$configured") -gt 0 ]] &&
                   ! jq -e --arg triple "$a_triple" 'index($triple) != null' <<< "$configured" >/dev/null; then
                    log_error "Declared target_triple for $a_name is not configured for $a_target: $a_triple"
                    return 4
                fi
            fi
            if [[ -n "$a_triple" && "$a_target" != */* ]]; then
                log_error "Manifest artifact $a_name has a target_triple without a platform"
                return 4
            fi
            if [[ "$a_target" == */* ]]; then
                if ! variant=$(artifact_naming_artifact_variant \
                        "$tool_name" "${a_target%/*}" "${a_target#*/}" "$a_name"); then
                    log_error "Cannot reconcile target_triple with artifact name: $a_name"
                    return 4
                fi
                triple="${variant%%$'\t'*}"
                how="${variant#*$'\t'}"
                if [[ -n "$a_triple" && ( "$how" == triple || "$how" == libc ) && "$a_triple" != "$triple" ]]; then
                    log_error "Declared target_triple for $a_name contradicts the artifact's variant name"
                    return 4
                fi
                if [[ "$how" == unknown ]]; then
                    log_error "Cannot identify the declared variant of release artifact $a_name"
                    return 4
                fi
                [[ -z "$a_triple" ]] || triple="$a_triple"
                primary=$(config_get_target_triple "$tool_name" "$a_target" 2>/dev/null) || primary=""
                if [[ -n "$primary" && "$triple" != "$primary" ]]; then
                    rank["$a_name"]=1
                fi
                log_debug "Release variant for $a_name: $triple ($how)"
            fi
            [[ -z "$a_triple" ]] || triple="$a_triple"
            release_artifact_triples["$a_name"]="$triple"
            artifact_candidates["$a_name"]=$(_release_artifact_candidate_names \
                "$a_name" "$a_target" "$a_format" "$triple") || return 4
            while IFS= read -r candidate; do
                [[ -n "$candidate" ]] || continue
                claimants["$candidate"]+="$a_name"$'\n'
            done <<< "${artifact_candidates[$a_name]}"
        done < <(jq -r 'def field: if . == null or . == "" then "-" else . end;
            .artifacts[] | [(.name // .filename), .sha256, (.target | field), (.archive_format | field), (.target_triple | field)] | @tsv' \
            <<< "$ordinary_manifest")

        local claimant winner best best_count distinct_sha first_sha
        local -A reported=()
        for a_name in "${order[@]}"; do
            local planned=""
            while IFS= read -r candidate; do
                [[ -n "$candidate" ]] || continue
                winner="" distinct_sha=false first_sha=""
                while IFS= read -r claimant; do
                    [[ -n "$claimant" ]] || continue
                    [[ -z "$first_sha" ]] && first_sha="${sha_of[$claimant]}"
                    [[ "${sha_of[$claimant]}" != "$first_sha" ]] && distinct_sha=true
                done <<< "${claimants[$candidate]}"
                if $distinct_sha; then
                    if [[ -n "${sha_of[$candidate]+set}" ]]; then
                        winner="$candidate"
                    else
                        best=-1 best_count=0
                        while IFS= read -r claimant; do
                            [[ -n "$claimant" ]] || continue
                            if [[ ${rank[$claimant]} -gt $best ]]; then
                                best=${rank[$claimant]} best_count=1 winner="$claimant"
                            elif [[ ${rank[$claimant]} -eq $best && "${sha_of[$claimant]}" != "${sha_of[$winner]}" ]]; then
                                best_count=$((best_count + 1))
                            fi
                        done <<< "${claimants[$candidate]}"
                        [[ $best_count -eq 1 ]] || winner=""
                    fi
                    if [[ -z "${reported[$candidate]:-}" ]]; then
                        reported["$candidate"]=1
                        if [[ -n "$winner" ]]; then
                            log_info "Upload name $candidate is derived by several variants; publishing it as $winner"
                        else
                            log_warn "Upload name $candidate is derived by several variants with no primary among them; not publishing it"
                        fi
                    fi
                    [[ "$winner" == "$a_name" ]] || continue
                fi
                planned+="$candidate"$'\n'
            done <<< "${artifact_candidates[$a_name]}"
            release_upload_plan["$a_name"]="$planned"
        done
    }

    # The names one manifest artifact is published under. SHA256SUMS, the
    # upload loop and the dry-run plan all use this list, so a plan always
    # matches what is uploaded.
    _release_artifact_upload_names() {
        local filename="$1" target="$2" format="$3"
        if [[ -n "${release_upload_plan[$filename]+set}" ]]; then
            printf '%s' "${release_upload_plan[$filename]}"
            return 0
        fi
        _release_artifact_candidate_names "$filename" "$target" "$format"
    }

    if [[ "$ordinary_manifest" != null ]]; then
        _release_plan_upload_names || return 4
    fi

    # Check the resolved ownership plan before any GitHub mutation. Shared
    # aliases keep their configured primary owner, but explicit artifact
    # bytes cannot collide with metadata or generated checksum names. Freeze
    # this inventory for the dry-run, checksums and actual upload loop.
    local -A ordinary_upload_names=() ordinary_alias_sha=() ordinary_alias_owner=()
    local -A ordinary_generated_names=()
    local -a ordinary_extra_files=()
    if ! $release_contract_enabled && $manifest_exists; then
        local row_name resolved_names alias_name alias_sha
        while IFS= read -r row_name; do
            resolved_names="${release_upload_plan[$row_name]%$'\n'}"
            ordinary_upload_names["$row_name"]="$resolved_names"
            alias_sha="${ordinary_expected_sha[$row_name]}"
            while IFS= read -r alias_name; do
                [[ -n "$alias_name" ]] || continue
                if [[ ! "$alias_name" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]; then
                    log_error "Unsafe upload name for $row_name: $alias_name"
                    return 4
                fi
                if [[ -n "${ordinary_alias_sha[$alias_name]:-}" && "${ordinary_alias_sha[$alias_name]}" != "$alias_sha" ]]; then
                    log_error "Upload name $alias_name maps to different artifact contents: ${ordinary_alias_owner[$alias_name]} and $row_name"
                    return 4
                fi
                ordinary_alias_sha["$alias_name"]="$alias_sha"
                ordinary_alias_owner["$alias_name"]="$row_name"
                ordinary_generated_names["$alias_name.sha256"]=1
            done <<< "$resolved_names"
        done < <(jq -r '.artifacts[] | .name // .filename' <<< "$ordinary_manifest")

        ordinary_generated_names[SHA256SUMS]=1
        for alias_name in "${!ordinary_generated_names[@]}" "${manifest_file##*/}"; do
            if [[ -n "${ordinary_alias_sha[$alias_name]:-}" ]]; then
                log_error "Artifact upload name $alias_name collides with release metadata or a generated checksum"
                return 4
            fi
            if [[ -L "$artifacts_dir/$alias_name" ||
                  ( -e "$artifacts_dir/$alias_name" && ! -f "$artifacts_dir/$alias_name" ) ]]; then
                log_error "Release metadata path must be a regular file: $alias_name"
                return 4
            fi
        done
        ordinary_extra_files+=("$manifest_file")
        local extra_file extra_name extra_sha
        while IFS= read -r -d '' extra_file; do
            extra_name="${extra_file##*/}"
            [[ -z "${ordinary_generated_names[$extra_name]:-}" ]] || continue
            [[ "$extra_file" != "$manifest_file" ]] || continue
            if [[ ! "$extra_name" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ||
                  ! -s "$extra_file" || -L "$extra_file" ]] ||
               ! extra_sha=$(_gh_asset_sha256 "$extra_file"); then
                log_error "Invalid release sidecar: $extra_name"
                return 4
            fi
            if [[ -n "${ordinary_alias_sha[$extra_name]:-}" && "${ordinary_alias_sha[$extra_name]}" != "$extra_sha" ]]; then
                log_error "Upload name $extra_name collides with an existing release sidecar"
                return 4
            fi
            ordinary_expected_sha["$extra_name"]="$extra_sha"
            ordinary_extra_files+=("$extra_file")
        done < <(find "$artifacts_dir" -maxdepth 1 -type f \
            \( -name 'SHA256SUMS*' -o -name '*.sha256' -o -name '*.minisig' -o -name '*.sbom.*' -o -name '*.intoto.jsonl' \) -print0)
    fi

    # Check the names a project's own curl|bash installer downloads against the
    # published (or planned) asset names read from stdin, one per line
    # (bd-1tv.10). Windows targets are installed by other means. Prints one
    # JSON report; never fails the release, since an installer is the
    # project's code, not a release input.
    _release_installer_check() {
        local -A names_present=()
        local -a expected=()
        local name target format target_triple os arch ext expectation expected_name script=""
        while IFS= read -r name; do
            [[ -n "$name" ]] && names_present["$name"]=1
        done
        if ! $manifest_exists || [[ -z "$local_path" || ! -d "$local_path" ]]; then
            jq -nc '{status: "skipped", reason: "no manifest or local checkout"}'
            return 0
        fi
        while IFS=$'\t' read -r name target format target_triple; do
            [[ "$target" == "-" ]] && target=""
            [[ "$format" == "-" ]] && format=""
            [[ "$target_triple" == "-" ]] && target_triple=""
            [[ -n "$target_triple" ]] || target_triple="${release_artifact_triples[$name]:-}"
            [[ "$target" == */* ]] || continue
            os="${target%/*}"
            arch="${target#*/}"
            [[ "$os" == windows ]] && continue
            ext="$format"
            case "$ext" in none|binary) ext="" ;; esac
            if [[ -z "$ext" ]]; then
                case "$name" in
                    *.tar.gz) ext="tar.gz" ;;
                    *.tgz) ext="tgz" ;;
                    *.tar.xz) ext="tar.xz" ;;
                    *.zip) ext="zip" ;;
                esac
            fi
            expectation=$(artifact_naming_installer_expected_name "$tool_name" "$version" \
                "$os" "$arch" "$ext" "$local_path" "$target_triple" 2>/dev/null) || continue
            expected_name=$(jq -r '.name' <<< "$expectation") || continue
            script=$(jq -r '.script' <<< "$expectation") || continue
            expected+=("$(jq -c --arg target "$target" --arg target_triple "$target_triple" --argjson present \
                "$([[ -n "${names_present[$expected_name]:-}" ]] && echo true || echo false)" \
                '{target: $target, name, present: $present, ext_mismatch} +
                 (if $target_triple == "" then {} else {target_triple: $target_triple} end)' <<< "$expectation")")
        done < <(jq -r 'def field: if . == null or . == "" then "-" else . end;
            .artifacts[] | [(.name // .filename), (.target | field), (.archive_format | field), (.target_triple | field)] | @tsv' \
            <<< "$ordinary_manifest")
        if [[ ${#expected[@]} -eq 0 ]]; then
            jq -nc '{status: "skipped", reason: "no installer download pattern found"}'
            return 0
        fi
        printf '%s\n' "${expected[@]}" | jq -sc --arg script "$script" '
            unique_by(.target, .target_triple, .name) as $expected |
            {status: (if all($expected[]; .present) then "ok" else "mismatch" end),
             script: $script, expected: $expected,
             missing: [$expected[] | select(.present | not) | .name]}'
    }

    _release_report_installer_check() {
        local report="$1" missing
        case "$(jq -r '.status' <<< "$report")" in
            ok)
                log_ok "Installer $(jq -r '.script' <<< "$report") finds every asset it downloads"
                ;;
            mismatch)
                while IFS= read -r missing; do
                    log_warn "Installer $(jq -r '.script' <<< "$report") downloads $missing, which this release does not publish"
                done < <(jq -r '.missing[]' <<< "$report")
                if jq -e 'any(.expected[]; .ext_mismatch)' <<< "$report" >/dev/null; then
                    log_warn "  The installer hardcodes a different archive extension than this release builds"
                fi
                log_warn "  Fix install.sh or set install_script_compat in repos.d/$tool_name.yaml, then check with: dsr repos validate"
                ;;
        esac
    }

    # Dry-run mode: show planned actions and exit
    if $DRY_RUN; then
        log_info "[dry-run] Would execute release:"
        log_info "  Tool:        $tool_name"
        log_info "  Version:     $tag"
        log_info "  Repo:        $repo"
        log_info "  Artifacts:   $artifacts_dir"
        log_info "  Manifest:    $($manifest_exists && echo "$manifest_file" || echo "(none)")"
        if $release_contract_enabled; then
            if $requested_draft; then
                log_info "  Draft:       retained after exact remote verification"
            else
                log_info "  Draft:       staging draft, published only after exact remote verification"
            fi
        else
            log_info "  Draft:       $draft"
        fi
        log_info "  Prerelease:  $prerelease"

        # List exactly what would be uploaded: every name of every artifact,
        # then the manifest, generated checksums and existing sidecars.
        local file_count=0 plan_entry plan_size plan_sha plan_names
        local -a plan_artifacts=() plan_extra=() plan_all_names=()
        if $release_contract_enabled; then
            while IFS= read -r name; do
                [[ -z "$name" ]] && continue
                log_info "  Would upload: $name"
                plan_all_names+=("$name")
                file_count=$((file_count + 1))
            done < <(jq -r '.assets[].name' <<< "$release_contract_plan")
        elif $manifest_exists && [[ -f "$manifest_file" ]]; then
            local plan_name plan_target plan_triple
            while IFS=$'\t' read -r plan_name plan_sha plan_target plan_triple; do
                [[ "$plan_target" == "-" ]] && plan_target=""
                [[ "$plan_triple" == "-" ]] && plan_triple=""
                [[ -n "$plan_triple" ]] || plan_triple="${release_artifact_triples[$plan_name]:-}"
                [[ -n "$plan_name" && -f "$artifacts_dir/$plan_name" ]] || continue
                plan_size=$(_release_file_size "$artifacts_dir/$plan_name" 2>/dev/null || echo 0)
                plan_names=$(jq -Rsc 'split("\n") | map(select(length > 0))' \
                    <<< "${ordinary_upload_names[$plan_name]}") || return 4
                plan_entry=$(jq -nc --arg name "$plan_name" --arg path "$artifacts_dir/$plan_name" \
                    --arg target "$plan_target" --arg sha256 "$plan_sha" \
                    --arg target_triple "$plan_triple" \
                    --argjson size_bytes "${plan_size:-0}" --argjson names "$plan_names" \
                    '{name: $name, path: $path, target: $target, size_bytes: $size_bytes,
                      sha256: $sha256, upload_names: $names} +
                      (if $target_triple == "" then {} else {target_triple: $target_triple} end)') || return 4
                plan_artifacts+=("$plan_entry")
                log_info "  Would upload: $plan_name (${plan_target:-untargeted}, $plan_size bytes, sha256 ${plan_sha:0:16}…)"
                if [[ $(jq 'length' <<< "$plan_names") -gt 1 ]]; then
                    log_info "      also as: $(jq -r '.[1:] | join(", ")' <<< "$plan_names")"
                fi
                while IFS= read -r name; do
                    plan_all_names+=("$name")
                done < <(jq -r '.[]' <<< "$plan_names")
            done < <(jq -r 'def field: if . == null or . == "" then "-" else . end;
                .artifacts[] | [(.name // .filename), .sha256, (.target | field), (.target_triple | field)] | @tsv' \
                <<< "$ordinary_manifest")
            log_info "  Would upload: ${manifest_file##*/} (build manifest)"
            plan_extra+=("${manifest_file##*/}")
            # SHA256SUMS and the per-name .sha256 sidecars are regenerated at
            # upload time; other signatures and evidence are uploaded as found.
            local unique_names
            unique_names=$(printf '%s\n' "${plan_all_names[@]}" | sort -u | grep -c . || true)
            log_info "  Would generate: SHA256SUMS ($unique_names entries) + $unique_names per-asset .sha256 sidecars"
            local extra_file
            for extra_file in "${ordinary_extra_files[@]}"; do
                [[ "$extra_file" != "$manifest_file" ]] || continue
                log_info "  Would upload: ${extra_file##*/} (existing sidecar)"
                plan_extra+=("${extra_file##*/}")
            done
            plan_all_names+=("${plan_extra[@]}" SHA256SUMS)
            file_count=$(printf '%s\n' "${plan_all_names[@]}" | sort -u | grep -c . || true)
            file_count=$((file_count + unique_names))
        else
            while IFS= read -r file; do
                log_info "  Would upload: $(basename "$file")"
                plan_all_names+=("$(basename "$file")")
                file_count=$((file_count + 1))
            done < <(find "$artifacts_dir" -maxdepth 1 -type f 2>/dev/null)
        fi
        log_info "  Total files: $file_count"

        local installer_report='{"status":"skipped","reason":"strict release contracts publish an exact asset set"}'
        if ! $release_contract_enabled; then
            installer_report=$(printf '%s\n' "${plan_all_names[@]}" | _release_installer_check) || \
                installer_report='{"status":"skipped","reason":"installer check failed to run"}'
            _release_report_installer_check "$installer_report"
        fi
        log_info "=== No changes made (dry-run) ==="

        if $JSON_MODE; then
            local plan_artifacts_json='[]' plan_extra_json='[]'
            if [[ ${#plan_artifacts[@]} -gt 0 ]]; then
                plan_artifacts_json=$(printf '%s\n' "${plan_artifacts[@]}" | jq -sc '.') || return 4
            fi
            if [[ ${#plan_extra[@]} -gt 0 ]]; then
                plan_extra_json=$(printf '%s\n' "${plan_extra[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))') || return 4
            fi
            json_envelope "release" "dry_run" 0 "$(jq -nc \
                --arg tool "$tool_name" \
                --arg version "$tag" \
                --arg repo "$repo" \
                --arg artifacts_dir "$artifacts_dir" \
                --argjson draft "$requested_draft" \
                --argjson prerelease "$prerelease" \
                --argjson file_count "$file_count" \
                --argjson artifacts "$plan_artifacts_json" \
                --argjson extra "$plan_extra_json" \
                --argjson strict "$release_contract_enabled" \
                --argjson installer "$installer_report" \
                --argjson contract_assets "$(if $release_contract_enabled; then jq -c '[.assets[].name]' <<< "$release_contract_plan"; else echo '[]'; fi)" \
                '{tool: $tool, version: $version, tag: $version, repo: $repo,
                  artifacts_dir: $artifacts_dir, draft: $draft, prerelease: $prerelease,
                  file_count: $file_count, mode: "dry_run", dry_run: true,
                  plan: (if $strict then {strict: true, assets: $contract_assets}
                         else {strict: false, artifacts: $artifacts, additional_files: $extra,
                               generated: ["SHA256SUMS", "<name>.sha256 per uploaded name"]} end),
                  installer_check: $installer}')"
        fi
        return 0
    fi

    # Record start time
    local start_time
    start_time=$(date +%s)

    # Create or get release
    local release_json release_id upload_url release_url

    _release_contract_require_tag_release_absent() {
        local check_repo="$1"
        local check_tag="$2"
        local scan_json="" match_count=""

        scan_json=$(_release_contract_scan_release_by_tag \
            "$check_repo" "$check_tag") || return 1
        match_count=$(jq -er '
            if type == "object" and
               ((.count == 0 and .release == null) or
                (.count == 1 and (.release | type == "object")))
            then .count
            else error("invalid strict release scan result")
            end
        ' <<< "$scan_json") || {
            log_error "Strict release received an invalid release-list scan result"
            return 1
        }
        if [[ "$match_count" != "0" ]]; then
            log_error "Strict release refused an existing release for tag $check_tag"
            return 1
        fi
        return 0
    }

    _release_contract_observe_owned_release() {
        local observe_repo="$1"
        local observe_release_id="$2"
        local expected_metadata_json="$3"
        local observed_json=""

        [[ "$observe_release_id" =~ ^[1-9][0-9]*$ ]] || return 1
        observed_json=$(gh_api "repos/$observe_repo/releases/$observe_release_id" \
            --no-cache 2>/dev/null) || return 1
        if ! jq -e \
            --argjson release_id "$observe_release_id" \
            --argjson expected "$expected_metadata_json" '
            .id == $release_id and
            .tag_name == $expected.tag_name and
            .name == $expected.name and
            .body == $expected.body and
            .prerelease == $expected.prerelease and
            (.target_commitish | type == "string" and length > 0) and
            (.draft | type == "boolean") and
            (.upload_url | type == "string" and length > 0) and
            (.html_url | type == "string" and length > 0) and
            (.assets | type == "array")
        ' <<< "$observed_json" >/dev/null 2>&1; then
            return 1
        fi
        printf '%s\n' "$observed_json"
    }

    _release_contract_confirm_or_restore_owned_draft() {
        local restore_repo="$1"
        local restore_release_id="$2"
        local expected_metadata_json="$3"
        local observed_json="" attempt
        local max_attempts=3
        local retry_delay="${DSR_RELEASE_STATE_RETRY_DELAY_SECONDS:-1}"

        [[ "$retry_delay" =~ ^[0-9]+$ ]] || retry_delay=1
        for ((attempt = 1; attempt <= max_attempts; attempt++)); do
            # Every PATCH is preceded by a fresh ownership proof. An ID/tag
            # match alone must never authorize mutation after ambiguous create.
            observed_json=$(_release_contract_observe_owned_release \
                "$restore_repo" "$restore_release_id" "$expected_metadata_json" \
                2>/dev/null || true)
            [[ -n "$observed_json" ]] || return 1
            if jq -e '.draft == true' <<< "$observed_json" >/dev/null 2>&1; then
                return 0
            fi

            gh_api "repos/$restore_repo/releases/$restore_release_id" \
                --method PATCH --data '{"draft":true}' --no-cache >/dev/null 2>&1 || true
            observed_json=$(_release_contract_observe_owned_release \
                "$restore_repo" "$restore_release_id" "$expected_metadata_json" \
                2>/dev/null || true)
            if [[ -n "$observed_json" ]] && \
               jq -e '.draft == true' <<< "$observed_json" >/dev/null 2>&1; then
                return 0
            fi
            if ((attempt < max_attempts && retry_delay > 0)); then
                sleep "$retry_delay"
            fi
        done
        return 1
    }

    log_info "Creating GitHub release for $tag..."

    local release_args=""
    if $release_contract_enabled || $requested_draft; then
        release_args+=" --draft"
    fi
    $prerelease && release_args+=" --prerelease"
    # A tag not yet on GitHub is created at the locally tagged commit, not
    # at the default branch head.
    if ! $release_contract_enabled && [[ "$release_tag_sha" =~ ^[0-9a-f]{40}$ ]]; then
        release_args+=" --target-commitish $release_tag_sha"
    fi
    if $release_contract_enabled; then
        release_args+=" --target-commitish $release_contract_git_sha"
        if ! _release_contract_require_tag_release_absent "$repo" "$tag"; then
            return 7
        fi
        if ! _release_contract_verify_tag_ruleset_receipt \
            "$release_contract_tag_ruleset_receipt"; then
            log_error "Immutable-tag governance changed before strict draft admission"
            return 1
        fi
    fi

    local create_status=0
    if $resume && ! $release_contract_enabled; then
        # Authenticated collection reads include drafts. A failed lookup is
        # unknown, not permission to create another release or trust a journal.
        local resume_scan
        if ! resume_scan=$(_release_contract_scan_release_by_tag "$repo" "$tag") ||
           ! release_json=$(jq -ces '
               if length == 1 and .[0].count == 1 and
                  (.[0].release | type == "object")
               then .[0].release else error("release not found or ambiguous") end
           ' <<< "$resume_scan" 2>/dev/null); then
            log_error "Cannot resume without one observable release for $repo $tag"
            return 7
        fi
        log_info "Resuming $tag by verifying remote asset contents"
    else
        # shellcheck disable=SC2086
        release_json=$(gh_create_release "$repo" "$tag" --name "$tag" --body "$release_body" $release_args) || create_status=$?
    fi

    if [[ $create_status -ne 0 ]]; then
        if $release_contract_enabled; then
            local create_error="$release_json"
            local observed_release_scan="" observed_release_id=""
            local observed_owned_release_json=""
            observed_release_scan=$(_release_contract_scan_release_by_tag \
                "$repo" "$tag" 2>/dev/null || true)
            observed_release_id=$(jq -r \
                'if .count == 1 then .release.id // empty else empty end' \
                <<< "$observed_release_scan" 2>/dev/null)
            observed_owned_release_json=$(_release_contract_observe_owned_release \
                "$repo" "$observed_release_id" "$release_contract_metadata_json" \
                2>/dev/null || true)
            if [[ -n "$observed_owned_release_json" ]] && \
               jq -e '.draft == true and (.assets | length == 0)' \
                <<< "$observed_owned_release_json" >/dev/null 2>&1 && \
               _release_contract_verify_remote_tag_identity \
                "$repo" "$tag" "$release_contract_git_sha"; then
                release_json="$observed_owned_release_json"
                log_warn "Create response failed, but no-cache observation confirmed the exact new empty draft"
            else
                log_error "Failed to create an exact staging draft: $create_error"
                # The ID/tag pair is not an ownership proof. Only a fresh
                # ID-bound observation carrying this invocation's nonce and
                # frozen metadata may be mutated after an ambiguous create.
                if [[ -n "$observed_owned_release_json" ]]; then
                    _release_contract_confirm_or_restore_owned_draft \
                        "$repo" "$observed_release_id" \
                        "$release_contract_metadata_json" >/dev/null 2>&1 || true
                fi
                return 7
            fi
        else
            # Check if release already exists
            release_json=$(gh_api "repos/$repo/releases/tags/$tag" --no-cache 2>/dev/null)
            if [[ -n "$release_json" ]] && echo "$release_json" | jq -e '.id' &>/dev/null; then
                log_info "Release $tag already exists, using existing release"
            else
                log_error "Failed to create release: $release_json"
                if $JSON_MODE; then
                    json_envelope "release" "error" 7 "$(jq -nc --arg error "$release_json" '{error: $error}')"
                fi
                return 7
            fi
        fi
    fi

    release_id=$(echo "$release_json" | jq -r '.id')
    upload_url=$(echo "$release_json" | jq -r '.upload_url')
    release_url=$(echo "$release_json" | jq -r '.html_url')

    if ! $release_contract_enabled; then
        if ! jq -es --arg repo "$repo" --arg tag "$tag" '
            length == 1 and (.[0] |
                (.id | type == "number" and floor == . and . > 0 and . <= 9007199254740991) and
                .tag_name == $tag and (.draft | type == "boolean") and
                (.prerelease | type == "boolean") and
                (.html_url | type == "string" and startswith("https://github.com/" + $repo + "/releases/")) and
                (.upload_url == ("https://uploads.github.com/repos/" + $repo +
                    "/releases/" + (.id | tostring) + "/assets{?name,label}") or
                 .upload_url == ("https://uploads.github.com/repos/" + $repo +
                    "/releases/" + (.id | tostring) + "/assets")))
        ' <<< "$release_json" >/dev/null 2>&1; then
            log_error "Release response has the wrong identity or upload destination"
            return 7
        fi
        # --draft asks for assets nobody can download yet. An existing release
        # that is already public (e.g. created by a stalled GitHub Actions
        # run) cannot honor that, so nothing is uploaded into it.
        if $requested_draft && [[ "$(jq -r '.draft' <<< "$release_json")" == false ]]; then
            log_error "--draft was requested, but $tag is already a published release; nothing uploaded"
            log_info "Release without --draft to add the assets to the published release"
            if $JSON_MODE; then
                json_envelope "release" "error" 7 "$(jq -nc --arg tag "$tag" --arg url "$release_url" \
                    '{error: "release already published; --draft cannot be honored", tag: $tag, release_url: $url}')"
            fi
            return 7
        fi
        if $prerelease && [[ "$(jq -r '.prerelease' <<< "$release_json")" == false ]]; then
            log_warn "--prerelease was requested, but the existing $tag release is not a prerelease"
        fi
        # An existing draft does not become public merely because --draft was
        # omitted on retry. Downstream dispatch must use observed state.
        draft=$(jq -r '.draft' <<< "$release_json")
        prerelease=$(jq -r '.prerelease' <<< "$release_json")
    fi

    if $release_contract_enabled; then
        if ! jq -e \
            --argjson expected "$release_contract_metadata_json" '
            (.id | type == "number" and floor == . and . > 0) and
            (.upload_url | type == "string" and length > 0) and
            (.html_url | type == "string" and length > 0) and
            .tag_name == $expected.tag_name and
            .name == $expected.name and
            .body == $expected.body and
            .prerelease == $expected.prerelease and
            .draft == true and
            (.assets | type == "array" and length == 0)
        ' <<< "$release_json" >/dev/null 2>&1; then
            log_error "GitHub did not create a new empty draft release for strict upload"
            local observed_owned_release_json=""
            observed_owned_release_json=$(_release_contract_observe_owned_release \
                "$repo" "$release_id" "$release_contract_metadata_json" \
                2>/dev/null || true)
            if [[ -n "$observed_owned_release_json" ]]; then
                _release_contract_confirm_or_restore_owned_draft \
                    "$repo" "$release_id" \
                    "$release_contract_metadata_json" >/dev/null 2>&1 || true
            fi
            return 7
        fi
        draft=true
    fi

    if $release_contract_enabled; then
        log_ok "Staging draft created: $release_url"
    else
        log_ok "Release created: $release_url"
    fi

    # Collect files to upload
    local files_to_upload=()
    local -A files_to_upload_set=()
    local uploaded_assets=()
    local failed_assets=()
    local skipped_assets=()
    local strict_upload_response_failures=()
    local -A strict_upload_response_failure_names=()

    _release_add_file() {
        local file="$1"
        [[ -z "$file" || ! -f "$file" ]] && return 0
        if [[ -z "${files_to_upload_set[$file]:-}" ]]; then
            files_to_upload+=("$file")
            files_to_upload_set["$file"]=1
        fi
    }

    if $release_contract_enabled; then
        # The strict plan is closed: primaries, exactly one checksum sidecar per
        # primary, and any explicitly named additional assets. Do not discover
        # manifests, evidence, SBOMs, signatures, aliases, or other directory
        # contents here.
        while IFS= read -r file_path; do
            [[ -n "$file_path" ]] && _release_add_file "$file_path"
        done < <(jq -r '.assets[].path' <<< "$release_contract_plan")
    else
    # === Generate SHA256SUMS + per-asset .sha256 for installer verification ===
    # Creates a standard SHA256SUMS file with entries for every name an artifact
    # will be uploaded as (primary, versioned, compat, and arch aliases) AND a
    # per-asset `<name>.sha256` sidecar containing the same single line.
    #
    # Both shapes matter:
    #   - SHA256SUMS              — `sha256sum --check`-style multi-line manifest
    #   - <artifact>.sha256       — per-asset one-liner that curl-pipe-bash
    #                               installers fetch as `${URL}.sha256`
    #
    # GH Actions `dist.yml`-style workflows emit both. dsr previously emitted
    # only the combined file, which silently broke any installer fetching the
    # per-asset URL when GH Actions was throttled and dsr took over.
    #
    # The find command below picks both shapes up automatically for upload.
    if $manifest_exists && [[ -f "$manifest_file" ]]; then
        local sha256sums_file="$artifacts_dir/SHA256SUMS"
        log_info "Generating SHA256SUMS + per-asset .sha256 sidecars for installer verification..."
        : > "$sha256sums_file"

        # Emit one `<sha>  <name>` line into SHA256SUMS AND a single-line
        # `<name>.sha256` sidecar with the same content. Keep the two shapes
        # in lock-step so a future installer that prefers one over the other
        # can never disagree with the other.
        _emit_sha_entry() {
            local sha="$1" name="$2"
            printf '%s  %s\n' "$sha" "$name" >> "$sha256sums_file"
            printf '%s  %s\n' "$sha" "$name" > "$artifacts_dir/${name}.sha256"
        }

        # Cross-artifact dedup: each filename is emitted at most once. Hoisted
        # outside the per-artifact loop because previously the dedup table was
        # scoped to one manifest row, so two artifacts whose alias-sets shared
        # the same compat/arch-alias filename each emitted a different SHA for
        # the same name — which produced a SHA256SUMS that always failed
        # `sha256sum --check` for the colliding name.
        local -A sha_seen=()

        while IFS=$'\t' read -r a_name a_sha256; do
            [[ -z "$a_name" || -z "$a_sha256" ]] && continue

            # Every name this artifact is uploaded as (primary, versioned,
            # compat, arch aliases); a name a prior row already wrote is skipped.
            local alias_name=""
            while IFS= read -r alias_name; do
                [[ -z "$alias_name" || -n "${sha_seen[$alias_name]:-}" ]] && continue
                _emit_sha_entry "$a_sha256" "$alias_name"
                sha_seen["$alias_name"]=1
            done <<< "${ordinary_upload_names[$a_name]}"
        done < <(jq -r '.artifacts[] | [.name // .filename, .sha256] | @tsv' <<< "$ordinary_manifest")

        if [[ -s "$sha256sums_file" ]]; then
            local line_count
            line_count=$(wc -l < "$sha256sums_file")
            log_ok "Generated SHA256SUMS with $line_count entries (+ matching per-asset .sha256 sidecars)"
        else
            rm -f "$sha256sums_file"
            log_warn "No checksum data available; SHA256SUMS not generated"
        fi
    fi

    # Build upload list from manifest when available to avoid stale artifacts
    if $manifest_exists && [[ -f "$manifest_file" ]]; then
        while IFS= read -r name; do
            [[ -z "$name" ]] && continue
            local file_path="$artifacts_dir/$name"
            if [[ -f "$file_path" ]]; then
                _release_add_file "$file_path"
            else
                log_warn "Manifest references missing artifact: $name"
            fi
        done < <(jq -r '.artifacts[] | .name // .filename' <<< "$ordinary_manifest")

        # Include manifest and common sidecar files (checksums, per-asset .sha256
        # one-liners that curl-pipe-bash installers fetch as `${URL}.sha256`,
        # signatures, SBOM, provenance).
        for extra_file in "${ordinary_extra_files[@]}"; do
            _release_add_file "$extra_file"
        done
        for name in "${!ordinary_generated_names[@]}"; do
            _release_add_file "$artifacts_dir/$name"
        done
    else
        # Fallback: upload all files in artifacts directory
        for file in "${ordinary_files[@]}"; do
            _release_add_file "$file"
        done
    fi
    fi

    local total_files=${#files_to_upload[@]}
    if $release_contract_enabled; then
        local expected_upload_count
        expected_upload_count=$(jq -r '.assets | length' <<< "$release_contract_plan")
        if [[ $total_files -ne $expected_upload_count ]]; then
            log_error "Strict upload plan is incomplete before upload"
            _release_contract_confirm_or_restore_bound_draft \
                "$repo" "$release_id" "$tag" >/dev/null 2>&1 || true
            return 1
        fi
    fi
    log_info "Uploading $total_files file(s)..."

    # Upload state for resume
    local upload_state_file="$state_dir/releases/${tool_name}-${tag}-upload.json"
    if ! mkdir -p "$(dirname "$upload_state_file")"; then
        log_error "Failed to create releases directory"
        if $release_contract_enabled; then
            _release_contract_confirm_or_restore_bound_draft \
                "$repo" "$release_id" "$tag" >/dev/null 2>&1 || true
        fi
        return 1
    fi

    # This set records only verified uploads made in this invocation. Never
    # seed it from a local journal: names can outlive deleted/replaced assets.
    local -A uploaded_name_set=()
    local -A uploaded_sha_set=()

    _release_save_state() (
        # Keep the previous journal on a failed write. Journals are diagnostic
        # receipts, never an authorization to skip remote content verification.
        local state_parent="${upload_state_file%/*}" temporary cleanup
        [[ -d "$state_parent" && ! -L "$state_parent" && ! -L "$upload_state_file" ]] || return 1
        [[ ! -e "$upload_state_file" || -f "$upload_state_file" ]] || return 1
        umask 077
        temporary=$(mktemp "$state_parent/.dsr-upload-state.XXXXXXXX") || return 1
        printf -v cleanup 'rm -f -- %q' "$temporary"
        # shellcheck disable=SC2064 # expand now: $cleanup is a %q-quoted command
        trap "$cleanup" EXIT
        trap 'exit 5' INT TERM
        jq -nc --arg repo "$repo" --arg tag "$tag" --argjson release_id "$release_id" \
            --arg run_id "${DSR_RUN_ID:-unknown}" \
            --argjson uploaded "$(printf '%s\n' "${uploaded_assets[@]}" | jq -sc '.')" \
            '{schema:"dsr.release_upload_receipt.v1",repo:$repo,tag:$tag,
              release_id:$release_id,run_id:$run_id,uploaded:$uploaded}' > "$temporary" || return 1
        [[ -s "$temporary" ]] && jq -es 'length==1 and (.[0]|type=="object")' "$temporary" >/dev/null || return 1
        mv -f -- "$temporary" "$upload_state_file"
    )

    _release_record_uploaded() {
        local name="$1"
        local status="$2"
        local size_bytes="$3"
        local content_type="$4"
        local receipt="${5:-null}" sha="${6:-}" record
        if ! record=$(jq -nc \
            --arg name "$name" \
            --argjson size "$size_bytes" \
            --arg content_type "$content_type" \
            --arg status "$status" \
            --arg sha256 "$sha" --argjson receipt "$receipt" \
            '{name: $name, size_bytes: $size, content_type: $content_type, status: $status}
             + (if $sha256 == "" then {} else {sha256:$sha256,remote_id:$receipt.id} end)'); then
            _release_record_failed "$name" "Could not encode verified upload receipt"
            return 1
        fi
        uploaded_assets+=("$record")
        if ! _release_save_state; then
            _release_record_failed "$name" "Upload verified but receipt persistence failed"
            return 1
        fi
    }

    _release_record_failed() {
        local name="$1"
        local error="$2"
        failed_assets+=("$(jq -nc \
            --arg name "$name" \
            --arg error "$error" \
            '{name: $name, error: $error}')")
    }

    # Upload each file
    local idx=0
    for file in "${files_to_upload[@]}"; do
        idx=$((idx + 1))
        local filename
        filename=$(basename "$file")

        local size_bytes
        size_bytes=$(stat -c %s "$file" 2>/dev/null || stat -f %z "$file" 2>/dev/null || echo 0)

        # Determine content type
        local content_type="application/octet-stream"
        case "$filename" in
            *.tar.gz|*.tgz) content_type="application/gzip" ;;
            *.tar.xz) content_type="application/x-xz" ;;
            *.zip) content_type="application/zip" ;;
            *.json) content_type="application/json" ;;
            *.txt) content_type="text/plain" ;;
            *.sha256) content_type="text/plain" ;;
            *.minisig) content_type="text/plain" ;;
        esac

        if $release_contract_enabled; then
            local planned_asset planned_kind planned_size planned_sha current_sha
            planned_asset=$(jq -c --arg name "$filename" '.assets[] | select(.name == $name)' \
                <<< "$release_contract_plan")
            planned_kind=$(jq -r '.kind' <<< "$planned_asset")
            planned_size=$(jq -r '.size_bytes' <<< "$planned_asset")

            if [[ -z "$planned_asset" || ! -f "$file" || -L "$file" || "$size_bytes" != "$planned_size" ]]; then
                log_error "[$idx/$total_files] Strict asset changed after preflight: $filename"
                _release_record_failed "$filename" "Asset changed after strict preflight"
                continue
            fi

            if [[ "$planned_kind" == "primary" || "$planned_kind" == "checksum" || \
                  "$planned_kind" == "minisign" || "$planned_kind" == "additional" || \
                  "$planned_kind" == "aggregate-checksum" || "$planned_kind" == "build-manifest" ]]; then
                planned_sha=$(jq -r '.sha256' <<< "$planned_asset")
                current_sha=$(_release_sha256 "$file" 2>/dev/null || true)
                if [[ "$current_sha" != "$planned_sha" ]]; then
                    log_error "[$idx/$total_files] Strict asset checksum changed after preflight: $filename"
                    _release_record_failed "$filename" "Asset checksum changed after strict preflight"
                    continue
                fi
            else
                log_error "[$idx/$total_files] Unknown strict asset kind: $filename"
                _release_record_failed "$filename" "Unknown strict asset kind"
                continue
            fi

            log_info "[$idx/$total_files] Uploading exact contract asset: $filename"
            local strict_upload_result=""
            if strict_upload_result=$(gh_upload_asset "$upload_url" "$file" "$content_type" 2>&1); then
                log_ok "  Uploaded: $filename ($size_bytes bytes)"
                _release_record_uploaded "$filename" "uploaded" "$size_bytes" "$content_type"
                uploaded_name_set["$filename"]=1
            else
                log_error "  Failed to upload: $filename"
                _release_record_failed "$filename" "$strict_upload_result"
                strict_upload_response_failures+=("$(jq -nc \
                    --arg name "$filename" \
                    --argjson size_bytes "$size_bytes" \
                    --arg content_type "$content_type" \
                    '{name: $name, size_bytes: $size_bytes, content_type: $content_type}')")
                strict_upload_response_failure_names["$filename"]=1
            fi
            continue
        fi

        local upload_sha
        if [[ ! -f "$file" || -L "$file" || ! -s "$file" ]] ||
           ! upload_sha=$(_gh_asset_sha256 "$file") ||
           { [[ -n "${ordinary_expected_sha[$filename]:-}" ]] &&
             [[ "$upload_sha" != "${ordinary_expected_sha[$filename]}" ]]; }; then
            _release_record_failed "$filename" "Artifact changed after release preflight"
            continue
        fi

        # Dual-name upload for manifest artifacts: the primary name plus its
        # versioned, installer-compatible and arch-alias names (deduped).
        if [[ -n "${ordinary_upload_names[$filename]:-}" ]]; then
            local -a upload_names=()
            mapfile -t upload_names <<< "${ordinary_upload_names[$filename]}"
            if [[ ${#upload_names[@]} -gt 1 ]]; then
                log_info "[$idx/$total_files] Uploading asset variants for: $filename"

                local upload_name
                for upload_name in "${upload_names[@]}"; do
                    if [[ -n "${uploaded_name_set[$upload_name]:-}" ]]; then
                        if [[ "${uploaded_sha_set[$upload_name]:-}" != "$upload_sha" ]]; then
                            _release_record_failed "$upload_name" "Different artifact contents resolve to the same upload name"
                            continue
                        fi
                        log_info "  Skipping (already handled in this run): $upload_name"
                        skipped_assets+=("$upload_name")
                        continue
                    fi
                    local upload_result
                    if upload_result=$(gh_upload_asset_named "$upload_url" "$file" "$upload_name" "$content_type"); then
                        log_ok "  Verified upload: $upload_name ($size_bytes bytes)"
                        _release_record_uploaded "$upload_name" "uploaded" "$size_bytes" "$content_type" "$upload_result" "$upload_sha"
                        uploaded_name_set["$upload_name"]=1
                        uploaded_sha_set["$upload_name"]="$upload_sha"
                    else
                        log_error "  Failed to upload: $upload_name"
                        _release_record_failed "$upload_name" "Verified upload failed (see release log): $upload_result"
                    fi
                done
                continue
            fi
        fi

        # Deduplicate only content-verified names from this invocation.
        if [[ -n "${uploaded_name_set[$filename]:-}" ]]; then
            if [[ "${uploaded_sha_set[$filename]:-}" != "$upload_sha" ]]; then
                _release_record_failed "$filename" "Different artifact contents resolve to the same upload name"
                continue
            fi
            log_info "[$idx/$total_files] Skipping (already handled in this run): $filename"
            skipped_assets+=("$filename")
            continue
        fi
        log_info "[$idx/$total_files] Uploading: $filename"

        # Upload
        local upload_result
        if upload_result=$(gh_upload_asset "$upload_url" "$file" "$content_type"); then
            log_ok "  Verified upload: $filename ($size_bytes bytes)"
            _release_record_uploaded "$filename" "uploaded" "$size_bytes" "$content_type" "$upload_result" "$upload_sha"
            uploaded_name_set["$filename"]=1
            uploaded_sha_set["$filename"]="$upload_sha"
        else
            log_error "  Failed to upload: $filename"
            log_error "  Error: $upload_result"
            _release_record_failed "$filename" "Verified upload failed (see release log): $upload_result"
        fi
    done

    # Verify uploaded assets match the selected release contract.
    local verification_status="skipped"
    local missing_assets=()
    if $release_contract_enabled; then
        local expected_assets_json
        local upload_failures=${#failed_assets[@]}
        local remote_verified=false
        expected_assets_json=$(jq -c '.assets' <<< "$release_contract_plan")

        if _release_contract_verify_remote_assets \
            "$repo" "$release_id" "$expected_assets_json" true "$tag" \
            "$release_contract_metadata_json" >/dev/null; then
            remote_verified=true
            verification_status="exact"
            log_ok "Remote draft contains the exact contracted asset set and sizes"
        else
            verification_status="incomplete"
            _release_record_failed "remote-verification" "Remote asset set or size mismatch"
        fi

        if $remote_verified && [[ ${#strict_upload_response_failures[@]} -gt 0 ]]; then
            if _release_contract_verify_remote_tag_identity \
                "$repo" "$tag" "$release_contract_git_sha"; then
                local -a remaining_failed_assets=()
                local failed_record failed_name reconciled_record
                for failed_record in "${failed_assets[@]}"; do
                    failed_name=$(jq -r '.name // empty' <<< "$failed_record")
                    if [[ -n "${strict_upload_response_failure_names[$failed_name]:-}" ]]; then
                        continue
                    fi
                    remaining_failed_assets+=("$failed_record")
                done
                failed_assets=("${remaining_failed_assets[@]}")

                for reconciled_record in "${strict_upload_response_failures[@]}"; do
                    local reconciled_name reconciled_size reconciled_content_type
                    reconciled_name=$(jq -r '.name' <<< "$reconciled_record")
                    reconciled_size=$(jq -r '.size_bytes' <<< "$reconciled_record")
                    reconciled_content_type=$(jq -r '.content_type' <<< "$reconciled_record")
                    _release_record_uploaded "$reconciled_name" "reconciled" \
                        "$reconciled_size" "$reconciled_content_type"
                    uploaded_name_set["$reconciled_name"]=1
                done
                upload_failures=${#failed_assets[@]}
                log_warn "Upload response failure(s) reconciled by exact no-cache draft verification"
            else
                verification_status="incomplete"
                _release_record_failed "upload-reconciliation" \
                    "Remote tag identity changed after ambiguous upload response"
                upload_failures=${#failed_assets[@]}
            fi
        fi

        local publish_preflight_valid=false
        local current_release_contract_plan=""
        if [[ $upload_failures -eq 0 ]] && $remote_verified; then
            if current_release_contract_plan=$(_release_contract_preflight \
                "$tool_name" "$tag" "$repo" "$local_path" "$artifacts_dir" \
                "$manifest_file" "$release_contract_json" verify); then
                current_release_contract_plan=$(jq -c \
                    --argjson release "$release_contract_metadata_json" \
                    '. + {release: $release}' <<< "$current_release_contract_plan") || \
                    current_release_contract_plan=""
                if jq -en \
                    --argjson frozen "$release_contract_plan" \
                    --argjson current "$current_release_contract_plan" \
                    '$frozen == $current' >/dev/null 2>&1; then
                    publish_preflight_valid=true
                else
                    _release_record_failed "publish-preflight" \
                        "Strict release plan changed after upload"
                    log_error "Strict release plan changed after upload; leaving the staging draft unpublished"
                fi
            else
                _release_record_failed "publish-preflight" \
                    "Source, artifact, or tag identity changed before publication"
                log_error "Strict release preflight no longer holds; leaving the staging draft unpublished"
            fi
        fi

        if [[ $upload_failures -eq 0 ]] && $remote_verified && $publish_preflight_valid; then
            local expected_git_sha
            expected_git_sha=$(jq -r '.git_sha' <<< "$release_contract_plan")
            if $requested_draft; then
                if _release_contract_verify_remote_assets \
                    "$repo" "$release_id" "$expected_assets_json" true "$tag" \
                    "$release_contract_metadata_json" >/dev/null && \
                   _release_contract_verify_remote_tag_identity \
                    "$repo" "$tag" "$expected_git_sha" && \
                   _release_contract_verify_tag_ruleset_receipt \
                    "$release_contract_tag_ruleset_receipt"; then
                    log_ok "Strict release retained as an exact verified draft by request"
                else
                    verification_status="incomplete"
                    _release_record_failed "draft-verification" \
                        "Remote draft or tag changed before final verification"
                    log_error "Strict draft changed before final verification"
                fi
            else
                local publish_release_payload
                publish_release_payload=$(jq -c '
                    .release |
                    {
                        tag_name,
                        target_commitish,
                        name,
                        body,
                        prerelease,
                        draft: false
                    }
                ' <<< "$release_contract_plan") || {
                    _release_contract_confirm_or_restore_bound_draft \
                        "$repo" "$release_id" "$tag" >/dev/null 2>&1 || true
                    return 4
                }
                if ! _release_contract_verify_remote_assets \
                    "$repo" "$release_id" "$expected_assets_json" true "$tag" \
                    "$release_contract_metadata_json" >/dev/null || \
                   ! _release_contract_verify_remote_tag_identity \
                    "$repo" "$tag" "$expected_git_sha" || \
                   ! _release_contract_verify_tag_ruleset_receipt \
                    "$release_contract_tag_ruleset_receipt"; then
                    verification_status="incomplete"
                    _release_record_failed "publish" \
                        "Remote draft or tag changed immediately before publication"
                    log_error "Remote draft or tag changed immediately before publication"
                else
                    local publish_patch_status=0
                    gh_api "repos/$repo/releases/$release_id" \
                        --method PATCH --data "$publish_release_payload" \
                        --no-cache >/dev/null 2>&1 || publish_patch_status=$?

                    local published_release_json=""
                    local postpublish_assets_valid=false
                    local postpublish_tag_valid=false
                    local postpublish_ruleset_valid=false
                    if published_release_json=$(_release_contract_verify_remote_assets \
                        "$repo" "$release_id" "$expected_assets_json" false "$tag" \
                        "$release_contract_metadata_json"); then
                        postpublish_assets_valid=true
                    fi
                    if _release_contract_verify_remote_tag_identity \
                        "$repo" "$tag" "$expected_git_sha"; then
                        postpublish_tag_valid=true
                    fi
                    if _release_contract_verify_tag_ruleset_receipt \
                        "$release_contract_tag_ruleset_receipt"; then
                        postpublish_ruleset_valid=true
                    fi

                    if $postpublish_assets_valid && $postpublish_tag_valid && \
                       $postpublish_ruleset_valid; then
                        draft=false
                        local published_url
                        published_url=$(jq -r '.html_url // empty' <<< "$published_release_json")
                        [[ -n "$published_url" ]] && release_url="$published_url"
                        if [[ $publish_patch_status -ne 0 ]]; then
                            log_warn "Publish response failed, but no-cache observation confirmed the exact public release"
                        fi
                        log_ok "Published release after exact remote verification: $release_url"
                    else
                        verification_status="incomplete"
                        local observed_draft_state=""
                        observed_draft_state=$(_release_contract_observe_draft_state \
                            "$repo" "$release_id" 2>/dev/null || true)
                        if [[ "$observed_draft_state" == "true" ]]; then
                            draft=true
                            _release_record_failed "publish" \
                                "Publish attempt left the verified release as a draft"
                            log_error "Publish attempt did not produce an exact public release"
                        else
                            # false means observed public; empty means unreadable. Both
                            # require a bounded best-effort re-draft before returning.
                            draft=false
                            _release_record_failed "publish" \
                                "Publication state failed exact no-cache verification"
                            log_error "Publication state failed exact no-cache verification"
                            if _release_contract_confirm_or_restore_bound_draft \
                                "$repo" "$release_id" "$tag"; then
                                draft=true
                            fi
                        fi
                    fi
                fi
            fi
        fi
    elif $manifest_exists; then
        verification_status="ok"
        while IFS= read -r expected_file; do
            [[ -z "$expected_file" ]] && continue
            local found=false
            # Check uploaded assets
            for asset in "${uploaded_assets[@]}"; do
                local asset_name
                asset_name=$(echo "$asset" | jq -r '.name')
                if [[ "$asset_name" == "$expected_file" ]]; then
                    found=true
                    break
                fi
            done
            # Also check skipped assets (from resume mode - already uploaded previously)
            if ! $found; then
                for skipped in "${skipped_assets[@]}"; do
                    if [[ "$skipped" == "$expected_file" ]]; then
                        found=true
                        break
                    fi
                done
            fi
            if ! $found; then
                missing_assets+=("$expected_file")
                verification_status="incomplete"
                _release_record_failed "$expected_file" "Required artifact was not verified on GitHub"
            fi
        done < <(jq -r '.artifacts[] | .name // .filename' <<< "$ordinary_manifest")
    fi

    if ! $release_contract_enabled; then
        # Re-read by immutable release ID after all uploads. A local journal,
        # an earlier POST response, or an earlier matching name is not proof
        # that the final release still contains the selected artifact bytes.
        _release_recheck_uploaded() (
            local record="$1" name sha size expected_id observed workdir cleanup
            name=$(jq -er '.name' <<< "$record") || return 1
            sha=$(jq -er '.sha256' <<< "$record") || return 1
            size=$(jq -er '.size_bytes' <<< "$record") || return 1
            expected_id=$(jq -er '.remote_id' <<< "$record") || return 1
            observed=$(_gh_find_release_asset "$repo" "$release_id" "$name") || return 1
            [[ "$(jq -r '.id' <<< "$observed")" == "$expected_id" ]] || return 1
            umask 077
            workdir=$(mktemp -d "${TMPDIR:-/tmp}/dsr-release-verify.XXXXXXXX") || return 1
            printf -v cleanup 'rm -f -- %q; rmdir -- %q 2>/dev/null || true' "$workdir/verified" "$workdir"
            # shellcheck disable=SC2064 # expand now: $cleanup is a %q-quoted command
            trap "$cleanup" EXIT
            trap 'exit 5' INT TERM
            _gh_verify_uploaded_asset "$repo" "$name" "$size" "$sha" "$observed" "$workdir" >/dev/null
        )
        local verified_record observed_release
        [[ "$verification_status" == "skipped" ]] && verification_status="ok"
        for verified_record in "${uploaded_assets[@]}"; do
            if ! _release_recheck_uploaded "$verified_record"; then
                _release_record_failed "$(jq -r '.name' <<< "$verified_record")" \
                    "Remote artifact changed or could not be reverified after upload"
                verification_status="incomplete"
            fi
        done
        if ! observed_release=$(gh_api "repos/$repo/releases/$release_id" --no-cache) ||
           ! jq -ens --argjson expected "$release_json" --argjson observed "$observed_release" '
               def identity: {id,tag_name,upload_url,draft,prerelease};
               ($observed | type == "object") and
               (($observed | identity) == ($expected | identity))
           ' >/dev/null 2>&1; then
            _release_record_failed "release-verification" "Release identity or visibility changed after upload"
            verification_status="incomplete"
        fi
    fi

    # Would the project's own curl|bash installer find its downloads on this
    # release? Warn loudly when not; the upload itself remains authoritative.
    local installer_report='{"status":"skipped","reason":"strict release contracts publish an exact asset set"}'
    if ! $release_contract_enabled; then
        local -A installer_published=()
        local installer_asset installer_name
        for installer_asset in "${uploaded_assets[@]}"; do
            installer_name=$(jq -r '.name // empty' <<< "$installer_asset" 2>/dev/null) || continue
            [[ -n "$installer_name" ]] && installer_published["$installer_name"]=1
        done
        for installer_name in "${skipped_assets[@]}"; do
            installer_published["$installer_name"]=1
        done
        if [[ ${#installer_published[@]} -gt 0 ]]; then
            installer_report=$(printf '%s\n' "${!installer_published[@]}" | _release_installer_check) || \
                installer_report='{"status":"skipped","reason":"installer check failed to run"}'
        else
            installer_report='{"status":"skipped","reason":"no assets were published"}'
        fi
        _release_report_installer_check "$installer_report"
    fi

    # Calculate duration after contract verification and publication.
    local end_time duration
    end_time=$(date +%s)
    duration=$((end_time - start_time))

    # Build result
    local success_count=${#uploaded_assets[@]}
    local failed_count=${#failed_assets[@]}
    local skipped_count=${#skipped_assets[@]}

    local status="success"
    local exit_code=0
    if [[ $failed_count -gt 0 ]]; then
        status="partial"
        exit_code=1
    fi

    if $release_contract_enabled && [[ $exit_code -ne 0 ]]; then
        if _release_contract_confirm_or_restore_bound_draft \
            "$repo" "$release_id" "$tag"; then
            draft=true
        else
            draft=false
            log_error "Strict release failure could not confirm a bound draft state"
        fi
    fi

    # Repository dispatch (post-release hook)
    local dispatch_enabled dispatch_event dispatch_repos
    local dispatch_results_json="[]"
    local dispatch_status="skipped"
    local dispatch_cfg

    dispatch_cfg=$(_dispatch_load_config "$tool_name")
    IFS='|' read -r dispatch_enabled dispatch_event dispatch_repos <<< "$dispatch_cfg"

    [[ -n "$dispatch_override" ]] && dispatch_enabled="$dispatch_override"
    [[ -n "$dispatch_event_override" ]] && dispatch_event="$dispatch_event_override"
    [[ -n "$dispatch_repos_override" ]] && dispatch_repos="$dispatch_repos_override"

    if _dispatch_is_true "$dispatch_enabled" && [[ -n "$dispatch_repos" ]] && \
       [[ $exit_code -eq 0 ]] && ! $draft; then
        local git_sha=""
        if [[ -n "$local_path" && -d "$local_path" ]]; then
            git_sha=$(git_ops_tag_sha "$local_path" "$tag" 2>/dev/null || true)
        fi
        if [[ -z "$git_sha" ]]; then
            git_sha=$(gh_resolve_tag_sha "$repo" "$tag" 2>/dev/null || true)
        fi
        [[ -z "$git_sha" ]] && git_sha="unknown"

        local dispatch_exit=0
        dispatch_results_json=$(_dispatch_send_all "$tool_name" "$version" "$tag" "$repo" "$git_sha" "$release_url" "$dispatch_event" "$dispatch_repos" "${DSR_RUN_ID:-run-unknown}") || dispatch_exit=$?
        case "$dispatch_exit" in
            0) dispatch_status="completed" ;;
            2) dispatch_status="skipped" ;;
            *) dispatch_status="failed" ;;
        esac
    elif _dispatch_is_true "$dispatch_enabled" && $draft; then
        log_info "Repository dispatch skipped while release remains a draft"
    elif _dispatch_is_true "$dispatch_enabled" && [[ -z "$dispatch_repos" ]]; then
        log_warn "Dispatch enabled but no target repos configured"
    fi

    # Clean up upload state on success
    if [[ $failed_count -eq 0 ]]; then
        rm -f "$upload_state_file"
    fi

    # Output
    if $JSON_MODE; then
        local details
        details=$(jq -nc \
            --arg repo "$repo" \
            --arg version "$version" \
            --arg tag "$tag" \
            --argjson release_id "$release_id" \
            --arg release_url "$release_url" \
            --arg upload_url "$upload_url" \
            --argjson draft "$draft" \
            --argjson prerelease "$prerelease" \
            --argjson uploaded "$(printf '%s\n' "${uploaded_assets[@]}" | jq -sc '.')" \
            --argjson failed "$(printf '%s\n' "${failed_assets[@]}" | jq -sc '.')" \
            --arg verification "$verification_status" \
            --argjson tag_ruleset_receipt "$release_contract_tag_ruleset_receipt" \
            --argjson total "$total_files" \
            --argjson success "$success_count" \
            --argjson failed_count "$failed_count" \
            --argjson skipped "$skipped_count" \
            --argjson duration "$duration" \
            --arg dispatch_status "$dispatch_status" \
            --arg dispatch_event "$dispatch_event" \
            --arg dispatch_repos "$dispatch_repos" \
            --argjson dispatch_results "$dispatch_results_json" \
            --argjson installer_check "$installer_report" \
            '{
                repo: $repo,
                version: $version,
                tag: $tag,
                release_id: $release_id,
                release_url: $release_url,
                upload_url: $upload_url,
                draft: $draft,
                prerelease: $prerelease,
                assets_uploaded: $uploaded,
                assets_failed: $failed,
                verification: $verification,
                installer_check: $installer_check,
                tag_ruleset_receipt: $tag_ruleset_receipt,
                total: $total,
                success: $success,
                failed: $failed_count,
                skipped: $skipped,
                duration_seconds: $duration,
                dispatch: {
                    status: $dispatch_status,
                    event: $dispatch_event,
                    repos: (if $dispatch_repos == "" then [] else ($dispatch_repos | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))) end),
                    results: $dispatch_results
                }
            }')
        json_envelope "release" "$status" "$exit_code" "$details"
    else
        echo ""
        if [[ $failed_count -eq 0 ]]; then
            log_ok "Release $tag complete: $success_count asset(s) uploaded"
        else
            log_error "Release $tag incomplete: $success_count uploaded, $failed_count failed"
        fi
        log_info "Release URL: $release_url"
        log_info "Duration: ${duration}s"

        if [[ ${#missing_assets[@]} -gt 0 ]]; then
            log_warn "Missing from manifest: ${missing_assets[*]}"
        fi
    fi

    # Run upgrade verification if requested and release succeeded
    if $verify_upgrade && [[ $exit_code -eq 0 ]] && ! $draft; then
        echo ""
        log_info "Running post-release upgrade verification..."
        if upgrade_verify_tool "$tool_name" --version "$version"; then
            log_ok "Upgrade verification passed for $tool_name"
        else
            log_warn "Upgrade verification failed for $tool_name"
            log_info "Run 'dsr verify upgrade $tool_name' to debug"
            # Don't fail the release, just warn
        fi
    elif $verify_upgrade && $draft; then
        log_info "Upgrade verification skipped while release remains a draft"
    fi

    return $exit_code
}

# ============================================================================
# RELEASE VERIFY SUBCOMMAND
# ============================================================================

cmd_release_verify() {
    local tool_name=""
    local version=""
    local verify_checksums=false
    local fix_missing=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tool|-t)
                tool_name="$2"
                shift 2
                ;;
            --version|-V)
                version="$2"
                shift 2
                ;;
            --verify-checksums|-c)
                verify_checksums=true
                shift
                ;;
            --fix)
                fix_missing=true
                shift
                ;;
            --help|-h)
                cat << 'EOF'
dsr release verify - Verify release assets against build manifest

USAGE:
    dsr release verify <tool> <version>
    dsr release verify --tool <name> --version <tag>

OPTIONS:
    -t, --tool <name>       Tool to verify (or first positional arg)
    -V, --version <ver>     Version to verify (or second positional arg)
    -c, --verify-checksums  Download assets and verify SHA256 checksums
    --fix                   Re-upload missing assets (strict contracts require a draft)
    --dry-run               With --fix, list the uploads without performing them

DESCRIPTION:
    Compares a GitHub release against the build manifest to verify all
    expected assets are present. Optionally downloads and verifies checksums.

OUTPUT:
    Reports missing, extra, or mismatched assets. JSON mode provides full
    verification report.

EXAMPLES:
    dsr release verify ntm 1.2.3               Quick manifest check
    dsr release verify ntm 1.2.3 --verify-checksums   Full checksum verify
    dsr release verify ntm 1.2.3 --fix         Re-upload missing assets

EXIT CODES:
    0  - All assets verified
    1  - Some assets missing or mismatched
    3  - Authentication error
    4  - Invalid arguments
    7  - Release not found
EOF
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                log_info "Run 'dsr release verify --help' for usage"
                return 4
                ;;
            *)
                # Positional arguments: tool, version
                if [[ -z "$tool_name" ]]; then
                    tool_name="$1"
                elif [[ -z "$version" ]]; then
                    version="$1"
                fi
                shift
                ;;
        esac
    done

    # Validate required arguments
    if [[ -z "$tool_name" ]]; then
        log_error "Tool name required"
        log_info "Run 'dsr release verify --help' for usage"
        return 4
    fi

    if [[ -z "$version" ]]; then
        log_error "Version required"
        log_info "Run 'dsr release verify --help' for usage"
        return 4
    fi

    # Check GitHub authentication
    if ! gh_check 2>/dev/null; then
        if ! gh_check_token 2>/dev/null; then
            log_error "GitHub authentication required"
            if $JSON_MODE; then
                json_envelope "release-verify" "error" 3 '{"error": "GitHub authentication required"}'
            fi
            return 3
        fi
    fi

    # Load tool configuration
    if ! act_load_repo_config "$tool_name" 2>/dev/null; then
        log_error "Tool '$tool_name' not found in repos.d"
        return 4
    fi

    # Get repository info
    local repo local_path
    repo=$(act_get_repo "$tool_name")
    local_path=$(act_get_local_path "$tool_name")
    if [[ -z "$repo" ]]; then
        log_error "No GitHub repo configured for $tool_name"
        return 4
    fi

    # Resolve owner/repo if short name
    if [[ ! "$repo" =~ / ]]; then
        repo="Dicklesworthstone/$repo"
    fi

    # Normalize version tag
    local tag
    tag=$(git_ops_version_to_tag "$version")

    local release_contract_json="null"
    local release_contract_enabled=false
    if declare -F config_get_release_contract_json &>/dev/null; then
        if ! config_validate_release_contract "$tool_name"; then
            log_error "Release contract validation failed for $tool_name"
            return 4
        fi
        release_contract_json=$(config_get_release_contract_json "$tool_name") || return $?
        [[ "$release_contract_json" != "null" ]] && release_contract_enabled=true
    fi

    log_info "Verifying release $tool_name $tag from $repo"

    # Reject local diagnostic/mixed authority before any remote lookup or repair.
    local state_dir="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}"
    local artifacts_dir="$state_dir/artifacts/${tool_name}-${tag}"
    local manifest_file="$artifacts_dir/${tool_name}-${tag}-manifest.json"
    if [[ ! -f "$manifest_file" ]]; then
        manifest_file="$state_dir/artifacts/${tool_name}-${tag}-manifest.json"
    fi
    if [[ -d "$artifacts_dir" ]]; then
        _release_require_publishable_artifacts "$artifacts_dir" "$manifest_file" \
            "$release_contract_enabled" || return 4
    elif [[ -f "$manifest_file" ]] || $release_contract_enabled; then
        _release_require_publishable_artifacts "${manifest_file%/*}" "$manifest_file" \
            "$release_contract_enabled" || return 4
    fi

    # Record start time
    local start_time
    start_time=$(date +%s)

    # Fetch release info from GitHub
    local release_json
    if $release_contract_enabled; then
        local release_scan="" scanned_release_id=""
        release_scan=$(_release_contract_scan_release_by_tag "$repo" "$tag" 2>/dev/null || true)
        scanned_release_id=$(jq -r \
            'if .count == 1 then .release.id // empty else empty end' \
            <<< "$release_scan" 2>/dev/null)
        if [[ "$scanned_release_id" =~ ^[1-9][0-9]*$ ]]; then
            release_json=$(gh_api "repos/$repo/releases/$scanned_release_id" \
                --no-cache 2>/dev/null || true)
        else
            release_json=""
        fi
    else
        release_json=$(gh_api "repos/$repo/releases/tags/$tag" 2>/dev/null)
    fi
    if [[ -z "$release_json" ]] || ! echo "$release_json" | jq -e '.id' &>/dev/null; then
        log_error "Release $tag not found in $repo"
        if $JSON_MODE; then
            json_envelope "release-verify" "error" 7 "$(jq -nc --arg tag "$tag" '{error: "Release not found", tag: $tag}')"
        fi
        return 7
    fi

    local release_id release_url
    release_id=$(echo "$release_json" | jq -r '.id')
    release_url=$(echo "$release_json" | jq -r '.html_url')

    # Strict repair may create checksum sidecars and clobber remote assets. Do
    # not allow either mutation unless a fresh, correctly bound release record
    # proves the release is still a draft.
    if $release_contract_enabled && $fix_missing; then
        if ! jq -e \
            --argjson release_id "$release_id" \
            --arg expected_tag "$tag" '
                .id == $release_id and
                .tag_name == $expected_tag and
                .draft == true
            ' <<< "$release_json" >/dev/null 2>&1; then
            log_error "Strict release repair is allowed only for a verified draft release"
            return 1
        fi
    fi

    log_info "Found release: $release_url"

    # Get release assets
    local assets_json
    assets_json=$(echo "$release_json" | jq -c '.assets // []')
    local asset_count
    asset_count=$(echo "$assets_json" | jq 'length')

    log_info "Release has $asset_count asset(s)"

    # Load build manifest if available
    local manifest_exists=false
    local expected_assets=()
    local release_contract_plan='{}'
    local strict_tag_ruleset_receipt='null'
    local -A expected_asset_sizes=()
    local -A expected_asset_paths=()
    local -A expected_asset_shas=()
    local -A expected_asset_kinds=()
    local -A expected_asset_source_shas=()
    local strict_remote_records_valid=true
    if $release_contract_enabled; then
        if [[ ! -f "$manifest_file" ]]; then
            log_error "Strict release contract requires manifest: $manifest_file"
            return 4
        fi
        artifacts_dir="${manifest_file%/*}"
        # Repair creates a missing sidecar only at its per-upload mutation
        # boundary, after re-confirming the remote release is still a draft.
        local contract_sidecar_mode="plan"
        if ! release_contract_plan=$(_release_contract_preflight \
            "$tool_name" "$tag" "$repo" "$local_path" "$artifacts_dir" \
            "$manifest_file" "$release_contract_json" "$contract_sidecar_mode"); then
            return 4
        fi
        strict_tag_ruleset_receipt=$(jq -c \
            '.tag_ruleset_receipt' <<< "$release_contract_plan") || return 4
        manifest_exists=true
        log_info "Using strict manifest: $manifest_file"
        while IFS=$'\t' read -r name size path sha kind source_sha; do
            [[ -n "$name" ]] || continue
            expected_assets+=("$name")
            expected_asset_sizes["$name"]="$size"
            expected_asset_paths["$name"]="$path"
            expected_asset_shas["$name"]="$sha"
            expected_asset_kinds["$name"]="$kind"
            expected_asset_source_shas["$name"]="$source_sha"
        done < <(jq -r '
            .assets[] |
            [.name, (.size_bytes | tostring), .path, .sha256, .kind, (.source_sha256 // "")] |
            @tsv
        ' <<< "$release_contract_plan")
        local strict_expected_assets_json
        strict_expected_assets_json=$(jq -c '.assets' <<< "$release_contract_plan")
        local strict_expected_draft="any"
        $fix_missing && strict_expected_draft="true"
        local strict_release_json=""
        if strict_release_json=$(_release_contract_verify_remote_assets \
            "$repo" "$release_id" "$strict_expected_assets_json" "$strict_expected_draft" "$tag") && \
           _release_contract_verify_remote_tag_identity \
            "$repo" "$tag" "$(jq -r '.git_sha' <<< "$release_contract_plan")" && \
           _release_contract_verify_tag_ruleset_receipt \
            "$strict_tag_ruleset_receipt"; then
            release_json="$strict_release_json"
            release_url=$(jq -r '.html_url // empty' <<< "$release_json")
            assets_json=$(jq -c '.assets' <<< "$release_json")
            asset_count=$(jq 'length' <<< "$assets_json")
        else
            strict_remote_records_valid=false
        fi
    elif [[ -f "$manifest_file" ]]; then
        manifest_exists=true
        log_info "Using manifest: $manifest_file"
        while IFS= read -r name; do
            [[ -n "$name" ]] && expected_assets+=("$name")
        done < <(jq -r '.artifacts[]?.name // .artifacts[]?.filename // empty' "$manifest_file" 2>/dev/null)
    else
        log_warn "No manifest found - cannot verify completeness"
    fi

    # Build verification report
    local missing_assets=()
    local present_assets=()
    local extra_assets=()
    local size_mismatches=()
    local digest_mismatches=()
    local checksum_errors=()
    local verified_checksums=()

    # Get list of actual asset names from release
    local actual_assets=()
    while IFS= read -r name; do
        [[ -n "$name" ]] && actual_assets+=("$name")
    done < <(echo "$assets_json" | jq -r '.[].name')

    # Check for missing assets (in manifest but not in release)
    if $manifest_exists; then
        for expected in "${expected_assets[@]}"; do
            local found=false
            for actual in "${actual_assets[@]}"; do
                if [[ "$expected" == "$actual" ]]; then
                    found=true
                    if $release_contract_enabled; then
                        local remote_size="" remote_digest=""
                        remote_size=$(jq -r --arg name "$actual" '.[] | select(.name == $name) | .size // empty' \
                            <<< "$assets_json")
                        remote_digest=$(jq -r --arg name "$actual" '.[] | select(.name == $name) | .digest // empty' \
                            <<< "$assets_json")
                        if [[ "$remote_size" != "${expected_asset_sizes[$expected]}" ]]; then
                            size_mismatches+=("$expected")
                        elif [[ "$remote_digest" != "sha256:${expected_asset_shas[$expected]}" ]]; then
                            digest_mismatches+=("$expected")
                        else
                            present_assets+=("$expected")
                        fi
                    else
                        present_assets+=("$expected")
                    fi
                    break
                fi
            done
            if ! $found; then
                missing_assets+=("$expected")
            fi
        done
    fi

    # Check for extra assets (in release but not in manifest)
    if $manifest_exists; then
        for actual in "${actual_assets[@]}"; do
            local found=false
            for expected in "${expected_assets[@]}"; do
                if [[ "$expected" == "$actual" ]]; then
                    found=true
                    break
                fi
            done
            if ! $found; then
                extra_assets+=("$actual")
            fi
        done
    else
        # Without manifest, all assets are "present"
        present_assets=("${actual_assets[@]}")
    fi

    # Verify checksums if requested
    if $verify_checksums; then
        log_info "Verifying checksums..."

        # Find SHA256SUMS file in release
        local checksums_url=""
        local checksums_name=""
        for name in "${actual_assets[@]}"; do
            if [[ "$name" == *"SHA256"* ]] || [[ "$name" == *"sha256"* ]] || [[ "$name" == *"checksums"* ]]; then
                checksums_name="$name"
                checksums_url=$(echo "$assets_json" | jq -r --arg name "$name" '.[] | select(.name == $name) | .browser_download_url')
                break
            fi
        done

        if [[ -n "$checksums_url" ]]; then
            log_info "Found checksums file: $checksums_name"

            # Download checksums file
            local temp_dir
            temp_dir=$(mktemp -d)
            local checksums_file="$temp_dir/$checksums_name"

            if curl -sL "$checksums_url" -o "$checksums_file" 2>/dev/null; then
                # Verify a sample of assets
                local verify_count=0
                local verify_max=3  # Spot-check up to 3 assets

                for name in "${actual_assets[@]}"; do
                    # Skip checksums and signature files
                    [[ "$name" == *"SHA256"* ]] && continue
                    [[ "$name" == *"sha256"* ]] && continue
                    [[ "$name" == *".minisig" ]] && continue
                    [[ "$name" == *".sig" ]] && continue

                    if [[ $verify_count -ge $verify_max ]]; then
                        break
                    fi

                    # Get expected checksum from file (use awk for literal filename matching)
                    local expected_sum
                    expected_sum=$(awk -v fname="$name" '$2 == fname || $2 == "*" fname {print $1; exit}' "$checksums_file" 2>/dev/null)

                    if [[ -n "$expected_sum" ]]; then
                        log_info "  Verifying: $name"

                        # Download asset
                        local asset_url
                        asset_url=$(echo "$assets_json" | jq -r --arg name "$name" '.[] | select(.name == $name) | .browser_download_url')
                        local asset_file="$temp_dir/$name"

                        if curl -sL "$asset_url" -o "$asset_file" 2>/dev/null; then
                            local actual_sum
                            # Use sha256sum on Linux, shasum -a 256 on macOS
                            if command -v sha256sum &>/dev/null; then
                                actual_sum=$(sha256sum "$asset_file" | awk '{print $1}')
                            else
                                actual_sum=$(shasum -a 256 "$asset_file" | awk '{print $1}')
                            fi

                            if [[ "$expected_sum" == "$actual_sum" ]]; then
                                log_ok "    Checksum OK"
                                verified_checksums+=("$name")
                            else
                                log_error "    Checksum MISMATCH"
                                checksum_errors+=("$name")
                            fi
                        else
                            log_warn "    Failed to download for verification"
                        fi

                        ((verify_count++))
                    fi
                done
            else
                log_warn "Failed to download checksums file"
            fi

            # Cleanup
            rm -rf "$temp_dir"
        else
            log_warn "No checksums file found in release"
        fi
    fi

    # Repair missing assets if requested. Existing wrong bytes are never
    # deleted or clobbered by strict repair.
    local assets_to_fix=("${missing_assets[@]}" "${size_mismatches[@]}" "${digest_mismatches[@]}")
    local -a planned_fixes=()
    local planned_fix
    if $fix_missing && ${DRY_RUN:-false}; then
        # --fix under --dry-run reports the repair plan and changes nothing:
        # no upload, no clobber, no locally materialized sidecar.
        if $release_contract_enabled; then
            if [[ ${#extra_assets[@]} -gt 0 || ${#size_mismatches[@]} -gt 0 || \
                  ${#digest_mismatches[@]} -gt 0 ]]; then
                log_warn "Strict repair would refuse: the draft has extra, wrong-size or wrong-digest assets"
            else
                planned_fixes=(${missing_assets[@]+"${missing_assets[@]}"})
            fi
        else
            for planned_fix in ${assets_to_fix[@]+"${assets_to_fix[@]}"}; do
                if [[ -f "$state_dir/artifacts/${tool_name}-${tag}/$planned_fix" ]]; then
                    planned_fixes+=("$planned_fix")
                else
                    log_warn "  Not found locally: $planned_fix"
                fi
            done
        fi
        for planned_fix in ${planned_fixes[@]+"${planned_fixes[@]}"}; do
            log_info "[dry-run] Would upload: $planned_fix"
        done
    elif $fix_missing && { $release_contract_enabled || [[ ${#assets_to_fix[@]} -gt 0 ]]; }; then
        planned_fixes=(${assets_to_fix[@]+"${assets_to_fix[@]}"})
        if [[ ${#assets_to_fix[@]} -gt 0 ]]; then
            if $release_contract_enabled; then
                log_info "Strict repair found ${#missing_assets[@]} missing asset(s)"
            else
                log_info "Attempting to re-upload ${#assets_to_fix[@]} missing or mismatched asset(s)..."
            fi
        fi
        if ! $release_contract_enabled; then
            artifacts_dir="$state_dir/artifacts/${tool_name}-${tag}"
        fi

        if $release_contract_enabled; then
            local expected_assets_json strict_fix_failed=false
            local upload_result=""
            expected_assets_json=$(jq -c '.assets' <<< "$release_contract_plan")

            # Additive repair is safe only for a structurally coherent draft.
            # Extra, duplicate, incomplete, or byte-mismatched existing records
            # require manual inspection and are never deleted or clobbered.
            if [[ ${#extra_assets[@]} -gt 0 ]] || ! jq -e '
                all(.[];
                    (.id | type == "number" and floor == . and . > 0) and
                    (.name | type == "string" and length > 0) and
                    (.size | type == "number" and floor == . and . >= 0) and
                    .state == "uploaded" and
                    (.digest | type == "string" and test("^sha256:[0-9a-f]{64}$"))
                ) and
                (([.[].id] | unique | length) == length) and
                (([.[].name] | unique | length) == length)
            ' <<< "$assets_json" >/dev/null 2>&1; then
                log_error "Strict release repair refused incomplete, duplicate, or extra remote asset records"
                strict_fix_failed=true
            fi
            if [[ ${#size_mismatches[@]} -gt 0 || ${#digest_mismatches[@]} -gt 0 ]]; then
                log_error "Strict release repair refuses existing assets with wrong size or digest"
                strict_fix_failed=true
            fi

            if ! $strict_fix_failed; then
                for missing in "${missing_assets[@]}"; do
                    local file_path="${expected_asset_paths[$missing]:-}"
                    local bound_draft_json="" bound_upload_url=""
                    local target_asset_count=0
                    local upload_content_type="application/octet-stream"

                    bound_draft_json=$(_release_contract_observe_bound_draft \
                        "$repo" "$release_id" "$tag" 2>/dev/null || true)
                    if [[ -z "$bound_draft_json" ]] || ! jq -e '
                        all(.assets[];
                            (.id | type == "number" and floor == . and . > 0) and
                            (.name | type == "string" and length > 0) and
                            .state == "uploaded" and
                            (.size | type == "number" and floor == . and . >= 0) and
                            (.digest | type == "string" and test("^sha256:[0-9a-f]{64}$"))
                        ) and
                        (([.assets[].id] | unique | length) == (.assets | length)) and
                        (([.assets[].name] | unique | length) == (.assets | length))
                    ' <<< "$bound_draft_json" >/dev/null 2>&1; then
                        log_error "Strict release left draft state before repair upload: $missing"
                        strict_fix_failed=true
                        break
                    fi

                    if [[ "${expected_asset_kinds[$missing]:-}" == "checksum" && \
                          ! -e "$file_path" && ! -L "$file_path" ]]; then
                        local source_sha="${expected_asset_source_shas[$missing]:-}"
                        local source_name="${missing%.sha256}"
                        if [[ "$source_name" == "$missing" || \
                              ! "$source_sha" =~ ^[0-9a-f]{64}$ ]] || \
                            ! (set -o noclobber; printf '%s  %s\n' \
                                "$source_sha" "$source_name" > "$file_path"); then
                            log_error "Could not create strict repair sidecar without clobbering: $file_path"
                            strict_fix_failed=true
                            break
                        fi
                    fi
                    # A public build-manifest copy is the frozen manifest's bytes.
                    if [[ "${expected_asset_kinds[$missing]:-}" == "build-manifest" && \
                          ! -e "$file_path" && ! -L "$file_path" ]] && \
                       ! (set -o noclobber; cat -- "$manifest_file" > "$file_path"); then
                        log_error "Could not create public build manifest without clobbering: $file_path"
                        strict_fix_failed=true
                        break
                    fi

                    if ! _release_contract_verify_local_asset \
                        "$file_path" "$missing" \
                        "${expected_asset_sizes[$missing]:-}" \
                        "${expected_asset_shas[$missing]:-}"; then
                        strict_fix_failed=true
                        break
                    fi

                    target_asset_count=$(jq -r --arg name "$missing" \
                        '[.assets[] | select(.name == $name)] | length' <<< "$bound_draft_json")
                    if [[ "$target_asset_count" -ne 0 ]]; then
                        log_error "Strict repair target is no longer absent: $missing"
                        strict_fix_failed=true
                        break
                    fi

                    bound_upload_url=$(jq -r '.upload_url // empty' <<< "$bound_draft_json")
                    if [[ "$missing" == *.sha256 || "$missing" == *.minisig ]]; then
                        upload_content_type="text/plain"
                    fi
                    log_info "  Uploading by release ID to draft: $missing"
                    if ! _release_contract_verify_tag_ruleset_receipt \
                        "$strict_tag_ruleset_receipt"; then
                        log_error "Immutable-tag governance changed before strict repair upload"
                        strict_fix_failed=true
                        break
                    elif upload_result=$(gh_upload_asset "$bound_upload_url" "$file_path" \
                        "$upload_content_type" 2>&1); then
                        log_ok "    Uploaded to ID-bound draft"
                    else
                        log_error "Strict ID-bound repair upload returned an ambiguous failure for $missing"
                        [[ -n "$upload_result" ]] && log_error "  Error: $upload_result"
                        strict_fix_failed=true
                        break
                    fi
                done
            fi

            # `preflight verify` requires the entire frozen local plan to be
            # materialized, including sidecars that were already correct
            # remotely and therefore were not selected for upload repair.
            if ! $strict_fix_failed; then
                local planned_name planned_path planned_source_sha planned_source_name
                local bound_sidecar_draft_json=""
                for planned_name in "${expected_assets[@]}"; do
                    case "${expected_asset_kinds[$planned_name]:-}" in
                        checksum|build-manifest) ;;
                        *) continue ;;
                    esac
                    planned_path="${expected_asset_paths[$planned_name]:-}"
                    if [[ ! -e "$planned_path" && ! -L "$planned_path" ]]; then
                        bound_sidecar_draft_json=$(_release_contract_observe_bound_draft \
                            "$repo" "$release_id" "$tag" 2>/dev/null || true)
                        if [[ -z "$bound_sidecar_draft_json" ]]; then
                            log_error "Strict release left draft state before sidecar materialization"
                            strict_fix_failed=true
                            break
                        fi
                        if [[ "${expected_asset_kinds[$planned_name]}" == "build-manifest" ]]; then
                            if ! (set -o noclobber; cat -- "$manifest_file" > "$planned_path"); then
                                log_error "Could not materialize public build manifest: $planned_path"
                                strict_fix_failed=true
                                break
                            fi
                            if ! _release_contract_verify_local_asset \
                                "$planned_path" "$planned_name" \
                                "${expected_asset_sizes[$planned_name]:-}" \
                                "${expected_asset_shas[$planned_name]:-}"; then
                                strict_fix_failed=true
                                break
                            fi
                            continue
                        fi
                        planned_source_sha="${expected_asset_source_shas[$planned_name]:-}"
                        planned_source_name="${planned_name%.sha256}"
                        if [[ "$planned_source_name" == "$planned_name" || \
                              ! "$planned_source_sha" =~ ^[0-9a-f]{64}$ ]] || \
                            ! (set -o noclobber; printf '%s  %s\n' \
                                "$planned_source_sha" "$planned_source_name" > "$planned_path"); then
                            log_error "Could not materialize frozen strict sidecar: $planned_path"
                            strict_fix_failed=true
                            break
                        fi
                    fi
                    if ! _release_contract_verify_local_asset \
                        "$planned_path" "$planned_name" \
                        "${expected_asset_sizes[$planned_name]:-}" \
                        "${expected_asset_shas[$planned_name]:-}"; then
                        strict_fix_failed=true
                        break
                    fi
                done
            fi

            local repaired_contract_plan="" repaired_plan_valid=false
            if ! $strict_fix_failed && _release_contract_verify_remote_assets \
                "$repo" "$release_id" "$expected_assets_json" true "$tag" >/dev/null && \
               repaired_contract_plan=$(_release_contract_preflight \
                "$tool_name" "$tag" "$repo" "$local_path" "$artifacts_dir" \
                "$manifest_file" "$release_contract_json" verify) && \
               jq -en \
                --argjson frozen "$release_contract_plan" \
                --argjson current "$repaired_contract_plan" \
                '$frozen == $current' >/dev/null 2>&1 && \
               _release_contract_verify_remote_tag_identity \
                "$repo" "$tag" "$(jq -r '.git_sha' <<< "$release_contract_plan")" && \
               _release_contract_verify_remote_assets \
                "$repo" "$release_id" "$expected_assets_json" true "$tag" >/dev/null && \
               _release_contract_verify_tag_ruleset_receipt \
                "$strict_tag_ruleset_receipt"; then
                repaired_plan_valid=true
            fi

            if $repaired_plan_valid; then
                present_assets=("${expected_assets[@]}")
                missing_assets=()
                extra_assets=()
                size_mismatches=()
                digest_mismatches=()
                strict_remote_records_valid=true
                log_ok "Strict draft repair matches the frozen release plan and tag"
            else
                log_error "Strict draft repair failed frozen-plan or tag revalidation"
                strict_fix_failed=true
                strict_remote_records_valid=false
            fi

            if $strict_fix_failed; then
                if ! _release_contract_confirm_or_restore_bound_draft \
                    "$repo" "$release_id" "$tag"; then
                    log_error "Strict repair failed and the release could not be left as a verified draft"
                else
                    log_warn "Strict repair failed; release remains a draft"
                fi
            fi
        else
            for missing in "${assets_to_fix[@]}"; do
                local file_path="$artifacts_dir/$missing"
                if [[ -f "$file_path" ]]; then
                    log_info "  Uploading: $missing"
                    if gh release upload "$tag" "$file_path" --repo "$repo" --clobber 2>/dev/null; then
                        log_ok "    Uploaded"
                        present_assets+=("$missing")
                    else
                        log_error "    Upload failed"
                    fi
                else
                    log_warn "  Not found locally: $missing"
                fi
            done

            # Re-check missing assets using the successful local upload results.
            missing_assets=()
            for expected in "${expected_assets[@]}"; do
                local found=false
                for present in "${present_assets[@]}"; do
                    if [[ "$expected" == "$present" ]]; then
                        found=true
                        break
                    fi
                done
                if ! $found; then
                    missing_assets+=("$expected")
                fi
            done
        fi
    fi

    # Calculate duration
    local end_time duration
    end_time=$(date +%s)
    duration=$((end_time - start_time))

    # Determine status
    local status="success"
    local exit_code=0
    if [[ ${#missing_assets[@]} -gt 0 ]] || [[ ${#size_mismatches[@]} -gt 0 ]] || \
        [[ ${#digest_mismatches[@]} -gt 0 ]] || \
        [[ ${#checksum_errors[@]} -gt 0 ]] || \
        { $release_contract_enabled && { [[ ${#extra_assets[@]} -gt 0 ]] || ! $strict_remote_records_valid; }; }; then
        status="incomplete"
        exit_code=1
    fi

    # Output
    if $JSON_MODE; then
        local details
        details=$(jq -nc \
            --arg repo "$repo" \
            --arg version "$version" \
            --arg tag "$tag" \
            --argjson release_id "$release_id" \
            --arg release_url "$release_url" \
            --argjson manifest_found "$manifest_exists" \
            --argjson expected_count "${#expected_assets[@]}" \
            --argjson present "$(printf '%s\n' "${present_assets[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
            --argjson missing "$(printf '%s\n' "${missing_assets[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
            --argjson extra "$(printf '%s\n' "${extra_assets[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
            --argjson size_mismatches "$(printf '%s\n' "${size_mismatches[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
            --argjson digest_mismatches "$(printf '%s\n' "${digest_mismatches[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
            --argjson remote_records_valid "$strict_remote_records_valid" \
            --argjson tag_ruleset_receipt "$strict_tag_ruleset_receipt" \
            --argjson checksum_verified "$(printf '%s\n' "${verified_checksums[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
            --argjson checksum_errors "$(printf '%s\n' "${checksum_errors[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
            --argjson fix_requested "$fix_missing" \
            --argjson dry_run "${DRY_RUN:-false}" \
            --argjson planned_fixes "$(printf '%s\n' ${planned_fixes[@]+"${planned_fixes[@]}"} | jq -Rsc 'split("\n") | map(select(length > 0))')" \
            --argjson duration "$duration" \
            '{
                repo: $repo,
                version: $version,
                tag: $tag,
                release_id: $release_id,
                release_url: $release_url,
                manifest_found: $manifest_found,
                verification: {
                    expected: $expected_count,
                    present: ($present | length),
                    missing: ($missing | length),
                    extra: ($extra | length),
                    size_mismatches: ($size_mismatches | length),
                    digest_mismatches: ($digest_mismatches | length),
                    remote_records_valid: $remote_records_valid,
                    tag_ruleset_receipt: $tag_ruleset_receipt
                },
                assets: {
                    present: $present,
                    missing: $missing,
                    extra: $extra,
                    size_mismatches: $size_mismatches,
                    digest_mismatches: $digest_mismatches
                },
                checksums: {
                    verified: $checksum_verified,
                    errors: $checksum_errors
                },
                repair: (if $fix_requested then
                    {dry_run: $dry_run, uploads: $planned_fixes} else null end),
                duration_seconds: $duration
            }')
        json_envelope "release-verify" "$status" "$exit_code" "$details"
    else
        echo ""
        log_info "=== Verification Report ==="
        log_info "Tool:     $tool_name"
        log_info "Version:  $tag"
        log_info "Release:  $release_url"
        echo ""

        if $manifest_exists; then
            log_info "Expected: ${#expected_assets[@]} asset(s)"
        fi
        log_info "Present:  ${#present_assets[@]} asset(s)"

        if [[ ${#missing_assets[@]} -gt 0 ]]; then
            log_error "Missing:  ${#missing_assets[@]} asset(s)"
            for asset in "${missing_assets[@]}"; do
                log_error "  - $asset"
            done
        fi

        if [[ ${#extra_assets[@]} -gt 0 ]]; then
            if $release_contract_enabled; then
                log_error "Extra:    ${#extra_assets[@]} asset(s) (forbidden by strict contract)"
            else
                log_warn "Extra:    ${#extra_assets[@]} asset(s) (not in manifest)"
            fi
            for asset in "${extra_assets[@]}"; do
                log_warn "  + $asset"
            done
        fi

        if [[ ${#size_mismatches[@]} -gt 0 ]]; then
            log_error "Wrong size: ${#size_mismatches[@]} asset(s)"
            for asset in "${size_mismatches[@]}"; do
                log_error "  ! $asset"
            done
        fi

        if [[ ${#digest_mismatches[@]} -gt 0 ]]; then
            log_error "Wrong digest: ${#digest_mismatches[@]} asset(s)"
            for asset in "${digest_mismatches[@]}"; do
                log_error "  ! $asset"
            done
        fi

        if $verify_checksums; then
            echo ""
            if [[ ${#verified_checksums[@]} -gt 0 ]]; then
                log_ok "Checksums verified: ${#verified_checksums[@]}"
            fi
            if [[ ${#checksum_errors[@]} -gt 0 ]]; then
                log_error "Checksum errors: ${#checksum_errors[@]}"
                for asset in "${checksum_errors[@]}"; do
                    log_error "  ! $asset"
                done
            fi
        fi

        echo ""
        if [[ $exit_code -eq 0 ]]; then
            log_ok "Verification: PASSED"
        else
            log_error "Verification: FAILED"
        fi
        log_info "Duration: ${duration}s"
    fi

    return $exit_code
}

cmd_fallback() {
    # Isolate lock cleanup, child flags, and signal handlers from the caller.
    # In particular, do not leave an EXIT trap referring to expired locals.
    (
    local tool_name="" version="" output_dir=""
    local build_only=false skip_checks=false resume=false
    local dry_run="$DRY_RUN" output_dir_explicit=false
    local resume_selector="latest" resume_run_id="" resume_state="" reuse_completed=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tool|-t|--repo|--version|-V|--output-dir|-o)
                if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
                    log_error "$1 requires a value"
                    return 4
                fi
                case "$1" in
                    --tool|-t|--repo) tool_name="$2" ;;
                    --version|-V) version="$2" ;;
                    --output-dir|-o) output_dir="$2"; output_dir_explicit=true ;;
                esac
                shift 2
                ;;
            --build-only) build_only=true; shift ;;
            --skip-checks) skip_checks=true; shift ;;
            --resume|-r) resume=true; shift ;;
            --resume=*) resume=true; resume_selector="${1#*=}"; shift ;;
            --dry-run|-n) dry_run=true; shift ;;
            --help|-h)
                cat <<'EOF'
dsr fallback - Orchestrated build + release pipeline

USAGE:
    dsr fallback <tool> [--version <version>] [options]

OPTIONS:
    -t, --tool <name>      Tool to build/release (--repo is an alias)
    -V, --version <ver>    Version to release (default: detect from source)
    --build-only           Build and verify artifacts without publishing
    --skip-checks          Skip ordinary quality checks; required checks still run
    -r, --resume[=RUN_ID]  Resume a build or reuse its verified completed outputs
    -o, --output-dir <dir> Artifact directory (created by the build command)
    -n, --dry-run          Plan without creating output, state, or releases

DESCRIPTION:
    Runs quality checks, builds all configured targets, verifies every manifest
    artifact, signs the selected payloads when enabled, then publishes. Partial
    builds, missing or changed artifacts, and signing failures never publish.
    Release checksum sidecars and aliases are generated by dsr release, not by
    a separate fallback filename scan. Strict contracts own their exact assets.
    Resume rechecks quality, source identity, and every artifact. For ordinary
    releases it reconciles an existing release or creates one when absent.
    Existing strict releases still require the strict release repair workflow.

EXIT CODES:
    0  - Pipeline completed successfully
    1  - Partial build or upload failure (partial builds are never published)
    2  - Lock conflict
    3  - Dependency error
    4  - Invalid arguments, configuration, or state
    5  - Interrupted
    6  - Build or artifact verification failed
    7  - Signing or release failed
    8  - Network error
EOF
                return 0
                ;;
            -*) log_error "Unknown option: $1"; return 4 ;;
            *)
                [[ -z "$tool_name" ]] || { log_error "Unexpected argument: $1"; return 4; }
                tool_name="$1"; shift
                ;;
        esac
    done
    if [[ ! "$tool_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        log_error "A safe tool name is required"
        return 4
    fi
    if $resume && [[ "$resume_selector" != latest &&
          ! "$resume_selector" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
        log_error "--resume requires a build run UUID"
        return 4
    fi

    local start_time run_id
    start_time=$(date +%s)
    run_id="${DSR_RUN_ID:-run-$start_time-$$}"
    export DSR_RUN_ID="$run_id"
    log_set_tool "$tool_name"

    local local_path="" repo="" contract="null" tag="" state_dir

    # Every real (non-plan) outcome is notified, so a watcher's "Fallback
    # started" is always followed by how it ended. Fallbacks started by one
    # watcher share its run id, so the dedup key also names tool and tag.
    _fallback_notify() {
        local rc="$1" phase="$2" error="$3" target="$tool_name ${tag:-$version}"
        local event level title message
        if [[ "$rc" == 0 ]]; then
            event=fallback.success level=success title="Release Complete"
            message="$target released successfully"
        else
            level=error
            case "$phase" in
                checks|build|verification|signing)
                    event=fallback.build_failed title="Build Failed"
                    message="$target did not build (phase $phase, exit $rc); release blocked" ;;
                release)
                    event=fallback.release_failed title="Release Failed"
                    message="$target was built but its release did not complete (exit $rc)" ;;
                *)
                    event=fallback.failed title="Fallback Failed"
                    message="$target fallback stopped in $phase (exit $rc)" ;;
            esac
            [[ -z "$error" ]] || message+=": $error"
        fi
        notify_event "$event" "$level" "$title" "$message" "$run_id:$tool_name:${tag:-$version}" >&2 || true
    }

    # Resolve repository, contract and tag (assigning the locals above).
    _fallback_resolve() {
        if ! act_load_repo_config "$tool_name"; then
            log_error "Tool '$tool_name' not found in repos.d"
            return 4
        fi
        local_path=$(act_get_local_path "$tool_name") || return 4
        repo=$(act_get_repo "$tool_name") || return 4
        [[ -d "$local_path" && -n "$repo" ]] || {
            log_error "A local source directory and GitHub repository are required"
            return 4
        }
        [[ "$repo" == */* ]] || repo="Dicklesworthstone/$repo"

        if declare -F config_get_release_contract_json >/dev/null; then
            config_validate_release_contract "$tool_name" || return 4
            contract=$(config_get_release_contract_json "$tool_name") || return 4
            jq -es 'length == 1 and (.[0] == null or (.[0] | type == "object"))' \
                <<< "$contract" >/dev/null || return 4
        fi
        if [[ -z "$version" ]]; then
            local language main_package
            language=$(config_get_tool_field "$tool_name" language "") || return 4
            main_package=$(config_get_tool_field "$tool_name" main_package "") || return 4
            version=$(version_detect "$local_path" "$language" "$main_package") || {
                log_error "Cannot detect version; specify --version"
                return 4
            }
        fi
        tag=$(git_ops_version_to_tag "$version") || return 4
        [[ "$tag" =~ ^v[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || {
            log_error "Invalid release version: $version"
            return 4
        }
    }
    if ! _fallback_resolve; then
        $dry_run || _fallback_notify 4 config "configuration could not be resolved"
        return 4
    fi
    state_dir="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}"
    [[ -n "$output_dir" ]] || output_dir="$state_dir/artifacts/${tool_name}-${tag}"
    # Do not create this directory here: strict cmd_build requires it absent.
    # The dry-run path must also remain entirely free of filesystem writes.
    local checks_status="pending" build_status="pending" verification_status="pending"
    local signing_status="skipped" release_status="pending" artifacts_count=0
    # steps[] (schemas/fallback-details.json): the throttle check, then build
    # (quality gate, build, verification, signing), then release. Each step's
    # outcome follows from the phase that ended the run.
    local fallback_check_step="null" fallback_trigger=""
    local fallback_build_started_ms="" fallback_release_started_ms=""
    _fallback_now_ms() {
        _get_ms_timestamp 2>/dev/null || echo $(( $(date +%s) * 1000 ))
    }

    _fallback_result() {
        local rc="$1" phase="${2:-complete}" error="${3:-}" status="success" details
        if [[ "$phase" == "plan" ]]; then
            status="dry_run"
        elif [[ "$rc" != 0 ]]; then
            status="error"
            [[ "$rc" == 1 ]] && status="partial"
        fi
        if $JSON_MODE; then
            details=$(jq -nc \
                --arg tool "$tool_name" --arg version "$tag" --arg repo "$repo" \
                --arg run_id "$run_id" --arg output_dir "$output_dir" \
                --arg checks "$checks_status" --arg build "$build_status" \
                --arg verification "$verification_status" --arg signing "$signing_status" \
                --arg release "$release_status" --arg phase "$phase" --arg error "$error" \
                --argjson artifacts "$artifacts_count" --argjson build_only "$build_only" \
                --argjson skip_checks "$skip_checks" --argjson resume "$resume" \
                --arg resume_run_id "$resume_run_id" \
                --argjson duration "$(($(date +%s) - start_time))" \
                --argjson rc "$rc" --argjson now_ms "$(_fallback_now_ms)" \
                --argjson check_step "$fallback_check_step" --arg trigger "$fallback_trigger" \
                --arg build_started "$fallback_build_started_ms" \
                --arg release_started "$fallback_release_started_ms" '
                def step($command; $failed; $started; $ended):
                    {command: $command,
                     status: (if $failed | not then "success" elif $rc == 1 then "partial" else "error" end),
                     exit_code: (if $failed then $rc else 0 end),
                     duration_ms: ([($ended - $started), 0] | max)}
                    + (if $failed and $error != "" then {error: $error} else {} end);
                ($phase | IN("checks", "build", "verification", "signing")) as $build_failed |
                ($now_ms) as $end |
                {tool:$tool,version:$version,repo:$repo,run_id:$run_id,
                  output_dir:$output_dir,phase:$phase,error:(if $error=="" then null else $error end),
                  phases:{checks:$checks,build:$build,verification:$verification,
                          signing:$signing,release:$release},
                  steps: ([
                      ($check_step // empty),
                      (if $build_started == "" then empty else
                          step("build"; $build_failed; ($build_started | tonumber);
                               (if $release_started == "" then $end else ($release_started | tonumber) end)) end),
                      (if $release_started == "" then empty else
                          step("release"; $phase == "release"; ($release_started | tonumber); $end) end)
                  ]),
                  artifacts_count:$artifacts,duration_seconds:$duration,
                  build_only:$build_only,skip_checks:$skip_checks,resume:$resume,
                  resume_run_id:$resume_run_id}
                + (if $trigger == "" then {} else {trigger: $trigger} end)') || return 4
            json_envelope fallback "$status" "$rc" "$details"
        else
            log_info "Fallback $status: $tool_name $tag (phase: $phase; artifacts: $artifacts_count)"
            [[ -z "$error" ]] || log_error "$error"
        fi
        [[ "$phase" == plan ]] || _fallback_notify "$rc" "$phase" "$error"
        return "$rc"
    }

    if $dry_run; then
        log_info "[dry-run] Would check, build, verify, and release $tool_name $tag in $output_dir"
        _fallback_result 0 plan
        return $?
    fi
    if ! build_state_init; then
        _fallback_result 4 state "Build state initialization failed"
        return 4
    fi
    local lock_rc=0
    build_lock_acquire "$tool_name" "$tag" || lock_rc=$?
    if [[ $lock_rc -ne 0 ]]; then
        _fallback_result "$lock_rc" lock "Could not acquire fallback build lock"
        return "$lock_rc"
    fi
    local cleanup
    printf -v cleanup 'build_lock_release %q %q >&2' "$tool_name" "$tag"
    # shellcheck disable=SC2064 # Freeze identity; no caller-local references survive.
    trap "$cleanup" EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    export DSR_BUILD_LOCK_HELD_BY_CALLER=1

    if $resume; then
        # Resolve latest once. Neither quality checks nor another new run may
        # redirect this invocation to a different checkpoint or output tree.
        if ! resume_state=$(build_state_get "$tool_name" "$version" "$resume_selector") ||
           ! jq -es --arg tool "$tool_name" --arg version "$version" '
                length == 1 and (.[0] | .tool == $tool and .version == $version and
                (.run_id | type == "string" and
                    test("^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")) and
                (.status == "created" or .status == "running" or .status == "failed" or
                 .status == "targets-complete" or .status == "completed") and
                (.git_sha | type == "string" and test("^[0-9a-f]{40}$")) and
                (.context.output_dir | type == "string" and length > 0) and
                (.context | if has("build_purpose") or has("publishable") then
                    .build_purpose == "release" and .publishable == true else true end) and
                (.targets | type == "array" and length > 0 and
                    (unique | length) == length and all(.[];
                    type == "string" and test("^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$"))))
            ' <<< "$resume_state" >/dev/null; then
            _fallback_result 4 resume "A valid release-build checkpoint is required"
            return 4
        fi
        resume_run_id=$(jq -r '.run_id' <<< "$resume_state") || return 4
        local resume_output
        resume_output=$(jq -r '.context.output_dir' <<< "$resume_state") || return 4
        if { [[ "$resume_selector" != latest && "$resume_run_id" != "$resume_selector" ]]; } ||
           { $output_dir_explicit && [[ "$output_dir" != "$resume_output" ]]; }; then
            _fallback_result 4 resume "Resume run or output directory differs from its checkpoint"
            return 4
        fi
        output_dir="$resume_output"
        [[ "$(jq -r '.status' <<< "$resume_state")" == completed ]] && reuse_completed=true
    fi

    _fallback_verify_completed_source() {
        local current_sha source_status target_list targets_json
        local tasks_json strict_tasks=false matrix_digest=""
        local -a configured_targets=()
        current_sha=$(git -C "$local_path" rev-parse --verify HEAD) || return 1
        source_status=$(git -C "$local_path" status --porcelain --untracked-files=all) || return 1
        target_list=$(act_get_targets "$tool_name") || return 1
        read -r -a configured_targets <<< "$target_list"
        targets_json=$(printf '%s\n' "${configured_targets[@]}" | jq -Rsc \
            'split("\n") | map(select(length > 0))') || return 1
        [[ -z "$source_status" && -d "$output_dir" && ! -L "$output_dir" ]] || return 1
        [[ "$contract" == null ]] || strict_tasks=true
        tasks_json=$(_act_build_task_plan "$tool_name" "$version" "$targets_json" "$strict_tasks") || return 1
        if jq -e 'any(.[]; .key != .platform)' <<< "$tasks_json" >/dev/null; then
            matrix_digest=$(_act_sha256 "$ACT_REPOS_DIR/${tool_name}.yaml") || return 1
        fi
        jq -e --arg sha "$current_sha" --argjson targets "$targets_json" \
            --argjson tasks "$tasks_json" --arg matrix_digest "$matrix_digest" '
            .git_sha == $sha and .targets == $targets and
            (if .context.build_tasks == null then all($tasks[]; .key == .platform)
             else .context.build_tasks == $tasks end) and
            (if $matrix_digest == "" then true
             else .context.native_matrix_config_sha256 == $matrix_digest end)
        ' <<< "$resume_state" >/dev/null
    }
    if $reuse_completed; then
        # A replacement ref must not reinterpret the source named by receipts.
        export GIT_NO_REPLACE_OBJECTS=1
        if ! _fallback_verify_completed_source; then
            _fallback_result 4 resume "Completed build source, target set, or output no longer matches"
            return 4
        fi
    fi

    # Throttle check: records why the fallback ran. It never blocks one that
    # was asked for, and a build-only run publishes nothing, so it skips it.
    if ! $build_only; then
        local check_started check_result="" check_rc=0 check_workflow check_threshold
        check_started=$(_fallback_now_ms)
        check_workflow=$(config_get_tool_field "$tool_name" "workflow" "" 2>/dev/null) || check_workflow=""
        config_load 2>/dev/null || true
        check_threshold=$(config_get threshold_seconds 600 2>/dev/null) || check_threshold=600
        [[ "$check_threshold" =~ ^[1-9][0-9]{0,6}$ ]] || check_threshold=600
        check_result=$(_check_repo "$repo" "$check_threshold" "$(date +%s)" "${check_workflow##*/}" 2>/dev/null) ||
            check_rc=$?
        jq -e 'type == "object"' <<< "$check_result" >/dev/null 2>&1 || check_result='{}'
        case "$check_rc" in
            1) fallback_trigger=$(jq -r --argjson t "$check_threshold" '"release workflow throttled: \((.queued_count // 0) + (.stuck_in_progress_count // 0)) run(s) over \($t)s"' <<< "$check_result")
               log_info "Fallback trigger: $fallback_trigger" ;;
            0) fallback_trigger="manual: no throttled release run detected"
               log_warn "No throttled run of $repo's release workflow detected; continuing as requested" ;;
            *) fallback_trigger="manual: throttle check unavailable"
               log_warn "Could not check $repo for throttling (exit $check_rc); continuing as requested" ;;
        esac
        fallback_check_step=$(jq -nc --argjson rc "$check_rc" --argjson started "$check_started" \
            --argjson ended "$(_fallback_now_ms)" --argjson result "$check_result" '
            {command: "check", status: (if $rc <= 1 then "success" else "error" end), exit_code: $rc,
             throttled: ($rc == 1), duration_ms: ([($ended - $started), 0] | max)}
            + (if $rc > 1 then {error: ($result.error // "throttle check failed")} else {} end)')
    fi
    fallback_build_started_ms=$(_fallback_now_ms)

    local -a quality_args=("$tool_name" --work-dir "$local_path")
    $skip_checks && quality_args+=(--skip-checks)
    local rc=0
    # Child commands own their output formats. Keep their stdout off the outer
    # JSON channel so the pipeline always emits exactly one result envelope.
    qg_run_checks "${quality_args[@]}" >&2 || rc=$?
    if [[ $rc -ne 0 ]]; then
        checks_status="failed"
        [[ $rc -eq 1 ]] && rc=6
        _fallback_result "$rc" checks "Quality checks failed"
        return "$rc"
    fi
    # A skipped gate must not be recorded as a passed one.
    if $skip_checks; then
        checks_status="skipped"
    else
        checks_status="passed"
    fi

    local -a build_args=("$tool_name" --version "$version" --output-dir "$output_dir")
    $resume && build_args+=("--resume=$resume_run_id")
    if $reuse_completed; then
        log_info "Source verified for completed build $resume_run_id; checking its artifacts before reuse"
    else
        cmd_build "${build_args[@]}" >&2 || rc=$?
    fi
    if [[ $rc -ne 0 ]]; then
        build_status="failed"
        [[ $rc -eq 1 ]] && build_status="partial"
        release_status="blocked"
        _fallback_result "$rc" build "Every requested target must succeed before publication"
        return "$rc"
    fi
    build_status="success"

    # cmd_build's exit code is necessary but not sufficient. Inspect the
    # authoritative manifest, not a prefix glob that misses workspace binaries
    # or mistakes logs, signatures, and stale files for completed builds.
    local manifest_file="$output_dir/${tool_name}-${tag}-manifest.json" manifest_json
    local manifest_sha name sha size actual_sha actual_size
    local -a payload_paths=()
    if [[ ! -f "$manifest_file" || -L "$manifest_file" ]] ||
       ! _release_require_publishable_artifacts "$output_dir" "$manifest_file" false ||
       ! manifest_json=$(jq -cse --arg tool "$tool_name" --arg tag "$tag" '
            if length == 1 and (.[0] |
                type == "object" and .tool == $tool and .version == $tag and
                .status == "success" and
                (.summary.total | type == "number" and floor == . and . > 0) and
                .summary.failed == 0 and .summary.success == .summary.total and
                (.artifacts | type == "array" and length > 0) and
                ([.artifacts[].name] | unique | length) == (.artifacts | length) and
                all(.artifacts[];
                    (.name | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._+-]*$")) and
                    (.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
                    (.size_bytes | type == "number" and floor == . and . > 0)))
            then .[0] else error("incomplete build manifest") end
        ' "$manifest_file"); then
        verification_status="failed"; release_status="blocked"
        _fallback_result 6 verification "A complete, publishable build manifest is required"
        return 6
    fi
    manifest_sha=$(_release_sha256 "$manifest_file") || return 6
    if $reuse_completed && ! jq -e --arg run "$resume_run_id" \
        --argjson state "$resume_state" '
            .run_id == $run and .source.git_sha == $state.git_sha and
            .summary.total == (($state.context.build_tasks // $state.targets) | length) and
            (. as $manifest | all(($state.context.build_tasks // [])[];
                if .method == "native" and (.target_triple | type == "string" and length > 0) then
                    . as $task | any($manifest.artifacts[];
                        .target == $task.platform and .target_triple == $task.target_triple)
                else true end))
        ' <<< "$manifest_json" >/dev/null; then
        _fallback_result 6 verification "Manifest does not belong to the completed build run"
        return 6
    fi
    while IFS=$'\t' read -r name sha size; do
        local file="$output_dir/$name"
        actual_sha=""; actual_size=""
        if [[ ! -f "$file" || -L "$file" ]] ||
           ! actual_sha=$(_release_sha256 "$file") ||
           ! actual_size=$(_release_file_size "$file") ||
           [[ "$actual_sha" != "$sha" || "$actual_size" != "$size" ]]; then
            verification_status="failed"; release_status="blocked"
            _fallback_result 6 verification "Manifest artifact is missing or changed: $name"
            return 6
        fi
        payload_paths+=("$file")
    done < <(jq -r '.artifacts[] | [.name,.sha256,(.size_bytes|tostring)] | @tsv' <<< "$manifest_json")
    artifacts_count=${#payload_paths[@]}
    if [[ $artifacts_count -ne $(jq '.artifacts | length' <<< "$manifest_json") ||
          "$(_release_sha256 "$manifest_file")" != "$manifest_sha" ]]; then
        _fallback_result 6 verification "Build manifest changed during verification"
        return 6
    fi
    verification_status="passed"

    # The release command owns checksums and aliases. Never generate a second
    # wildcard checksum inventory (which used absolute paths and included stale
    # signatures), and never add generic sidecars to a strict closed contract.
    if [[ "$contract" != null ]]; then
        signing_status="contract-owned"
    elif signing_wanted && ! signing_is_enabled; then
        # Signing is configured but the keypair cannot sign. A key that
        # exists but is unusable (minisign missing, wrong permissions, no
        # public half) would ship unsigned assets that installers embedding
        # that key reject, so it blocks the release. With no key at all the
        # release is unsigned, and says so.
        if [[ -e "${SIGNING_PRIVATE_KEY:-}" || -e "${SIGNING_PUBLIC_KEY:-}" ]]; then
            signing_check >&2 || true
            signing_status="failed"; release_status="blocked"
            _fallback_result 7 signing "Signing is enabled but the keypair at ${SIGNING_PRIVATE_KEY:-} cannot sign (see above); fix it, or set signing.enabled: false"
            return 7
        fi
        signing_status="unsigned"
        log_warn "Signing is enabled but no keypair exists: releasing UNSIGNED (run 'dsr signing init', or set signing.enabled: false)"
    elif signing_is_enabled; then
        signing_status="running"
        local -a unsigned_paths=()
        local payload
        for payload in "${payload_paths[@]}"; do
            if [[ -e "${payload}.minisig" || -L "${payload}.minisig" ]]; then
                if [[ ! -f "${payload}.minisig" || -L "${payload}.minisig" ]] ||
                   ! signing_verify "$payload" >&2; then
                    signing_status="failed"; release_status="blocked"
                    _fallback_result 7 signing "Existing signature is invalid: ${payload##*/}"
                    return 7
                fi
            else
                unsigned_paths+=("$payload")
            fi
        done
        # Re-signing a completed asset changes its remote signature bytes and
        # defeats content-verified resume. Retain verified sidecars exactly.
        if [[ ${#unsigned_paths[@]} -gt 0 ]]; then
            signing_sign_batch "${unsigned_paths[@]}" >&2 || rc=$?
        fi
        if [[ $rc -ne 0 ]]; then
            signing_status="failed"; release_status="blocked"
            case "$rc" in 5|130|143) ;; *) rc=7 ;; esac
            _fallback_result "$rc" signing "Artifact signing failed; release blocked"
            return "$rc"
        fi
        for payload in "${payload_paths[@]}"; do
            if [[ ! -f "${payload}.minisig" || -L "${payload}.minisig" ]] ||
               ! signing_verify "$payload" >&2; then
                signing_status="failed"; release_status="blocked"
                _fallback_result 7 signing "Signature verification failed: ${payload##*/}"
                return 7
            fi
        done
        signing_status="passed"
    fi

    # Quality/signing commands may mutate the source or payload. Bind the final
    # handoff to the same frozen manifest and bytes, including build-only runs.
    while IFS=$'\t' read -r name sha size; do
        local file="$output_dir/$name"
        if [[ ! -f "$file" || -L "$file" ]] ||
           [[ "$(_release_sha256 "$file")" != "$sha" || "$(_release_file_size "$file")" != "$size" ]]; then
            _fallback_result 6 verification "Artifact changed before release: $name"
            return 6
        fi
    done < <(jq -r '.artifacts[] | [.name,.sha256,(.size_bytes|tostring)] | @tsv' <<< "$manifest_json")
    if [[ "$(_release_sha256 "$manifest_file")" != "$manifest_sha" ]] ||
       { $reuse_completed && ! _fallback_verify_completed_source; }; then
        _fallback_result 6 verification "Manifest or completed source changed before release"
        return 6
    fi

    if $build_only; then
        release_status="skipped"
    else
        fallback_release_started_ms=$(_fallback_now_ms)
        local -a release_args=("$tool_name" "$version" --artifacts "$output_dir")
        if $resume && [[ "$contract" == null ]]; then
            local scan
            if ! scan=$(_release_contract_scan_release_by_tag "$repo" "$tag") ||
               ! jq -es --arg tag "$tag" 'length == 1 and (.[0] |
                    (.count == 0 and .release == null) or
                    (.count == 1 and (.release | type == "object" and .tag_name == $tag)))' \
                <<< "$scan" >/dev/null; then
                _fallback_result 8 release "Could not unambiguously resolve release for resume"
                return 8
            fi
            [[ "$(jq -r '.count' <<< "$scan")" == 1 ]] && release_args+=(--resume)
        fi
        cmd_release "${release_args[@]}" >&2 || rc=$?
        if [[ $rc -ne 0 ]]; then
            release_status="failed"
            [[ $rc -eq 1 ]] && release_status="partial"
            _fallback_result "$rc" release "Release did not complete"
            return "$rc"
        fi
        release_status="success"
    fi
    # Explicitly check release of the lock before reporting success. The EXIT
    # trap remains armed on failure, and restores no caller-owned trap state.
    if ! build_lock_release "$tool_name" "$tag" >&2; then
        _fallback_result 4 lock "Could not release fallback build lock"
        return 4
    fi
    trap - EXIT
    _fallback_result 0
    )
}

cmd_repos() {
    local subcmd="${1:-list}"
    shift 2>/dev/null || true

    case "$subcmd" in
        list)
            cmd_repos_list "$@"
            ;;
        add)
            cmd_repos_add "$@"
            ;;
        remove)
            cmd_repos_remove "$@"
            ;;
        info)
            cmd_repos_info "$@"
            ;;
        validate)
            cmd_repos_validate "$@"
            ;;
        discover)
            cmd_repos_discover "$@"
            ;;
        sync)
            cmd_repos_sync "$@"
            ;;
        --help|-h|help)
            cat << 'EOF'
dsr repos - Manage repository registry

USAGE:
    dsr repos <subcommand> [options]

SUBCOMMANDS:
    list        List all registered repositories
    add         Add a repository to the registry
    remove      Remove a repository from the registry
    info        Show detailed info for a repository
    validate    Validate repository configurations
    discover    Discover repos that could benefit from dsr
    sync        Sync repository metadata from GitHub

OPTIONS:
    --json      Output in JSON format (global)

EXAMPLES:
    dsr repos list                          List all repos
    dsr repos add ntm --local-path /data/projects/ntm
    dsr repos add dicklesworthstone/bv
    dsr repos remove ntm
    dsr repos info ntm --json
    dsr repos validate
    dsr repos discover --path /data/projects

For more information, see docs/CLI_CONTRACT.md
EOF
            ;;
        *)
            log_error "Unknown repos subcommand: $subcmd"
            log_info "Run 'dsr repos --help' for usage"
            return 4
            ;;
    esac
}

# List all registered repositories
cmd_repos_list() {
    local format="table"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --format|-f)
                [[ $# -ge 2 && "$2" =~ ^(table|json|plain)$ ]] || {
                    log_error "--format requires table, json or plain"
                    return 4
                }
                format="$2"
                shift 2
                ;;
            --help|-h)
                cat << 'EOF'
dsr repos list - List registered repositories

USAGE:
    dsr repos list [--format table|plain|json]

OPTIONS:
    -f, --format <fmt>   table (default), plain (name: repo), or json (envelope)
EOF
                return 0
                ;;
            *)
                log_error "Unknown option: $1"
                return 4
                ;;
        esac
    done
    # --format json is the JSON envelope, exactly as the global --json.
    [[ "$format" == json ]] && JSON_MODE=true

    # Load repos config
    if [[ ! -f "$DSR_REPOS_FILE" ]]; then
        log_error "Repos file not found: $DSR_REPOS_FILE"
        log_info "Run: dsr config init"
        if $JSON_MODE; then
            json_envelope "repos" "error" 4 '{"action": "list", "repos": [], "errors": [{"code": "E052", "message": "repos file not found"}]}'
        fi
        return 4
    fi

    local repos_json="[]"
    if command -v yq &>/dev/null; then
        repos_json=$(yq -o=json '.tools // {}' "$DSR_REPOS_FILE" 2>/dev/null | jq -c '
            to_entries | map({
                name: .key,
                repo: (.value.repo // ""),
                local_path: (.value.local_path // ""),
                language: (.value.language // ""),
                targets: (.value.targets // []),
                workflow: (.value.workflow // ""),
                enabled: (.value.enabled // true)
            })
        ' 2>/dev/null || echo "[]")
    else
        # Fallback: simple parsing without yq
        repos_json="[]"
        log_warn "yq not found. Install yq for full repos functionality."
    fi

    if $JSON_MODE; then
        json_envelope "repos" "success" 0 "$(jq -nc --argjson repos "$repos_json" '{action: "list", repos: $repos}')"
    else
        local count
        count=$(echo "$repos_json" | jq 'length')

        if [[ "$count" -eq 0 ]]; then
            log_info "No repositories registered."
            log_info "Run: dsr repos add <owner/repo> --local-path <path>"
            return 0
        fi

        log_info "Registered repositories ($count):"
        echo ""

        if [[ "$format" == "table" ]]; then
            printf "%-12s %-30s %-10s %s\n" "NAME" "REPO" "LANGUAGE" "TARGETS"
            printf "%s\n" "$(printf '%.0s-' {1..80})"
            echo "$repos_json" | jq -r '.[] | [.name, .repo, .language, (.targets | join(","))] | @tsv' | \
                while IFS=$'\t' read -r name repo lang targets; do
                    printf "%-12s %-30s %-10s %s\n" "$name" "$repo" "${lang:-?}" "${targets:-all}"
                done
        else
            echo "$repos_json" | jq -r '.[] | "\(.name): \(.repo)"'
        fi
    fi
}

# Add a repository to the registry
cmd_repos_add() {
    local repo_input=""
    local local_path=""
    local language=""
    local name=""
    local dry_run="${DRY_RUN:-false}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --local-path|-p)
                local_path="$2"
                shift 2
                ;;
            --language|-l)
                language="$2"
                shift 2
                ;;
            --name|-n)
                name="$2"
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                return 4
                ;;
            *)
                repo_input="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$repo_input" ]]; then
        log_error "Usage: dsr repos add <owner/repo|name> [--local-path <path>] [--language <lang>]"
        return 4
    fi

    # Parse repo input - could be "owner/repo" or just "name"
    local repo
    if [[ "$repo_input" =~ / ]]; then
        repo="$repo_input"
        [[ -z "$name" ]] && name="${repo_input#*/}"
    else
        name="$repo_input"
        repo=""
    fi

    # Validate local_path if provided
    if [[ -n "$local_path" ]]; then
        # Source guardrails for path resolution
        source "$SCRIPT_DIR/src/guardrails.sh"
        local_path=$(resolve_path "$local_path" 2>&1) || {
            log_error "Invalid local path: $local_path"
            if $JSON_MODE; then
                json_envelope "repos" "error" 4 "$(jq -nc --arg name "$name" '{action: "add", repo: $name, errors: [{code: "E052", message: "invalid local path"}]}')"
            fi
            return 4
        }

        # Auto-detect language if not specified
        if [[ -z "$language" && -d "$local_path" ]]; then
            if [[ -f "$local_path/Cargo.toml" ]]; then
                language="rust"
            elif [[ -f "$local_path/go.mod" ]]; then
                language="go"
            elif [[ -f "$local_path/package.json" ]]; then
                if [[ -f "$local_path/bun.lockb" ]]; then
                    language="bun"
                else
                    language="node"
                fi
            elif [[ -f "$local_path/pyproject.toml" || -f "$local_path/setup.py" ]]; then
                language="python"
            fi
        fi

        # Auto-detect repo from git remote if not specified
        if [[ -z "$repo" && -d "$local_path/.git" ]]; then
            local remote_url
            remote_url=$(git -C "$local_path" remote get-url origin 2>/dev/null || true)
            if [[ -n "$remote_url" ]]; then
                # Parse owner/repo from git URL
                repo=$(echo "$remote_url" | sed -E 's#.*(github\.com[:/])([^/]+/[^/]+)(\.git)?$#\2#')
                repo="${repo%.git}"
            fi
        fi
    fi

    # Check if yq is available for writing
    if ! command -v yq &>/dev/null; then
        log_error "yq is required to add repositories"
        log_info "Install: brew install yq  OR  apt install yq"
        if $JSON_MODE; then
            json_envelope "repos" "error" 3 '{"action": "add", "errors": [{"code": "E041", "message": "yq required"}]}'
        fi
        return 3
    fi

    # Ensure repos file exists
    if [[ ! -f "$DSR_REPOS_FILE" ]] && ! $dry_run; then
        log_warn "Repos file not found, running config init..."
        config_init >/dev/null 2>&1
    fi

    # Check if already exists
    local existing
    existing=$(DSR_ADD_NAME="$name" yq '.tools[strenv(DSR_ADD_NAME)]' "$DSR_REPOS_FILE" 2>/dev/null)
    if [[ "$existing" != "null" && -n "$existing" ]]; then
        log_error "Repository '$name' already exists"
        log_info "Use 'dsr repos remove $name' first, or choose a different name"
        if $JSON_MODE; then
            json_envelope "repos" "error" 4 "$(jq -nc --arg name "$name" '{action: "add", repo: $name, errors: [{code: "E052", message: "repo already exists"}]}')"
        fi
        return 4
    fi

    # Add to repos.yaml in one write, values passed as data rather than
    # spliced into the yq expression. Dry runs show the entry only.
    local write_status=0
    if ! $dry_run; then
        DSR_ADD_NAME="$name" DSR_ADD_REPO="${repo:-}" DSR_ADD_PATH="${local_path:-}" \
        DSR_ADD_LANG="${language:-}" yq -i '
            .tools[strenv(DSR_ADD_NAME)] = {
                "repo": strenv(DSR_ADD_REPO), "local_path": strenv(DSR_ADD_PATH),
                "language": strenv(DSR_ADD_LANG),
                "targets": ["linux/amd64", "darwin/arm64", "windows/amd64"]} |
            del(.tools[strenv(DSR_ADD_NAME)][] | select(. == ""))
        ' "$DSR_REPOS_FILE" || write_status=$?
    fi
    if [[ $write_status -ne 0 ]]; then
        log_error "Could not write $DSR_REPOS_FILE; '$name' was not added"
        if $JSON_MODE; then
            json_envelope "repos" "error" 1 "$(jq -nc --arg name "$name" '{action: "add", repo: $name, errors: [{code: "E052", message: "registry write failed", repo: $name}]}')"
        fi
        return 1
    fi

    if $JSON_MODE; then
        local added_json
        added_json=$(jq -nc \
            --arg name "$name" \
            --arg repo "${repo:-}" \
            --arg local_path "${local_path:-}" \
            --arg language "${language:-}" \
            '{name: $name, repo: $repo, local_path: $local_path, language: $language, targets: ["linux/amd64", "darwin/arm64", "windows/amd64"]}')
        json_envelope "repos" "success" 0 "$(jq -nc --argjson added "[$added_json]" --argjson dry_run "$dry_run" '{action: "add", added: $added, dry_run: $dry_run}')"
    elif $dry_run; then
        log_info "[dry-run] Would add repository: $name"
        [[ -n "$repo" ]] && log_info "  repo: $repo"
        [[ -n "$local_path" ]] && log_info "  local_path: $local_path"
        [[ -n "$language" ]] && log_info "  language: $language"
        return 0
    else
        log_ok "Added repository: $name"
        [[ -n "$repo" ]] && log_info "  repo: $repo"
        [[ -n "$local_path" ]] && log_info "  local_path: $local_path"
        [[ -n "$language" ]] && log_info "  language: $language"
    fi

    # `repos add` writes the registry, but the build runner reads only
    # repos.d/<name>.yaml — without that file this tool looks registered and
    # still cannot build (issue #12 instance 1). Say so at add time.
    local added_repos_d_file="${DSR_CONFIG_DIR:-$HOME/.config/dsr}/repos.d/${name}.yaml"
    if [[ ! -f "$added_repos_d_file" ]]; then
        log_warn "No repos.d/${name}.yaml yet — dsr build/release read ONLY that file, so '$name' is not buildable until it exists"
        log_info "Create it from a template (config/repos.d/_template_*.yaml) and keep it in agreement with repos.yaml; 'dsr repos validate' checks the two for divergence"
    fi
}

# Remove a repository from the registry
cmd_repos_remove() {
    local name=""
    local dry_run="${DRY_RUN:-false}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                dry_run=true
                shift
                ;;
            --help|-h)
                cat << 'EOF'
dsr repos remove - Remove a repository from the registry

USAGE:
    dsr repos remove <name> [--dry-run]

OPTIONS:
    --dry-run   Show the entry that would be removed; change nothing
EOF
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                return 4
                ;;
            *)
                if [[ -n "$name" ]]; then
                    log_error "repos remove takes one name (got '$name' and '$1')"
                    return 4
                fi
                name="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$name" ]]; then
        log_error "Usage: dsr repos remove <name> [--dry-run]"
        return 4
    fi

    if ! command -v yq &>/dev/null; then
        log_error "yq is required to remove repositories"
        if $JSON_MODE; then
            json_envelope "repos" "error" 3 '{"action": "remove", "errors": [{"code": "E041", "message": "yq required"}]}'
        fi
        return 3
    fi

    if [[ ! -f "$DSR_REPOS_FILE" ]]; then
        log_error "Repos file not found"
        return 4
    fi

    # Check if exists
    local existing
    existing=$(DSR_RM_NAME="$name" yq '.tools[strenv(DSR_RM_NAME)]' "$DSR_REPOS_FILE" 2>/dev/null)
    if [[ "$existing" == "null" || -z "$existing" ]]; then
        log_error "Repository '$name' not found"
        if $JSON_MODE; then
            json_envelope "repos" "error" 4 "$(jq -nc --arg name "$name" '{action: "remove", repo: $name, errors: [{code: "E052", message: "repo not found"}]}')"
        fi
        return 4
    fi
    local removed_repo
    removed_repo=$(DSR_RM_NAME="$name" yq '.tools[strenv(DSR_RM_NAME)].repo // ""' "$DSR_REPOS_FILE" 2>/dev/null)

    if ! $dry_run && ! DSR_RM_NAME="$name" yq -i 'del(.tools[strenv(DSR_RM_NAME)])' "$DSR_REPOS_FILE"; then
        log_error "Could not write $DSR_REPOS_FILE; '$name' was not removed"
        if $JSON_MODE; then
            json_envelope "repos" "error" 1 "$(jq -nc --arg name "$name" '{action: "remove", repo: $name, errors: [{code: "E052", message: "registry write failed", repo: $name}]}')"
        fi
        return 1
    fi

    if $JSON_MODE; then
        json_envelope "repos" "success" 0 "$(jq -nc --arg name "$name" --arg repo "$removed_repo" \
            --argjson dry_run "$dry_run" '{action: "remove", removed: [{name: $name, repo: $repo}], dry_run: $dry_run}')"
    elif $dry_run; then
        log_info "[dry-run] Would remove repository: $name${removed_repo:+ ($removed_repo)}"
    else
        log_ok "Removed repository: $name"
    fi
}

# Show detailed info for a repository
cmd_repos_info() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        log_error "Usage: dsr repos info <name>"
        return 4
    fi

    if [[ ! -f "$DSR_REPOS_FILE" ]]; then
        log_error "Repos file not found"
        return 4
    fi

    local tool_yaml
    if command -v yq &>/dev/null; then
        tool_yaml=$(yq ".tools.$name" "$DSR_REPOS_FILE" 2>/dev/null)
    else
        log_error "yq required for repos info"
        return 3
    fi

    if [[ "$tool_yaml" == "null" || -z "$tool_yaml" ]]; then
        log_error "Repository '$name' not found"
        if $JSON_MODE; then
            json_envelope "repos" "error" 4 "$(jq -nc --arg name "$name" '{action: "info", repo: $name, errors: [{code: "E052", message: "repo not found"}]}')"
        fi
        return 4
    fi

    local tool_json
    tool_json=$(yq -o=json ".tools.$name" "$DSR_REPOS_FILE" 2>/dev/null | jq -c --arg name "$name" '. + {name: $name}')

    if $JSON_MODE; then
        json_envelope "repos" "success" 0 "$(jq -nc --argjson repos "[$tool_json]" --arg name "$name" '{action: "info", repo: $name, repos: $repos}')"
    else
        log_info "Repository: $name"
        echo ""
        echo "$tool_json" | jq -r 'to_entries[] | "  \(.key): \(.value)"'
    fi
}

# ---------------------------------------------------------------------------
# GoReleaser compatibility validation helpers
# ---------------------------------------------------------------------------

_goreleaser_find_config() {
    local repo_path="$1"
    local candidates=(
        ".goreleaser.yaml"
        ".goreleaser.yml"
    )
    local candidate
    for candidate in "${candidates[@]}"; do
        if [[ -f "$repo_path/$candidate" ]]; then
            echo "$repo_path/$candidate"
            return 0
        fi
    done
    return 1
}

_goreleaser_extract_targets() {
    local gr_json="$1"
    printf '%s\n' "$gr_json" | jq -r '
        (.builds // []) as $builds
        | if ($builds | length) == 0 then empty else
            [ $builds[]
              | (.goos // []) as $os
              | (.goarch // []) as $arch
              | if ($os | length) == 0 or ($arch | length) == 0 then empty
                else $os[] as $o | $arch[] as $a | "\($o)/\($a)"
                end
            ] | unique | .[]
          end
    ' 2>/dev/null
}

_goreleaser_render_template() {
    local template="$1"
    local project_name="$2"
    local version="$3"
    local os="$4"
    local arch="$5"
    local ext="$6"
    local binary="$7"

    local rendered="$template"
    # Note: In sed -E, curly braces are special (quantifiers), so escape them
    rendered=$(echo "$rendered" | sed -E \
        -e "s/\{\{[^}]*\.ProjectName[^}]*\}\}/$project_name/g" \
        -e "s/\{\{[^}]*\.Binary[^}]*\}\}/$binary/g" \
        -e "s/\{\{[^}]*\.Version[^}]*\}\}/$version/g" \
        -e "s/\{\{[^}]*\.Os[^}]*\}\}/$os/g" \
        -e "s/\{\{[^}]*\.Arch[^}]*\}\}/$arch/g" \
        -e "s/\{\{[^}]*\.Arm[^}]*\}\}//g" \
        -e "s/\{\{[^}]*\.Ext[^}]*\}\}/$ext/g")

    echo "$rendered"
}

_dsr_render_artifact_name() {
    local pattern="$1"
    local name="$2"
    local version="$3"
    local os="$4"
    local arch="$5"
    local binary="$6"
    local ext="$7"

    local rendered="$pattern"
    local arch_resolved="$arch"
    local arch_alias=""
    if declare -F config_get_arch_alias &>/dev/null; then
        arch_alias=$(config_get_arch_alias "$name" "$arch" 2>/dev/null || echo "")
        [[ -n "$arch_alias" ]] && arch_resolved="$arch_alias"
    fi

    local target_triple=""
    if declare -F config_get_target_triple &>/dev/null; then
        target_triple=$(config_get_target_triple "$name" "${os}/${arch}" 2>/dev/null || echo "")
    fi
    if [[ -z "$target_triple" ]]; then
        case "$os/$arch" in
            linux/amd64) target_triple="x86_64-unknown-linux-gnu" ;;
            linux/arm64) target_triple="aarch64-unknown-linux-gnu" ;;
            darwin/amd64) target_triple="x86_64-apple-darwin" ;;
            darwin/arm64) target_triple="aarch64-apple-darwin" ;;
            windows/amd64) target_triple="x86_64-pc-windows-msvc" ;;
            windows/arm64) target_triple="aarch64-pc-windows-msvc" ;;
            *) target_triple="${os}-${arch}" ;;
        esac
    fi

    local target="${os}-${arch_resolved}"
    rendered="${rendered//\$\{name\}/$name}"
    rendered="${rendered//\$\{binary\}/$binary}"
    rendered="${rendered//\$\{version\}/$version}"
    rendered="${rendered//\$\{os\}/$os}"
    rendered="${rendered//\$\{arch\}/$arch_resolved}"
    rendered="${rendered//\$\{target\}/$target}"
    rendered="${rendered//\$\{target_triple\}/$target_triple}"
    rendered="${rendered//\$\{ext\}/$ext}"

    echo "$rendered"
}

goreleaser_validate_tool() {
    local tool_name="$1"
    local tool_json="$2"
    local repo_path="$3"

    local messages=()
    local status="ok"

    if [[ -z "$repo_path" || ! -d "$repo_path" ]]; then
        echo "skip|"
        return 0
    fi

    local gr_config
    if ! gr_config=$(_goreleaser_find_config "$repo_path"); then
        echo "skip|"
        return 0
    fi

    if ! command -v jq &>/dev/null; then
        echo "warn|jq required for goreleaser validation"
        return 0
    fi

    local gr_json
    if ! gr_json=$(yq -o=json '.' "$gr_config" 2>/dev/null); then
        echo "warn|Unable to parse goreleaser config: $gr_config"
        return 0
    fi

    # Merge repos.yaml config with repos.d config if present (repos.d takes precedence)
    local merged_json="$tool_json"
    local dsr_config_file="${DSR_CONFIG_DIR:-$HOME/.config/dsr}/repos.d/${tool_name}.yaml"
    if [[ -f "$dsr_config_file" ]]; then
        local dsr_json
        if dsr_json=$(yq -o=json '.' "$dsr_config_file" 2>/dev/null); then
            merged_json=$(jq -s '.[0] * .[1]' \
                <(printf '%s\n' "$tool_json") \
                <(printf '%s\n' "$dsr_json") 2>/dev/null) || merged_json="$tool_json"
        fi
    fi

    # Extract dsr targets
    local dsr_targets=()
    mapfile -t dsr_targets < <(printf '%s\n' "$merged_json" | jq -r '.targets[]?' 2>/dev/null)

    # Extract goreleaser targets
    local gr_targets=()
    mapfile -t gr_targets < <(_goreleaser_extract_targets "$gr_json")

    if [[ ${#dsr_targets[@]} -eq 0 ]]; then
        status="warn"
        messages+=("No dsr targets defined; cannot validate goreleaser targets")
    elif [[ ${#gr_targets[@]} -eq 0 ]]; then
        status="warn"
        messages+=("No goreleaser targets found in config")
    else
        local missing_in_dsr missing_in_gr
        missing_in_dsr=$(comm -23 \
            <(printf '%s\n' "${gr_targets[@]}" | sort -u) \
            <(printf '%s\n' "${dsr_targets[@]}" | sort -u) 2>/dev/null)
        missing_in_gr=$(comm -23 \
            <(printf '%s\n' "${dsr_targets[@]}" | sort -u) \
            <(printf '%s\n' "${gr_targets[@]}" | sort -u) 2>/dev/null)
        if [[ -n "$missing_in_dsr" ]]; then
            status="warn"
            messages+=("Targets missing in dsr config: $(echo "$missing_in_dsr" | paste -sd ',' -)")
        fi
        if [[ -n "$missing_in_gr" ]]; then
            status="warn"
            messages+=("Targets missing in goreleaser config: $(echo "$missing_in_gr" | paste -sd ',' -)")
        fi
    fi

    # Archive format comparison
    local gr_archive
    gr_archive=$(printf '%s\n' "$gr_json" | jq -c '.archives[0] // {}' 2>/dev/null)
    local gr_format_default
    gr_format_default=$(printf '%s\n' "$gr_archive" | jq -r '
        if .format then .format
        elif (.formats | type) == "array" and (.formats | length) > 0 then .formats[0]
        else "" end
    ' 2>/dev/null)

    if [[ -z "$gr_format_default" ]]; then
        status="warn"
        messages+=("No default archive format in goreleaser config")
    fi

    local target
    for target in "${dsr_targets[@]}"; do
        local os arch
        os="${target%%/*}"
        arch="${target##*/}"

        local dsr_format
        dsr_format=$(printf '%s\n' "$merged_json" | jq -r --arg os "$os" '
            if .archive_format == null then ""
            elif (.archive_format | type) == "string" then .archive_format
            elif (.archive_format | type) == "object" then .archive_format[$os] // ""
            else "" end
        ' 2>/dev/null)

        local gr_format
        gr_format=$(printf '%s\n' "$gr_archive" | jq -r --arg os "$os" '
            (.format_overrides // []) as $o
            | ($o[]? | select(.goos == $os) | .format) // empty
        ' 2>/dev/null | head -n1)
        [[ -z "$gr_format" ]] && gr_format="$gr_format_default"

        if [[ -n "$dsr_format" && -n "$gr_format" && "$dsr_format" != "$gr_format" ]]; then
            status="warn"
            messages+=("Archive format mismatch for $os/$arch: dsr=$dsr_format goreleaser=$gr_format")
        elif [[ -z "$dsr_format" ]]; then
            status="warn"
            messages+=("Archive format missing in dsr config for $os/$arch")
        fi
    done

    # Artifact naming template comparison (best-effort)
    local dsr_pattern
    dsr_pattern=$(printf '%s\n' "$merged_json" | jq -r '.artifact_naming // empty' 2>/dev/null)
    local gr_name_template
    gr_name_template=$(printf '%s\n' "$gr_archive" | jq -r '.name_template // empty' 2>/dev/null)

    local dsr_binary
    dsr_binary=$(printf '%s\n' "$merged_json" | jq -r '.binary_name // empty' 2>/dev/null)
    local gr_project_name
    gr_project_name=$(printf '%s\n' "$gr_json" | jq -r '.project_name // empty' 2>/dev/null)
    [[ -z "$gr_project_name" ]] && gr_project_name="$tool_name"

    if [[ -n "$dsr_pattern" && -n "$gr_name_template" ]]; then
        local sample_version="1.2.3"
        local name_mismatch=false
        for target in "${dsr_targets[@]}"; do
            local os arch dsr_format gr_format
            os="${target%%/*}"
            arch="${target##*/}"

            dsr_format=$(printf '%s\n' "$merged_json" | jq -r --arg os "$os" '
                if .archive_format == null then ""
                elif (.archive_format | type) == "string" then .archive_format
                elif (.archive_format | type) == "object" then .archive_format[$os] // ""
                else "" end
            ' 2>/dev/null)
            gr_format=$(printf '%s\n' "$gr_archive" | jq -r --arg os "$os" '
                (.format_overrides // []) as $o
                | ($o[]? | select(.goos == $os) | .format) // empty
            ' 2>/dev/null | head -n1)
            [[ -z "$gr_format" ]] && gr_format="$gr_format_default"

            local dsr_name gr_name
            dsr_name=$(_dsr_render_artifact_name "$dsr_pattern" "$tool_name" "$sample_version" "$os" "$arch" "$dsr_binary" "$dsr_format")
            gr_name=$(_goreleaser_render_template "$gr_name_template" "$gr_project_name" "$sample_version" "$os" "$arch" "$gr_format" "$dsr_binary")
            if [[ "$dsr_name" != "$gr_name" ]]; then
                name_mismatch=true
                messages+=("Artifact name mismatch for $os/$arch: dsr='$dsr_name' goreleaser='$gr_name'")
                break
            fi
        done
        if $name_mismatch; then
            status="warn"
        fi
    else
        status="warn"
        messages+=("Missing artifact_naming or goreleaser name_template")
    fi

    local msg_str=""
    [[ ${#messages[@]} -gt 0 ]] && msg_str=$(IFS='; '; echo "${messages[*]}")
    echo "$status|$msg_str"
}

# Validate repository configurations
# Includes artifact naming consistency checks (bd-1tv.4)
cmd_repos_validate() {
    local repo_filter=""
    local path_override=""
    local naming_only=false
    local skip_naming=false

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo|-r)
                repo_filter="$2"
                shift 2
                ;;
            --path|-p)
                path_override="$2"
                shift 2
                ;;
            --naming|--naming-only)
                naming_only=true
                shift
                ;;
            --skip-naming)
                skip_naming=true
                shift
                ;;
            --help|-h)
                cat << 'EOF'
dsr repos validate - Validate repository configurations

USAGE:
    dsr repos validate [options]

OPTIONS:
    --repo, -r <name>   Validate only this repository
    --path, -p <path>   Validate a local project (not registered)
    --naming            Only check artifact naming consistency
    --skip-naming       Skip artifact naming checks
    --json              Output in JSON format

ARTIFACT NAMING CHECKS:
    Validates consistency between:
    - repos.d/*.yaml artifact_naming config
    - Project install.sh expected patterns
    - .github/workflows/release.yml artifact names

    Detects mismatches BEFORE a release attempt fails.

EXAMPLES:
    dsr repos validate                  Validate all repos
    dsr repos validate --repo ntm       Validate specific repo
    dsr repos validate --path /data/projects/my_tool
    dsr repos validate --naming         Only check naming
EOF
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                log_info "Run 'dsr repos validate --help' for usage"
                return 4
                ;;
            *)
                # For backward compat: first positional arg is repo filter
                [[ -z "$repo_filter" ]] && repo_filter="$1"
                shift
                ;;
        esac
    done

    # If --path specified, validate that project directly
    if [[ -n "$path_override" ]]; then
        _validate_project_at_path "$path_override"
        return $?
    fi

    if [[ ! -f "$DSR_REPOS_FILE" ]]; then
        log_error "Repos file not found"
        return 4
    fi

    if ! command -v yq &>/dev/null; then
        log_error "yq required for validation"
        return 3
    fi

    # Load artifact_naming module for naming checks
    if [[ "$skip_naming" != "true" ]]; then
        _dsr_require artifact_naming
    fi

    local tools_json
    tools_json=$(yq -o=json '.tools // {}' "$DSR_REPOS_FILE" 2>/dev/null)

    # A filter naming nothing must not validate "successfully" (a typo would
    # otherwise pass the release preflight it is meant to guard).
    if [[ -n "$repo_filter" ]] &&
       ! jq -e --arg name "$repo_filter" 'has($name)' <<< "$tools_json" >/dev/null 2>&1 &&
       [[ ! -f "${DSR_CONFIG_DIR:-$HOME/.config/dsr}/repos.d/${repo_filter}.yaml" ]]; then
        log_error "Repository '$repo_filter' not found in repos.yaml or repos.d"
        if $JSON_MODE; then
            json_envelope "repos" "error" 4 "$(jq -nc --arg name "$repo_filter" '{action: "validate", repo: $name, validated: [], errors: [{code: "E052", message: "repo not found", repo: $name}]}')"
        fi
        return 4
    fi

    local results=()
    local errors=0
    local warnings=0

    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        [[ -n "$repo_filter" && "$name" != "$repo_filter" ]] && continue

        local tool_json
        tool_json=$(echo "$tools_json" | jq -c --arg name "$name" '.[$name]')

        local status="ok"
        local messages=()
        local naming_info="{}"

        # Check required fields
        local repo local_path
        repo=$(echo "$tool_json" | jq -r '.repo // ""')
        local_path=$(echo "$tool_json" | jq -r '.local_path // ""')

        if [[ "$naming_only" != "true" ]]; then
            if [[ -z "$repo" && -z "$local_path" ]]; then
                status="error"
                messages+=("Missing both 'repo' and 'local_path' - need at least one")
                ((errors++))
            fi
        fi

        local resolved_path=""
        # Check local_path exists
        if [[ -n "$local_path" ]]; then
            source "$SCRIPT_DIR/src/guardrails.sh"
            resolved_path=$(resolve_path "$local_path" 2>/dev/null) || {
                if [[ "$naming_only" != "true" ]]; then
                    status="error"
                    messages+=("Invalid local_path: $local_path")
                    ((errors++))
                fi
            }
            if [[ -n "$resolved_path" && ! -d "$resolved_path" ]]; then
                if [[ "$naming_only" != "true" ]]; then
                    status="warn"
                    messages+=("local_path does not exist: $resolved_path")
                    ((warnings++))
                fi
            fi
        fi

        # Skip non-naming checks if --naming flag
        if [[ "$naming_only" != "true" ]]; then
            # Check workflow file exists
            local workflow
            workflow=$(echo "$tool_json" | jq -r '.workflow // ""')
            if [[ -n "$workflow" && -n "$local_path" ]]; then
                source "$SCRIPT_DIR/src/guardrails.sh"
                local workflow_resolved_path
                workflow_resolved_path=$(resolve_path "$local_path" 2>/dev/null) || true
                if [[ -n "$workflow_resolved_path" && ! -f "$workflow_resolved_path/$workflow" ]]; then
                    if [[ "$status" != "error" ]]; then
                        status="warn"
                    fi
                    messages+=("Workflow file not found: $workflow")
                    ((warnings++))
                fi
            fi

            # GoReleaser compatibility validation (best-effort)
            local gr_result gr_status gr_message
            gr_result=$(goreleaser_validate_tool "$name" "$tool_json" "$resolved_path")
            gr_status="${gr_result%%|*}"
            gr_message="${gr_result#*|}"
            if [[ "$gr_status" == "warn" && -n "$gr_message" ]]; then
                if [[ "$status" != "error" ]]; then
                    status="warn"
                fi
                messages+=("$gr_message")
                ((warnings++))
            elif [[ "$gr_status" == "error" && -n "$gr_message" ]]; then
                status="error"
                messages+=("$gr_message")
                ((errors++))
            fi
        fi

        # Artifact naming consistency validation (bd-1tv.4)
        if [[ "$skip_naming" != "true" && -n "$resolved_path" && -d "$resolved_path" ]]; then
            local naming_result
            naming_result=$(_validate_artifact_naming "$name" "$tool_json" "$resolved_path")

            local naming_status naming_messages naming_json
            naming_status=$(echo "$naming_result" | jq -r '.status // "ok"')
            naming_messages=$(echo "$naming_result" | jq -r '.messages[]? // empty' 2>/dev/null)
            naming_json="$naming_result"

            if [[ "$naming_status" == "warning" ]]; then
                if [[ "$status" != "error" ]]; then
                    status="warn"
                fi
                while IFS= read -r msg; do
                    [[ -n "$msg" ]] && messages+=("Naming: $msg")
                done <<< "$naming_messages"
                ((warnings++))
            elif [[ "$naming_status" == "error" ]]; then
                status="error"
                while IFS= read -r msg; do
                    [[ -n "$msg" ]] && messages+=("Naming: $msg")
                done <<< "$naming_messages"
                ((errors++))
            fi
            naming_info="$naming_json"
        fi

        # Registry vs build-config agreement (issues #12/#13). repos.yaml is
        # what list/info/check/quality read; repos.d/<tool>.yaml is what the
        # build runner reads. Divergence means the tool you inspect is not the
        # tool you build, and it has shipped wrong platform matrices — so a
        # green validate must guarantee the two agree.
        if [[ "$naming_only" != "true" ]]; then
            local div_json="" div_rc=0
            div_json=$(config_registry_divergence_json "$name" 2>/dev/null) || div_rc=$?
            if [[ $div_rc -ne 0 || -z "$div_json" ]]; then
                status="error"
                messages+=("Could not compare repos.yaml with repos.d/${name}.yaml (unparseable config)")
                ((errors++))
            else
                local div_repo_config div_tool_name div_mismatched div_registry_only
                div_repo_config=$(jq -r '.repo_config' <<< "$div_json")
                div_tool_name=$(jq -r '.tool_name // ""' <<< "$div_json")
                div_mismatched=$(jq -r '.mismatched_keys | join(", ")' <<< "$div_json")
                div_registry_only=$(jq -r '.registry_only_build_keys | join(", ")' <<< "$div_json")
                if [[ "$div_repo_config" != "true" ]]; then
                    if [[ "$status" != "error" ]]; then
                        status="warn"
                    fi
                    messages+=("No repos.d/${name}.yaml — dsr build/release read only repos.d, so this tool is registry-only and cannot build")
                    ((warnings++))
                else
                    if [[ -n "$div_tool_name" && "$div_tool_name" != "$name" ]]; then
                        status="error"
                        messages+=("repos.d/${name}.yaml declares tool_name '${div_tool_name}' — the build runner loads repos.d/<tool_name>.yaml by filename, so this file can never be loaded as '${div_tool_name}'; rename the file or fix tool_name")
                        ((errors++))
                    fi
                    if [[ -n "$div_mismatched" ]]; then
                        status="error"
                        messages+=("repos.yaml and repos.d/${name}.yaml disagree on: ${div_mismatched} (repos.d wins for builds; align the two files)")
                        ((errors++))
                    fi
                    if [[ -n "$div_registry_only" ]]; then
                        status="error"
                        messages+=("build keys set only in repos.yaml are ignored by the build runner: ${div_registry_only} (copy them into repos.d/${name}.yaml)")
                        ((errors++))
                    fi
                fi
            fi

            # Windows targets need drive-qualified host_paths (issue #8);
            # a POSIX root fails the sync and the build-step path validator.
            local windows_path_problem
            while IFS= read -r windows_path_problem; do
                [[ -n "$windows_path_problem" ]] || continue
                status="error"
                messages+=("$windows_path_problem")
                ((errors++))
            done < <(config_windows_host_path_problems "$name" 2>/dev/null)
        fi

        local msg_str=""
        [[ ${#messages[@]} -gt 0 ]] && msg_str=$(IFS='; '; echo "${messages[*]}")

        results+=("$(jq -nc --arg repo "$name" --arg status "$status" --arg message "$msg_str" --argjson naming "$naming_info" \
            '{repo: $repo, status: $status, message: $message, naming: $naming}')")

        if ! $JSON_MODE; then
            if [[ "$status" == "ok" ]]; then
                log_ok "$name: OK"
            elif [[ "$status" == "warn" ]]; then
                log_warn "$name: $msg_str"
            else
                log_error "$name: $msg_str"
            fi
        fi

    done < <(echo "$tools_json" | jq -r 'keys[]')

    # Sweep repos.d for build configs the registry does not know about
    # (issue #13 instance 1): a fully-formed repos.d/<tool>.yaml that was
    # never adopted into repos.yaml is invisible to `dsr repos list/info`,
    # and a file named differently from its own tool_name can never be
    # loaded by the build runner. Both used to pass validate silently.
    if [[ "$naming_only" != "true" ]]; then
        local repos_d_dir="${DSR_CONFIG_DIR:-$HOME/.config/dsr}/repos.d"
        if [[ -d "$repos_d_dir" ]]; then
            local orphan_file orphan_name orphan_tool_name
            for orphan_file in "$repos_d_dir"/*.yaml; do
                [[ -f "$orphan_file" ]] || continue
                orphan_name=$(basename "$orphan_file" .yaml)
                [[ -n "$repo_filter" && "$orphan_name" != "$repo_filter" ]] && continue
                if echo "$tools_json" | jq -e --arg name "$orphan_name" 'has($name)' >/dev/null 2>&1; then
                    continue
                fi
                orphan_tool_name=$(yq -r '.tool_name // ""' "$orphan_file" 2>/dev/null)
                [[ "$orphan_tool_name" == "null" ]] && orphan_tool_name=""
                local orphan_msg="repos.d/${orphan_name}.yaml is not registered in repos.yaml — dsr repos list/info/check cannot see this tool; add it to repos.yaml"
                if [[ -n "$orphan_tool_name" && "$orphan_tool_name" != "$orphan_name" ]]; then
                    orphan_msg+="; it also declares tool_name '${orphan_tool_name}', and the build runner loads repos.d/<tool_name>.yaml by filename, so this file can never be loaded"
                fi
                results+=("$(jq -nc --arg repo "$orphan_name" --arg message "$orphan_msg" \
                    '{repo: $repo, status: "error", message: $message, naming: {}}')")
                ((errors++))
                if ! $JSON_MODE; then
                    log_error "$orphan_name: $orphan_msg"
                fi
            done
        fi
    fi

    local results_json
    results_json=$(printf '%s\n' "${results[@]}" | jq -sc '.')

    if $JSON_MODE; then
        local status="success"
        local exit_code=0
        if [[ $errors -gt 0 ]]; then
            status="error"
            exit_code=1
        elif [[ $warnings -gt 0 ]]; then
            status="partial"
        fi
        json_envelope "repos" "$status" "$exit_code" "$(jq -nc --argjson validated "$results_json" '{action: "validate", validated: $validated}')"
        return "$exit_code"
    else
        echo "" >&2
        if [[ $errors -gt 0 ]]; then
            log_error "Validation found $errors error(s), $warnings warning(s)"
            return 1
        elif [[ $warnings -gt 0 ]]; then
            log_warn "Validation found $warnings warning(s)"
        else
            log_ok "All repositories validated successfully"
        fi
    fi
}

# Validate artifact naming consistency for a tool
# Args: tool_name tool_json resolved_path
# Output: JSON with status, messages, and naming details
_validate_artifact_naming() {
    local tool="$1"
    local tool_json="$2"
    local repo_path="$3"

    local status="ok"
    local messages=()
    local sources="{}"
    local recommendations=()

    # Get config pattern
    local config_pattern
    config_pattern=$(echo "$tool_json" | jq -r '.artifact_naming // ""')

    # Get install_script_compat (explicit override)
    local install_compat
    install_compat=$(echo "$tool_json" | jq -r '.install_script_compat // ""')

    # Get install.sh pattern (if available)
    local install_pattern=""
    local install_path
    install_path=$(echo "$tool_json" | jq -r '.install_script_path // ""')
    if [[ -z "$install_path" ]]; then
        # Default locations to check
        for default_path in "install.sh" "scripts/install.sh" "install"; do
            if [[ -f "$repo_path/$default_path" ]]; then
                install_path="$default_path"
                break
            fi
        done
    fi

    if [[ -n "$install_path" && -f "$repo_path/$install_path" ]]; then
        install_pattern=$(artifact_naming_parse_install_script "$repo_path/$install_path" 2>/dev/null || echo "")
    fi

    # Get workflow pattern (if available)
    local workflow_patterns=""
    local workflow_file
    workflow_file=$(echo "$tool_json" | jq -r '.workflow // ""')
    if [[ -z "$workflow_file" ]]; then
        workflow_file=".github/workflows/release.yml"
    fi

    if [[ -f "$repo_path/$workflow_file" ]]; then
        workflow_patterns=$(artifact_naming_parse_workflow "$repo_path/$workflow_file" 2>/dev/null || echo "[]")
    fi

    # Build sources JSON
    sources=$(jq -nc \
        --arg config "$config_pattern" \
        --arg install "$install_pattern" \
        --arg install_compat "$install_compat" \
        --argjson workflow "${workflow_patterns:-[]}" \
        '{config: $config, install_script: $install, install_script_compat: $install_compat, workflow: $workflow}')

    # Validate using artifact_naming module
    if [[ -n "$config_pattern" || -n "$install_pattern" ]]; then
        local validation_result
        validation_result=$(artifact_naming_validate "$tool" "$config_pattern" "$install_pattern" "$workflow_patterns" 2>/dev/null || echo "{}")

        local val_status
        val_status=$(echo "$validation_result" | jq -r '.status // "ok"')

        if [[ "$val_status" == "warning" ]]; then
            status="warning"
            # Extract recommendations
            local recs
            recs=$(echo "$validation_result" | jq -r '.recommendations[]? // empty')
            while IFS= read -r rec; do
                [[ -n "$rec" ]] && recommendations+=("$rec")
            done <<< "$recs"

            # Check specific mismatch types
            if echo "$validation_result" | jq -e '.mismatches[]? | select(.field == "version")' &>/dev/null; then
                messages+=("Config includes version but install.sh does not expect it")
                if [[ -z "$install_compat" ]]; then
                    recommendations+=("Add install_script_compat: \"\${name}-\${os}-\${arch}\" to config")
                fi
            fi

            if echo "$validation_result" | jq -e '.mismatches[]? | select(.field == "separator")' &>/dev/null; then
                messages+=("Separator mismatch between config and install.sh")
            fi
        fi
    fi

    # Check for missing patterns
    if [[ -z "$config_pattern" && -z "$install_pattern" ]]; then
        # No patterns to validate - not an error, just skip
        :
    elif [[ -n "$config_pattern" && -n "$install_pattern" && -z "$install_compat" ]]; then
        # Both patterns exist but no explicit compat - check if they differ
        local config_has_version=false
        local install_has_version=false

        # shellcheck disable=SC2016  # Match the literal template placeholder.
        [[ "$config_pattern" == *'${version}'* || "$config_pattern" == *'-v'* ]] && config_has_version=true
        # shellcheck disable=SC2016  # Match the literal template placeholder.
        [[ "$install_pattern" == *'${version}'* || "$install_pattern" == *'-v'* ]] && install_has_version=true

        if [[ "$config_has_version" == "true" && "$install_has_version" == "false" ]]; then
            if [[ "$status" != "error" ]]; then
                status="warning"
            fi
            messages+=("Versioned config but install.sh expects unversioned")
            recommendations+=("dsr will auto-generate compat names during release")
        fi
    fi

    # Build result JSON (handle empty arrays defensively)
    local msgs_json recs_json
    if [[ ${#messages[@]} -gt 0 ]]; then
        msgs_json=$(printf '%s\n' "${messages[@]}" | jq -R . | jq -sc '.')
    else
        msgs_json="[]"
    fi
    if [[ ${#recommendations[@]} -gt 0 ]]; then
        recs_json=$(printf '%s\n' "${recommendations[@]}" | jq -R . | jq -sc '.')
    else
        recs_json="[]"
    fi

    jq -nc \
        --arg status "$status" \
        --argjson sources "$sources" \
        --argjson messages "${msgs_json:-[]}" \
        --argjson recommendations "${recs_json:-[]}" \
        '{status: $status, sources: $sources, messages: $messages, recommendations: $recommendations}'
}

# Validate a project at a specific path (not in repos registry)
# Args: path
_validate_project_at_path() {
    local project_path="$1"

    source "$SCRIPT_DIR/src/guardrails.sh"
    local resolved_path
    resolved_path=$(resolve_path "$project_path" --must-exist 2>&1) || {
        log_error "Invalid path: $project_path"
        return 4
    }

    if [[ ! -d "$resolved_path" ]]; then
        log_error "Path does not exist: $resolved_path"
        return 4
    fi

    _dsr_require artifact_naming

    # Try to detect tool name from directory or package files
    local tool_name
    tool_name=$(basename "$resolved_path")

    # Check for Cargo.toml, package.json, etc.
    if [[ -f "$resolved_path/Cargo.toml" ]]; then
        local cargo_name
        cargo_name=$(grep -m1 '^name\s*=' "$resolved_path/Cargo.toml" | sed 's/.*=\s*"\([^"]*\)".*/\1/' 2>/dev/null)
        [[ -n "$cargo_name" ]] && tool_name="$cargo_name"
    elif [[ -f "$resolved_path/package.json" ]]; then
        local pkg_name
        pkg_name=$(jq -r '.name // empty' "$resolved_path/package.json" 2>/dev/null)
        [[ -n "$pkg_name" ]] && tool_name="${pkg_name##*/}"  # Strip scope
    fi

    log_info "Validating naming consistency for: $tool_name at $resolved_path"

    # Build minimal tool_json
    local tool_json
    tool_json=$(jq -nc --arg path "$resolved_path" '{local_path: $path}')

    local result
    result=$(_validate_artifact_naming "$tool_name" "$tool_json" "$resolved_path")

    local status
    status=$(echo "$result" | jq -r '.status')

    if $JSON_MODE; then
        json_envelope "repos" "success" 0 "$(jq -nc --arg tool "$tool_name" --argjson result "$result" '{action: "validate", tool: $tool, naming: $result}')"
    else
        local sources
        sources=$(echo "$result" | jq -r '.sources')

        echo ""
        log_info "Sources detected:"
        local config_pattern install_pattern
        config_pattern=$(echo "$sources" | jq -r '.config // ""')
        install_pattern=$(echo "$sources" | jq -r '.install_script // ""')

        if [[ -n "$config_pattern" ]]; then
            echo "  Config:     $config_pattern"
        else
            echo "  Config:     (none)"
        fi

        if [[ -n "$install_pattern" ]]; then
            echo "  Install.sh: $install_pattern"
        else
            echo "  Install.sh: (not found or no pattern detected)"
        fi

        echo ""

        if [[ "$status" == "ok" ]]; then
            log_ok "Naming consistency: OK"
        elif [[ "$status" == "warning" ]]; then
            log_warn "Naming consistency: warnings detected"
            echo ""
            echo "Messages:"
            echo "$result" | jq -r '.messages[]?' | while IFS= read -r msg; do
                echo "  - $msg"
            done
            echo ""
            echo "Recommendations:"
            echo "$result" | jq -r '.recommendations[]?' | while IFS= read -r rec; do
                echo "  - $rec"
            done
        else
            log_error "Naming consistency: errors detected"
            echo "$result" | jq -r '.messages[]?' | while IFS= read -r msg; do
                echo "  - $msg"
            done
        fi
    fi

    [[ "$status" == "ok" ]] && return 0
    [[ "$status" == "warning" ]] && return 0  # Warnings are not failures
    return 1
}

# Discover repositories that could benefit from dsr
cmd_repos_discover() {
    local search_path="/data/projects"
    local apply=false org_filter="" language_filter=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --path|-p)
                [[ $# -ge 2 && -n "$2" ]] || { log_error "$1 requires a directory"; return 4; }
                search_path="$2"
                shift 2
                ;;
            --org)
                # Only checkouts whose GitHub remote belongs to this owner.
                [[ $# -ge 2 && "$2" =~ ^[A-Za-z0-9_.-]+$ ]] || { log_error "--org requires an owner name"; return 4; }
                org_filter="$2"
                shift 2
                ;;
            --language|-l)
                [[ $# -ge 2 && "$2" =~ ^(rust|go|node)$ ]] || {
                    log_error "--language requires rust, go or node"; return 4; }
                language_filter="$2"
                shift 2
                ;;
            --apply)
                apply=true
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                return 4
                ;;
        esac
    done

    # Validate search path
    source "$SCRIPT_DIR/src/guardrails.sh"
    # shellcheck disable=SC2034 # Used by guardrails is_non_interactive
    [[ "$NON_INTERACTIVE" == "true" ]] && DSR_NON_INTERACTIVE=true
    search_path=$(resolve_path "$search_path" --must-exist 2>&1) || {
        log_error "Invalid search path: $search_path"
        return 4
    }

    log_info "Scanning $search_path for buildable projects..."

    local discovered=()

    # Find directories with build files
    while IFS= read -r dir; do
        local name
        name=$(basename "$dir")
        local language=""
        local repo=""

        # Detect language
        if [[ -f "$dir/Cargo.toml" ]]; then
            language="rust"
        elif [[ -f "$dir/go.mod" ]]; then
            language="go"
        elif [[ -f "$dir/package.json" ]]; then
            language="node"
        else
            continue
        fi

        [[ -z "$language_filter" || "$language" == "$language_filter" ]] || continue

        # Get repo from git remote
        if [[ -d "$dir/.git" ]]; then
            local remote_url
            remote_url=$(git -C "$dir" remote get-url origin 2>/dev/null || true)
            if [[ "$remote_url" =~ github\.com[:/]([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)$ ]]; then
                repo="${BASH_REMATCH[1]%.git}"
            fi
        fi
        local owner="${repo%%/*}"
        [[ -z "$org_filter" || ( -n "$repo" && "${owner,,}" == "${org_filter,,}" ) ]] || continue

        # Check if has release workflow
        local has_workflow=false
        if [[ -d "$dir/.github/workflows" ]]; then
            # grep -q decides by itself; `grep -l | head -1` could SIGPIPE
            # grep when several workflows match and pipefail hid the result.
            if grep -qE 'release|build' "$dir/.github/workflows/"*.yml "$dir/.github/workflows/"*.yaml 2>/dev/null; then
                has_workflow=true
            fi
        fi

        local entry
        entry=$(jq -nc \
            --arg name "$name" \
            --arg repo "${repo:-}" \
            --arg local_path "$dir" \
            --arg language "$language" \
            --argjson has_workflow "$has_workflow" \
            '{name: $name, repo: $repo, local_path: $local_path, language: $language, has_workflow: $has_workflow}')

        discovered+=("$entry")

        if ! $JSON_MODE; then
            local workflow_indicator="  "
            $has_workflow && workflow_indicator="✓ "
            log_info "$workflow_indicator$name ($language) - $dir"
        fi

    done < <(find "$search_path" -maxdepth 2 -type f \( -name "Cargo.toml" -o -name "go.mod" -o -name "package.json" \) -print0 2>/dev/null | xargs -0 -I{} dirname {} | sort -u)

    local discovered_json
    discovered_json=$(printf '%s\n' "${discovered[@]}" | jq -sc '.')

    if $JSON_MODE; then
        json_envelope "repos" "success" 0 "$(jq -nc --argjson discovered "$discovered_json" '{action: "discover", discovered: $discovered}')"
    else
        echo ""
        local count
        count=$(echo "$discovered_json" | jq 'length')
        log_info "Discovered $count potential repositories"
        if [[ $count -gt 0 ]] && ! $apply; then
            log_info "Run with --apply to add them to the registry"
        fi
    fi

    # Apply if requested
    if $apply && [[ ${#discovered[@]} -gt 0 ]]; then
        log_info "Adding discovered repositories..."
        for entry in "${discovered[@]}"; do
            local name repo local_path language
            name=$(echo "$entry" | jq -r '.name')
            repo=$(echo "$entry" | jq -r '.repo // ""')
            local_path=$(echo "$entry" | jq -r '.local_path')
            language=$(echo "$entry" | jq -r '.language')

            # Register the GitHub repository when the checkout names one;
            # check and fallback need it.
            if [[ -n "$repo" ]]; then
                cmd_repos_add "$repo" --name "$name" --local-path "$local_path" --language "$language" 2>/dev/null || true
            else
                cmd_repos_add "$name" --local-path "$local_path" --language "$language" 2>/dev/null || true
            fi
        done
    fi
}

# Sync repository metadata from GitHub
cmd_repos_sync() {
    local dry_run="${DRY_RUN:-false}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                dry_run=true
                shift
                ;;
            --help|-h)
                cat << 'EOF'
dsr repos sync - Record each repository's default branch from GitHub

USAGE:
    dsr repos sync [--dry-run]

OPTIONS:
    --dry-run   Fetch and show the values; do not write repos.yaml

EXIT CODES:
    0  All repositories synced
    1  Some repositories could not be synced
    3  yq or GitHub authentication unavailable
    4  No repos file
EOF
                return 0
                ;;
            *)
                log_error "Unknown option: $1"
                return 4
                ;;
        esac
    done

    log_info "Syncing repository metadata from GitHub..."

    if [[ ! -f "$DSR_REPOS_FILE" ]]; then
        log_error "Repos file not found"
        $JSON_MODE && json_envelope "repos" "error" 4 '{"action": "sync", "errors": [{"code": "E052", "message": "repos file not found"}]}'
        return 4
    fi

    if ! command -v yq &>/dev/null; then
        log_error "yq required for sync"
        $JSON_MODE && json_envelope "repos" "error" 3 '{"action": "sync", "errors": [{"code": "E041", "message": "yq required"}]}'
        return 3
    fi

    # Without GitHub access nothing can be synced; that is a dependency
    # error, not one failure per repository.
    if ! gh_check 2>/dev/null && ! gh_check_token 2>/dev/null; then
        log_error "GitHub authentication required (gh auth login or GITHUB_TOKEN)"
        $JSON_MODE && json_envelope "repos" "error" 3 '{"action": "sync", "errors": [{"code": "E001", "message": "GitHub authentication required"}]}'
        return 3
    fi

    local tools_json
    tools_json=$(yq -o=json '.tools // {}' "$DSR_REPOS_FILE" 2>/dev/null)

    local synced=0
    local failed=0
    local -a errors=()

    while IFS= read -r name; do
        [[ -z "$name" ]] && continue

        local repo
        repo=$(echo "$tools_json" | jq -r --arg name "$name" '.[$name].repo // ""')

        if [[ -z "$repo" ]]; then
            log_warn "$name: no repo configured, skipping"
            continue
        fi

        log_info "Syncing $name ($repo)..."

        local repo_info default_branch
        if ! repo_info=$(gh_repo "$repo" 2>/dev/null) ||
           ! default_branch=$(jq -er '.default_branch | select(type == "string" and length > 0)' <<< "$repo_info" 2>/dev/null); then
            log_warn "$name: failed to fetch repo info"
            errors+=("$(jq -nc --arg repo "$name" '{code: "E003", message: "failed to fetch repository metadata", repo: $repo}')")
            ((failed++))
            continue
        fi

        if $dry_run; then
            log_info "[dry-run] $name: would set default_branch: $default_branch"
        elif ! DSR_SYNC_NAME="$name" DSR_SYNC_BRANCH="$default_branch" \
                yq -i '.tools[strenv(DSR_SYNC_NAME)].default_branch = strenv(DSR_SYNC_BRANCH)' "$DSR_REPOS_FILE"; then
            log_warn "$name: could not write $DSR_REPOS_FILE"
            errors+=("$(jq -nc --arg repo "$name" '{code: "E052", message: "registry write failed", repo: $repo}')")
            ((failed++))
            continue
        else
            log_ok "$name: synced (default_branch: $default_branch)"
        fi
        ((synced++))

    done < <(echo "$tools_json" | jq -r 'keys[]')

    local status="success" exit_code=0
    if [[ $failed -gt 0 ]]; then
        exit_code=1
        status="partial"
        [[ $synced -eq 0 ]] && status="error"
    fi

    if $JSON_MODE; then
        local errors_json='[]'
        [[ ${#errors[@]} -gt 0 ]] && errors_json=$(printf '%s\n' "${errors[@]}" | jq -sc '.')
        json_envelope "repos" "$status" "$exit_code" "$(jq -nc --argjson synced "$synced" --argjson failed "$failed" \
            --argjson dry_run "$dry_run" --argjson errors "$errors_json" \
            '{action: "sync", synced: $synced, failed: $failed, dry_run: $dry_run, errors: $errors}')"
    else
        log_info "Sync complete: $synced synced, $failed failed"
    fi
    return "$exit_code"
}

# ============================================================================
# HEALTH SUBCOMMAND
# ============================================================================

cmd_health() {
    local subcmd="${1:-check}"
    shift 2>/dev/null || true

    case "$subcmd" in
        check)
            cmd_health_check "$@"
            ;;
        all)
            cmd_health_all "$@"
            ;;
        clear-cache)
            cmd_health_clear_cache "$@"
            ;;
        --help|-h|help)
            cat << 'EOF'
dsr health - Check health of build hosts

USAGE:
    dsr health <subcommand> [options]

SUBCOMMANDS:
    check <host>    Check specific host health
    all             Check all configured hosts
    clear-cache     Clear health check cache

OPTIONS:
    --no-cache      Skip cache and perform fresh checks
    --json          Output in JSON format (global)

CHECKS PERFORMED:
    - SSH connectivity (short timeout + BatchMode)
    - Disk space threshold (warn >90%, error >95%)
    - Toolchain availability (rust/go/bun per host)
    - Docker/Colima for act runners
    - Clock drift detection

EXAMPLES:
    dsr health check trj            Check local Threadripper
    dsr health check mmini          Check Mac Mini via SSH
    dsr health all                  Check all build hosts
    dsr health all --no-cache       Force fresh checks
    dsr health clear-cache          Clear cached results

For more information, see docs/CLI_CONTRACT.md
EOF
            ;;
        *)
            # Treat as hostname if not a subcommand
            cmd_health_check "$subcmd" "$@"
            ;;
    esac
}

cmd_health_check() {
    local hostname="${1:-}"
    shift 2>/dev/null || true
    local no_cache=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-cache) no_cache=true; shift ;;
            *) shift ;;
        esac
    done

    if [[ -z "$hostname" ]]; then
        log_error "Usage: dsr health check <hostname>"
        return 4
    fi

    local -a flags=()
    $no_cache && flags+=("--no-cache")
    $JSON_MODE && flags+=("--json")

    host_health_check "$hostname" "${flags[@]}"
}

cmd_health_all() {
    local no_cache=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-cache) no_cache=true; shift ;;
            *)
                log_error "Unknown option: $1"
                log_info "Usage: dsr health all [--no-cache]"
                return 4
                ;;
        esac
    done

    # Exit 1 when any enabled host is unhealthy, so `dsr health all && dsr
    # build` stops at a dead host. Disabled hosts are not failures.
    local -a flags=(--fail-unhealthy)
    $no_cache && flags+=("--no-cache")
    $JSON_MODE && flags+=("--json")

    host_health_check_all "${flags[@]}"
}

cmd_health_clear_cache() {
    local hostname="${1:-}"
    host_health_clear_cache "$hostname"

    if $JSON_MODE; then
        if [[ -n "$hostname" ]]; then
            json_envelope "health" "success" 0 "{\"action\": \"clear-cache\", \"host\": \"$hostname\"}"
        else
            json_envelope "health" "success" 0 '{"action": "clear-cache", "all": true}'
        fi
    else
        if [[ -n "$hostname" ]]; then
            log_ok "Cleared health cache for: $hostname"
        else
            log_ok "Cleared all health cache"
        fi
    fi
}

# ============================================================================
# PRUNE SUBCOMMAND
# ============================================================================

_prune_size_bytes() {
    local path="$1"
    if [[ -f "$path" ]]; then
        stat -c%s "$path" 2>/dev/null || stat -f%z "$path" 2>/dev/null || echo 0
        return 0
    fi
    if [[ -d "$path" ]]; then
        local kb
        kb=$(du -sk "$path" 2>/dev/null | awk '{print $1}' || echo 0)
        echo $((kb * 1024))
        return 0
    fi
    echo 0
}

_prune_mtime_epoch() {
    local path="$1"
    stat -c%Y "$path" 2>/dev/null || stat -f%m "$path" 2>/dev/null || echo 0
}

_prune_epoch_to_iso() {
    local epoch="$1"
    if date -u -d "@$epoch" +"%Y-%m-%dT%H:%M:%SZ" >/dev/null 2>&1; then
        date -u -d "@$epoch" +"%Y-%m-%dT%H:%M:%SZ"
        return 0
    fi
    date -u -r "$epoch" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo ""
}

_prune_log_file() {
    local msg="$1"
    local path="$2"
    local size_bytes="$3"
    local log_file="${LOG_FILE:-}"

    [[ -z "$log_file" ]] && return 0

    local ts escaped_msg escaped_path
    ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    escaped_msg=$(_json_escape "$msg")
    escaped_path=$(_json_escape "$path")

    cat >> "$log_file" << EOF
{"ts":"$ts","run_id":"$DSR_RUN_ID","level":"info","cmd":"prune","msg":"$escaped_msg","event":"prune","path":"$escaped_path","size_bytes":$size_bytes}
EOF
}

cmd_prune() {
    # The global --dry-run (dsr -n prune) must never delete either.
    local dry_run="${DRY_RUN:-false}"
    local max_age_days=30
    local keep_last=5
    local keep_releases=true
    local force=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run|-n)
                dry_run=true
                shift
                ;;
            --keep-releases|--keep-releases=true)
                keep_releases=true
                shift
                ;;
            --no-keep-releases|--keep-releases=false)
                keep_releases=false
                shift
                ;;
            --max-age|--cutoff-days)
                max_age_days="${2:-}"
                shift 2
                ;;
            --keep-last)
                keep_last="${2:-}"
                shift 2
                ;;
            --force|--yes|-y)
                force=true
                shift
                ;;
            --help|-h)
                cat << 'EOF'
dsr prune - Clean up old artifacts, logs, and cache

USAGE:
    dsr prune [options]

OPTIONS:
    -n, --dry-run       Show what would be removed without deleting
        --max-age DAYS  Remove items older than DAYS (default: 30)
        --keep-last N   Always keep the N most recent artifact sets per tool
                        and build runs per tool/version (default: 5)
        --keep-releases Never remove artifacts of a release dsr published (default)
        --no-keep-releases
                        Also remove old artifacts of published releases
        --force         Skip confirmation prompt

A build run that `latest` points to is always kept (it is what resume uses).

EXAMPLES:
    dsr prune --dry-run
    dsr prune --max-age 14 --keep-last 3
EOF
                return 0
                ;;
            *)
                log_error "Unknown option: $1"
                log_info "Run 'dsr prune --help' for usage"
                return 4
                ;;
        esac
    done

    if [[ -z "$max_age_days" || ! "$max_age_days" =~ ^[0-9]+$ ]]; then
        log_error "Invalid --max-age: $max_age_days"
        return 4
    fi
    if [[ -z "$keep_last" || ! "$keep_last" =~ ^[0-9]+$ ]]; then
        log_error "Invalid --keep-last: $keep_last"
        return 4
    fi

    source "$SCRIPT_DIR/src/guardrails.sh"

    local state_dir cache_dir
    state_dir=$(resolve_path "$DSR_STATE_DIR" 2>/dev/null || echo "$DSR_STATE_DIR")
    cache_dir=$(resolve_path "$DSR_CACHE_DIR" 2>/dev/null || echo "$DSR_CACHE_DIR")

    if [[ ! -d "$state_dir" ]]; then
        log_error "State directory not found: $state_dir"
        if $JSON_MODE; then
            json_envelope "prune" "error" 4 "{\"state_dir\": \"$state_dir\", \"dry_run\": $dry_run, \"pruned_count\": 0, \"bytes_freed\": 0}"
        fi
        return 4
    fi

    if [[ ! -d "$cache_dir" ]]; then
        if ! $JSON_MODE; then
            log_warn "Cache directory not found: $cache_dir (skipping cache cleanup)"
        fi
    fi

    if ! $dry_run && ! $force; then
        if ! confirm "Prune old artifacts and cache in $state_dir and $cache_dir?" "n"; then
            if $JSON_MODE; then
                json_envelope "prune" "error" 5 "{\"state_dir\": \"$state_dir\", \"dry_run\": $dry_run, \"pruned_count\": 0, \"bytes_freed\": 0}"
            fi
            return 5
        fi
    fi

    local now_epoch cutoff_epoch
    now_epoch=$(date +%s)
    cutoff_epoch=$((now_epoch - max_age_days * 86400))

    local pruned_count=0
    local bytes_freed=0
    local pruned_items=()
    local errors=()

    _prune_record() {
        local path="$1"
        local size_bytes="$2"
        local mtime_iso="$3"
        pruned_items+=("{\"path\":\"$(_json_escape "$path")\",\"size_bytes\":$size_bytes,\"mtime\":\"$mtime_iso\"}")
        pruned_count=$((pruned_count + 1))
        bytes_freed=$((bytes_freed + size_bytes))
        if ! $JSON_MODE; then
            echo "$path"
        fi
    }

    _prune_error() {
        local code="$1"
        local message="$2"
        local path="$3"
        errors+=("{\"code\":\"$code\",\"message\":\"$(_json_escape "$message")\",\"path\":\"$(_json_escape "$path")\"}")
        if ! $JSON_MODE; then
            log_warn "$message: $path"
        fi
    }

    _prune_consider() {
        local path="$1"
        [[ -z "$path" ]] && return 0

        local size_bytes mtime_epoch mtime_iso
        size_bytes=$(_prune_size_bytes "$path")
        mtime_epoch=$(_prune_mtime_epoch "$path")
        mtime_iso=$(_prune_epoch_to_iso "$mtime_epoch")

        if $dry_run; then
            _prune_record "$path" "$size_bytes" "$mtime_iso"
            return 0
        fi

        if safe_rm "$path" --force; then
            _prune_record "$path" "$size_bytes" "$mtime_iso"
            _prune_log_file "Pruned path" "$path" "$size_bytes"
            if ! $JSON_MODE; then
                log_info "Pruned: $path"
            fi
            return 0
        fi

        _prune_error "E051" "Failed to delete" "$path"
        return 1
    }

    if ! $JSON_MODE; then
        $dry_run && log_info "Dry run: scanning for items older than $max_age_days days..."
        $dry_run || log_info "Pruning items older than $max_age_days days..."
    fi

    # Prune old logs
    if [[ -d "$state_dir/logs" ]]; then
        while IFS= read -r path; do
            _prune_consider "$path"
        done < <(find "$state_dir/logs" -mindepth 1 -maxdepth 1 -type d -mtime +"$max_age_days" 2>/dev/null)

        while IFS= read -r path; do
            _prune_consider "$path"
        done < <(find "$state_dir/logs" -type f -mtime +"$max_age_days" 2>/dev/null)
    fi

    # Prune old manifests
    if [[ -d "$state_dir/manifests" ]]; then
        while IFS= read -r path; do
            _prune_consider "$path"
        done < <(find "$state_dir/manifests" -type f -mtime +"$max_age_days" 2>/dev/null)
    fi

    # Prune old artifact sets: $state_dir/artifacts/<tool>-<tag>/ and its
    # <tool>-<tag>-manifest.json. The keep_last newest sets of each tool stay,
    # and so (with --keep-releases) does every set whose release dsr
    # published, recorded as releases/<tool>-<tag>-upload.json.
    local kept_for_releases=0
    if [[ -d "$state_dir/artifacts" ]]; then
        local entry set_name set_tool set_manifest set_mtime
        local -A set_seen=() set_group=() set_time=()
        while IFS= read -r -d '' entry; do
            set_name="${entry##*/}"
            [[ -f "$entry" && "$set_name" == *-manifest.json ]] && set_name="${set_name%-manifest.json}"
            [[ -d "$entry" || -f "$entry" ]] || continue
            [[ -z "${set_seen[$set_name]:-}" ]] || continue
            set_seen["$set_name"]=1
            set_tool=""
            for set_manifest in "$state_dir/artifacts/$set_name-manifest.json" \
                "$state_dir/artifacts/$set_name"/*-manifest.json; do
                [[ -f "$set_manifest" && ! -L "$set_manifest" ]] || continue
                set_tool=$(jq -r '.tool // empty | strings' "$set_manifest" 2>/dev/null) && [[ -n "$set_tool" ]] && break
            done
            if [[ -z "$set_tool" && "$set_name" =~ ^(.+)-v?[0-9]+\.[0-9]+ ]]; then
                set_tool="${BASH_REMATCH[1]}"
            fi
            set_group["$set_name"]="${set_tool:-$set_name}"
            if [[ -e "$state_dir/artifacts/$set_name" ]]; then
                set_mtime=$(_prune_mtime_epoch "$state_dir/artifacts/$set_name")
            else
                set_mtime=$(_prune_mtime_epoch "$state_dir/artifacts/$set_name-manifest.json")
            fi
            set_time["$set_name"]="$set_mtime"
        done < <(find "$state_dir/artifacts" -mindepth 1 -maxdepth 1 \( -type d -o -type f \) -print0 2>/dev/null)

        local -A group_kept=()
        local group
        while IFS=' ' read -r set_mtime set_name; do
            [[ -n "$set_name" ]] || continue
            group="${set_group[$set_name]}"
            group_kept["$group"]=$(( ${group_kept[$group]:-0} + 1 ))
            [[ ${group_kept[$group]} -le $keep_last ]] && continue
            [[ "$set_mtime" -le "$cutoff_epoch" ]] || continue
            if $keep_releases && [[ -e "$state_dir/releases/$set_name-upload.json" ]]; then
                kept_for_releases=$((kept_for_releases + 1))
                continue
            fi
            [[ -d "$state_dir/artifacts/$set_name" && ! -L "$state_dir/artifacts/$set_name" ]] &&
                _prune_consider "$state_dir/artifacts/$set_name"
            [[ -f "$state_dir/artifacts/$set_name-manifest.json" ]] &&
                _prune_consider "$state_dir/artifacts/$set_name-manifest.json"
        done < <(for set_name in "${!set_time[@]}"; do
                     printf '%s %s\n' "${set_time[$set_name]}" "$set_name"
                 done | sort -rn)
    fi

    # Prune old build runs beyond keep_last: every run directory, whatever
    # its ID scheme, except the one `latest` points to.
    if [[ -d "$state_dir/builds" ]]; then
        local tool_dir version_dir latest_run
        for tool_dir in "$state_dir/builds"/*; do
            [[ -d "$tool_dir" && ! -L "$tool_dir" ]] || continue
            for version_dir in "$tool_dir"/*; do
                [[ -d "$version_dir" && ! -L "$version_dir" ]] || continue
                latest_run=""
                [[ -L "$version_dir/latest" ]] && latest_run=$(readlink "$version_dir/latest" 2>/dev/null)

                local run_dirs=()
                while IFS= read -r line; do
                    run_dirs+=("$line")
                done < <(
                    find "$version_dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null | while read -r dir; do
                        local mtime
                        mtime=$(_prune_mtime_epoch "$dir")
                        echo "$mtime $dir"
                    done | sort -rn | cut -d' ' -f2-
                )

                local idx=0
                for run_dir in ${run_dirs[@]+"${run_dirs[@]}"}; do
                    [[ "${run_dir##*/}" == "$latest_run" ]] && continue
                    idx=$((idx + 1))
                    if [[ $idx -le $keep_last ]]; then
                        continue
                    fi
                    local run_mtime
                    run_mtime=$(_prune_mtime_epoch "$run_dir")
                    if [[ "$run_mtime" -le "$cutoff_epoch" ]]; then
                        _prune_consider "$run_dir"
                    fi
                done
            done
        done
    fi

    # Prune cache entries
    if [[ -d "$cache_dir" ]]; then
        while IFS= read -r path; do
            _prune_consider "$path"
        done < <(find "$cache_dir" -mindepth 1 -maxdepth 1 -mtime +"$max_age_days" 2>/dev/null)
    fi

    local pruned_json errors_json details_json
    pruned_json=$(printf '%s\n' "${pruned_items[@]}" | jq -sc '.' 2>/dev/null || echo "[]")
    errors_json=$(printf '%s\n' "${errors[@]}" | jq -sc '.' 2>/dev/null || echo "[]")

    local status="success"
    local exit_code=0
    if [[ "${#errors[@]}" -gt 0 ]]; then
        status="partial"
        exit_code=1
    fi

    if $JSON_MODE; then
        details_json=$(jq -nc \
            --arg state_dir "$state_dir" \
            --argjson dry_run "$dry_run" \
            --argjson cutoff_days "$max_age_days" \
            --argjson keep_last "$keep_last" \
            --argjson keep_releases "$keep_releases" \
            --argjson kept_for_releases "$kept_for_releases" \
            --argjson pruned_count "$pruned_count" \
            --argjson bytes_freed "$bytes_freed" \
            --argjson pruned_paths "$pruned_json" \
            --argjson errors "$errors_json" \
            '{state_dir: $state_dir, dry_run: $dry_run, cutoff_days: $cutoff_days, keep_last: $keep_last,
              keep_releases: $keep_releases, kept_for_releases: $kept_for_releases,
              pruned_count: $pruned_count, bytes_freed: $bytes_freed, pruned_paths: $pruned_paths, errors: $errors}')
        json_envelope "prune" "$status" "$exit_code" "$details_json"
    else
        if $dry_run; then
            log_info "Dry run complete: $pruned_count item(s) would be removed, ${bytes_freed} bytes freed"
        else
            log_info "Prune complete: $pruned_count item(s) removed, ${bytes_freed} bytes freed"
        fi
    fi

    return $exit_code
}

# ============================================================================
# STATUS SUBCOMMAND
# ============================================================================

# Sessions recorded in run logs read from stdin (oldest first), as a JSON
# array of {run_id, command, tool, started_at, finished_at, exit_code}. A
# finish closes the open session of the same run and command, so concurrent
# dsr processes sharing one log (a watcher and the fallbacks it starts) pair
# correctly; the first tool a session logs is its tool.
_dsr_log_sessions() {
    jq -Rnc '
        reduce (inputs | fromjson? | select(type == "object" and (.run_id | type) == "string")) as $e
            ({sessions: [], open: {}};
             ($e.run_id + "\u0000" + ($e.cmd // "")) as $key |
             if $e.msg == "Session started" then
                 .open[$key] = (.sessions | length) |
                 .sessions += [{run_id: $e.run_id, command: ($e.cmd // ""), tool: $e.tool,
                                started_at: $e.ts, finished_at: null, exit_code: null}]
             elif .open[$key] == null then .
             elif $e.msg == "Session finished" then
                 .sessions[.open[$key]] += {finished_at: $e.ts, exit_code: $e.exit_code} |
                 del(.open[$key])
             elif $e.tool != null and .sessions[.open[$key]].tool == null then
                 .sessions[.open[$key]].tool = $e.tool
             else . end) | .sessions'
}

# Print the logs (rotated .gz included) of the dated log directories on or
# after <YYYY-MM-DD>, oldest first.
_dsr_cat_run_logs_since() {
    local log_dir="$1" first_day="$2" day_dir file
    for day_dir in "$log_dir"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]; do
        [[ -d "$day_dir" && ! -L "$day_dir" && ! "${day_dir##*/}" < "$first_day" ]] || continue
        for file in "$day_dir"/run.log.gz "$day_dir"/run.log; do
            [[ -f "$file" && ! -L "$file" ]] || continue
            if [[ "$file" == *.gz ]]; then
                gzip -dc -- "$file" 2>/dev/null || true
            else
                cat -- "$file"
            fi
        done
    done
}

# Recent activity from the run logs (docs/CLI_CONTRACT.md `dsr report`).
cmd_report() {
    local since="24h" limit=20 repo_filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --since)
                [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]{0,5}[smhd]$ ]] || {
                    log_error "--since requires a duration such as 30m, 24h or 7d"; return 4; }
                since="$2"; shift 2 ;;
            --limit)
                [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]{0,3}$ ]] || {
                    log_error "--limit requires a positive number"; return 4; }
                limit="$2"; shift 2 ;;
            --repo)
                [[ $# -ge 2 && -n "$2" ]] || { log_error "--repo requires a tool name"; return 4; }
                repo_filter="$2"; shift 2 ;;
            --help|-h)
                cat << 'EOF'
dsr report - Recent runs, failures and throttling

USAGE:
    dsr report [--since <duration>] [--limit <n>] [--repo <tool>]

OPTIONS:
    --since <d>    Lookback window: 30m, 24h, 7d (default: 24h)
    --limit <n>    Most recent runs to list (default: 20)
    --repo <tool>  Only runs for this tool
    --json         JSON output (global flag)

Reads the run logs every dsr command writes (status, help, version and
report themselves are not listed) and the last `dsr check` result.

EXIT CODES:
    0  - Report generated
    3  - No run logs to report on
    4  - Invalid arguments
EOF
                return 0 ;;
            *)
                log_error "Unknown option: $1"
                log_info "Run 'dsr report --help' for usage"
                return 4 ;;
        esac
    done

    local unit_seconds
    case "${since: -1}" in
        s) unit_seconds=1 ;; m) unit_seconds=60 ;; h) unit_seconds=3600 ;; d) unit_seconds=86400 ;;
    esac
    local now window_start first_day generated_at
    now=$(date +%s)
    window_start=$(( now - ${since%?} * unit_seconds ))
    (( window_start > now - 86400 )) && first_day=$(( now - 86400 )) || first_day=$window_start
    # Directory dates are local; read one more day than the window needs.
    first_day=$(date -d "@$(( first_day - 86400 ))" +%Y-%m-%d 2>/dev/null ||
        date -r "$(( first_day - 86400 ))" +%Y-%m-%d)
    generated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    local state_dir="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}"
    local log_dir="$state_dir/logs"
    if [[ ! -d "$log_dir" ]]; then
        log_error "No run logs at $log_dir"
        $JSON_MODE && json_envelope "report" "error" 3 "$(jq -nc --arg g "$generated_at" '
            {generated_at: $g, summary: {runs_last_24h: 0, failures_last_24h: 0, throttled_repos: 0},
             alerts: [{code: "E060", message: "report data unavailable: no run logs", severity: "error"}]}')"
        return 3
    fi

    local sessions check_snapshot="null"
    sessions=$(_dsr_cat_run_logs_since "$log_dir" "$first_day" | _dsr_log_sessions) || sessions='[]'
    if [[ -f "$state_dir/check/last.json" && ! -L "$state_dir/check/last.json" ]]; then
        check_snapshot=$(jq -c 'select(type == "object")' "$state_dir/check/last.json" 2>/dev/null) || check_snapshot="null"
        [[ -n "$check_snapshot" ]] || check_snapshot="null"
    fi

    local details
    details=$(jq -nc --argjson sessions "$sessions" --argjson check "$check_snapshot" \
        --argjson now "$now" --argjson window_start "$window_start" --argjson limit "$limit" \
        --arg since "$since" --arg repo "$repo_filter" --arg generated_at "$generated_at" '
        def epoch: (try fromdateiso8601 catch null);
        # Usage errors (4) and interrupts (5, 130) are not failures.
        def failed: .exit_code != 0 and (.exit_code | IN(4, 5, 130) | not);
        def alert_code: {"3": "E041", "6": "E010", "7": "E020", "8": "E003"}[.exit_code | tostring]
            // (if .command == "release" then "E020"
                elif (.command | IN("build", "fallback", "quality")) then "E010"
                elif (.command | IN("check", "watch")) then "E003" else "E030" end);
        [$sessions[] | select((.command | IN("", "status", "help", "version", "report")) | not)
            | select($repo == "" or .tool == $repo)
            | . + {start: (.started_at | epoch)} | select(.start != null)] as $runs |
        [$runs[] | select(.exit_code | type == "number")] as $finished |
        [$finished[] | select(.start >= $now - 86400)] as $day |
        [$finished[] | select(.start >= $window_start)] as $window |
        ($check != null and (($check.checked_at // "") | epoch // 0) >= $now - 86400) as $fresh_check |
        {
            generated_at: $generated_at,
            summary: {
                runs_last_24h: ($day | length),
                failures_last_24h: ([$day[] | select(failed)] | length),
                throttled_repos: (if $fresh_check then ($check.throttled // [] | length) else 0 end),
                in_progress: ([$runs[] | select(.exit_code == null and .start >= $window_start)] | length)
            },
            window: {since: $since, from: ($window_start | todate), runs: ($window | length),
                     failures: ([$window[] | select(failed)] | length)},
            recent_runs: [$window | reverse | .[:$limit][] | {
                repo: (.tool // ""), command, exit_code,
                status: (if .exit_code == 0 then "success" elif .exit_code == 1 then "partial" else "error" end),
                run_id, started_at,
                duration_ms: (((.finished_at | epoch) // .start) - .start | if . < 0 then 0 else . * 1000 end)
            }],
            alerts: ([$window | reverse | .[] | select(failed) | {
                code: alert_code, severity: "error",
                message: "\(.command)\(if .tool then " " + .tool else "" end) exited \(.exit_code) at \(.started_at)"
            }] | .[:10])
        } + (if $repo == "" then {} else {repo: $repo} end)') || {
        log_error "Could not build the report"
        $JSON_MODE && json_envelope "report" "error" 3 "$(jq -nc --arg g "$generated_at" '
            {generated_at: $g, summary: {runs_last_24h: 0, failures_last_24h: 0, throttled_repos: 0},
             alerts: [{code: "E060", message: "report generation failed", severity: "error"}]}')"
        return 3
    }

    if $JSON_MODE; then
        json_envelope "report" "success" 0 "$details"
        return 0
    fi
    jq -r '
        "Report (last \(.window.since)): \(.window.runs) run(s), \(.window.failures) failure(s)",
        "Last 24h: \(.summary.runs_last_24h) run(s), \(.summary.failures_last_24h) failure(s), \(.summary.throttled_repos) throttled repo(s)",
        (if .summary.in_progress > 0 then "In progress: \(.summary.in_progress)" else empty end),
        "",
        (if (.recent_runs | length) == 0 then "No runs in this window."
         else (.recent_runs[] |
             "  \(.started_at)  \(.command | . + (" " * (9 - length)))  \(if .repo == "" then "-" else .repo end)  \(.status) (exit \(.exit_code), \((.duration_ms / 1000) | floor)s)")
         end),
        (if (.alerts | length) > 0 then "", "Alerts:", (.alerts[] | "  [\(.code)] \(.message)") else empty end)
    ' <<< "$details" >&2
    return 0
}

# Get last run info from log directory
_status_get_last_run() {
    local state_dir="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}"
    local log_dir="$state_dir/logs"
    local latest_link="$log_dir/latest"

    if [[ ! -L "$latest_link" ]]; then
        echo '{"run_id": null, "timestamp": null, "log_file": null}'
        return
    fi

    local latest_date
    latest_date=$(readlink "$latest_link" 2>/dev/null)
    local run_log="$log_dir/$latest_date/run.log"

    if [[ ! -f "$run_log" ]]; then
        echo '{"run_id": null, "timestamp": null, "log_file": null}'
        return
    fi

    # The last real command (not status/help/version) and, once it finished,
    # its exit code, searching back through the week's daily logs; else the
    # last session of any kind.
    local day_log summary=""
    while IFS= read -r day_log; do
        summary=$(_dsr_log_sessions < "$day_log" 2>/dev/null | jq -c --arg log "$day_log" '
            ([.[] | select(.command | IN("", "status", "help", "version", "report") | not)] | last) as $s |
            if $s == null then empty else
                {run_id: $s.run_id, timestamp: $s.started_at, started_at: $s.started_at,
                 log_file: $log, command: $s.command}
                + (if ($s.exit_code | type) != "number" then {} else
                    {completed_at: $s.finished_at, exit_code: $s.exit_code,
                     status: (if $s.exit_code == 0 then "success"
                              elif $s.exit_code == 1 then "partial" else "error" end)} end)
            end' 2>/dev/null) || summary=""
        [[ -n "$summary" ]] && break
    done < <(find "$log_dir" -mindepth 2 -maxdepth 2 -name run.log -type f 2>/dev/null | sort -r | head -7)

    if [[ -z "$summary" ]]; then
        summary=$(jq -Rnc --arg log "$run_log" '
            ([inputs | fromjson? | select(type == "object" and .msg == "Session started")] | last) as $any |
            if $any == null then {run_id: null, timestamp: null, log_file: null}
            else {run_id: ($any.run_id // null), timestamp: ($any.ts // null), log_file: $log} end' \
            "$run_log" 2>/dev/null) || summary=""
    fi
    [[ -n "$summary" ]] || summary='{"run_id": null, "timestamp": null, "log_file": null}'
    printf '%s\n' "$summary"
}

# Get config summary
_status_get_config() {
    local config_file="${DSR_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dsr}/config.yaml"

    if [[ ! -f "$config_file" ]]; then
        echo '{"valid": false, "path": null}'
        return
    fi

    echo "{\"valid\": true, \"path\": \"$config_file\"}"
}

# Get signing status
_status_get_signing() {
    local private_key="${DSR_CONFIG_DIR:-$HOME/.config/dsr}/secrets/minisign.key"
    local public_key="${DSR_CONFIG_DIR:-$HOME/.config/dsr}/minisign.pub"

    local configured=false
    if [[ -f "$private_key" && -f "$public_key" ]]; then
        configured=true
    fi

    echo "{\"configured\": $configured}"
}

# Status command
cmd_status() {
    local refresh=false compact=false watch=false interval=5

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --refresh|-r)
                refresh=true
                shift
                ;;
            --compact)
                compact=true
                shift
                ;;
            --watch|-w)
                watch=true
                shift
                ;;
            --interval|-i)
                [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]{0,4}$ ]] || {
                    log_error "--interval requires a positive number of seconds"
                    return 4
                }
                interval="$2"
                shift 2
                ;;
            --help|-h)
                cat << 'EOF'
dsr status - System and last run summary

USAGE:
    dsr status [options]

OPTIONS:
    --refresh, -r    Refresh host health (makes network calls)
    --compact        One-line summary
    --watch, -w      Redraw the summary until interrupted
    --interval <s>   Seconds between --watch redraws (default: 5)
    --json           JSON output (global flag)

DESCRIPTION:
    Shows a quick summary of:
    - Overall health (ok, degraded, error)
    - Last command run (command, run_id, outcome)
    - Configuration status
    - Host health (from cache by default)
    - Signing configuration

    By default, status is read from local state only (<1s).
    Use --refresh to update host health checks.

EXIT CODES:
    0  - Healthy
    1  - Degraded (an unhealthy host, or the last command failed)
    3  - Unhealthy (no valid configuration)
    4  - Invalid arguments

EXAMPLES:
    dsr status                Show cached status
    dsr status --refresh      Refresh host health
    dsr status --compact      One line, for prompts and tmux
    dsr status --json         Machine-readable output
EOF
                return 0
                ;;
            *)
                log_error "Unknown option: $1"
                return 4
                ;;
        esac
    done

    if $watch; then
        if $JSON_MODE; then
            log_error "--watch redraws a terminal summary; it cannot be combined with --json"
            return 4
        fi
        local watch_args=()
        $refresh && watch_args+=(--refresh)
        $compact && watch_args+=(--compact)
        while true; do
            [[ -t 2 ]] && printf '\033[H\033[2J' >&2
            cmd_status ${watch_args[@]+"${watch_args[@]}"}
            sleep "$interval" || break
        done
        return 0
    fi

    # Collect status information
    local last_run config_status signing_status hosts_status

    last_run=$(_status_get_last_run)
    config_status=$(_status_get_config)
    signing_status=$(_status_get_signing)

    # The last `dsr check` result, if any (state/check/last.json).
    local check_snapshot="null"
    local check_file="${DSR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsr}/check/last.json"
    if [[ -f "$check_file" && ! -L "$check_file" ]]; then
        check_snapshot=$(jq -c 'select(type == "object")' "$check_file" 2>/dev/null) || check_snapshot="null"
        [[ -n "$check_snapshot" ]] || check_snapshot="null"
    fi

    # Get host health (refresh if requested)
    if $refresh; then
        log_info "Refreshing host health..."
        hosts_status=$(host_health_check_all --json 2>/dev/null | jq -c '.hosts | map({(.hostname): .}) | add // {}' 2>/dev/null) || hosts_status='{}'
    else
        # Try to get from cache for enabled hosts only, fallback to empty
        local cache_dir="${DSR_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/dsr}/health"
        local enabled_hosts
        enabled_hosts=$(config_list_hosts 2>/dev/null || true)
        if [[ -d "$cache_dir" && -n "$enabled_hosts" ]]; then
            hosts_status=$(while IFS= read -r host; do
                [[ -z "$host" ]] && continue
                local cache_file="$cache_dir/${host}.json"
                [[ -f "$cache_file" ]] && cat "$cache_file"
            done <<< "$enabled_hosts" | jq -s 'map({(.hostname): .}) | add // {}' 2>/dev/null) || hosts_status='{}'
        else
            hosts_status='{}'
        fi
    fi

    # Ensure hosts_status is valid JSON
    if [[ -z "$hosts_status" ]] || ! echo "$hosts_status" | jq -e . &>/dev/null; then
        hosts_status='{}'
    fi

    # Build JSON output (schemas/status-details.json). Overall health: no
    # valid config is an error (exit 3); an unhealthy host or a failed last
    # command degrades it (exit 1). Missing signing keys only warn.
    local json_output
    json_output=$(jq -nc \
        --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --argjson last_run "$last_run" \
        --argjson config "$config_status" \
        --argjson signing "$signing_status" \
        --argjson check "$check_snapshot" \
        --argjson hosts "$hosts_status" '
        ($hosts | to_entries | map(.value as $h | {
            host: .key,
            status: (if $h.healthy == false then "error"
                     else ({ok: "ok", warning: "warn", warn: "warn", error: "error"}[$h.status // ""] // "unknown") end),
            platform: $h.platform,
            last_checked_at: $h.checked_at,
            message: (if (($h.errors // 0) | type) == "number" and (($h.errors // 0) + ($h.warnings // 0)) > 0
                      then "\($h.errors // 0) error(s), \($h.warnings // 0) warning(s)" else null end)
        } | with_entries(select(.value != null)))) as $host_list |
        ([$host_list[] | select(.status == "error") | .host]) as $bad_hosts |
        # A usage error (4) or an interrupt (5, 130) says nothing about health.
        (($last_run.exit_code // 0) as $code | $code != 0 and ($code | IN(4, 5, 130) | not)) as $last_failed |
        (if ($config.valid | not) then "error"
         elif ($bad_hosts | length) > 0 or $last_failed then "degraded"
         else "ok" end) as $overall |
        {
            generated_at: $generated_at,
            overall_status: $overall,
            last_run: $last_run,
            config: $config,
            signing: $signing,
            hosts: $host_list,
            queue: (if $check == null then null else
                {throttled_count: ($check.throttled // [] | length),
                 threshold_seconds: $check.threshold_seconds, checked_at: $check.checked_at} end),
            warnings: ([
                (if ($config.valid | not) then "no configuration (run dsr config init)" else empty end),
                ($bad_hosts[] | "host \(.) is unhealthy"),
                (if $last_failed
                 then "last command \($last_run.command) exited \($last_run.exit_code)" else empty end),
                (if ($signing.configured | not) then "signing keypair not configured" else empty end)
            ])
        } | with_entries(select(.value != null))' 2>/dev/null) || json_output='{"overall_status": "error"}'

    local overall status_exit=0 envelope_status="success"
    overall=$(jq -r '.overall_status // "error"' <<< "$json_output")
    case "$overall" in
        ok) ;;
        degraded) status_exit=1 envelope_status="partial" ;;
        *) status_exit=3 envelope_status="error" ;;
    esac

    if $JSON_MODE; then
        json_envelope "status" "$envelope_status" "$status_exit" "$json_output"
    elif $compact; then
        jq -r '"dsr: \(.overall_status)"
            + " | config \(if .config.valid then "ok" else "missing" end)"
            + " | hosts \([.hosts[] | select(.status == "ok" or .status == "warn")] | length)/\(.hosts | length) ok"
            + " | last \(.last_run.command // "none")"
            + (if .last_run.status then " \(.last_run.status)" else "" end)' <<< "$json_output" >&2
    else
        # Human-readable output (stderr; stdout carries structured data only)
        echo "" >&2
        log_info "=== DSR Status ==="
        case "$overall" in
            ok) log_ok "Overall: ok" ;;
            degraded) log_warn "Overall: degraded" ;;
            *) log_error "Overall: error" ;;
        esac
        echo "" >&2

        # Last run
        local run_id ts last_command last_outcome
        run_id=$(echo "$last_run" | jq -r '.run_id // "none"')
        ts=$(echo "$last_run" | jq -r '.timestamp // "never"')
        last_command=$(echo "$last_run" | jq -r '.command // empty')
        last_outcome=$(echo "$last_run" | jq -r 'if .exit_code == null then empty
            else "\(.status) (exit \(.exit_code))" end')

        if [[ "$run_id" != "null" && "$run_id" != "none" ]]; then
            log_info "Last Run:"
            [[ -n "$last_command" ]] && log_info "  Command:   $last_command"
            log_info "  Run ID:    $run_id"
            log_info "  Timestamp: $ts"
            [[ -n "$last_outcome" ]] && log_info "  Outcome:   $last_outcome"
        else
            log_info "Last Run: no runs recorded"
        fi
        echo "" >&2

        # Config
        local config_valid config_path
        config_valid=$(echo "$config_status" | jq -r '.valid')
        config_path=$(echo "$config_status" | jq -r '.path // "not found"')

        log_info "Configuration:"
        if [[ "$config_valid" == "true" ]]; then
            log_ok "  Config: valid ($config_path)"
        else
            log_warn "  Config: not found (run 'dsr config init')"
        fi
        echo "" >&2

        # Signing
        local signing_configured
        signing_configured=$(echo "$signing_status" | jq -r '.configured')

        log_info "Signing:"
        if [[ "$signing_configured" == "true" ]]; then
            log_ok "  Keypair: configured"
        else
            log_warn "  Keypair: not configured (run 'dsr signing init')"
        fi
        echo "" >&2

        # Hosts (if any cached)
        if jq -e '.hosts | length > 0' <<< "$json_output" >/dev/null 2>&1; then
            log_info "Build Hosts ($($refresh && echo refreshed || echo cached)):"
            jq -r '.hosts[] | "  \(.host): \(.status)" + (if .message then " (\(.message))" else "" end)' \
                <<< "$json_output" >&2 2>/dev/null || true
        else
            log_info "Build Hosts: no cached status (use --refresh)"
        fi
        echo "" >&2
    fi

    return "$status_exit"
}

# ============================================================================
# VERSION SUBCOMMAND
# ============================================================================

cmd_version() {
    local subcmd="${1:-detect}"
    shift 2>/dev/null || true

    case "$subcmd" in
        detect)
            # dsr version detect <tool|path>
            local target="${1:-}"
            local repo_path=""
            local language=""
            local main_package=""

            if [[ -z "$target" ]]; then
                log_error "Usage: dsr version detect <tool|path>"
                return 4
            fi

            # Resolve target to repo path
            if [[ -d "$target" ]]; then
                repo_path="$target"
            else
                # Try to find tool in repos.d
                local config_file="${DSR_CONFIG_DIR:-$HOME/.config/dsr}/repos.d/${target}.yaml"
                if [[ -f "$config_file" ]] && command -v yq &>/dev/null; then
                    repo_path=$(yq -r '.local_path // ""' "$config_file" 2>/dev/null)
                    language=$(yq -r '.language // ""' "$config_file" 2>/dev/null)
                    main_package=$(yq -r '.main_package // ""' "$config_file" 2>/dev/null)
                fi
            fi

            if [[ -z "$repo_path" || ! -d "$repo_path" ]]; then
                log_error "Cannot resolve target to repository: $target"
                return 4
            fi

            if $JSON_MODE; then
                local json_result
                if ! json_result=$(version_info_json "$repo_path" "$language" "$main_package"); then
                    json_envelope "version detect" "error" 1 \
                        "$(jq -nc --arg repo_path "$repo_path" '{repo_path: $repo_path, error: "No unambiguous version source"}')"
                    return 1
                fi
                json_envelope "version detect" "success" 0 "$json_result"
            else
                local version
                if version=$(version_detect "$repo_path" "$language" "$main_package"); then
                    log_ok "Version: $version (v$version)"
                    if version_needs_tag "$repo_path" "$language" "$main_package"; then
                        log_info "Tag v$version does not exist (create with: dsr version tag $target)"
                    else
                        log_info "Tag v$version already exists"
                    fi
                else
                    log_error "No version file found in $repo_path"
                    return 1
                fi
            fi
            ;;

        tag)
            # dsr version tag <tool|path> [--push] [--all]
            local target="${1:-}"
            local push=false
            local tag_all=false
            local dry_run="$DRY_RUN"
            local language=""
            local main_package=""

            # Parse options
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --push) push=true; shift ;;
                    --all) tag_all=true; shift ;;
                    --dry-run|-n) dry_run=true; shift ;;
                    -*) shift ;;
                    *)
                        if [[ -z "$target" || "$target" == --* ]]; then
                            target="$1"
                        fi
                        shift
                        ;;
                esac
            done

            if $tag_all; then
                # Tag all configured tools
                local -a args=()
                $push && args+=("--push")
                $dry_run && args+=("--dry-run")
                $JSON_MODE && args+=("--json")
                version_tag_all "${args[@]}"
                return $?
            fi

            if [[ -z "$target" ]]; then
                log_error "Usage: dsr version tag <tool|path> [--push]"
                log_error "       dsr version tag --all [--push]"
                return 4
            fi

            # Resolve target to repo path
            local repo_path=""
            if [[ -d "$target" ]]; then
                repo_path="$target"
            else
                local config_file="${DSR_CONFIG_DIR:-$HOME/.config/dsr}/repos.d/${target}.yaml"
                if [[ -f "$config_file" ]] && command -v yq &>/dev/null; then
                    repo_path=$(yq -r '.local_path // ""' "$config_file" 2>/dev/null)
                    language=$(yq -r '.language // ""' "$config_file" 2>/dev/null)
                    main_package=$(yq -r '.main_package // ""' "$config_file" 2>/dev/null)
                fi
            fi

            if [[ -z "$repo_path" || ! -d "$repo_path" ]]; then
                log_error "Cannot resolve target to repository: $target"
                return 4
            fi

            local -a tag_args=()
            $push && tag_args+=("--push")
            $dry_run && tag_args+=("--dry-run")
            [[ -n "$language" ]] && tag_args+=("--language" "$language")
            [[ -n "$main_package" ]] && tag_args+=("--main-package" "$main_package")

            if version_create_tag "$repo_path" "${tag_args[@]}"; then
                if $JSON_MODE; then
                    local json_result
                    json_result=$(version_info_json "$repo_path" "$language" "$main_package")
                    json_envelope "version tag" "success" 0 "$json_result"
                fi
                return 0
            else
                # 2 = origin holds a different tag, 8 = origin unreadable.
                return $?
            fi
            ;;

        --help|-h|help)
            cat << 'EOF'
dsr version - Detect and tag versions from version files

USAGE:
    dsr version <subcommand> [options]

SUBCOMMANDS:
    detect <tool|path>      Show version from version files
    tag <tool|path>         Create git tag for detected version
    tag --all               Tag all configured tools with new versions

OPTIONS:
    --push          Push tags to remote after creation
    --dry-run       Show planned actions without executing

VERSION SOURCES:
    Rust        Cargo.toml       version = "X.Y.Z"
    Go          VERSION, *.go    Version = "X.Y.Z"
    Node/Bun    package.json     "version": "X.Y.Z"
    Python      pyproject.toml   version = "X.Y.Z"

EXAMPLES:
    dsr version detect ntm          Show version for ntm tool
    dsr version detect /path/to/repo
    dsr version tag ntm --push      Create and push tag
    dsr version tag --all           Tag all tools needing tags
    dsr version tag --all --push    Tag and push all

For more information, see docs/CLI_CONTRACT.md
EOF
            ;;

        *)
            log_error "Unknown version subcommand: $subcmd"
            log_info "Run 'dsr version --help' for usage"
            return 4
            ;;
    esac
}

