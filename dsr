# Show version
show_version() {
    if $JSON_MODE; then
        echo "{\"tool\": \"dsr\", \"version\": \"$DSR_VERSION\"}"
    else
        echo "dsr version $DSR_VERSION"
    fi
}

# Run a command, keeping its stdout (its result) apart from its stderr (its
# diagnostics): stdout goes to _DSR_CAPTURED_OUT, stderr is replayed to
# stderr and kept, color codes stripped, in _DSR_CAPTURED_ERR.
# Usage: _dsr_capture <command> [args...]; returns the command's status.
_dsr_capture() {
    local err_file status=0
    _DSR_CAPTURED_OUT=""
    _DSR_CAPTURED_ERR=""
    err_file=$(mktemp "${TMPDIR:-/tmp}/dsr-stderr.XXXXXX") || return 1
    _DSR_CAPTURED_OUT=$("$@" 2> "$err_file") || status=$?
    _DSR_CAPTURED_ERR=$(sed $'s/\x1b\\[[0-9;]*m//g' "$err_file")
    cat -- "$err_file" >&2
    rm -f -- "$err_file"
    return "$status"
}

# JSON envelope helper
# Usage: json_envelope <command> <status> <exit_code> [details_json]
json_envelope() {
    local cmd="$1"
    local vstatus="$2"  # renamed to avoid potential conflict
    local exit_code="$3"
    local details="${4:-"{}"}"
    # stdout must stay one JSON document: details that are not exactly one
    # JSON value (a caller pasting log text or two objects) are carried as a
    # string instead of corrupting the envelope.
    local normalized
    if normalized=$(jq -ces 'if length == 1 then .[0] else error("not one value") end' <<< "$details" 2>/dev/null); then
        details="$normalized"
    else
        log_warn "Internal: $cmd produced malformed JSON details; reporting them as text"
        details=$(jq -nc --arg raw "$details" '{error: "malformed details", raw: $raw}')
    fi
    local run_id
    run_id=$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null || echo "unknown")
    local started_at
    started_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    cat << EOF
{
  "command": "$cmd",
  "status": "$vstatus",
  "exit_code": $exit_code,
  "run_id": "$run_id",
  "started_at": "$started_at",
  "duration_ms": 0,
  "tool": "dsr",
  "version": "$DSR_VERSION",
  "details": $details
}
EOF
}

# ============================================================================
# CONFIG SUBCOMMAND
# ============================================================================

cmd_config() {
    local subcmd="${1:-show}"
    shift 2>/dev/null || true

    case "$subcmd" in
        init)
            cmd_config_init "$@"
            ;;
        show)
            cmd_config_show "$@"
            ;;
        get)
            cmd_config_get "$@"
            ;;
        set)
            cmd_config_set "$@"
            ;;
        validate)
            cmd_config_validate "$@"
            ;;
        migrate)
            cmd_config_migrate "$@"
            ;;
        edit)
            cmd_config_edit "$@"
            ;;
        --help|-h|help)
            cat << 'EOF'
dsr config - View and modify configuration

USAGE:
    dsr config <subcommand> [options]

SUBCOMMANDS:
    init        Initialize configuration directories and files
    show        Show current configuration (--section <name> for one part)
    get <key>   Get a specific config value
    set <k>=<v> Set a config value (saved to config.yaml; requires yq)
    validate    Validate configuration files
    migrate     Bring config.yaml to the current schema (backup first)
    edit        Open config in $EDITOR

OPTIONS:
    --json      Output in JSON format
    --force     Overwrite existing files (init only)
    --dry-run   Report migration changes without writing (migrate only)

EXAMPLES:
    dsr config init              Create default config files
    dsr config show              Show all configuration
    dsr config show --section signing
    dsr config get threshold_seconds
    dsr config set log_level=debug
    dsr config validate
    dsr config migrate --dry-run
EOF
            ;;
        *)
            log_error "Unknown config subcommand: $subcmd"
            log_info "Run 'dsr config --help' for usage"
            return 4
            ;;
    esac
}

# Every config subcommand answers --json with one "config" envelope whose
# details.action names the subcommand (schemas/config-details.json).
_config_envelope() {
    local exit_code="$1" details="$2" status="success"
    [[ "$exit_code" -eq 0 ]] || status="error"
    json_envelope "config" "$status" "$exit_code" "$details"
}

cmd_config_init() {
    local force=false
    [[ "${1:-}" == "--force" ]] && force=true

    if $JSON_MODE; then
        local status=0
        if $force; then
            config_init --force >/dev/null 2>&1 || status=$?
        else
            config_init >/dev/null 2>&1 || status=$?
        fi
        _config_envelope "$status" "$(jq -nc --arg dir "$DSR_CONFIG_DIR" --arg file "$DSR_CONFIG_FILE" \
            --argjson initialized "$([[ $status -eq 0 ]] && echo true || echo false)" \
            '{action: "init", config_dir: $dir, config_file: $file, initialized: $initialized}')"
        return $status
    else
        if $force; then
            config_init --force
        else
            config_init
        fi
    fi
}

cmd_config_show() {
    local section=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --section)
                [[ $# -ge 2 && -n "$2" ]] || { log_error "--section requires a name"; return 4; }
                section="$2"
                shift 2
                ;;
            --section=*)
                section="${1#*=}"
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                return 4
                ;;
            *)
                section="$1"
                shift
                ;;
        esac
    done

    config_load
    # A section is a key or a dotted prefix: `signing` shows signing.enabled.
    local -a keys=()
    local k
    for k in "${!DSR_CONFIG[@]}"; do
        [[ -z "$section" || "$k" == "$section" || "$k" == "$section".* ]] && keys+=("$k")
    done
    if [[ -n "$section" && ${#keys[@]} -eq 0 ]]; then
        log_error "No configuration under: $section"
        $JSON_MODE && _config_envelope 4 "$(jq -nc --arg section "$section" \
            '{action: "show", section: $section, values: {}}')"
        return 4
    fi

    if ! $JSON_MODE; then
        config_show "$section"
        return $?
    fi
    local values='{}'
    for k in ${keys[@]+"${keys[@]}"}; do
        values=$(jq -c --arg k "$k" --arg v "${DSR_CONFIG[$k]}" '. + {($k): $v}' <<< "$values")
    done
    _config_envelope 0 "$(jq -nc --argjson values "$values" --arg section "$section" \
        --arg config_dir "$DSR_CONFIG_DIR" --arg cache_dir "$DSR_CACHE_DIR" --arg state_dir "$DSR_STATE_DIR" \
        --arg config_file "$DSR_CONFIG_FILE" --arg hosts_file "$DSR_HOSTS_FILE" --arg repos_file "$DSR_REPOS_FILE" '
        {action: "show", config_dir: $config_dir, cache_dir: $cache_dir, state_dir: $state_dir,
         config_file: $config_file, hosts_file: $hosts_file, repos_file: $repos_file,
         section: (if $section == "" then null else $section end),
         values: ($values | to_entries | sort_by(.key) | from_entries)}')"
}

cmd_config_get() {
    local key="${1:-}"
    if [[ -z "$key" ]]; then
        log_error "Usage: dsr config get <key>"
        return 4
    fi

    config_load
    local value
    value=$(config_get "$key" "")

    if [[ -z "$value" ]]; then
        log_error "Key not found: $key"
        $JSON_MODE && _config_envelope 4 "$(jq -nc --arg key "$key" \
            '{action: "get", key: $key, errors: [{code: "E031", message: "key not found"}]}')"
        return 4
    fi

    if $JSON_MODE; then
        _config_envelope 0 "$(jq -nc --arg key "$key" --arg value "$value" \
            '{action: "get", key: $key, value: $value}')"
    else
        echo "$value"
    fi
}

cmd_config_set() {
    local input="${1:-}"
    if [[ -z "$input" || ! "$input" =~ = ]]; then
        log_error "Usage: dsr config set KEY=VALUE"
        return 4
    fi

    local key="${input%%=*}"
    local value="${input#*=}"
    local status=0 reason=""

    # A one-shot CLI has no "in memory": the value is saved or the command fails.
    if ! command -v yq &>/dev/null; then
        log_error "Saving configuration requires yq (mikefarah/yq v4)"
        status=3 reason="yq is not installed"
    elif [[ ! -f "$DSR_CONFIG_FILE" ]]; then
        log_error "No configuration file at $DSR_CONFIG_FILE; run 'dsr config init' first"
        status=4 reason="configuration file not found"
    else
        config_load
        config_set "$key" "$value" --persist || status=$?
        [[ $status -eq 0 ]] || reason="could not write $DSR_CONFIG_FILE"
    fi

    if $JSON_MODE; then
        _config_envelope "$status" "$(jq -nc --arg key "$key" --arg value "$value" \
            --arg file "$DSR_CONFIG_FILE" --arg reason "$reason" '
            {action: "set", key: $key, value: $value, config_file: $file, persisted: ($reason == "")}
            + (if $reason == "" then {} else {errors: [{message: $reason,
                code: (if ($reason | test("not found|not installed")) then "E031" else "E030" end)}]} end)')"
    fi
    return $status
}

cmd_config_validate() {
    local status=0
    config_load
    if $JSON_MODE; then
        config_validate 2>/dev/null || status=4
        _config_envelope "$status" "$(jq -nc --arg file "$DSR_CONFIG_FILE" \
            --argjson valid "$([[ $status -eq 0 ]] && echo true || echo false)" \
            '{action: "validate", config_file: $file, valid: $valid}')"
        return $status
    fi
    config_validate
}

# Bring config.yaml to this dsr's schema version, backing it up first.
# Schema 1.0.0 is the only version so far: migration stamps a missing
# schema_version and refuses versions this dsr does not know.
cmd_config_migrate() {
    local dry_run="${DRY_RUN:-false}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run|-n) dry_run=true; shift ;;
            *) log_error "Unknown option: $1"; return 4 ;;
        esac
    done

    local target="$DSR_SCHEMA_VERSION" from="" status=0 reason="" backup=""
    local -a changed=()
    if [[ ! -f "$DSR_CONFIG_FILE" ]]; then
        status=4 reason="configuration file not found; run 'dsr config init'"
    elif ! command -v yq &>/dev/null; then
        status=3 reason="yq (mikefarah/yq v4) is required"
    elif ! from=$(yq -r '.schema_version // "" | tostring' "$DSR_CONFIG_FILE" 2>/dev/null); then
        status=4 reason="configuration file is not valid YAML"
    elif [[ -z "$from" || "$from" == null ]]; then
        from=""
        changed+=(schema_version)
    elif [[ "$from" != "$target" ]]; then
        status=4 reason="unknown schema_version $from (this dsr supports $target)"
    fi

    if [[ $status -eq 0 && ${#changed[@]} -gt 0 ]]; then
        if $dry_run; then
            log_info "[DRY RUN] Would set schema_version: $target in $DSR_CONFIG_FILE (backup first)"
        else
            backup="$DSR_CONFIG_FILE.bak.$(date -u +%Y%m%dT%H%M%SZ)"
            if [[ -e "$backup" ]] || ! cp -p -- "$DSR_CONFIG_FILE" "$backup"; then
                status=1 reason="could not create backup $backup" backup=""
            elif ! DSR_SET_VALUE="$target" yq -i '.schema_version = strenv(DSR_SET_VALUE)' "$DSR_CONFIG_FILE"; then
                status=1 reason="could not write $DSR_CONFIG_FILE (backup kept at $backup)"
            else
                log_ok "Migrated $DSR_CONFIG_FILE to schema $target (backup: $backup)"
            fi
        fi
    elif [[ $status -eq 0 ]]; then
        log_ok "$DSR_CONFIG_FILE is already at schema $target; nothing to migrate"
    fi
    [[ $status -eq 0 ]] || log_error "Config migration failed: $reason"

    if $JSON_MODE; then
        _config_envelope "$status" "$(jq -nc --arg file "$DSR_CONFIG_FILE" --arg from "$from" \
            --arg to "$target" --arg backup "$backup" --arg reason "$reason" \
            --argjson dry_run "$dry_run" \
            --argjson changed "$(printf '%s\n' ${changed[@]+"${changed[@]}"} | jq -Rsc 'split("\n") | map(select(length > 0))')" '
            {action: "migrate", config_file: $file,
             from_version: (if $from == "" then null else $from end), to_version: $to,
             changed_keys: $changed, backup_path: (if $backup == "" then null else $backup end),
             dry_run: $dry_run} | with_entries(select(.value != null))
            + (if $reason == "" then {} else {errors: [{message: $reason,
                code: (if ($reason | test("not found|required")) then "E031" else "E030" end)}]} end)')"
    fi
    return $status
}

cmd_config_edit() {
    local editor="${EDITOR:-vi}"
    if [[ ! -f "$DSR_CONFIG_FILE" ]]; then
        log_error "Config file not found. Run: dsr config init"
        return 4
    fi
    exec "$editor" "$DSR_CONFIG_FILE"
}

# ============================================================================
# DOCTOR SUBCOMMAND
# ============================================================================

# doctor --fix: append the invoking user's UID:GID mapping to an actrc that
# binds the workspace without one, after a timestamped backup. Prints the
# backup path.
_doctor_fix_actrc_user() {
    local file="$1" backup
    backup="$file.bak.$(date -u +%Y%m%dT%H%M%SZ)"
    [[ -f "$file" && ! -L "$file" && ! -e "$backup" ]] || return 1
    cp -p -- "$file" "$backup" || return 1
    printf -- '--container-options --user=%s:%s\n' "$(id -u)" "$(id -g)" >> "$file" || return 1
    printf '%s\n' "$backup"
}

# doctor --fix: create a missing actrc from config/actrc.example, mapped to
# the invoking user's UID:GID instead of the example's 1000:1000.
_doctor_create_actrc() {
    local file="$1" example="$SCRIPT_DIR/config/actrc.example" tmp
    [[ -f "$example" && ! -e "$file" && ! -L "$file" ]] || return 1
    tmp=$(mktemp "$file.XXXXXXXX") || return 1
    if sed -E "s/--user=[0-9]+:[0-9]+/--user=$(id -u):$(id -g)/" "$example" > "$tmp" &&
       grep -q -- "--user=$(id -u):$(id -g)" "$tmp" && mv -n -- "$tmp" "$file" && [[ ! -e "$tmp" ]]; then
        return 0
    fi
    rm -f -- "$tmp"
    return 1
}

cmd_doctor() {
    local quick_mode=false
    local fix_mode=false
    local -a fixed=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --quick|-q)
                quick_mode=true
                shift
                ;;
            --fix|-f)
                fix_mode=true
                shift
                ;;
            --help|-h)
                cat << 'EOF'
dsr doctor - System diagnostics

USAGE:
    dsr doctor [options]

OPTIONS:
    --quick, -q     Quick check (core deps + auth only)
    --fix, -f       Apply safe fixes, list remediation for the rest:
                    creates a missing config (dsr config init), creates a
                    missing ~/.actrc from config/actrc.example mapped to your
                    UID:GID, and adds that mapping to an actrc that binds
                    without one (backup first). Never installs software.
    --json          JSON output (global flag)

CHECKS:
    Core (always run):
      - git, gh (auth status), jq, curl

    Build tools:
      - docker, act, ssh to build hosts

    Signing tools (if enabled):
      - minisign, syft

    Network:
      - api.github.com, github.com connectivity

    Config:
      - Configuration file validation
      - Artifact naming consistency across registered repos (not in --quick)

EXIT CODES:
    0  - All checks passed (or only warnings)
    3  - Critical errors found (missing core deps)

EXAMPLES:
    dsr doctor              Full diagnostics
    dsr doctor --quick      Core deps only
    dsr doctor --fix        Apply safe fixes, show remediation steps
    dsr doctor --json       Machine-readable output
EOF
                return 0
                ;;
            *)
                log_error "Unknown option: $1"
                log_info "Run 'dsr doctor --help' for usage"
                return 4
                ;;
        esac
    done

    log_info "Running system diagnostics..."
    $quick_mode && log_info "(quick mode - core checks only)"
    echo ""

    local errors=0
    local warnings=0
    local checks=()
    local fixes=()

    # Helper to escape JSON strings
    _json_escape() {
        printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\n/\\n/g'
    }

    # Helper to add a check result
    _add_check() {
        local name="$1"
        local status="$2"
        local details="$3"
        checks+=("{\"name\": \"$name\", \"status\": \"$status\"$details}")
    }

    # ========== CORE DEPENDENCIES ==========
    log_info "Core dependencies:"

    # Check git
    if command -v git &>/dev/null; then
        local git_ver
        git_ver=$(git --version | cut -d' ' -f3)
        _add_check "git" "ok" ", \"version\": \"$(_json_escape "$git_ver")\""
        log_ok "  git: $git_ver"
    else
        _add_check "git" "error" ", \"message\": \"not found\""
        log_error "  git: not found"
        fixes+=("Install git: apt install git OR brew install git")
        ((errors++))
    fi

    # Check gh
    if command -v gh &>/dev/null; then
        local gh_ver
        gh_ver=$(gh --version 2>/dev/null | head -1 | awk '{print $3}')
        if gh auth status &>/dev/null 2>&1; then
            local gh_user
            gh_user=$(gh api user --jq '.login' 2>/dev/null || echo "unknown")
            _add_check "gh" "ok" ", \"version\": \"$gh_ver\", \"authenticated\": true, \"user\": \"$gh_user\""
            log_ok "  gh: $gh_ver (authenticated as $gh_user)"
        else
            _add_check "gh" "error" ", \"version\": \"$gh_ver\", \"authenticated\": false"
            log_error "  gh: not authenticated"
            fixes+=("Authenticate GitHub CLI: gh auth login")
            ((errors++))
        fi
    else
        _add_check "gh" "error" ", \"message\": \"not found\""
        log_error "  gh: not found"
        fixes+=("Install GitHub CLI: brew install gh OR apt install gh")
        ((errors++))
    fi

    # Check jq
    if command -v jq &>/dev/null; then
        local jq_ver
        jq_ver=$(jq --version 2>/dev/null | sed 's/jq-//')
        _add_check "jq" "ok" ", \"version\": \"$jq_ver\""
        log_ok "  jq: $jq_ver"
    else
        _add_check "jq" "error" ", \"message\": \"not found\""
        log_error "  jq: not found"
        fixes+=("Install jq: brew install jq OR apt install jq")
        ((errors++))
    fi

    # Check curl
    if command -v curl &>/dev/null; then
        local curl_ver
        curl_ver=$(curl --version 2>/dev/null | head -1 | awk '{print $2}')
        _add_check "curl" "ok" ", \"version\": \"$curl_ver\""
        log_ok "  curl: $curl_ver"
    else
        _add_check "curl" "error" ", \"message\": \"not found\""
        log_error "  curl: not found"
        fixes+=("Install curl: apt install curl")
        ((errors++))
    fi

    # Check yq (needed for config operations)
    if command -v yq &>/dev/null; then
        local yq_ver
        yq_ver=$(yq --version 2>/dev/null | awk '{print $NF}')
        _add_check "yq" "ok" ", \"version\": \"$yq_ver\""
        log_ok "  yq: $yq_ver"
    else
        _add_check "yq" "warning" ", \"message\": \"not found\""
        log_warn "  yq: not found (needed for config operations)"
        fixes+=("Install yq: brew install yq OR snap install yq")
        ((warnings++))
    fi

    # Quick mode stops here
    if $quick_mode; then
        echo ""
        _doctor_summary "$errors" "$warnings" "$fix_mode"
        [[ $errors -eq 0 ]] && return 0 || return 3
    fi

    # ========== BUILD TOOLS ==========
    echo ""
    log_info "Build tools:"

    # Check docker
    if command -v docker &>/dev/null; then
        if docker info &>/dev/null 2>&1; then
            local docker_ver
            docker_ver=$(docker --version 2>/dev/null | awk '{print $3}' | tr -d ',')
            _add_check "docker" "ok" ", \"version\": \"$docker_ver\", \"running\": true"
            log_ok "  docker: $docker_ver (running)"
        else
            _add_check "docker" "warning" ", \"running\": false"
            log_warn "  docker: installed but not running"
            fixes+=("Start Docker: systemctl start docker OR open Docker Desktop")
            ((warnings++))
        fi
    else
        _add_check "docker" "warning" ", \"message\": \"not found\""
        log_warn "  docker: not found (needed for act)"
        fixes+=("Install Docker: https://docs.docker.com/get-docker/")
        ((warnings++))
    fi

    # Check act
    if command -v act &>/dev/null; then
        _dsr_require act_runner
        local act_ver act_version
        act_ver=$(act --version 2>/dev/null | head -1)
        act_version="$(_act_installed_version)"
        local act_min_json
        act_min_json="$(_json_escape "$ACT_MIN_VERSION")"
        if act_version_is_supported "$act_version"; then
            _add_check "act" "ok" ", \"version\": \"$(_json_escape "$act_ver")\", \"minimum_version\": \"$act_min_json\""
            log_ok "  act: $act_ver"
        else
            _add_check "act" "warning" ", \"version\": \"$(_json_escape "$act_ver")\", \"minimum_version\": \"$act_min_json\", \"message\": \"unsupported or vulnerable act version\""
            log_warn "  act: $act_ver (upgrade required; minimum supported is v$ACT_MIN_VERSION)"
            fixes+=("Install act v$ACT_MIN_VERSION or newer: https://github.com/nektos/act/releases")
            ((warnings++))
        fi
    else
        _add_check "act" "warning" ", \"message\": \"not found\""
        log_warn "  act: not found (needed for local builds)"
        fixes+=("Install act: brew install act OR https://github.com/nektos/act/releases")
        ((warnings++))
    fi

    # Check actrc configuration (CRITICAL: prevents UID mismatch)
    # catthehacker images run as UID 1001 (runner). Without --user flag,
    # files created by act will have wrong ownership, breaking other processes.
    local actrc_file="$HOME/.actrc"
    if [[ -f "$actrc_file" ]]; then
        local has_bind=false has_user=false
        # Use 'command grep' to bypass any aliases (e.g., rg aliased as grep)
        # Pattern handles optional leading whitespace: "  --bind" or "--bind"
        if command grep -qE '^[[:space:]]*--bind([[:space:]]|$)' "$actrc_file" 2>/dev/null; then
            has_bind=true
        fi
        if command grep -qE -- '--container-options.*--user|--container-options=.*--user' "$actrc_file" 2>/dev/null; then
            has_user=true
        fi

        local actrc_backup=""
        if $has_bind && ! $has_user && $fix_mode &&
           actrc_backup=$(_doctor_fix_actrc_user "$actrc_file"); then
            _add_check "actrc" "ok" ", \"file\": \"$actrc_file\", \"bind\": true, \"user_mapping\": true, \"fixed\": true"
            log_ok "  actrc: fixed - added --container-options --user=$(id -u):$(id -g) (backup: $actrc_backup)"
            fixed+=("actrc: added --user=$(id -u):$(id -g) to $actrc_file (backup $actrc_backup)")
        elif $has_bind && ! $has_user; then
            _add_check "actrc" "error" ", \"message\": \"--bind without --user causes UID mismatch\", \"file\": \"$actrc_file\""
            log_error "  actrc: CRITICAL - --bind without --user flag"
            log_error "         Files created by act will have wrong ownership (UID 1001)"
            log_error "         This WILL break file access for other processes!"
            fixes+=("Fix actrc: Run 'id' to get your UID:GID, then add to ~/.actrc: --container-options --user=UID:GID")
            fixes+=("Quick fix: echo '--container-options --user=$(id -u):$(id -g)' >> ~/.actrc")
            ((errors++))
        elif $has_bind && $has_user; then
            _add_check "actrc" "ok" ", \"file\": \"$actrc_file\", \"bind\": true, \"user_mapping\": true"
            log_ok "  actrc: configured correctly (--bind with --user)"
        else
            _add_check "actrc" "ok" ", \"file\": \"$actrc_file\", \"bind\": false"
            log_ok "  actrc: present (no --bind, no UID concerns)"
        fi
    elif $fix_mode && _doctor_create_actrc "$actrc_file"; then
        _add_check "actrc" "ok" ", \"file\": \"$actrc_file\", \"bind\": true, \"user_mapping\": true, \"fixed\": true"
        log_ok "  actrc: created from config/actrc.example (--user=$(id -u):$(id -g))"
        fixed+=("actrc: created $actrc_file from config/actrc.example")
    else
        _add_check "actrc" "warning" ", \"message\": \"not found\", \"file\": \"$actrc_file\""
        log_warn "  actrc: ~/.actrc not found"
        fixes+=("Create actrc: cp $SCRIPT_DIR/config/actrc.example ~/.actrc")
        fixes+=("See docs/ACT_SETUP.md for configuration guide")
        ((warnings++))
    fi

    # Check SSH
    if command -v ssh &>/dev/null; then
        _add_check "ssh" "ok" ""
        log_ok "  ssh: available"
    else
        _add_check "ssh" "warning" ", \"message\": \"not found\""
        log_warn "  ssh: not found (needed for remote builds)"
        ((warnings++))
    fi

    # ========== SSH TO BUILD HOSTS ==========
    echo ""
    log_info "Build hosts:"

    local timeout_cmd=""
    if command -v timeout &>/dev/null; then
        timeout_cmd="timeout"
    elif command -v gtimeout &>/dev/null; then
        timeout_cmd="gtimeout"
    else
        log_warn "timeout command not available; SSH checks will run without timeout"
    fi

    local enabled_hosts=""
    enabled_hosts=$(config_list_hosts 2>/dev/null || true)
    if [[ -z "$enabled_hosts" ]]; then
        log_warn "  no enabled hosts configured"
    fi

    local host
    while IFS= read -r host; do
        [[ -n "$host" ]] || continue

        local connection ssh_host ssh_timeout check_timeout
        connection="ssh"
        ssh_host="$host"
        ssh_timeout="3"

        if command -v yq &>/dev/null && [[ -f "${DSR_HOSTS_FILE:-}" ]]; then
            connection=$(HOST="$host" yq -r '.hosts[env(HOST)].connection // "ssh"' "$DSR_HOSTS_FILE" 2>/dev/null || echo "ssh")
            ssh_host=$(HOST="$host" yq -r '.hosts[env(HOST)].ssh_host // env(HOST)' "$DSR_HOSTS_FILE" 2>/dev/null || echo "$host")
            ssh_timeout=$(HOST="$host" yq -r '.hosts[env(HOST)].ssh_timeout // 3' "$DSR_HOSTS_FILE" 2>/dev/null || echo "3")
        fi

        [[ -n "$connection" && "$connection" != "null" ]] || connection="ssh"
        [[ -n "$ssh_host" && "$ssh_host" != "null" ]] || ssh_host="$host"
        [[ "$ssh_timeout" =~ ^[0-9]+$ ]] || ssh_timeout="3"
        ((ssh_timeout > 0)) || ssh_timeout="3"
        check_timeout=$((ssh_timeout + 2))

        case "$connection" in
            local)
                _add_check "host-$host" "ok" ", \"connection\": \"local\""
                log_ok "  $host: local"
                ;;
            ssh)
                if [[ -n "$timeout_cmd" ]]; then
                    if "$timeout_cmd" "$check_timeout" ssh -o ConnectTimeout="$ssh_timeout" -o BatchMode=yes "$ssh_host" "echo ok" &>/dev/null 2>&1; then
                        _add_check "ssh-$host" "ok" ", \"ssh_host\": \"$(_json_escape "$ssh_host")\""
                        log_ok "  $host: reachable ($ssh_host)"
                    else
                        _add_check "ssh-$host" "warning" ", \"message\": \"unreachable\", \"ssh_host\": \"$(_json_escape "$ssh_host")\""
                        log_warn "  $host: unreachable ($ssh_host)"
                        fixes+=("Check SSH config for $host: ssh $ssh_host")
                        ((warnings++))
                    fi
                else
                    if ssh -o ConnectTimeout="$ssh_timeout" -o BatchMode=yes "$ssh_host" "echo ok" &>/dev/null 2>&1; then
                        _add_check "ssh-$host" "ok" ", \"ssh_host\": \"$(_json_escape "$ssh_host")\""
                        log_ok "  $host: reachable ($ssh_host)"
                    else
                        _add_check "ssh-$host" "warning" ", \"message\": \"unreachable\", \"ssh_host\": \"$(_json_escape "$ssh_host")\""
                        log_warn "  $host: unreachable ($ssh_host)"
                        fixes+=("Check SSH config for $host: ssh $ssh_host")
                        ((warnings++))
                    fi
                fi
                ;;
            *)
                _add_check "host-$host" "warning" ", \"message\": \"unsupported connection\", \"connection\": \"$(_json_escape "$connection")\""
                log_warn "  $host: unsupported connection '$connection'"
                ((warnings++))
                ;;
        esac
    done <<< "$enabled_hosts"

    # ========== SIGNING TOOLS ==========
    echo ""
    log_info "Signing tools:"

    # Check minisign
    if command -v minisign &>/dev/null; then
        local minisign_ver
        minisign_ver=$(minisign -v 2>&1 | head -1 || echo "unknown")
        _add_check "minisign" "ok" ", \"version\": \"$(_json_escape "$minisign_ver")\""
        log_ok "  minisign: available"

        # Check if key exists
        if [[ -f "${SIGNING_PRIVATE_KEY:-$HOME/.config/dsr/secrets/minisign.key}" ]]; then
            _add_check "minisign-key" "ok" ""
            log_ok "  minisign key: configured"
        else
            _add_check "minisign-key" "warning" ", \"message\": \"not configured\""
            log_warn "  minisign key: not configured"
            fixes+=("Generate signing key: dsr signing init")
            ((warnings++))
        fi
    else
        _add_check "minisign" "warning" ", \"message\": \"not found\""
        log_warn "  minisign: not found (needed for signing)"
        fixes+=("Install minisign: brew install minisign")
        ((warnings++))
    fi

    # Check syft (SBOM generation)
    if command -v syft &>/dev/null; then
        local syft_ver
        syft_ver=$(syft --version 2>/dev/null | head -1 || echo "unknown")
        _add_check "syft" "ok" ", \"version\": \"$(_json_escape "$syft_ver")\""
        log_ok "  syft: $syft_ver"
    else
        _add_check "syft" "warning" ", \"message\": \"not found\""
        log_warn "  syft: not found (needed for SBOM generation)"
        fixes+=("Install syft: brew install syft OR https://github.com/anchore/syft/releases")
        ((warnings++))
    fi

    # ========== NETWORK CONNECTIVITY ==========
    echo ""
    log_info "Network connectivity:"

    # Check api.github.com
    if curl -sf --max-time 5 "https://api.github.com" >/dev/null 2>&1; then
        _add_check "network-api.github.com" "ok" ""
        log_ok "  api.github.com: reachable"
    else
        _add_check "network-api.github.com" "warning" ", \"message\": \"unreachable\""
        log_warn "  api.github.com: unreachable"
        fixes+=("Check network connectivity to GitHub")
        ((warnings++))
    fi

    # Check github.com
    if curl -sf --max-time 5 "https://github.com" >/dev/null 2>&1; then
        _add_check "network-github.com" "ok" ""
        log_ok "  github.com: reachable"
    else
        _add_check "network-github.com" "warning" ", \"message\": \"unreachable\""
        log_warn "  github.com: unreachable"
        ((warnings++))
    fi

    # ========== DISK SPACE ==========
    echo ""
    log_info "Disk space:"

    local disk_avail_kb disk_avail_gb
    disk_avail_kb=$(df -k . 2>/dev/null | tail -1 | awk '{print $4}')
    if [[ -n "$disk_avail_kb" ]]; then
        disk_avail_gb=$((disk_avail_kb / 1024 / 1024))
        if [[ $disk_avail_gb -lt 5 ]]; then
            _add_check "disk-local" "warning" ", \"available_gb\": $disk_avail_gb"
            log_warn "  local: ${disk_avail_gb}GB available (low)"
            fixes+=("Free up disk space (< 5GB available)")
            ((warnings++))
        else
            _add_check "disk-local" "ok" ", \"available_gb\": $disk_avail_gb"
            log_ok "  local: ${disk_avail_gb}GB available"
        fi
    fi

    # ========== CONFIG ==========
    echo ""
    log_info "Configuration:"

    config_load 2>/dev/null || true
    if config_validate &>/dev/null 2>&1; then
        _add_check "config" "ok" ""
        log_ok "  config: valid"
    elif $fix_mode && [[ ! -e "$DSR_CONFIG_FILE" ]] && config_init >/dev/null 2>&1 &&
         config_load 2>/dev/null && config_validate &>/dev/null; then
        # Only a missing configuration is created; an invalid one is the
        # operator's to repair (dsr config validate names the problem).
        _add_check "config" "ok" ", \"fixed\": true"
        log_ok "  config: created defaults (dsr config init)"
        fixed+=("config: created $DSR_CONFIG_FILE (dsr config init)")
    else
        _add_check "config" "warning" ", \"message\": \"invalid or missing\""
        log_warn "  config: invalid or missing"
        fixes+=("Initialize config: dsr config init")
        ((warnings++))
    fi

    # Artifact naming consistency (bd-1tv.5): catch config / install.sh /
    # workflow naming drift during routine health checks, before a release
    # uploads assets an installer cannot find. Delegates to the same
    # validator as `dsr repos validate --naming`, in a child process so its
    # human output and JSON envelope stay out of the doctor report.
    if ! $quick_mode; then
        local naming_report naming_counts naming_warn=0 naming_err=0 naming_repos=""
        # Validation exits 1 when it finds errors; the report is still the
        # envelope on stdout, so read it whatever the exit code.
        naming_report=$(bash "$SCRIPT_DIR/dsr" --json repos validate --naming 2>/dev/null || true)
        if jq -e '.details.action == "validate"' <<< "$naming_report" >/dev/null 2>&1 &&
           naming_counts=$(jq -er '[.details.validated[]? | (.naming.status // "ok")] |
                "\(map(select(. == "warning")) | length) \(map(select(. == "error")) | length)"' \
                <<< "$naming_report" 2>/dev/null); then
            read -r naming_warn naming_err <<< "$naming_counts"
            naming_repos=$(jq -c '[.details.validated[]? |
                select((.naming.status // "ok") == "warning" or (.naming.status // "ok") == "error") | .repo]' \
                <<< "$naming_report" 2>/dev/null || echo '[]')
            if [[ "$naming_err" -gt 0 ]]; then
                # Reported as an error check but counted as a warning: doctor's
                # exit 3 means missing core dependencies, not config drift.
                _add_check "artifact_naming" "error" ", \"message\": \"$naming_err repo(s) with naming errors\", \"repos\": $naming_repos"
                log_error "  artifact naming: $naming_err repo(s) with errors (run 'dsr repos validate --naming')"
                fixes+=("Align artifact naming: dsr repos validate --naming")
                ((warnings++))
            elif [[ "$naming_warn" -gt 0 ]]; then
                _add_check "artifact_naming" "warning" ", \"message\": \"$naming_warn repo(s) with naming mismatches\", \"repos\": $naming_repos"
                log_warn "  artifact naming: $naming_warn repo(s) with mismatches (run 'dsr repos validate --naming')"
                fixes+=("Align artifact naming: dsr repos validate --naming")
                ((warnings++))
            else
                _add_check "artifact_naming" "ok" ""
                log_ok "  artifact naming: all registered repos consistent"
            fi
        else
            _add_check "artifact_naming" "warning" ", \"message\": \"could not run naming validation\""
            log_warn "  artifact naming: could not validate (no repos registered, or validation failed)"
            ((warnings++))
        fi
    fi

    # Summary
    echo ""
    _doctor_summary "$errors" "$warnings" "$fix_mode"
    [[ $errors -eq 0 ]] && return 0 || return 3
}

# Doctor summary helper - called at end to print summary and JSON output
# Uses global arrays: checks[], fixes[]
_doctor_summary() {
    local errors="$1"
    local warnings="$2"
    local fix_mode="$3"

    local exit_code=0
    local overall_status="healthy"

    if [[ $errors -gt 0 ]]; then
        log_error "Found $errors error(s), $warnings warning(s)"
        exit_code=3
        overall_status="unhealthy"
    elif [[ $warnings -gt 0 ]]; then
        log_warn "Found $warnings warning(s)"
        overall_status="degraded"
    else
        log_ok "All checks passed"
    fi

    # Show fixes if requested
    if [[ "$fix_mode" == "true" && ${#fixed[@]} -gt 0 ]]; then
        echo "" >&2
        log_ok "Applied fixes:"
        for fix in "${fixed[@]}"; do
            log_ok "  ✓ $fix"
        done
    fi
    if [[ "$fix_mode" == "true" && ${#fixes[@]} -gt 0 ]]; then
        echo "" >&2
        log_info "Suggested fixes:"
        for fix in "${fixes[@]}"; do
            log_info "  → $fix"
        done
    fi

    if $JSON_MODE; then
        local checks_json details_json
        checks_json=$(printf '%s\n' "${checks[@]}" | jq -sc '.')
        details_json=$(jq -nc \
            --argjson errors "$errors" \
            --argjson warnings "$warnings" \
            --arg overall_status "$overall_status" \
            --argjson checks "$checks_json" \
            --argjson fixed "$(printf '%s\n' ${fixed[@]+"${fixed[@]}"} | jq -Rsc 'split("\n") | map(select(length > 0))')" \
            '{
                overall_status: $overall_status,
                errors: $errors,
                warnings: $warnings,
                checks: $checks,
                fixed: $fixed
            }')
        local status_str
        [[ "$errors" -eq 0 ]] && status_str="success" || status_str="error"
        json_envelope "doctor" "$status_str" "$exit_code" "$details_json"
    fi
}

